# Copy to .env and fill in values. Never commit .env.

# ── Social Gallery (Cloudflare R2) ────────────────────────────────────────────
SOCIAL_GALLERY_R2_ACCOUNT_ID=
SOCIAL_GALLERY_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
SOCIAL_GALLERY_R2_ACCESS_KEY_ID=
SOCIAL_GALLERY_R2_SECRET_ACCESS_KEY=
SOCIAL_GALLERY_R2_BUCKET=clean-social-gallery
SOCIAL_GALLERY_R2_REGION=auto
SOCIAL_GALLERY_R2_CORS_ORIGINS=http://localhost:8069
# Optional Cloudflare dashboard API token (not used by upload flow today)
SOCIAL_GALLERY_CLOUDFLARE_API_TOKEN=

# ── Company Documentary (Cloudflare R2) ───────────────────────────────────────
COMPANY_DOCUMENTARY_R2_ACCOUNT_ID=
COMPANY_DOCUMENTARY_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
COMPANY_DOCUMENTARY_R2_ACCESS_KEY_ID=
COMPANY_DOCUMENTARY_R2_SECRET_ACCESS_KEY=
COMPANY_DOCUMENTARY_R2_BUCKET=clean-company-documentary
COMPANY_DOCUMENTARY_R2_REGION=auto
COMPANY_DOCUMENTARY_R2_CORS_ORIGINS=http://localhost:8069
COMPANY_DOCUMENTARY_CLOUDFLARE_API_TOKEN=

# ── Social Gallery AI moderation (Hugging Face — preferred) ─────────────────
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V4.1-Flash:novita

# ── Social Gallery AI moderation (Ollama — local fallback) ──────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llava
# Set SOCIAL_GALLERY_OLLAMA_DISABLED=1 to skip local Ollama.

# ── Social Gallery AI moderation (OpenRouter — optional fallback) ─────────────
# Also used by Organizational Files folder description assist.
OPENROUTER_API_KEY=
# Optional. Organizational Files defaults to nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=
# ── Organizational Files cloud import (OAuth) ─────────────────────────────────
# Per provider: ORG_<PROVIDER>_CLIENT_ID and ORG_<PROVIDER>_CLIENT_SECRET
# Providers: GOOGLE_DRIVE, DROPBOX, ONEDRIVE, SHAREPOINT
# Redirect URI (register in each OAuth app): {web.base.url}/api/organizational/oauth/callback
ORG_GOOGLE_DRIVE_CLIENT_ID=
ORG_GOOGLE_DRIVE_CLIENT_SECRET=
ORG_DROPBOX_CLIENT_ID=
ORG_DROPBOX_CLIENT_SECRET=
ORG_ONEDRIVE_CLIENT_ID=
ORG_ONEDRIVE_CLIENT_SECRET=
ORG_SHAREPOINT_CLIENT_ID=
ORG_SHAREPOINT_CLIENT_SECRET=

# ── Document Management / Odoo dev ───────────────────────────────────────────
# Local machine without torch / Qwen Ask embeddings (no pip install, no HF downloads):
#   CLEON_LOCAL_RAG=0
#   ODOO_SKIP_PYTHON_DEPS=1
# Ask RAG on a server that should index: install sentence-transformers + torch in the Odoo venv.
# Optional: CLEON_RAG_PRELOAD=1 to load cached HF weights at Odoo startup.

# Optional Odoo system parameters: social_gallery.huggingface_token,
# social_gallery.huggingface_model, social_gallery.ollama_host,
# social_gallery.ollama_model, social_gallery.openrouter_model
