<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ir_ui_menu_inherited" model="ir.ui.view">
        <field name="name">ir.ui.menu.inherited</field>
        <field name="model">ir.ui.menu</field>
        <field name="inherit_id" ref="base.edit_menu_access"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='sequence']" position="after">
                <field name="category_name"/>
            </xpath>
        </field>
    </record>

    

    <record id="action_core_view_hr_core_employee" model="ir.actions.act_window">
        <field name="name">Employee</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="view_hr_core_employee_tree"/>
        <field name="search_view_id" ref="view_hr_core_employee_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {
                'view_mode': 'tree',
                'view_id': ref('view_hr_core_employee_tree'),
            }),
            (0, 0, {
                'view_mode': 'kanban',
                'view_id': ref('hr_employee.view_employee_kanban_without_custom'),
            }),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No recorded yet.
            </p>
            <p>Create a New record.</p>
        </field>
    </record>


</odoo>