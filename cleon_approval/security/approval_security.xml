<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_cleon_approval" model="ir.module.category">
            <field name="name">Workflows &amp; Approvals</field>
            <field name="description">CleonHR Shared Approval Engine Management</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_cleon_approval_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_cleon_approval"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_cleon_approval_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_cleon_approval"/>
            <field name="implied_ids" eval="[(4, ref('group_cleon_approval_user'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- Multi-Company Rules -->
        <record id="rule_cleon_approval_chain_company" model="ir.rule">
            <field name="name">Cleon Approval Chain Multi-Company</field>
            <field name="model_id" ref="model_cleon_approval_chain"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleon_approval_step_company" model="ir.rule">
            <field name="name">Cleon Approval Step Multi-Company</field>
            <field name="model_id" ref="model_cleon_approval_step"/>
            <field name="domain_force">['|', ('chain_id.company_id', '=', False), ('chain_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleon_approval_instance_company" model="ir.rule">
            <field name="name">Cleon Approval Instance Multi-Company</field>
            <field name="model_id" ref="model_cleon_approval_instance"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleon_approval_instance_step_company" model="ir.rule">
            <field name="name">Cleon Approval Instance Step Multi-Company</field>
            <field name="model_id" ref="model_cleon_approval_instance_step"/>
            <field name="domain_force">['|', ('instance_id.company_id', '=', False), ('instance_id.company_id', 'in', company_ids)]</field>
        </record>

        <!-- User Visibility Rules for Instances & Steps -->
        <record id="rule_cleon_approval_instance_user_visibility" model="ir.rule">
            <field name="name">Cleon Approval Instance User Visibility</field>
            <field name="model_id" ref="model_cleon_approval_instance"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('step_ids.resolved_user_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_cleon_approval_instance_manager" model="ir.rule">
            <field name="name">Cleon Approval Instance Administrator All</field>
            <field name="model_id" ref="model_cleon_approval_instance"/>
            <field name="groups" eval="[(4, ref('group_cleon_approval_manager'))]"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleon_approval_instance_step_user_visibility" model="ir.rule">
            <field name="name">Cleon Approval Instance Step User Visibility</field>
            <field name="model_id" ref="model_cleon_approval_instance_step"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('instance_id.employee_id.user_id', '=', user.id), ('resolved_user_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_cleon_approval_instance_step_manager" model="ir.rule">
            <field name="name">Cleon Approval Instance Step Administrator All</field>
            <field name="model_id" ref="model_cleon_approval_instance_step"/>
            <field name="groups" eval="[(4, ref('group_cleon_approval_manager'))]"/>
            <field name="domain_force">['|', ('instance_id.company_id', '=', False), ('instance_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
