<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cleon_approval.WorkflowsApp">
        <div class="cleon-wf-app-container">
            <div class="cleon-wf-heading">
                <div>
                    <h1><i class="fa fa-shield" style="color: #EC4899; margin-right: 8px;"/> Approval Settings</h1>
                    <p>Configure approval routes, routing rules, escalation and delegation.</p>
                </div>
            </div>

            <div class="cleon-wf-tabs" aria-label="Approval configuration">
                <button t-att-class="'cleon-wf-tab ' + (state.activeTab === 'chains' ? 'active' : '')" t-on-click="() => this.setTab('chains')">Approval Workflows</button>
                <button t-att-class="'cleon-wf-tab ' + (state.activeTab === 'types' ? 'active' : '')" t-on-click="() => this.setTab('types')">Workflow Types</button>
                <button t-att-class="'cleon-wf-tab ' + (state.activeTab === 'rules' ? 'active' : '')" t-on-click="() => this.setTab('rules')">Rules &amp; Conditions</button>
                <button t-att-class="'cleon-wf-tab ' + (state.activeTab === 'escalations' ? 'active' : '')" t-on-click="() => this.setTab('escalations')">Escalations</button>
                <button t-att-class="'cleon-wf-tab ' + (state.activeTab === 'delegations' ? 'active' : '')" t-on-click="() => this.setTab('delegations')">Delegation</button>
                <button t-if="!state.scoped" t-att-class="'cleon-wf-tab ' + (state.activeTab === 'history' ? 'active' : '')" t-on-click="() => this.setTab('history')">Audit History</button>
            </div>

            <div class="cleon-wf-content">
                <!-- TAB 1: APPROVAL CHAINS -->
                <t t-if="state.activeTab === 'chains'">
                    <div class="cleon-wf-head">
                        <div>
                            <h2>Approval Workflows</h2>
                            <p>Define the executable approver levels, backups, escalation and auto-approval timers.</p>
                        </div>
                        <button class="cleon-btn pink" t-on-click="() => this.addApprovalChain()"><i class="fa fa-plus"/> Add Approval Workflow</button>
                    </div>

                    <div class="cleon-wf-toolbar">
                        <input type="search" class="form-control" placeholder="Search workflows, codes or approvers…" aria-label="Search approval workflows" t-att-value="state.search" t-on-input="ev => this.filterChains('search', ev.target.value)"/>
                        <select class="form-select" aria-label="Filter workflow status" t-att-value="state.status" t-on-change="ev => this.filterChains('status', ev.target.value)">
                            <option value="all">All statuses</option><option value="active">Active</option><option value="inactive">Inactive</option><option value="draft">Draft</option><option value="archived">Archived</option>
                        </select>
                    </div>
                    <div t-if="state.loading" class="text-center p-5 text-muted" role="status">Loading approval workflows…</div>
                    <div t-elif="state.loadError" class="alert alert-danger" role="alert">
                        Approval data could not be loaded. <button class="btn btn-link" t-on-click="loadData">Try again</button>
                    </div>
                    <div t-elif="!filteredChains.length" class="text-center p-5 text-muted">
                        <i class="fa fa-sitemap fa-2x mb-3"/>
                        <h4 t-esc="state.approvalChains.length ? 'No matching workflows' : 'No approval workflows yet'"/>
                        <p t-esc="state.approvalChains.length ? 'Try another search or status filter.' : 'Create a workflow to define its approval levels.'"/>
                    </div>
                    <t t-else="">
                        <div class="table-responsive cleon-wf-table-wrap">
                            <table class="table cleon-wf-table cleon-wf-routes">
                                <thead><tr><th>Workflow name</th><th>Code</th><th>Workflow type</th><th>Levels</th><th>Approvers</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                                <tbody>
                                    <t t-foreach="visibleChains" t-as="chain" t-key="chain.id">
                                        <tr>
                                            <td><button class="cleon-wf-name" t-on-click="() => this.viewApprovalChain(chain.id)" t-esc="chain.name"/></td>
                                            <td><code class="cleon-code" t-esc="chain.code"/></td>
                                            <td t-esc="chain.module"/>
                                            <td><button class="cleon-wf-levels" t-att-aria-expanded="state.expandedChainIds.includes(chain.id) ? 'true' : 'false'" t-att-aria-label="'Show approval levels for ' + chain.name" t-on-click="() => this.toggleExpandChain(chain.id)"><t t-esc="chain.levels"/> <i t-att-class="'fa ms-1 ' + (state.expandedChainIds.includes(chain.id) ? 'fa-angle-up' : 'fa-angle-down')"/></button></td>
                                            <td><span class="cleon-wf-approvers" t-att-title="chain.approvers" t-esc="chain.approvers || 'Not configured'"/></td>
                                            <td><span t-att-class="'cleon-cfg-badge ' + (chain.active ? 'active' : 'inactive')" t-esc="chain.lifecycleState.charAt(0).toUpperCase() + chain.lifecycleState.slice(1)"/></td>
                                            <td class="text-end">
                                                <Dropdown togglerClass="'btn btn-light border cleon-wf-menu-button'" title="'Actions for ' + chain.name">
                                                    <t t-set-slot="toggler"><i class="fa fa-ellipsis-v"/><span class="visually-hidden">Workflow actions</span></t>
                                                    <DropdownItem onSelected="() => this.viewApprovalChain(chain.id)">View details</DropdownItem>
                                                    <DropdownItem onSelected="() => this.editApprovalChain(chain.id)">Edit workflow</DropdownItem>
                                                    <DropdownItem onSelected="() => this.duplicateApprovalChain(chain.id)">Duplicate workflow</DropdownItem>
                                                    <DropdownItem onSelected="() => this.toggleApprovalChain(chain.id)"><t t-esc="chain.active ? 'Deactivate' : 'Activate'"/></DropdownItem>
                                                    <DropdownItem onSelected="() => this.deleteApprovalChain(chain.id)"><span class="text-danger">Delete workflow</span></DropdownItem>
                                                </Dropdown>
                                            </td>
                                        </tr>
                                        <tr t-if="state.expandedChainIds.includes(chain.id)" class="cleon-wf-detail-row">
                                            <td colspan="7">
                                                <p t-if="chain.description" t-esc="chain.description"/>
                                                <ol class="cleon-wf-level-list">
                                                    <li t-foreach="chain.steps" t-as="step" t-key="step.id">
                                                        <span class="cleon-wf-step-number" t-esc="step_index + 1"/>
                                                        <div class="cleon-wf-step-content">
                                                            <strong t-esc="step.name"/>
                                                            <span class="cleon-wf-step-person"><i class="fa fa-user-o" aria-hidden="true"/> <t t-esc="step.approverTypeLabel"/></span>
                                                            <span class="cleon-wf-step-mode" t-esc="step.completionMode === 'all' ? 'All approvers required' : step.completionMode === 'any' ? 'Any one approver' : 'Single approver'"/>
                                                        </div>
                                                    </li>
                                                </ol>
                                                <span t-if="!chain.steps.length" class="text-muted">No approval levels configured.</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="cleon-wf-list-footer">
                            <label class="d-flex align-items-center gap-2">Rows per page
                                <select class="form-select form-select-sm" aria-label="Workflows per page" t-att-value="state.limit" t-on-change="ev => this.updatePager({offset: 0, limit: Number(ev.target.value)})"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select>
                            </label>
                            <Pager offset="chainOffset" limit="state.limit" total="filteredChains.length" onUpdate.bind="updatePager" isEditable="false"/>
                        </div>
                    </t>
                </t>

                <!-- TAB 2: WORKFLOW TYPES -->
                <t t-if="state.activeTab === 'types'">
                    <div class="cleon-wf-head">
                        <div>
                            <h2>Workflow Types</h2>
                            <p>Manage available workflow types registered across system modules</p>
                        </div>
                        <button class="cleon-btn pink" t-on-click="() => this.addWorkflowType()"><i class="fa fa-plus"/> Add Workflow Type</button>
                    </div>

                    <div t-if="!state.workflowTypes.length" class="text-center p-5 text-muted">
                        <i class="fa fa-cubes fa-3x mb-3" style="color: #D1D5DB;"/>
                        <h4>No Workflow Types Registered</h4>
                        <p>Click <strong>+ Add Workflow Type</strong> to register a new target model workflow.</p>
                    </div>

                    <div t-else="" class="table-responsive">
                        <table class="table cleon-wf-table">
                            <thead>
                                <tr>
                                    <th>NAME</th>
                                    <th>CODE</th>
                                    <th>EVENT</th>
                                    <th>DEFAULT BEHAVIOUR</th>
                                    <th>APPROVAL REQUIRED</th>
                                    <th>DEFAULT ROUTE</th>
                                    <th>STATUS</th>
                                    <th class="text-end">ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.workflowTypes" t-as="type" t-key="type.id">
                                    <td><strong t-esc="type.name"/></td>
                                    <td><code class="cleon-code" t-esc="type.code"/></td>
                                    <td t-esc="type.eventTrigger"/>
                                    <td t-esc="type.defaultBehavior"/>
                                    <td t-esc="type.requiresApproval"/>
                                    <td t-esc="type.defaultRoute"/>
                                    <td><span t-att-class="'cleon-cfg-badge ' + (type.status === 'Enabled' ? 'active' : 'inactive')" t-esc="type.status"/></td>
                                    <td class="text-end">
                                        <button class="btn btn-link btn-sm text-secondary me-2" t-on-click="() => this.editWorkflowType(type.id)" title="Edit Type"><i class="fa fa-pencil"/></button>
                                        <button class="btn btn-link btn-sm text-danger" t-on-click="() => this.deleteWorkflowType(type.id)" title="Delete Type"><i class="fa fa-trash-o"/></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>

                <!-- TAB 3: APPROVAL RULES -->
                <t t-if="state.activeTab === 'rules'">
                    <div class="cleon-wf-head">
                        <div>
                            <h2>Approval Rules &amp; Conditions</h2>
                            <p>Apply a different Approval Route when conditions match. Lowest priority number is evaluated first.</p>
                        </div>
                        <button class="cleon-btn pink" t-on-click="() => this.addApprovalRule()"><i class="fa fa-plus"/> Add Rule</button>
                    </div>
                    <div t-if="!state.approvalRules.length" class="text-center p-5 text-muted">
                        <i class="fa fa-sliders fa-3x mb-3" style="color: #D1D5DB;"/>
                        <h4>No Approval Rules Configured</h4>
                        <p>When no rule matches, the Workflow Type's default Approval Route is used.</p>
                    </div>
                    <div t-else="" class="table-responsive"><table class="table cleon-wf-table"><thead><tr><th>PRIORITY</th><th>RULE</th><th>WORKFLOW TYPE</th><th>CONDITIONS</th><th>APPROVAL ROUTE</th><th>APPLIES TO</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody><tr t-foreach="state.approvalRules" t-as="rule" t-key="rule.id"><td><span class="cleon-priority-badge" t-esc="rule.priority"/></td><td><strong t-esc="rule.name"/></td><td t-esc="rule.workflow"/><td><t t-esc="rule.conditions"/> condition(s)</td><td t-esc="rule.route"/><td t-esc="rule.appliesTo"/><td><span t-att-class="'cleon-cfg-badge ' + (rule.active ? 'active' : 'inactive')" t-esc="rule.active ? 'Active' : 'Inactive'"/></td><td><button class="btn btn-link btn-sm text-secondary" t-on-click="() => this.editApprovalRule(rule.id)"><i class="fa fa-pencil"/></button></td></tr></tbody></table></div>
                </t>

                <!-- TAB 4: ESCALATIONS -->
                <t t-if="state.activeTab === 'escalations'">
                    <div class="cleon-wf-head">
                        <div>
                            <h2>Escalation Rules</h2>
                            <p>Auto-escalate pending approvals after specified SLA timeframes</p>
                        </div>
                        <button class="cleon-btn pink" t-on-click="() => this.addEscalationRule()"><i class="fa fa-plus"/> Add Escalation Rule</button>
                    </div>

                    <div t-if="!state.escalations.length" class="text-center p-5 text-muted">
                        <i class="fa fa-clock-o fa-3x mb-3" style="color: #D1D5DB;"/>
                        <h4>No Step SLA Escalations Configured</h4>
                        <p>Configure SLA timeouts on approval chain steps to display active escalation rules.</p>
                    </div>

                    <div t-else="" class="table-responsive">
                        <table class="table cleon-wf-table">
                            <thead>
                                <tr>
                                    <th>WORKFLOW TYPE</th>
                                    <th>APPROVAL ROUTE</th>
                                    <th>STEP / LEVEL</th>
                                    <th>ESCALATE AFTER</th>
                                    <th>ESCALATION ACTION</th>
                                    <th>ESCALATE TO</th>
                                    <th>STATUS</th>
                                    <th>ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.escalations" t-as="esc" t-key="esc.id">
                                    <td><strong t-esc="esc.workflow"/></td>
                                    <td t-esc="esc.route"/>
                                    <td t-esc="esc.level"/>
                                    <td t-esc="esc.escalateAfter"/>
                                    <td><span class="badge bg-info text-dark" t-esc="esc.slaAction"/></td>
                                    <td t-esc="esc.target"/>
                                    <td><span t-att-class="'cleon-cfg-badge ' + (esc.status === 'Enabled' ? 'active' : 'inactive')" t-esc="esc.status"/></td>
                                    <td><button class="btn btn-link btn-sm text-secondary" t-on-click="() => this.editEscalationRule(esc.id)"><i class="fa fa-pencil"/></button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>

                <t t-if="state.activeTab === 'delegations'">
                    <div class="cleon-wf-head"><div><h2>Approval Delegation</h2><p>Apply a delegate when new requests resolve their approvers during the selected dates. Existing pending requests are unchanged.</p></div><button class="cleon-btn pink" t-on-click="() => this.addDelegation()"><i class="fa fa-plus"/> Add Delegation</button></div>
                    <div t-if="!state.delegations.length" class="text-center p-5 text-muted"><i class="fa fa-user-plus fa-3x mb-3"/><h4>No Delegations Configured</h4></div>
                    <div t-else="" class="table-responsive"><table class="table cleon-wf-table"><thead><tr><th>APPROVER</th><th>DELEGATE</th><th>FROM</th><th>TO</th><th>REASON</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody><tr t-foreach="state.delegations" t-as="item" t-key="item.id"><td t-esc="item.approver"/><td t-esc="item.delegate"/><td t-esc="item.dateFrom"/><td t-esc="item.dateTo"/><td t-esc="item.reason"/><td><span t-att-class="'cleon-cfg-badge ' + (item.active ? 'active' : 'inactive')" t-esc="item.active ? 'Active' : 'Inactive'"/></td><td><button class="btn btn-link btn-sm text-secondary" t-on-click="() => this.editDelegation(item.id)"><i class="fa fa-pencil"/></button></td></tr></tbody></table></div>
                </t>

                <t t-if="!state.scoped and state.activeTab === 'history'">
                    <div class="cleon-wf-head"><div><h2>Approval Audit History</h2><p>Review the route and conditional rule selected for each approval workflow instance.</p></div></div>
                    <div t-if="!state.history.length" class="text-center p-5 text-muted"><i class="fa fa-history fa-3x mb-3"/><h4>No Approval History Yet</h4></div>
                    <div t-else="" class="table-responsive"><table class="table cleon-wf-table"><thead><tr><th>STARTED</th><th>WORKFLOW TYPE</th><th>EMPLOYEE</th><th>ROUTE</th><th>MATCHED RULE</th><th>DECISION SOURCE</th><th>STATE</th><th>ACTIONS</th></tr></thead><tbody><tr t-foreach="state.history" t-as="item" t-key="item.id"><td t-esc="item.started"/><td t-esc="item.workflow"/><td t-esc="item.employee"/><td t-esc="item.route"/><td t-esc="item.rule"/><td t-esc="item.source"/><td><span class="cleon-cfg-badge" t-esc="item.state"/></td><td><button class="btn btn-link btn-sm text-secondary" t-on-click="() => this.openHistory(item.id)"><i class="fa fa-eye"/></button></td></tr></tbody></table></div>
                </t>
            </div>
        </div>
    </t>
    <t t-name="cleon_approval.WorkflowFormDialog">
        <Dialog size="props.size" title="props.title" withBodyPadding="false" modalRef="modalRef" contentClass="'cleon-workflow-dialog'">
            <div class="cleon-workflow-intro"><span class="cleon-workflow-emblem"><i class="fa fa-sitemap" aria-hidden="true"/></span><div><strong>Approval workflow</strong><p t-esc="props.mode === 'readonly' ? 'Review the route, approvers and decision rules.' : 'Define who reviews requests and how each approval progresses.'"/></div><span class="cleon-workflow-mode" t-esc="props.mode === 'readonly' ? 'Read only' : 'Configuration'"/></div>
            <View t-props="viewProps"/>
            <t t-set-slot="footer">
                <button t-if="props.preventEdit and props.preventCreate" class="btn btn-primary" t-on-click="() => props.close()">Close</button>
                <button t-else="" class="btn btn-primary o-default-button" t-on-click="() => props.close()">Done</button>
            </t>
        </Dialog>
    </t>
</templates>
