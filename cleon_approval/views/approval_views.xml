<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Workflow Types Views -->
    <record id="view_cleon_approval_workflow_type_tree" model="ir.ui.view">
        <field name="name">cleon.approval.workflow.type.tree</field>
        <field name="model">cleon.approval.workflow.type</field>
        <field name="arch" type="xml">
            <tree string="Workflow Types">
                <field name="code"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_cleon_approval_workflow_type_form" model="ir.ui.view">
        <field name="name">cleon.approval.workflow.type.form</field>
        <field name="model">cleon.approval.workflow.type</field>
        <field name="arch" type="xml">
            <form string="Workflow Type">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="model_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Approval Chain Views -->
    <record id="view_cleon_approval_chain_tree" model="ir.ui.view">
        <field name="name">cleon.approval.chain.tree</field>
        <field name="model">cleon.approval.chain</field>
        <field name="arch" type="xml">
            <tree string="Approval Chains">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="workflow_type_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="is_default"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_cleon_approval_chain_form" model="ir.ui.view">
        <field name="name">cleon.approval.chain.form</field>
        <field name="model">cleon.approval.chain</field>
        <field name="arch" type="xml">
            <form string="Approval Chain">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Standard Overtime Approval Chain"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="workflow_type_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Steps">
                            <field name="step_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_type"/>
                                    <field name="approver_group_id" required="approver_type == 'group'"/>
                                    <field name="specific_user_id" required="approver_type == 'specific_user'"/>
                                    <field name="sla_timeout_hours"/>
                                    <field name="sla_action"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Approval Instance Views -->
    <record id="view_cleon_approval_instance_tree" model="ir.ui.view">
        <field name="name">cleon.approval.instance.tree</field>
        <field name="model">cleon.approval.instance</field>
        <field name="arch" type="xml">
            <tree string="Approval Workflow Instances" create="false" edit="false">
                <field name="create_date" string="Started"/>
                <field name="workflow_type_id"/>
                <field name="employee_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="current_step_sequence"/>
                <field name="state" widget="badge"/>
                <field name="decision_source"/>
            </tree>
        </field>
    </record>

    <record id="view_cleon_approval_instance_form" model="ir.ui.view">
        <field name="name">cleon.approval.instance.form</field>
        <field name="model">cleon.approval.instance</field>
        <field name="arch" type="xml">
            <form string="Approval Instance" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="workflow_type_id"/>
                            <field name="employee_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="decision_source"/>
                            <field name="decision_comment"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Step Log &amp; History">
                            <field name="step_ids">
                                <tree create="false" edit="false">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="approver_type"/>
                                    <field name="resolved_user_ids" widget="many2many_tags"/>
                                    <field name="state" widget="badge"/>
                                    <field name="sla_timeout_hours"/>
                                    <field name="deadline"/>
                                    <field name="decision_user_id"/>
                                    <field name="decision_at"/>
                                    <field name="decision_comment"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_cleon_approval_chain" model="ir.actions.act_window">
        <field name="name">Approval Chains</field>
        <field name="res_model">cleon.approval.chain</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define multi-level approval chains for HR workflows.
            </p>
        </field>
    </record>

    <record id="action_cleon_approval_workflow_type" model="ir.actions.act_window">
        <field name="name">Workflow Types</field>
        <field name="res_model">cleon.approval.workflow.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_cleon_approval_instance" model="ir.actions.act_window">
        <field name="name">Approval Monitor</field>
        <field name="res_model">cleon.approval.instance</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_cleon_workflows_app" model="ir.actions.client">
        <field name="name">Workflows &amp; Approvals</field>
        <field name="tag">cleon_approval.WorkflowsApp</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_cleon_approval_root"
              name="Workflows &amp; Approvals"
              parent="hr_administration.hr_administration_dashboard"
              action="action_cleon_workflows_app"
              sequence="50"/>

    <record id="menu_cleon_approval_root" model="ir.ui.menu">
        <field name="icon_class">fa fa-sitemap</field>
        <field name="icon_color">#EC4899</field>
        <field name="category_name">CleonHR-HR Admin</field>
        <field name="sequence">50</field>
    </record>

    <menuitem id="menu_cleon_approval_chain" name="Approval Chains" parent="menu_cleon_approval_root" action="action_cleon_approval_chain" sequence="10"/>
    <menuitem id="menu_cleon_approval_instance" name="Approval Instances" parent="menu_cleon_approval_root" action="action_cleon_approval_instance" sequence="20"/>
    <menuitem id="menu_cleon_approval_workflow_type" name="Workflow Types" parent="menu_cleon_approval_root" action="action_cleon_approval_workflow_type" sequence="30"/>
</odoo>
