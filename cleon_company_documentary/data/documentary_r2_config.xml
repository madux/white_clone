<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
      Prefer environment variables for R2 configuration in production.
      See repository root .env.example (COMPANY_DOCUMENTARY_R2_*).
    -->
    <record id="param_r2_account_id" model="ir.config_parameter">
        <field name="key">company_documentary.r2_account_id</field>
        <field name="value"></field>
    </record>
    <record id="param_r2_endpoint_url" model="ir.config_parameter">
        <field name="key">company_documentary.r2_endpoint_url</field>
        <field name="value"></field>
    </record>
    <record id="param_r2_access_key_id" model="ir.config_parameter">
        <field name="key">company_documentary.r2_access_key_id</field>
        <field name="value"></field>
    </record>
    <record id="param_r2_secret_access_key" model="ir.config_parameter">
        <field name="key">company_documentary.r2_secret_access_key</field>
        <field name="value"></field>
    </record>
    <record id="param_r2_bucket" model="ir.config_parameter">
        <field name="key">company_documentary.r2_bucket</field>
        <field name="value"></field>
    </record>
    <record id="param_r2_region" model="ir.config_parameter">
        <field name="key">company_documentary.r2_region</field>
        <field name="value">auto</field>
    </record>
    <record id="param_r2_cors_origins" model="ir.config_parameter">
        <field name="key">company_documentary.r2_cors_origins</field>
        <field name="value"></field>
    </record>
</odoo>
