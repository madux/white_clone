<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to documentary_r2_config.xml for local/dev installs, or set values via
  Odoo system parameters.   Prefer environment variables (see repository root .env.example):

    COMPANY_DOCUMENTARY_R2_ACCOUNT_ID
    COMPANY_DOCUMENTARY_R2_ENDPOINT_URL
    COMPANY_DOCUMENTARY_R2_ACCESS_KEY_ID
    COMPANY_DOCUMENTARY_R2_SECRET_ACCESS_KEY
    COMPANY_DOCUMENTARY_R2_BUCKET
    COMPANY_DOCUMENTARY_R2_REGION
    COMPANY_DOCUMENTARY_R2_CORS_ORIGINS
-->
<odoo noupdate="1">
    <record id="param_r2_account_id" model="ir.config_parameter">
        <field name="key">company_documentary.r2_account_id</field>
        <field name="value">&lt;cloudflare-account-id&gt;</field>
    </record>
    <record id="param_r2_endpoint_url" model="ir.config_parameter">
        <field name="key">company_documentary.r2_endpoint_url</field>
        <field name="value">https://&lt;account-id&gt;.r2.cloudflarestorage.com</field>
    </record>
    <record id="param_r2_access_key_id" model="ir.config_parameter">
        <field name="key">company_documentary.r2_access_key_id</field>
        <field name="value">&lt;r2-access-key-id&gt;</field>
    </record>
    <record id="param_r2_secret_access_key" model="ir.config_parameter">
        <field name="key">company_documentary.r2_secret_access_key</field>
        <field name="value">&lt;r2-secret-access-key&gt;</field>
    </record>
    <record id="param_r2_bucket" model="ir.config_parameter">
        <field name="key">company_documentary.r2_bucket</field>
        <field name="value">clean-company-documentary</field>
    </record>
    <record id="param_r2_region" model="ir.config_parameter">
        <field name="key">company_documentary.r2_region</field>
        <field name="value">auto</field>
    </record>
    <record id="param_r2_cors_origins" model="ir.config_parameter">
        <field name="key">company_documentary.r2_cors_origins</field>
        <field name="value">http://localhost:8069,https://your-odoo-domain.com</field>
    </record>
</odoo>
