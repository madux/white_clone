<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_company_documentary_folder_user" model="ir.rule">
        <field name="name">Company Documentary folders: permitted audience</field>
        <field name="model_id" ref="model_company_documentary_folder"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_user'))]"/>
        <field name="domain_force">[
            '&amp;', '&amp;', ('company_id', '=', user.company_id.id), ('archived', '=', False),
            '&amp;', ('deleted_at', '=', False),
            '|', ('owner_id', '=', user.id),
            '|', ('editor_ids', 'in', [user.id]),
            '|', ('access_scope', '=', 'company'),
            '|', '&amp;', ('access_scope', '=', 'department'), ('department_ids', 'in', [user.employee_id.department_id.id]),
            '|', '&amp;', ('access_scope', '=', 'grade'), ('grade_ids', 'in', [user.employee_id.grade_id.id]),
            '&amp;', ('access_scope', '=', 'employee'), ('employee_ids.user_id', '=', user.id)
        ]</field>
    </record>

    <record id="rule_company_documentary_folder_manager" model="ir.rule">
        <field name="name">Company Documentary folders: managers</field>
        <field name="model_id" ref="model_company_documentary_folder"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_manager'))]"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
    </record>

    <!-- Controller methods perform the exact media override check. This rule
         keeps direct Odoo access company-bound and excludes inactive media. -->
    <record id="rule_company_documentary_media_user" model="ir.rule">
        <field name="name">Company Documentary videos: active company media</field>
        <field name="model_id" ref="model_company_documentary_media"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_user'))]"/>
        <field name="domain_force">[
            '&amp;', '&amp;', ('company_id', '=', user.company_id.id), ('active', '=', True),
            '&amp;', ('processing_state', '=', 'ready'),
            '&amp;', ('folder_id.archived', '=', False), ('folder_id.deleted_at', '=', False)
        ]</field>
    </record>

    <record id="rule_company_documentary_media_manager" model="ir.rule">
        <field name="name">Company Documentary videos: managers</field>
        <field name="model_id" ref="model_company_documentary_media"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_manager'))]"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
    </record>

    <record id="rule_company_documentary_tag_user" model="ir.rule">
        <field name="name">Company Documentary tags: company</field>
        <field name="model_id" ref="model_company_documentary_tag"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_user'))]"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id), ('active', '=', True)]</field>
    </record>

    <record id="rule_company_documentary_tag_manager" model="ir.rule">
        <field name="name">Company Documentary tags: managers</field>
        <field name="model_id" ref="model_company_documentary_tag"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_manager'))]"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
    </record>

    <record id="rule_company_documentary_upload_user" model="ir.rule">
        <field name="name">Company Documentary uploads: own sessions</field>
        <field name="model_id" ref="model_company_documentary_upload"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_user'))]"/>
        <field name="domain_force">[('initiated_by', '=', user.id)]</field>
    </record>

    <record id="rule_company_documentary_upload_manager" model="ir.rule">
        <field name="name">Company Documentary uploads: managers</field>
        <field name="model_id" ref="model_company_documentary_upload"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_manager'))]"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
    </record>

    <record id="rule_company_documentary_subtitle_user" model="ir.rule">
        <field name="name">Company Documentary subtitles: permitted media</field>
        <field name="model_id" ref="model_company_documentary_subtitle"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_user'))]"/>
        <field name="domain_force">[('media_id.company_id', '=', user.company_id.id), ('active', '=', True)]</field>
    </record>

    <record id="rule_company_documentary_subtitle_manager" model="ir.rule">
        <field name="name">Company Documentary subtitles: managers</field>
        <field name="model_id" ref="model_company_documentary_subtitle"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_manager'))]"/>
        <field name="domain_force">[('media_id.company_id', '=', user.company_id.id)]</field>
    </record>

    <record id="rule_company_documentary_watch_user" model="ir.rule">
        <field name="name">Company Documentary watch progress: own records</field>
        <field name="model_id" ref="model_company_documentary_watch"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_company_documentary_watch_event_manager" model="ir.rule">
        <field name="name">Company Documentary watch events: company managers</field>
        <field name="model_id" ref="model_company_documentary_watch_event"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_manager'))]"/>
        <field name="domain_force">[('media_id.company_id', '=', user.company_id.id)]</field>
    </record>

    <record id="rule_company_documentary_manager_records" model="ir.rule">
        <field name="name">Company Documentary records: managers</field>
        <field name="model_id" ref="model_company_documentary_watch"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_manager'))]"/>
        <field name="domain_force">[('media_id.company_id', '=', user.company_id.id)]</field>
    </record>

    <record id="rule_company_documentary_audit_manager" model="ir.rule">
        <field name="name">Company Documentary audit: company managers</field>
        <field name="model_id" ref="model_company_documentary_audit"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_manager'))]"/>
        <field name="domain_force">['|', ('folder_id.company_id', '=', user.company_id.id), ('media_id.company_id', '=', user.company_id.id)]</field>
    </record>

    <record id="rule_company_documentary_comment_user" model="ir.rule">
        <field name="name">Company Documentary comments: permitted media</field>
        <field name="model_id" ref="model_company_documentary_comment"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_user'))]"/>
        <field name="domain_force">[('media_id.company_id', '=', user.company_id.id), ('active', '=', True)]</field>
    </record>

    <record id="rule_company_documentary_comment_manager" model="ir.rule">
        <field name="name">Company Documentary comments: managers</field>
        <field name="model_id" ref="model_company_documentary_comment"/>
        <field name="groups" eval="[Command.link(ref('cleon_company_documentary.group_company_documentary_manager'))]"/>
        <field name="domain_force">[('media_id.company_id', '=', user.company_id.id)]</field>
    </record>
</odoo>
