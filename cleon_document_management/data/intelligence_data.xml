<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="type_employment_contract" model="doc.document.type">
            <field name="name">Employment Contract</field>
            <field name="category">employment</field>
            <field name="intelligence_scope">employee</field>
            <field name="classification_labels">employment contract, contract of employment, offer of employment</field>
            <field name="is_mandatory_default" eval="True"/>
        </record>
        <record id="type_cv_resume" model="doc.document.type">
            <field name="name">CV/Resume</field>
            <field name="category">hr</field>
            <field name="intelligence_scope">employee</field>
            <field name="classification_labels">cv, resume, curriculum vitae</field>
        </record>
        <record id="type_offer_letter" model="doc.document.type">
            <field name="name">Offer Letter</field>
            <field name="category">employment</field>
            <field name="intelligence_scope">employee</field>
            <field name="classification_labels">offer letter, job offer</field>
        </record>
        <record id="type_training_certificate" model="doc.document.type">
            <field name="name">Training Certificate</field>
            <field name="category">training</field>
            <field name="intelligence_scope">employee</field>
            <field name="classification_labels">training certificate, course completion</field>
        </record>
        <record id="type_vendor_contract" model="doc.document.type">
            <field name="name">Vendor Contract</field>
            <field name="category">legal</field>
            <field name="intelligence_scope">organization</field>
            <field name="classification_labels">vendor contract, supplier agreement</field>
        </record>
        <function model="doc.intelligence.profile" name="_seed_default_profiles"/>
    </data>
</odoo>
