<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_purge_old_notifications" model="ir.cron">
        <field name="name">DMS: Purge notifications older than 90 days</field>
        <field name="model_id" ref="model_doc_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_old_notifications()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_notification_email_retry" model="ir.cron">
        <field name="name">DMS: Retry failed notification emails</field>
        <field name="model_id" ref="model_doc_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_failed_emails()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_notification_digest" model="ir.cron">
        <field name="name">DMS: Send notification digest emails</field>
        <field name="model_id" ref="model_doc_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_digest_emails()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
