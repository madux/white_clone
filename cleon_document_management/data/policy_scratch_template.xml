<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Seeded for the main company; other companies get ensure_policy_scratch_template() on first use. -->
    <record id="template_policy_scratch_blank" model="doc.template">
        <field name="name">Blank policy document</field>
        <field name="kind">template</field>
        <field name="category_id" ref="template_category_legal"/>
        <field name="description">Internal editor shell for policy scratch documents.</field>
        <field name="status">published</field>
        <field name="is_system_internal" eval="True"/>
        <field name="icon">📄</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="template_policy_scratch_blank_version" model="doc.template.version">
        <field name="template_id" ref="template_policy_scratch_blank"/>
        <field name="version_number">1</field>
        <field name="editor_json">{"type": "doc", "content": [{"type": "paragraph"}]}</field>
        <field name="extracted_text"></field>
        <field name="merge_field_schema">[]</field>
        <field name="extraction_status">ready</field>
        <field name="published" eval="True"/>
    </record>
    <record id="template_policy_scratch_blank" model="doc.template">
        <field name="current_version_id" ref="template_policy_scratch_blank_version"/>
    </record>
</odoo>
