<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doc_template_list" model="ir.ui.view">
        <field name="name">doc.template.list</field>
        <field name="model">doc.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="kind"/>
                <field name="category_id"/>
                <field name="status"/>
                <field name="owner_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_doc_template_form" model="ir.ui.view">
        <field name="name">doc.template.form</field>
        <field name="model">doc.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_archive" type="object" string="Archive" invisible="not active"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="kind"/>
                        <field name="category_id"/>
                        <field name="status"/>
                        <field name="icon"/>
                        <field name="description"/>
                        <field name="current_version_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_doc_template" model="ir.actions.act_window">
        <field name="name">Templates &amp; Forms</field>
        <field name="res_model">doc.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
