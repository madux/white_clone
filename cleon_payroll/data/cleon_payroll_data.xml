<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="decimal_precision_payroll" model="decimal.precision">
            <field name="name">Payroll</field>
            <field name="digits">2</field>
        </record>

        <!-- Default rule categories -->
        <record id="cat_basic" model="cleon.payroll.category">
            <field name="name">Basic</field>
            <field name="code">BASIC</field>
            <field name="sequence">1</field>
        </record>
        <record id="cat_allowance" model="cleon.payroll.category">
            <field name="name">Allowances</field>
            <field name="code">ALW</field>
            <field name="sequence">2</field>
        </record>
        <record id="cat_gross" model="cleon.payroll.category">
            <field name="name">Gross</field>
            <field name="code">GROSS</field>
            <field name="sequence">3</field>
        </record>
        <record id="cat_deduction" model="cleon.payroll.category">
            <field name="name">Deductions</field>
            <field name="code">DED</field>
            <field name="sequence">4</field>
        </record>
        <record id="cat_employer" model="cleon.payroll.category">
            <field name="name">Employer Contributions</field>
            <field name="code">EMPCONT</field>
            <field name="sequence">5</field>
        </record>
        <record id="cat_net" model="cleon.payroll.category">
            <field name="name">Net</field>
            <field name="code">NET</field>
            <field name="sequence">6</field>
        </record>

        <!-- <record id="overtime_allowance" model="cleon.payroll.category">
            <field name="name">Overtime</field>
            <field name="code">ALW</field>
            <field name="sequence">7</field>
        </record> -->

        <!-- Default input types -->
        <record id="input_type_overtime" model="cleon.payroll.input.type">
            <field name="name">Overtime Amount</field>
            <field name="code">OVERTIME</field>
        </record>
        <record id="input_type_bonus" model="cleon.payroll.input.type">
            <field name="name">Bonus</field>
            <field name="code">BONUS</field>
        </record>

        <!-- Example rule: Basic Salary from contract wage -->
        <record id="rule_basic" model="cleon.payroll.rule">
            <field name="name">Basic Salary</field>
            <field name="code">BASIC</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="cat_basic"/>
            <field name="rule_type">gross</field>
            <field name="amount_select">formula</field>
            <field name="amount_python_compute">result = contract.wage</field>
        </record>

        <!-- Example rule: Housing Allowance = 20% of Basic -->
        <record id="rule_housing" model="cleon.payroll.rule">
            <field name="name">Housing Allowance</field>
            <field name="code">HOUSING</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="cat_allowance"/>
            <field name="rule_type">gross</field>
            <field name="amount_select">percentage</field>
            <field name="amount_percentage">20</field>
            <field name="amount_percentage_base">rules.BASIC</field>
        </record>

        <!-- <record id="default_overtime_rule_id" model="cleon.payroll.rule">
            <field name="name">Overtime</field>
            <field name="code">OVERTIME</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="input_type_overtime"/>
            <field name="rule_type">gross</field>
            <field name="amount_select">fixed</field>
            <field name="amount_percentage">20</field>
            <field name="amount_percentage_base">rules.BASIC</field>
        </record> -->

        <!-- Example rule: PAYE-style progressive deduction placeholder -->
        <record id="rule_tax" model="cleon.payroll.rule">
            <field name="name">Income Tax</field>
            <field name="code">PAYE</field>
            <field name="sequence">90</field>
            <field name="category_id" ref="cat_deduction"/>
            <field name="rule_type">deduction</field>
            <field name="amount_select">formula</field>
            <field name="amount_python_compute">
gross = categories.GROSS or (rules.BASIC + rules.HOUSING)
if gross &lt;= 300000:
    result = gross * 0.07
else:
    result = gross * 0.11
            </field>
        </record>

        <!-- Example structure -->
        <record id="structure_monthly_staff" model="cleon.payroll.structure">
            <field name="name">Monthly Staff Structure</field>
            <field name="code">MONTHLY_STAFF</field>
            <field name="schedule_pay">monthly</field>
            <field name="rule_ids" eval="[(6, 0, [ref('rule_basic'), ref('rule_housing'), ref('rule_tax')])]"/>
        </record>

    </data>
</odoo>
