<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_cleon_payslip" model="ir.sequence">
            <field name="name">Cleon Payslip</field>
            <field name="code">cleon.payslip</field>
            <field name="prefix">PAY/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_cleon_payslip_run" model="ir.sequence">
            <field name="name">Cleon Payslip Run</field>
            <field name="code">cleon.payslip.run</field>
            <field name="prefix">RUN/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
