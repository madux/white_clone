<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================= -->
        <!-- NIGERIAN GOVERNMENT PAYROLL CATEGORIES             -->
        <!-- ================================================= -->

        <record id="template_ng_id" model="cleon.payroll.template">
            <field name="name">Nigeria Public Sector</field>
            <field name="code">NPC</field> 
            <field name="country_id" ref="base.ng"/> 
            <field name="payroll_structure_ids" eval="[(6, 0, [
                ref('cleon_payroll.structure_ng_conpss'),
                ref('cleon_payroll.structure_ng_conpass'),
                ref('cleon_payroll.structure_ng_conhess'),
                ref('cleon_payroll.structure_ng_conmess'),
                ref('cleon_payroll.structure_ng_conuass'),
                ref('cleon_payroll.structure_ng_contiss2'),
                ref('cleon_payroll.structure_ng_contediss'),
                ref('cleon_payroll.structure_ng_conpcass'),
                ref('cleon_payroll.structure_ng_conraiss'),
            ])]"/>
        </record>

        <record id="template_default_id" model="cleon.payroll.template">
            <field name="name">Default Payroll Template</field>
            <field name="code">DEFAULT</field>
            <field name="country_id" ref="base.ng"/> 
            <field name="payroll_structure_ids" eval="[(6, 0, [
                ref('cleon_payroll.structure_monthly_staff')
            ])]"/>
        </record>

         
    </data>
</odoo>
