<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_cleon_payroll" model="ir.module.category">
            <field name="name">Cleon Payroll</field>
            <field name="sequence">15</field>
        </record>

        <record id="group_payroll_employee" model="res.groups">
            <field name="name">Employee (Self Service)</field>
            <field name="category_id" ref="module_category_cleon_payroll"/>
        </record>

        <record id="group_payroll_officer" model="res.groups">
            <field name="name">Payroll Officer</field>
            <field name="category_id" ref="module_category_cleon_payroll"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_employee'))]"/>
        </record>

        <record id="group_payroll_manager" model="res.groups">
            <field name="name">Payroll Manager</field>
            <field name="category_id" ref="module_category_cleon_payroll"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_officer'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Employees can only see their own payslips -->
        <record id="rule_payslip_employee_own" model="ir.rule">
            <field name="name">Payslip: employee sees own only</field>
            <field name="model_id" ref="model_cleon_payslip"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_payroll_employee'))]"/>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_payslip_officer_all" model="ir.rule">
            <field name="name">Payslip: officer sees all company payslips</field>
            <field name="model_id" ref="model_cleon_payslip"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_payroll_officer'))]"/>
        </record>

    </data>
</odoo>
