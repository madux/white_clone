<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cleon_payroll_dashboard.CustomPayrollKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[@t-ref='root']" position="before">
            <!-- ===== Sidebar ===== -->
            <div class="cpd-sidebar" id="cpdSidebar">

                <!-- SIDEBAR BRAND -->
                <div class="cpd-sidebar-brand">

                    <span class="cpd-brand-text" id="cpdApps">
                        <i class="fa-solid fa-chart-pie"/>
                    </span>

                    <a href="#"
                    t-on-click="openRecord"
                    data-action="cleon_payroll.action_cleon_payslip_run">

                        <span class="cpd-logo-dot"/>

                        <span class="cpd-brand-text">
                            Cleon <b>Payroll</b>
                        </span>
                    </a>

                    <button class="cpd-sidebar-close d-lg-none"
                            id="cpdSidebarClose"
                            type="button">
                        <i class="fa-solid fa fa-times"/>
                    </button>

                </div>


                <!-- SIDEBAR NAVIGATION -->
                <nav class="cpd-nav" id="cpdNav">


                    <!-- ================================================= -->
                    <!-- OVERVIEW PARENT -->
                    <!-- ================================================= -->

                    <div class="cpd-nav-group">

                        <a href="#"
                        class="cpd-nav-link cpd-nav-parent"
                        data-menu="overview"
                        t-att-class="state.expandedMenus.overview ? 'expanded' : ''"
                        t-on-click="toggleMenu">

                            <i class="fa-solid fa fa-dashboard"/>
                            <span>Overview</span>

                            <i t-att-class="'fa-solid fa-chevron-down cpd-nav-chevron ' +
                                (state.expandedMenus.overview ? 'expanded' : '')"/>
                        </a>


                        <div class="cpd-subnav"
                            t-att-class="state.expandedMenus.overview ? 'show' : ''">

                            <a href="#"
                            t-on-click="openRecord"
                            data-menu="overview"
                            data-key="overview_dashboard"
                            data-action="cleon_payroll.action_cleon_payslip"
                            t-att-class="'cpd-nav-link cpd-subnav-link ' +
                                (state.activeMenu === 'overview_dashboard' ? 'active' : '')">

                                <i class="fa-solid fa fa-tachometer"/>
                                <span>Dashboard</span>
                            </a>


                            <a href="#"
                            t-on-click="openRecord"
                            data-menu="overview"
                            data-key="payslips"
                            data-action="cleon_payroll.action_cleon_payslip"
                            t-att-class="'cpd-nav-link cpd-subnav-link ' +
                                (state.activeMenu === 'payslips' ? 'active' : '')">

                                <i class="fa-solid fa-file-text-o"/>
                                <span>Payslips</span>
                            </a>


                            <a href="#"
                            t-on-click="openRecord"
                            data-menu="overview"
                            data-key="employees"
                            data-action="cleon_payroll.action_hr_employee_pink_kanban"
