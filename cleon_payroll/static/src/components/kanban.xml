                                <i class="fa-solid fa fa-users"/>
                                <span>Employees</span>
                            </a>


                            <a href="#"
                            t-on-click="openRecord"
                            data-menu="overview"
                            data-key="all_payments"
                            data-action="cleon_payroll.action_cleon_payslip"
