                            </a>
                            
                            
                            <a href="#"
                               t-on-click="openRecord"
                               data-menu="setups"
                               data-key="template"
                               data-action="cleon_payroll.action_cleon_payroll_template"
                               t-att-class="'cpd-nav-link cpd-subnav-link ' + (sidebarState.activeMenu === 'template' ? 'active' : '')">

                                <i class="fa fa-file-text-o"/>
                                <span>Template</span>
                            </a>
                        </div>
                    </div>

                    <!-- ============================================ -->
