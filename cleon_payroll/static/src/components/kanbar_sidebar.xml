                            </a>

                            <a href="#"
                               t-on-click="openRecord"
                               data-menu="compliance"
                               data-key="payroll_exceptions"
                               data-action="cleon_payroll.action_cleon_payroll_setup"
                               t-att-class="'cpd-nav-link cpd-subnav-link ' + (sidebarState.activeMenu === 'payroll_exceptions' ? 'active' : '')">

                                <i class="fa fa-exclamation-triangle"/>
