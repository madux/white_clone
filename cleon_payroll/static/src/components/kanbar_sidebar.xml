<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cleon_payroll_dashboard.CustomPayrollKanbanRenderer"
       t-inherit="web.KanbanRenderer"
       t-inherit-mode="primary">
        <xpath expr="//div[@t-ref='root']" position="before">
            <div class="cpd-sidebar" id="cpdSidebar">
                <!-- BRAND -->
                <div class="cpd-sidebar-brand">
                    <span class="cpd-brand-text" id="cpdApps">
                        <i class="fa fa-bar-chart"/>
                    </span>

                    <a href="#"
                       t-on-click="openRecord"
                       data-action="cleon_payroll.action_cleon_payslip_run">

                        <span class="cpd-logo-dot"/>

                        <span class="cpd-brand-text">
                            Cleon <b>Payroll</b>
                        </span>
                    </a>

                    <button class="cpd-sidebar-close d-lg-none"
                            id="cpdSidebarClose"
                            type="button">
                        <i class="fa fa fa-times"/>
                    </button>

                </div>

                <!-- NAVIGATION -->
                <nav class="cpd-nav" id="cpdNav">

                    <!-- ============================================ -->
                    <!-- OVERVIEW -->
                    <!-- ============================================ -->

                    <div class="cpd-nav-group">

                        <a href="#"
                           class="cpd-nav-link cpd-nav-parent"
                           data-menu="overview"
                           t-att-class="'cpd-nav-link cpd-nav-parent ' + (sidebarState.expandedMenus.overview ? 'expanded' : '')"
                           t-on-click="toggleMenu">

                            <i class="fa fa-dashboard"/>
                            <span>Overview</span>

                            <i t-att-class="'fa fa-chevron-down cpd-nav-chevron ' + (sidebarState.expandedMenus.overview ? 'expanded' : '')"/>
                        </a>

                        <div t-att-class="'cpd-subnav ' + (sidebarState.expandedMenus.overview ? 'show' : '')">

                            <a href="#"
                               t-on-click="openRecord"
                               data-menu="overview"
                               data-key="overview_dashboard"
                               data-action="cleon_payroll.action_cleon_payslip"
                               t-att-class="'cpd-nav-link cpd-subnav-link '"> 
                                <i class="fa fa-tachometer"/>
                                <span>Dashboard</span>
                            </a>

                            <a href="#"
                               t-on-click="openRecord"
                               data-menu="overview"
                               data-key="payslips"
                               data-action="cleon_payroll.action_cleon_payslip"
                               t-att-class="'cpd-nav-link cpd-subnav-link ' + (sidebarState.activeMenu === 'payslips' ? 'active' : '')">

                                <i class="fa fa-file-text-o"/>
                                <span>Payslips</span>
                            </a>

                            <a href="#"
                               t-on-click="openRecord"
                               data-menu="overview"
                               data-key="employees"
                               data-action="cleon_payroll.action_hr_employee_pink_kanban"
                               t-att-class="'cpd-nav-link cpd-subnav-link ' + (sidebarState.activeMenu === 'employees' ? 'active' : '')"> 
                               <i class="fa fa-users"/>
                                <span>Employees</span>
                            </a> 
                            <a href="#"
                                t-on-click="openRecord"
                                data-menu="overview"
                                data-key="contracts"
                                data-action="hr_contract.action_hr_contract"
                                t-att-class="'cpd-nav-link cpd-subnav-link ' +
                                    (sidebarState.activeMenu === 'contracts' ? 'active' : '')">

                                    <i class="fa fa-th-large"/>
                                    <span>Contract</span>
                                </a>
                            <a href="#"
                                t-on-click="openRecord"
                                data-menu="overview"
                                data-key="approval_structure"
                                data-action="cleon_payroll.action_cleon_structure_approval"
                                t-att-class="'cpd-nav-link cpd-subnav-link ' +
                                    (sidebarState.activeMenu === 'approval_structure' ? 'active' : '')">

                                    <i class="fa fa-check"/>
                                    <span>Structure Approvals</span>
                            </a>
