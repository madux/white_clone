                               <i class="fa fa-calendar-check-o"/>
                                <span>All Payments</span>
                            </a>

                        </div>
                    </div>

                    <!-- ============================================ -->
                    <!-- PAYROLL -->
                    <!-- ============================================ -->

                    <div class="cpd-nav-group">

                        <a href="#"
                           data-menu="payroll"
