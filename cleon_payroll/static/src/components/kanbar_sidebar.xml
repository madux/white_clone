                               t-att-class="'cpd-nav-link cpd-subnav-link ' + (sidebarState.activeMenu === 'pay_group' ? 'active' : '')">

                                <i class="fa fa-users"/>
                                <span>Pay Group</span>
                            </a> 
                             
                            <a href="#"
                               t-on-click="openRecord"
                               data-menu="payroll"
                               data-key="pay_cycle"
