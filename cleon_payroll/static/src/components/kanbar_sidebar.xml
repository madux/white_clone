                               t-on-click="openRecord"
                               data-menu="setups"
                               data-key="payroll_rules"
                               data-action="cleon_payroll.action_cleon_payroll_rule"
                               t-att-class="'cpd-nav-link cpd-subnav-link ' + (sidebarState.activeMenu === 'payroll_rules' ? 'active' : '')">

                                <i class="fa fa-list-ul"/>
                                <span>Rules &amp; Components</span>
                            </a>
                            <a href="#"
                            t-on-click="openRecord"
                            data-menu="setups"
                            data-key="other_inputs"
                            data-action="cleon_payroll.action_cleon_payroll_input_type"
                            t-att-class="'cpd-nav-link cpd-subnav-link ' +
                                (state.activeMenu === 'other_inputs' ? 'active' : '')">

                                <i class="fa fa-credit-card"/>
