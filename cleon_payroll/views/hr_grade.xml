<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_core_grade_form_inherited" model="ir.ui.view">
        <field name="name">cleon.hr.grade.inherited</field>
        <field name="model">cleon.hr.grade</field>
        <field name="inherit_id" ref="hr_employee.view_core_grade_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='salary_band']" position="after">
                <field name="structure_id" required="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_cleon_hr_grade_search" model="ir.ui.view">
        <field name="name">cleon.hr.grade.search</field>
        <field name="model">cleon.hr.grade</field>
        <field name="arch" type="xml">
            <search string="Search Salary Grades">
                <field name="name"/>
                <field name="structure_id"/>
                <field name="country_id"/>

                <group expand="0" string="Group By">
                    <filter
                        name="group_by_structure"
                        string="Salary Structure"
                        context="{'group_by': 'structure_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_payroll_grade_tree" model="ir.ui.view">
        <field name="name">hr.grade.tree.pink</field>
        <field name="model">cleon.hr.grade</field>
        <field name="arch" type="xml">
            <tree string="Grades">
                <field name="name"/>
                <field name="minimum_salary_band"/>
                <field name="max_salary_band"/>
                <field name="salary_band"/>
                <field name="employee_count"/>
            </tree>
         </field>
    </record>

    <record id="view_payrollgrade_kanban_pink" model="ir.ui.view">
        <field name="name">hr.grade.kanban.pink</field>
        <field name="model">cleon.hr.grade</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" js_class="payroll_kanban_sidebar">
                <field name="name"/>
                <field name="minimum_salary_band"/>
                <field name="max_salary_band"/>
                <field name="salary_band"/>
                <field name="employee_count"/>
                <field name="active"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-0 border-0 rounded-3 shadow-sm overflow-hidden position-relative" 
                            style="background: linear-gradient(135deg, #FFF5F7 0%, #FCE4EC 50%, #F8BBD0 100%); max-width: 380px; font-family: 'Inter', sans-serif;">
                            
                            <!-- Background Accent Pattern -->
                            <div style="position: absolute; right: -20px; top: -20px; width: 100px; height: 100px; background: rgba(233, 30, 99, 0.05); border-radius: 50%; pointer-events: none;"/>
                            
                            <!-- Top Header Section -->
                            <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-2">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="fw-bold fs-6 text-uppercase" style="color: #AD1457; letter-spacing: 0.5px;">
                                        <i class="fa fa-building me-1"/> <field name="name"/> 
                                    </span>
                                </div>
                                <i class="fa fa-circle text-success fs-6" title="Active Status"/>
                            </div>

                            <!-- Card Body -->
                            <div class="row g-0 px-3 py-2 align-items-center">
                                <!-- Left: Employee Avatar -->
                                <!-- <div class="col-4 text-center">
                                    <div class="position-relative d-inline-block">

                                    </div>
                                </div> -->

                                <!-- Right: Employee Details -->
                                <div class="col-8 ps-3">
                                    <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.1rem;">
                                        <field name="name"/>
                                    </h5>
                                    <p class="text-muted mb-2 fw-semibold" style="font-size: 0.85rem; color: #880E4F !important;">
                                        <!-- <field name="active" widget="badge"/> -->
                                    </p>
                                    
                                    <div class="lh-sm" style="font-size: 0.78rem; color: #16090d;">
                                        <div class="mb-1">
                                            <span class="fw-bold">Min Salary Band:</span> 
                                            <span class="color-darkred"><field name="minimum_salary_band"/></span>
                                        </div>
                                        <div class="mb-1 text-truncate">
                                            <span class="fw-bold">Max Salary band:</span> 
                                            <span class="color-darkred"><field name="max_salary_band"/></span>
                                        </div>
                                        <div class="text-truncate">
                                            <span class="fw-bold">Salary band:</span> 
                                            <span class="color-darkred"><field name="salary_band"/></span>
                                        </div>
                                        <div class="text-truncate">
                                            <span class="fw-bold">No of Employees:</span> 
                                            <span class="color-darkred"><field name="employee_count"/></span>
                                        </div>
                                         
                                    </div>
                                </div>
                            </div>

                            <!-- Bottom Footer Badge -->
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 mt-1" 
                                style="background: rgba(255, 255, 255, 0.6); border-top: 1px solid rgba(244, 143, 177, 0.3);">
                                <span class="badge rounded-pill px-2 py-1" style="background-color: #F8BBD0; color: #880E4F; font-weight: 500;">
                                    <i class="fa fa-check-circle me-1"/> Active
                                </span>
                                <small style="color: #AD1457; font-weight: 500; font-size: 0.75rem;">
                                    Create Date:
                                    <t t-if="record.create_date and record.create_date.value"
                                    t-esc="record.create_date.value"/>
                                    <t t-else="">N/A</t>
                                </small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>



    <record id="action_cleon_grade_cycle" model="ir.actions.act_window">
        <field name="name">Grade</field>
        <field name="res_model">cleon.hr.grade</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="target">current</field> 
        <field name="search_view_id" ref="view_cleon_hr_grade_search"/>
        <field name="context">
            {'search_default_group_by_structure': 1}
        </field>
    </record>

    <record id="view_hr_level_kanban_pink" model="ir.ui.view">
        <field name="name">hr.level.kanban.pink</field>
        <field name="model">hr.level</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" js_class="payroll_kanban_sidebar">
                <field name="name"/>
                <field name="country_id"/>
                <field name="active"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click"
                            style="
                                background: #FFF1F5;
                                border: 1px solid #F8BBD0;
                                border-radius: 12px;
                                padding: 16px;
                                box-shadow: 0 2px 6px rgba(173, 20, 87, 0.08);">

                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span style="
                                    color: #AD1457;
                                    font-size: 16px;
                                    font-weight: 700;">
                                    <field name="name"/>
                                </span>

                                <field name="active"
                                    widget="boolean_toggle"/>
                            </div>

                            <!-- Grade -->
                            <div class="mb-3"
                                style="
                                    background: #FFFFFF;
                                    border-radius: 8px;
                                    padding: 10px;">
                                <div style="
                                    color: #AD1457;
                                    font-size: 11px;
                                    font-weight: 600;
                                    text-transform: uppercase;
                                    margin-bottom: 4px;">
                                    Country Applicable
                                </div>

                                <div style="
                                    color: #4A2535;
                                    font-size: 14px;
                                    font-weight: 500;">
                                    <t t-if="record.country_id.raw_value">
                                        <field name="country_id"/>
                                    </t>
                                     <t t-else="">
                                        <span class="badge rounded-pill text-bg-primary">
                                            N/A
                                        </span>
                                    </t> 
                                </div>
                            </div>

                            <!-- Active Badge -->
                            <div>
                                <t t-if="record.active.raw_value">
                                    <span class="badge rounded-pill text-bg-success">
                                        Active
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="badge rounded-pill text-bg-secondary">
                                        Inactive
                                    </span>
                                </t>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
