<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Simplified Company Form -->
    <record id="view_company_quick_setup_form" model="ir.ui.view">
        <field name="name">res.company.quick.setup.form</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <form string="Payroll Run" class="o_qms_form">
                <div class="o_hr_payroll_form_layout">
                    <field name="show_payroll_link" widget="payroll_app_link"/>
                    <div class="hd-main">
                        <div class="qms-card">
                            <div class="qms-card-header">
                                <div class="qms-card-icon">
                                    <svg viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                </div>
                                <span class="qms-card-title">Organization</span>
                            </div>
                            <div class="pink-card-body">
                                <group>
                                    <group>
                                        <field name="partner_id" string="Contact" readonly="1" required="0" groups="base.group_no_one"/>
                                        <label for="street" string="Address"/>
                                        <div class="o_address_format">
                                            <field name="street" placeholder="Street..." class="o_address_street"/>
                                            <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                            <field name="city" placeholder="City" class="o_address_city"/>
                                            <field name="state_id" class="o_address_state" placeholder="State" options="{&quot;no_open&quot;: True}"/>
                                            <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                            <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                                        </div>
                                        
                                    </group>
                                    <group>
                                        <field name="vat"/>
                                        <field name="company_registry"/>
                                        <field name="currency_id" options="{'no_create': True, 'no_open': True}" id="company_currency" context="{'active_test': False}"/>
                                    </group>
                                    <group name="social_media"/>
                                </group>
                            </div>
                            <div class="ash-card-body text-sm">
                                <span class="qms-card-title">More information</span>
                                <group>
                                    <group>
                                        <field name="phone" class="o_force_ltr"/>
                                        <field name="mobile" class="o_force_ltr"/>
                                        <field name="email"/>
                                        <field name="website" string="Website" widget="url" placeholder="e.g. https://www.odoo.com"/>
                                        <field name="is_government_organization"/>
                                        <field name="cleon_payroll_template_id" options="{'no_create': True, 'no_open': True}"/>

                                    </group>
                                    <group>
                                        <field name="parent_id" groups="base.group_no_one"/>
                                        <field name="parent_id" invisible="1"/>
                                        <field name="sequence" invisible="1"/>
                                        <field name="color" widget="color_picker"/>
                                    </group>
                                </group>
                            </div>
                            <header>
                                <button class="btn btn-primary" name="action_configure_payroll_type" type="object"
                                        string="Auto Configure Payroll"/>
                                
                            </header>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <!-- Dedicated Window Action -->
    <record id="action_company_quick_setup"
            model="ir.actions.act_window">
        <field name="name">Company Setup</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">form</field>
        <field name="view_id"
               ref="view_company_quick_setup_form"/>
        <field name="target">current</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>

    <!-- New Menu -->
    <menuitem id="menu_company_quick_setup"
              name="Organisation Setup"
              parent="cleon_payroll.menu_cleon_payroll_root"
              action="action_company_quick_setup"
              sequence="70" groups="cleon_payroll.group_root_user"/>

</odoo>
