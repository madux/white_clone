<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resource_calendar_attendance_tree_inherit" model="ir.ui.view">
        <field name="name">resource.calendar.attendance.tree.inherit.hours.worked</field>
        <field name="model">resource.calendar.attendance</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hour_to']" position="after">
                <field name="today_week_per_day" sum="total"/>
                <field name="overtime_hours" sum="total"/>
                
            </xpath>
        </field>
    </record>
</odoo>
