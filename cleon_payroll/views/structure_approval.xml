<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cleon_structure_approval_form"
            model="ir.ui.view">
        <field name="name">cleon.structure.approval.form</field>
        <field name="model">cleon.structure.approval</field>
        <field name="arch" type="xml">
            <form string="Payroll Structure Approval">
                <div class="o_hr_payroll_form_layout">
                    <field name="show_payroll_link" widget="payroll_app_link"/>
                    
                    <div class="hd-main">
                        <div class="qms-card">
                            <header class="m-4">
                                <button name="action_approve"
                                        string="Approve"
                                        type="object"
                                        class="btn-primary"
                                        invisible="state != 'pending'" />

                                <button name="action_refuse"
                                        string="Refuse"
                                        type="object"
                                        class="btn-secondary"
                                        invisible="state != 'pending'"/>

                                <field name="state"
                                    widget="statusbar"
                                    statusbar_visible="pending,approved"/>
                            </header>

                            <sheet>
                                <div class="oe_title">
                                    <h1>
                                        <field name="name"/>
                                    </h1>
                                </div>

                                <group>
                                    <group>
                                        <field name="structure_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                                        <field name="requested_by" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                                        <field name="approver_user_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                                    </group>
                                    <group>
                                        <field name="create_date"/>
                                        <field name="warning_message"
                                            invisible="warning_message == False"/>
                                    </group>
                                </group>

                                <notebook>
                                    <page string="📋 Employees">
                                        <field name="employee_ids" readonly="1"
                                            widget="many2many" options="{'no_create': True, 'no_open': False, 'no_create_edit': True}">
                                            <tree>
                                                <field name="name"/>
                                                <field name="work_email"/>
                                                <field name="job_id"/>
                                            </tree>
                                        </field>
                                    </page>

                                    <page string="📋 Contracts">
                                        <field name="contract_ids" readonly="1">
                                            <tree>
                                                <field name="name"/>
                                                <field name="employee_id"/>
                                                <field name="date_start"/>
                                                <field name="date_end"/>
                                                <field name="state"/>
                                            </tree>
                                        </field>
                                    </page>
                                </notebook>

                                <group invisible ="state != 'refused'">
                                    <field name="refusal_reason"/>
                                </group>
                            </sheet>
                        </div>
                    </div>
                </div>


                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cleon_structure_approval"
            model="ir.actions.act_window">
        <field name="name">Payroll Structure Approvals</field>
        <field name="res_model">cleon.structure.approval</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_cleon_structure_approval_tree"
            model="ir.ui.view">
        <field name="name">cleon.structure.approval.tree</field>
        <field name="model">cleon.structure.approval</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'approved'"
                  decoration-danger="state == 'refused'"
                  decoration-warning="state == 'pending'">
                <field name="name"/>
                <field name="structure_id"/>
                <field name="requested_by"/>
                <field name="approver_user_id"/>
                <field name="create_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
</odoo>