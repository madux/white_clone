    <template id="cleonhr_login" name="CleonHR Login" inherit_id="web.login">
        <xpath expr="//form[hasclass('oe_login_form')]" position="replace">
            <!-- <t t-call="web.login_layout"> -->
             <div class="cleonhr_form_card">
                <div class="loginavatar"></div>
                <h2 class="cleonhr_card_title">Welcome to CleonHR</h2>
                <h4 class="cleonhr_card_subtitle">Your all-in-one recruitment platform</h4>

                <form class="oe_login_form" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="mb-3" t-if="databases and len(databases) &gt; 1">
                        <label for="db" class="col-form-label">Database</label>
                        <div t-attf-class="input-group {{'input-group-sm' if form_small else ''}}">
                            <input type="text" name="db" t-att-value="request.db" id="db" t-attf-class="form-control #{'form-control-sm' if form_small else ''} cleonhr_input" required="required" readonly="readonly"/>
                            <a role="button" href="/web/database/selector" class="btn btn-secondary">Select <i class="fa fa-database" role="img" aria-label="Database" title="Database"/></a>
                        </div>
                    </div>

                    <div class="mb-3 field-login">
                        
                        <label for="login" class="form-label cleonhr_label"><i class="fa fa-user p-2"/> Email Address</label>
                        <input type="text" placeholder="Email" name="login" t-att-value="login" id="login" t-attf-class="form-control #{'form-control-sm' if form_small else ''}cleonhr_input" required="required" autocomplete="username" autofocus="autofocus" autocapitalize="off"/>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label cleonhr_label"><i class="fa fa-lock p-2"/>Password</label>
                        <input type="password" placeholder="Password" name="password" id="password" t-attf-class="form-control #{'form-control-sm' if form_small else ''}cleonhr_input" required="required" autocomplete="current-password" t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
                        <i class="fa fa-eye cleonhc-toggle-pwd" data-target="#password"/>
                    </div>
                    <p class="cleonhr_signup">
                        <a 
                            t-if="reset_password_enabled" 
                            t-attf-href="/web/reset_password?{{ keep_query() }}" 
                            class="cleonhr_signup_link">
                            Forgot Password
                        </a>
                    </p>

                    <p class="alert alert-danger" t-if="error" role="alert">
                        <t t-esc="error"/>
                    </p>
                    <p class="alert alert-success" t-if="message" role="status">
                        <t t-esc="message"/>
                    </p>

                    <div t-attf-class="clearfix oe_login_buttons text-center gap-1 d-grid mb-1 {{'pt-2' if form_small else 'pt-3'}}">
                        <button type="submit" class="btn btn-primary cleonhr_btn">Sign in</button>
                        <!-- <t t-if="debug">
                            <button type="submit" name="redirect" value="/web/become" class="btn btn-link btn-sm">Log in as superuser</button>
                        </t> -->
                        <div class="o_login_auth"/>
                    </div>
                    <p class="cleonhr_signup">
                        Don't have an account? <a href="/maacherp/register" class="cleonhr_signup_link">Sign up for free</a>
                    </p>

                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                </form>
            </div>
        </xpath>
    </template>
</odoo>