<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Form-only inherit. Do NOT xpath-replace website.layout — that hung installs.
      Gradient/orbs come from CSS on .oe_website_login_container (website.login_layout).
    -->
    <template id="cleonhr_login" name="CleonHR Login" inherit_id="web.login" priority="50">
        <xpath expr="//form[hasclass('oe_login_form')]" position="replace">
            <div class="cleonhr-login-card">
                <div class="cleonhr-login-brand">
                    <p class="cleonhr-login-logo">
                        <span class="cleonhr-login-logo-cleon">Cleon</span><span class="cleonhr-login-logo-hr">HR</span>
                    </p>
                </div>

                <div class="cleonhr-login-heading">
                    <h1>Welcome back</h1>
                    <p>Sign in to your CleonHR account</p>
                </div>

                <form class="oe_login_form cleonhr-login-form" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="cleonhr-login-field" t-if="databases and len(databases) &gt; 1">
                        <label for="db" class="cleonhr-login-label">Database</label>
                        <div t-attf-class="input-group {{'input-group-sm' if form_small else ''}}">
                            <input type="text" name="db" t-att-value="request.db" id="db" t-attf-class="form-control cleonhr-login-input #{'form-control-sm' if form_small else ''}" required="required" readonly="readonly"/>
                            <a role="button" href="/web/database/selector" class="btn btn-secondary">Select <i class="fa fa-database" role="img" aria-label="Database" title="Database"/></a>
                        </div>
                    </div>

                    <div class="cleonhr-login-field field-login">
                        <label for="login" class="cleonhr-login-label">Email Address</label>
                        <input
                            type="text"
                            placeholder="john@example.com"
                            name="login"
                            t-att-value="login"
                            id="login"
                            class="form-control cleonhr-login-input"
                            required="required"
                            autocomplete="username"
                            autofocus="autofocus"
                            autocapitalize="off"
                        />
                    </div>

                    <div class="cleonhr-login-field cleonhr-login-field--password">
                        <div class="cleonhr-login-password-head">
                            <label for="password" class="cleonhr-login-label">Password</label>
                            <a
                                t-if="reset_password_enabled"
                                t-attf-href="/web/reset_password?{{ keep_query() }}"
                                class="cleonhr-login-forgot"
                            >Forgot Password?</a>
                        </div>
                        <div class="cleonhr-login-password-wrap">
                            <input
                                type="password"
                                placeholder="••••••••"
                                name="password"
                                id="password"
                                class="form-control cleonhr-login-input cleonhr-login-input--password"
                                required="required"
                                autocomplete="current-password"
                                t-att-autofocus="'autofocus' if login else None"
                                maxlength="4096"
                            />
                            <button type="button" class="cleonhr-login-eye" data-cleonhr-toggle-pwd="password" aria-label="Show password">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <p class="alert alert-danger cleonhr-login-alert" t-if="error" role="alert">
                        <t t-esc="error"/>
                    </p>
                    <p class="alert alert-success cleonhr-login-alert" t-if="message" role="status">
                        <t t-esc="message"/>
                    </p>

                    <div class="oe_login_buttons cleonhr-login-actions">
                        <button type="submit" class="cleonhr-login-submit">Sign In</button>
                        <t t-if="debug">
                            <button type="submit" name="redirect" value="/web/become" class="btn btn-link btn-sm">Log in as superuser</button>
                        </t>
                        <div class="o_login_auth"/>
                    </div>

                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                </form>

                <p class="cleonhr-login-signup">
                    Don't have an account?
                    <a href="/maacherp/register" class="cleonhr-login-signup-link">Create Account</a>
                </p>

                <!-- Temporarily disabled
                <button type="button" class="cleonhr-login-default" data-cleonhr-default-creds="">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/>
                        <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>
                    </svg>
                    Use Default Credentials
                </button>
                -->
            </div>
        </xpath>
    </template>

</odoo>
