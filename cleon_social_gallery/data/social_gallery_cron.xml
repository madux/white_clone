<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_social_gallery_purge_recycle_bin" model="ir.cron">
        <field name="name">Social Gallery: Purge Recycle Bin</field>
        <field name="model_id" ref="model_social_gallery_media"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_recycle_bin()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_social_gallery_monthly_album" model="ir.cron">
        <field name="name">Social Gallery: Create Monthly Album</field>
        <field name="model_id" ref="model_social_gallery_album"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_monthly_album()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_social_gallery_weekly_digest" model="ir.cron">
        <field name="name">Social Gallery: Weekly Digest</field>
        <field name="model_id" ref="model_social_gallery_notify"/>
        <field name="state">code</field>
        <field name="code">model._cron_weekly_digest()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
