<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
      Storage credentials must be supplied via environment variables:
      SOCIAL_GALLERY_R2_ACCOUNT_ID, SOCIAL_GALLERY_R2_ENDPOINT_URL,
      SOCIAL_GALLERY_R2_ACCESS_KEY_ID, SOCIAL_GALLERY_R2_SECRET_ACCESS_KEY,
      SOCIAL_GALLERY_R2_BUCKET, SOCIAL_GALLERY_R2_REGION, SOCIAL_GALLERY_R2_CORS_ORIGINS
    -->
    <record id="param_r2_account_id" model="ir.config_parameter">
        <field name="key">social_gallery.r2_account_id</field>
        <field name="value"></field>
    </record>
    <record id="param_r2_endpoint_url" model="ir.config_parameter">
        <field name="key">social_gallery.r2_endpoint_url</field>
        <field name="value"></field>
    </record>
    <record id="param_r2_access_key_id" model="ir.config_parameter">
        <field name="key">social_gallery.r2_access_key_id</field>
        <field name="value"></field>
    </record>
    <record id="param_r2_secret_access_key" model="ir.config_parameter">
        <field name="key">social_gallery.r2_secret_access_key</field>
        <field name="value"></field>
    </record>
    <record id="param_r2_bucket" model="ir.config_parameter">
        <field name="key">social_gallery.r2_bucket</field>
        <field name="value"></field>
    </record>
    <record id="param_r2_region" model="ir.config_parameter">
        <field name="key">social_gallery.r2_region</field>
        <field name="value">auto</field>
    </record>
    <record id="param_r2_cors_origins" model="ir.config_parameter">
        <field name="key">social_gallery.r2_cors_origins</field>
        <field name="value"></field>
    </record>
</odoo>
