<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_social_gallery" model="ir.module.category">
        <field name="name">Social Gallery</field>
        <field name="sequence">37</field>
    </record>

    <record id="group_social_gallery_user" model="res.groups">
        <field name="name">Gallery User</field>
        <field name="category_id" ref="module_category_social_gallery"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('cleon_social_gallery.group_social_gallery_user'))]"/>
    </record>

    <record id="group_social_gallery_manager" model="res.groups">
        <field name="name">Gallery Manager</field>
        <field name="category_id" ref="module_category_social_gallery"/>
        <field name="implied_ids" eval="[Command.link(ref('cleon_social_gallery.group_social_gallery_user'))]"/>
    </record>

    <record id="group_social_gallery_admin" model="res.groups">
        <field name="name">Gallery Administrator</field>
        <field name="category_id" ref="module_category_social_gallery"/>
        <field name="implied_ids" eval="[Command.link(ref('cleon_social_gallery.group_social_gallery_manager'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('cleon_social_gallery.group_social_gallery_admin'))]"/>
    </record>
</odoo>
