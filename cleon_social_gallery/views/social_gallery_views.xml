<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_gallery_album_tree" model="ir.ui.view">
        <field name="name">social.gallery.album.tree</field>
        <field name="model">social.gallery.album</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="visibility"/>
                <field name="status"/>
                <field name="media_count"/>
                <field name="created_by"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_social_gallery_album_form" model="ir.ui.view">
        <field name="name">social.gallery.album.form</field>
        <field name="model">social.gallery.album</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="visibility"/>
                        <field name="access_scope"/>
                        <field name="status"/>
                        <field name="event_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_social_gallery_media_tree" model="ir.ui.view">
        <field name="name">social.gallery.media.tree</field>
        <field name="model">social.gallery.media</field>
        <field name="arch" type="xml">
            <tree>
                <field name="display_name"/>
                <field name="album_id"/>
                <field name="media_type"/>
                <field name="approval_status"/>
                <field name="uploaded_by"/>
                <field name="file_size"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="action_social_gallery_album" model="ir.actions.act_window">
        <field name="name">Gallery Albums</field>
        <field name="res_model">social.gallery.album</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_social_gallery_media" model="ir.actions.act_window">
        <field name="name">Gallery Media</field>
        <field name="res_model">social.gallery.media</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
