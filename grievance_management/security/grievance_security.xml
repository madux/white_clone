<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_grievance" model="ir.module.category">
        <field name="name">Grievance Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_grievance_user" model="res.groups">
        <field name="name">User: Handle Cases</field>
        <field name="category_id" ref="module_category_grievance"/>
    </record>

    <record id="group_grievance_manager" model="res.groups">
        <field name="name">Manager: Full Configuration</field>
        <field name="category_id" ref="module_category_grievance"/>
        <field name="implied_ids" eval="[(4, ref('group_grievance_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Users only see cases where they are the handler, unless Manager -->
    <record id="grievance_case_rule_user" model="ir.rule">
        <field name="name">Grievance Case: own or handled cases</field>
        <field name="model_id" ref="model_grievance_case"/>
        <field name="domain_force">['|', ('handler_id', '=', user.id), ('handler_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_grievance_user'))]"/>
    </record>

    <record id="grievance_case_rule_manager" model="ir.rule">
        <field name="name">Grievance Case: manager full access</field>
        <field name="model_id" ref="model_grievance_case"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_grievance_manager'))]"/>
    </record>
</odoo>
