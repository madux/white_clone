<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grievance_category_list" model="ir.ui.view">
        <field name="name">grievance.category.list</field>
        <field name="model">grievance.category</field>
        <field name="arch" type="xml">
            <tree string="Categories" js_class="grievance_management_dashboard_list">
                <field name="name"/>
                <field name="type_count" string="# Types"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_grievance_category_form" model="ir.ui.view">
        <field name="name">grievance.category.form</field>
        <field name="model">grievance.category</field>
        <field name="arch" type="xml">
            <form string="Grievance Category">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <field name="description" placeholder="Description shown to users..."/>
                    <notebook>
                        <page string="Types">
                            <field name="type_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="default_priority"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_grievance_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">grievance.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
