<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grievance_escalation_rule_kanban" model="ir.ui.view">
        <field name="name">grievance.escalation.rule.kanban</field>
        <field name="model">grievance.escalation.rule</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="active_case_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-3 border rounded mb-2">
                            <div class="d-flex justify-content-between">
                                <strong><field name="name"/></strong>
                                <field name="active" widget="boolean_toggle"/>
                            </div>
                            <div class="text-muted mb-2">
                                <field name="active_case_count"/> active cases
                            </div>
                            <div>
                                <span class="badge text-bg-warning">Trigger: <field name="trigger_type"/></span>
                            </div>
                            <div class="mt-1">
                                <span class="badge text-bg-info">Action: <field name="action_type"/></span>
                            </div>
                            <div class="mt-1 text-muted">
                                Target: <field name="target_label"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_grievance_escalation_rule_list" model="ir.ui.view">
        <field name="name">grievance.escalation.rule.list</field>
        <field name="model">grievance.escalation.rule</field>
        <field name="arch" type="xml">
            <tree string="Escalation Rules" js_class="grievance_management_dashboard_list">
                <field name="name"/>
                <field name="trigger_type"/>
                <field name="deadline_days" optional="show"/>
                <field name="action_type"/>
                <field name="target_label" string="Target"/>
                <field name="active_case_count" string="Active Cases"/>
                <field name="active" widget="boolean_toggle"/>
                <button name="action_run_now" type="object" string="Run Now" icon="fa-bolt"/>
            </tree>
        </field>
    </record>

    <record id="view_grievance_escalation_rule_form" model="ir.ui.view">
        <field name="name">grievance.escalation.rule.form</field>
        <field name="model">grievance.escalation.rule</field>
        <field name="arch" type="xml">
            <form string="Escalation Rule">
                <header>
                    <button name="action_run_now" type="object" string="Run Now" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Overdue Case Escalation"/></h1></div>
                    <group>
                        <group string="Trigger">
                            <field name="trigger_type"/>
                            <field name="deadline_days" invisible="trigger_type != 'deadline_exceeded'"/>
                        </group>
                        <group string="Action">
                            <field name="action_type"/>
                            <field name="target_user_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Currently Matching">
                        <field name="active_case_count" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_grievance_escalation_rule" model="ir.actions.act_window">
        <field name="name">Escalation Rules</field>
        <field name="res_model">grievance.escalation.rule</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>
</odoo>
