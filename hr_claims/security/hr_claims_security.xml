<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hr_claims" model="ir.module.category">
        <field name="name">Claims</field>
        <field name="description">Employee claims, approvals, payments, and audit</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_hr_claim_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="category_id" ref="module_category_hr_claims"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="group_hr_claim_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_hr_claims"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="group_hr_claim_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="category_id" ref="module_category_hr_claims"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="group_hr_claim_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_hr_claims"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_hr_claim_manager'), ref('group_hr_claim_finance')])]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company boundaries are global and therefore cannot be widened by group rules. -->
    <record id="rule_hr_claim_category_company" model="ir.rule">
        <field name="name">Claim categories: allowed companies</field>
        <field name="model_id" ref="model_hr_claim_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_claim_type_company" model="ir.rule">
        <field name="name">Claim types: allowed companies</field>
        <field name="model_id" ref="model_hr_claim_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_claim_window_company" model="ir.rule">
        <field name="name">Claim windows: allowed companies</field>
        <field name="model_id" ref="model_hr_claim_window"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_claim_company" model="ir.rule">
        <field name="name">Claims: allowed companies</field>
        <field name="model_id" ref="model_hr_claim"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_claim_line_company" model="ir.rule">
        <field name="name">Claim lines: allowed companies</field>
        <field name="model_id" ref="model_hr_claim_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_claim_payment_company" model="ir.rule">
        <field name="name">Claim payments: allowed companies</field>
        <field name="model_id" ref="model_hr_claim_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_claim_audit_company" model="ir.rule">
        <field name="name">Claim audit: allowed companies</field>
        <field name="model_id" ref="model_hr_claim_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_expense_request_type_company" model="ir.rule">
        <field name="name">Request types: allowed companies</field>
        <field name="model_id" ref="model_hr_expense_request_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_expense_request_company" model="ir.rule">
        <field name="name">Requests: allowed companies</field>
        <field name="model_id" ref="model_hr_expense_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_cash_advance_company" model="ir.rule">
        <field name="name">Advances: allowed companies</field>
        <field name="model_id" ref="model_hr_cash_advance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_cash_advance_retirement_company" model="ir.rule">
        <field name="name">Advance retirements: allowed companies</field>
        <field name="model_id" ref="model_hr_cash_advance_retirement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_expense_approval_rule_company" model="ir.rule">
        <field name="name">Approval rules: allowed companies</field>
        <field name="model_id" ref="model_hr_expense_approval_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_expense_approval_step_company" model="ir.rule">
        <field name="name">Approval steps: allowed companies</field>
        <field name="model_id" ref="model_hr_expense_approval_step"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Employee self-service; privileged all-record rules are unioned with these. -->
    <record id="rule_hr_claim_employee_own" model="ir.rule">
        <field name="name">Claims: employee owns record</field>
        <field name="model_id" ref="model_hr_claim"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_hr_claim_privileged_all" model="ir.rule">
        <field name="name">Claims: manager, finance and admin see all</field>
        <field name="model_id" ref="model_hr_claim"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_manager')), (4, ref('group_hr_claim_finance')), (4, ref('group_hr_claim_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_hr_claim_line_employee_own" model="ir.rule">
        <field name="name">Claim lines: employee owns claim</field>
        <field name="model_id" ref="model_hr_claim_line"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_employee'))]"/>
        <field name="domain_force">[('claim_id.employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_hr_claim_line_privileged_all" model="ir.rule">
        <field name="name">Claim lines: privileged roles see all</field>
        <field name="model_id" ref="model_hr_claim_line"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_manager')), (4, ref('group_hr_claim_finance')), (4, ref('group_hr_claim_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_hr_claim_payment_employee_own" model="ir.rule">
        <field name="name">Claim payments: employee owns claim</field>
        <field name="model_id" ref="model_hr_claim_payment"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_hr_claim_payment_finance_all" model="ir.rule">
        <field name="name">Claim payments: manager, finance and admin see all</field>
        <field name="model_id" ref="model_hr_claim_payment"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_manager')), (4, ref('group_hr_claim_finance')), (4, ref('group_hr_claim_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_hr_expense_request_employee_own" model="ir.rule">
        <field name="name">Requests: employee owns record</field>
        <field name="model_id" ref="model_hr_expense_request"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_hr_expense_request_privileged_all" model="ir.rule">
        <field name="name">Requests: operational roles see all</field>
        <field name="model_id" ref="model_hr_expense_request"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_manager')), (4, ref('group_hr_claim_finance')), (4, ref('group_hr_claim_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_hr_cash_advance_employee_own" model="ir.rule">
        <field name="name">Advances: employee owns record</field>
        <field name="model_id" ref="model_hr_cash_advance"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_hr_cash_advance_privileged_all" model="ir.rule">
        <field name="name">Advances: Finance and Admin see all</field>
        <field name="model_id" ref="model_hr_cash_advance"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_finance')), (4, ref('group_hr_claim_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_hr_cash_advance_retirement_employee_own" model="ir.rule">
        <field name="name">Advance retirements: employee owns advance</field>
        <field name="model_id" ref="model_hr_cash_advance_retirement"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_employee'))]"/>
        <field name="domain_force">[('advance_id.employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_hr_cash_advance_retirement_privileged_all" model="ir.rule">
        <field name="name">Advance retirements: Finance and Admin see all</field>
        <field name="model_id" ref="model_hr_cash_advance_retirement"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_finance')), (4, ref('group_hr_claim_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_hr_expense_approval_step_employee_own" model="ir.rule">
        <field name="name">Approval steps: employee owns source</field>
        <field name="model_id" ref="model_hr_expense_approval_step"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_employee'))]"/>
        <field name="domain_force">['|', ('claim_id.employee_id.user_id', '=', user.id), ('request_id.employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_hr_expense_approval_step_manager_all" model="ir.rule">
        <field name="name">Approval steps: Managers and Admin see all</field>
        <field name="model_id" ref="model_hr_expense_approval_step"/>
        <field name="groups" eval="[(4, ref('group_hr_claim_manager')), (4, ref('group_hr_claim_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
