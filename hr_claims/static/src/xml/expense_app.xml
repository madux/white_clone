<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_claims.ExpenseKpiCard" owl="1">
        <button class="o_expense_kpi card border-0 text-start h-100 w-100"
                t-att-class="props.onClick ? 'o_expense_clickable' : ''"
                t-on-click="click">
            <div class="card-body d-flex align-items-start gap-3">
                <span class="o_expense_kpi_icon" t-att-class="'o_expense_tone_' + (props.tone || 'pink')">
                    <i t-att-class="'fa ' + props.icon"/>
                </span>
                <div class="min-w-0">
                    <div class="small text-uppercase text-muted fw-bold" t-esc="props.label"/>
                    <div class="h2 fw-black mb-0 text-dark" t-esc="props.value"/>
                    <div t-if="props.hint" class="small text-muted text-truncate" t-esc="props.hint"/>
                </div>
            </div>
        </button>
    </t>

    <t t-name="hr_claims.ExpenseApp" owl="1">
        <div class="o_expense_app" t-att-class="state.sidebarCollapsed ? 'o_expense_sidebar_collapsed' : ''">
            <aside class="o_expense_sidebar">
                <div class="o_expense_brand d-flex align-items-center gap-3 px-3 py-3">
                    <span class="o_expense_logo">C</span>
                    <div t-if="!state.sidebarCollapsed" class="min-w-0">
                        <div class="fw-black text-white text-truncate">Expense Management</div>
                        <div class="small text-white-50">Community ERP</div>
                    </div>
                </div>
                <div t-if="!state.sidebarCollapsed" class="px-3 pb-2">
                    <div class="input-group input-group-sm o_expense_module_search">
                        <span class="input-group-text border-0"><i class="fa fa-search"/></span>
                        <input class="form-control border-0" placeholder="Search modules"
                               t-att-value="state.moduleSearch" t-on-input="updateModuleSearch"/>
                    </div>
                </div>
                <nav class="o_expense_module_nav px-2 py-2">
                    <button t-foreach="modules" t-as="module" t-key="module.key"
                            class="o_expense_module_btn btn w-100 d-flex align-items-center gap-3 text-start"
                            t-att-class="state.activeModule === module.key ? 'active' : ''"
                            t-att-title="module.label"
                            t-on-click="() => this.selectModule(module.key)">
                        <i t-att-class="'fa ' + module.icon"/>
                        <span t-if="!state.sidebarCollapsed" class="flex-grow-1" t-esc="module.label"/>
                        <span t-if="!module.available and !state.sidebarCollapsed" class="o_expense_build_dot" title="Implementation in progress"/>
                    </button>
                </nav>
                <div class="mt-auto p-2">
                    <button class="btn o_expense_collapse_btn w-100" t-on-click="toggleSidebar">
                        <i t-att-class="state.sidebarCollapsed ? 'fa fa-angle-double-right' : 'fa fa-angle-double-left'"/>
                        <span t-if="!state.sidebarCollapsed" class="ms-2">Collapse</span>
                    </button>
                </div>
            </aside>

            <section class="o_expense_workspace">
                <header class="o_expense_header px-3 px-lg-4 py-3 d-flex align-items-center justify-content-between gap-3">
                    <div class="min-w-0">
                        <div class="small text-muted"><t t-esc="state.data?.company.name || ''"/> / <t t-esc="activeModule?.label || 'Dashboard'"/></div>
                        <h1 class="h4 fw-black mb-0 text-truncate" t-esc="activePage?.label || activeModule?.label || 'Dashboard'"/>
                    </div>
                    <div class="d-flex align-items-center gap-2 gap-lg-3">
                        <button class="btn btn-light rounded-circle" title="Refresh" t-on-click="refresh"><i class="fa fa-refresh"/></button>
                        <span class="badge rounded-pill o_expense_role_badge" t-esc="state.data?.role_label || ''"/>
                        <div class="d-none d-md-block text-end">
                            <div class="small fw-bold" t-esc="state.data?.user.name || ''"/>
                            <div class="text-muted" style="font-size: .72rem">Signed in</div>
                        </div>
                    </div>
                </header>

                <div t-if="activeModule?.pages.length &gt; 1" class="o_expense_subnav px-3 px-lg-4">
                    <button t-foreach="activeModule.pages" t-as="page" t-key="page.key"
                            class="btn o_expense_subnav_btn"
                            t-att-class="state.activePage === page.key ? 'active' : ''"
                            t-on-click="() => this.selectPage(page.key)" t-esc="page.label"/>
                </div>

                <main class="o_expense_content p-3 p-lg-4">
                    <div t-if="state.loading" class="o_expense_state card border-0">
                        <div class="card-body text-center py-5">
                            <span class="spinner-border text-primary"/><p class="text-muted mt-3 mb-0">Loading your workspace…</p>
                        </div>
                    </div>
                    <div t-elif="state.error" class="o_expense_state card border-0">
                        <div class="card-body text-center py-5">
                            <i class="fa fa-exclamation-triangle fa-2x text-danger"/>
                            <h2 class="h5 mt-3">We could not load Expense Management</h2>
                            <button class="btn btn-primary mt-2" t-on-click="refresh">Try again</button>
                        </div>
                    </div>

                    <t t-elif="isDashboard">
                        <div class="o_expense_page_intro d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                            <div>
                                <h2 class="h3 fw-black mb-1">Good day, <t t-esc="state.data.user.name"/>.</h2>
                                <p class="text-muted mb-0">Claims, approvals, payments, and financial exposure at a glance</p>
                            </div>
                            <button t-if="canCreateClaim" class="btn btn-primary o_expense_primary" t-on-click="newClaim"><i class="fa fa-plus me-2"/>New Claim</button>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-sm-6 col-xl-3"><ExpenseKpiCard label="Claims Pending" value="kpis.submitted || 0" hint="Awaiting action" icon="fa-clock-o" tone="warning" onClick="() => this.openClaims([['state', '=', 'submitted']])"/></div>
                            <div class="col-12 col-sm-6 col-xl-3"><ExpenseKpiCard label="Approved Claims" value="formatMoney(kpis.approved_value)" t-att-hint="`${kpis.approved || 0} claims`" icon="fa-check" tone="success" onClick="() => this.openClaims([['state', '=', 'approved']])"/></div>
                            <div class="col-12 col-sm-6 col-xl-3"><ExpenseKpiCard label="Payments Queue" value="formatMoney(kpis.payable_value)" t-att-hint="`${kpis.payable_count || 0} claims`" icon="fa-credit-card" tone="violet" onClick="() => this.openClaims([['state', '=', 'approved']])"/></div>
                            <div class="col-12 col-sm-6 col-xl-3"><ExpenseKpiCard label="Paid Out" value="formatMoney(kpis.paid_value)" t-att-hint="`${kpis.paid || 0} completed`" icon="fa-money" tone="pink" onClick="() => this.openClaims([['state', '=', 'paid']])"/></div>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-xl-4"><div class="card o_expense_panel h-100"><div class="card-body"><h3 class="h6 fw-black">Claims Status</h3><p class="small text-muted">Current workflow distribution</p><div class="o_expense_chart"><canvas t-ref="statusChart"/></div></div></div></div>
                            <div class="col-12 col-xl-8"><div class="card o_expense_panel h-100"><div class="card-body"><h3 class="h6 fw-black">Six-Month Trend</h3><p class="small text-muted">Submitted, approved, and paid values by event date</p><div class="o_expense_chart"><canvas t-ref="trendChart"/></div></div></div></div>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-xl-5"><div class="card o_expense_panel h-100"><div class="card-body"><h3 class="h6 fw-black">Spend by Department</h3><p class="small text-muted">Approved and paid exposure</p><div class="o_expense_chart"><canvas t-ref="departmentChart"/></div></div></div></div>
                            <div class="col-12 col-xl-7"><div class="card o_expense_panel h-100"><div class="card-header bg-white border-0 d-flex justify-content-between align-items-center"><div><h3 class="h6 fw-black mb-0">Recent Activity</h3><span class="small text-muted">Latest visible claims</span></div><button class="btn btn-sm btn-light" t-on-click="() => this.openClaims([])">View all</button></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Claim</th><th>Employee</th><th class="text-end">Amount</th><th>Status</th></tr></thead><tbody><tr t-foreach="dashboard.recent || []" t-as="claim" t-key="claim.id" class="o_expense_table_row" t-on-click="() => this.openClaim(claim.id)"><td><strong t-esc="claim.name"/><div class="small text-muted" t-esc="claim.title"/></td><td t-esc="claim.employee"/><td class="text-end fw-bold" t-esc="formatMoney(claim.amount)"/><td><span class="badge rounded-pill text-bg-light" t-esc="claim.state_label"/></td></tr><tr t-if="!(dashboard.recent || []).length"><td colspan="4" class="text-center text-muted py-4">No activity yet.</td></tr></tbody></table></div></div></div>
                        </div>
                    </t>

                    <t t-elif="isClaims">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h2 class="h3 fw-black mb-1">Claims Data</h2><p class="text-muted mb-0">Create, review, approve, and reimburse employee expenses</p></div><div class="d-flex gap-2"><button class="btn btn-outline-secondary" t-on-click="() => this.openClaims([])"><i class="fa fa-table me-2"/>Advanced View</button><button t-if="canCreateClaim" class="btn btn-primary o_expense_primary" t-on-click="newClaim"><i class="fa fa-plus me-2"/>New Claim</button></div></div>
                        <div class="row g-3 mb-4"><div class="col-sm-6 col-xl-3"><ExpenseKpiCard label="Total Claims" value="kpis.total || 0" hint="Visible records" icon="fa-files-o" tone="pink"/></div><div class="col-sm-6 col-xl-3"><ExpenseKpiCard label="Under Review" value="kpis.submitted || 0" t-att-hint="formatMoney(kpis.submitted_value)" icon="fa-clock-o" tone="warning"/></div><div class="col-sm-6 col-xl-3"><ExpenseKpiCard label="Approved" value="kpis.approved || 0" hint="Awaiting payment" icon="fa-check" tone="success"/></div><div class="col-sm-6 col-xl-3"><ExpenseKpiCard label="Paid" value="kpis.paid || 0" hint="Completed" icon="fa-credit-card" tone="violet"/></div></div>
                        <div class="card o_expense_panel"><div class="card-header bg-white border-0 d-flex justify-content-between align-items-center"><h3 class="h6 fw-black mb-0">Recent Claims</h3><div class="btn-group btn-group-sm"><button class="btn btn-light active">Table</button><button class="btn btn-light" t-on-click="() => this.openClaims([])">Kanban</button></div></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Claim</th><th>Employee</th><th>Type</th><th class="text-end">Amount</th><th>Status</th></tr></thead><tbody><tr t-foreach="dashboard.recent || []" t-as="claim" t-key="claim.id" class="o_expense_table_row" t-on-click="() => this.openClaim(claim.id)"><td class="fw-bold" t-esc="claim.name"/><td t-esc="claim.employee"/><td t-esc="claim.title"/><td class="text-end fw-bold" t-esc="formatMoney(claim.amount)"/><td><span class="badge rounded-pill text-bg-light" t-esc="claim.state_label"/></td></tr></tbody></table></div></div>
                    </t>

                    <t t-elif="isRequests">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                            <div><h2 class="h3 fw-black mb-1" t-esc="activePage?.label"/><p class="text-muted mb-0">Pre-approvals for expenses and cash advances</p></div>
                            <button t-if="state.activePage === 'data'" class="btn btn-primary o_expense_primary" t-on-click="openRequestModal"><i class="fa fa-plus me-2"/>New Request</button>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-6 col-xl-3"><ExpenseKpiCard label="Total" value="pageKpis.total || 0" hint="Visible requests" icon="fa-clipboard" tone="pink"/></div>
                            <div class="col-6 col-xl-3"><ExpenseKpiCard label="Pending" value="pageKpis.pending || 0" hint="Awaiting approval" icon="fa-clock-o" tone="warning"/></div>
                            <div class="col-6 col-xl-3"><ExpenseKpiCard label="Approved" value="pageKpis.approved || 0" hint="Ready to fulfil" icon="fa-check" tone="success"/></div>
                            <div class="col-6 col-xl-3"><ExpenseKpiCard label="Rejected" value="pageKpis.rejected || 0" hint="Declined requests" icon="fa-times" tone="violet"/></div>
                        </div>
                        <div t-if="state.activePage === 'types'" class="row g-3">
                            <div t-foreach="state.pageData.request_types || []" t-as="item" t-key="item.id" class="col-12 col-md-6 col-xl-4">
                                <div class="card o_expense_panel h-100"><div class="card-body"><span class="o_expense_kpi_icon o_expense_tone_violet"><i class="fa fa-tags"/></span><h3 class="h5 fw-bold mt-3" t-esc="item.name"/><p class="text-muted mb-2" t-esc="item.creates_advance ? 'Creates a cash advance after approval' : 'Expense pre-approval'"/><div class="small"><span t-if="item.minimum">Minimum: <strong t-esc="formatMoney(item.minimum)"/></span><span t-if="item.maximum" class="ms-3">Maximum: <strong t-esc="formatMoney(item.maximum)"/></span></div></div></div>
                            </div>
                        </div>
                        <div t-else="" class="card o_expense_panel">
                            <div class="card-header bg-white border-0 d-flex flex-wrap justify-content-between gap-2 align-items-center">
                                <div class="input-group input-group-sm o_expense_record_search"><span class="input-group-text"><i class="fa fa-search"/></span><input class="form-control" placeholder="Search requests" t-att-value="state.recordSearch" t-on-input="updateRecordSearch"/></div>
                                <div class="d-flex gap-2"><select class="form-select form-select-sm" t-on-change="updateStatusFilter"><option value="all">All Status</option><option value="draft">Draft</option><option value="submitted">Pending</option><option value="approved">Approved</option><option value="rejected">Rejected</option></select><div class="btn-group btn-group-sm"><button class="btn btn-light" t-att-class="state.viewMode === 'table' ? 'active' : ''" t-on-click="() => this.setViewMode('table')"><i class="fa fa-table"/></button><button class="btn btn-light" t-att-class="state.viewMode === 'card' ? 'active' : ''" t-on-click="() => this.setViewMode('card')"><i class="fa fa-th-large"/></button></div></div>
                            </div>
                            <div t-if="state.pageLoading" class="text-center py-5"><span class="spinner-border text-primary"/></div>
                            <div t-elif="state.viewMode === 'table'" class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Request #</th><th>Employee</th><th>Type</th><th>Purpose</th><th class="text-end">Amount</th><th>Status</th><th>Needed</th><th/></tr></thead><tbody><tr t-foreach="pageRecords" t-as="record" t-key="record.id"><td><button class="btn btn-link p-0 fw-bold" t-on-click="() => this.openRequest(record.id)" t-esc="record.name"/></td><td><span t-esc="record.employee"/><div class="small text-muted" t-esc="record.department"/></td><td t-esc="record.type"/><td class="text-truncate" style="max-width:260px" t-esc="record.purpose"/><td class="text-end fw-bold" t-esc="formatMoney(record.amount)"/><td><span class="badge rounded-pill" t-att-class="statusClass(record.state)" t-esc="record.state_label"/></td><td t-esc="formatDate(record.needed_date)"/><td class="text-end"><button t-if="record.can_submit" class="btn btn-sm btn-outline-primary" t-on-click="() => this.requestAction(record, 'submit')">Submit</button><button t-if="record.can_issue" class="btn btn-sm btn-primary" t-on-click="() => this.requestAction(record, 'issue')">Issue</button></td></tr><tr t-if="!pageRecords.length"><td colspan="8" class="text-center text-muted py-5">No requests match these filters.</td></tr></tbody></table></div>
                            <div t-else="" class="row g-3 p-3"><div t-foreach="pageRecords" t-as="record" t-key="record.id" class="col-12 col-md-6 col-xl-4"><div class="card border h-100"><div class="card-body"><div class="d-flex justify-content-between gap-2"><button class="btn btn-link p-0 fw-bold" t-on-click="() => this.openRequest(record.id)" t-esc="record.name"/><span class="badge rounded-pill" t-att-class="statusClass(record.state)" t-esc="record.state_label"/></div><p class="fw-bold mt-3 mb-1" t-esc="record.employee"/><p class="text-muted small" t-esc="record.type"/><p t-esc="record.purpose"/><div class="h5 fw-black mb-0" t-esc="formatMoney(record.amount)"/></div></div></div></div>
                        </div>
                    </t>

                    <t t-elif="isAdvances">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h2 class="h3 fw-black mb-1" t-esc="activePage?.label"/><p class="text-muted mb-0">Track issued funds, aging, and employee retirement balances</p></div></div>
                        <div class="row g-3 mb-4"><div class="col-6 col-xl-3"><ExpenseKpiCard label="Total Outstanding" value="formatMoney(pageKpis.total_outstanding)" hint="Unretired balance" icon="fa-money" tone="pink"/></div><div class="col-6 col-xl-3"><ExpenseKpiCard label="Active Advances" value="pageKpis.active || 0" hint="Open balances" icon="fa-briefcase" tone="violet"/></div><div class="col-6 col-xl-3"><ExpenseKpiCard label="Overdue" value="pageKpis.overdue || 0" hint="Past retirement date" icon="fa-exclamation-triangle" tone="warning"/></div><div class="col-6 col-xl-3"><ExpenseKpiCard label="Critical" value="pageKpis.critical || 0" hint="At least 100,000" icon="fa-bell" tone="success"/></div></div>
                        <div t-if="state.activePage === 'issue'" class="card o_expense_panel"><div class="card-header bg-white border-0"><h3 class="h6 fw-black mb-0">Approved cash-advance requests</h3></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Request</th><th>Employee</th><th>Purpose</th><th class="text-end">Amount</th><th/></tr></thead><tbody><tr t-foreach="state.pageData.issuable_requests || []" t-as="record" t-key="record.id"><td class="fw-bold" t-esc="record.name"/><td t-esc="record.employee"/><td t-esc="record.purpose"/><td class="text-end fw-bold" t-esc="formatMoney(record.amount)"/><td class="text-end"><button class="btn btn-sm btn-primary" t-on-click="() => this.requestAction(record, 'issue')">Issue Advance</button></td></tr><tr t-if="!(state.pageData.issuable_requests || []).length"><td colspan="5" class="text-center text-muted py-5">No approved requests are waiting to be issued.</td></tr></tbody></table></div></div>
                        <div t-else="" class="card o_expense_panel"><div class="card-header bg-white border-0 d-flex flex-wrap justify-content-between gap-2"><div class="input-group input-group-sm o_expense_record_search"><span class="input-group-text"><i class="fa fa-search"/></span><input class="form-control" placeholder="Search advances" t-att-value="state.recordSearch" t-on-input="updateRecordSearch"/></div><select class="form-select form-select-sm o_expense_filter_select" t-on-change="updateStatusFilter"><option value="all">All Status</option><option value="outstanding">Outstanding</option><option value="partial">Partially Retired</option><option value="retired">Retired</option></select></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Advance #</th><th>Employee</th><th class="text-end">Issued</th><th class="text-end">Outstanding</th><th>Days</th><th>Age</th><th>Status</th><th/></tr></thead><tbody><tr t-foreach="pageRecords" t-as="record" t-key="record.id"><td><button class="btn btn-link p-0 fw-bold" t-on-click="() => this.openAdvance(record.id)" t-esc="record.name"/></td><td><span t-esc="record.employee"/><div class="small text-muted" t-esc="record.department"/></td><td class="text-end" t-esc="formatMoney(record.issued)"/><td class="text-end fw-bold" t-esc="formatMoney(record.outstanding)"/><td t-esc="record.days"/><td><span class="badge text-bg-light" t-esc="record.age"/></td><td><span class="badge rounded-pill" t-att-class="statusClass(record.state)" t-esc="record.state_label"/></td><td class="text-end"><button t-if="record.can_retire" class="btn btn-sm btn-outline-primary" t-on-click="() => this.openRetirementModal(record)">Retire</button></td></tr><tr t-if="!pageRecords.length"><td colspan="8" class="text-center text-muted py-5">No advances match these filters.</td></tr></tbody></table></div></div>
                    </t>

                    <t t-elif="isWorkflow">
                        <div class="mb-4"><h2 class="h3 fw-black mb-1" t-esc="activePage?.label"/><p class="text-muted">Claims and requests in one decision workspace</p></div>
                        <div class="row g-3 mb-4"><div class="col-md-4"><ExpenseKpiCard label="Awaiting Action" value="pageKpis.awaiting || 0" t-att-hint="`${pageKpis.claims || 0} claims · ${pageKpis.requests || 0} requests`" icon="fa-hourglass-half" tone="warning"/></div><div class="col-md-4"><ExpenseKpiCard label="Total Value" value="formatMoney(pageKpis.total_value)" hint="Financial exposure" icon="fa-line-chart" tone="violet"/></div><div class="col-md-4"><ExpenseKpiCard label="Approval Types" t-att-value="`${pageKpis.claims || 0} / ${pageKpis.requests || 0}`" hint="Claims / Requests" icon="fa-random" tone="pink"/></div></div>
                        <div t-if="state.pageData.rule_page" class="card o_expense_panel"><div class="card-header bg-white border-0 d-flex justify-content-between align-items-center"><div><h3 class="h6 fw-black mb-0">Approval Routes</h3><span class="small text-muted"><t t-esc="pageKpis.active || 0"/> active rules</span></div><button t-if="state.data.role.admin" class="btn btn-sm btn-primary" t-on-click="openApprovalRules"><i class="fa fa-cog me-2"/>Configure</button></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Rule</th><th>Target</th><th>Department</th><th>Amount Range</th><th>Levels</th><th>Status</th></tr></thead><tbody><tr t-foreach="state.pageData.records || []" t-as="rule" t-key="rule.id"><td class="fw-bold" t-esc="rule.name"/><td t-esc="rule.target"/><td t-esc="rule.department"/><td><t t-esc="formatMoney(rule.minimum)"/> – <t t-esc="rule.maximum ? formatMoney(rule.maximum) : 'No limit'"/></td><td t-esc="rule.levels"/><td><span class="badge rounded-pill" t-att-class="rule.active ? 'text-bg-success' : 'text-bg-light'" t-esc="rule.active ? 'Active' : 'Inactive'"/></td></tr><tr t-if="!(state.pageData.records || []).length"><td colspan="6" class="text-center text-muted py-5">No approval rule matches this page. Admins can configure one.</td></tr></tbody></table></div></div>
                        <div t-else="" class="card o_expense_panel"><div class="card-header bg-white border-0 d-flex flex-wrap justify-content-between gap-2"><div class="input-group input-group-sm o_expense_record_search"><span class="input-group-text"><i class="fa fa-search"/></span><input class="form-control" placeholder="Search approvals" t-att-value="state.recordSearch" t-on-input="updateRecordSearch"/></div><div class="btn-group btn-group-sm"><button class="btn btn-light" t-att-class="state.viewMode === 'table' ? 'active' : ''" t-on-click="() => this.setViewMode('table')">Table</button><button class="btn btn-light" t-att-class="state.viewMode === 'card' ? 'active' : ''" t-on-click="() => this.setViewMode('card')">Card</button></div></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Type</th><th>Reference</th><th>Employee</th><th>Description</th><th class="text-end">Amount</th><th>Date</th><th/></tr></thead><tbody><tr t-foreach="pageRecords" t-as="record" t-key="record.kind + '-' + record.id"><td><span class="badge text-bg-light" t-esc="record.kind_label"/></td><td class="fw-bold" t-esc="record.reference"/><td><span t-esc="record.employee"/><div class="small text-muted" t-esc="record.department"/></td><td t-esc="record.description"/><td class="text-end fw-bold" t-esc="formatMoney(record.amount)"/><td t-esc="formatDate(record.date)"/><td class="text-end"><div t-if="state.activePage === 'pending'" class="btn-group btn-group-sm"><button class="btn btn-outline-success" t-on-click="() => this.openDecisionModal(record.kind, record, 'approve')">Approve</button><button class="btn btn-outline-danger" t-on-click="() => this.openDecisionModal(record.kind, record, 'reject')">Reject</button><button class="btn btn-light" t-on-click="() => this.openDecisionModal(record.kind, record, 'return')">Return</button></div></td></tr><tr t-if="!pageRecords.length"><td colspan="7" class="text-center text-muted py-5">No approval items on this page.</td></tr></tbody></table></div></div>
                    </t>

                    <t t-elif="isPayments">
                        <div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h2 class="h3 fw-black mb-1" t-esc="activePage?.label"/><p class="text-muted">Payables, batch disbursement, methods, and history</p></div><button t-if="state.activePage === 'process' and state.data.role.finance" class="btn btn-primary o_expense_primary" t-on-click="processAllPayables"><i class="fa fa-play me-2"/>Process Batch</button></div>
                        <div class="row g-3 mb-4"><div class="col-md-4"><ExpenseKpiCard label="Total Payables" value="formatMoney(pageKpis.payable_value)" t-att-hint="`${pageKpis.payable_count || 0} claims`" icon="fa-credit-card" tone="pink"/></div><div class="col-md-4"><ExpenseKpiCard label="Paid" value="formatMoney(pageKpis.paid_value)" t-att-hint="`${pageKpis.paid_count || 0} payments`" icon="fa-check-circle" tone="success"/></div><div class="col-md-4"><ExpenseKpiCard label="Batches" t-att-value="(state.pageData.batches || []).length" hint="Processing history" icon="fa-list" tone="violet"/></div></div>
                        <div t-if="state.activePage === 'methods'" class="row g-3"><div t-foreach="pageRecords" t-as="method" t-key="method.id" class="col-md-6"><div class="card o_expense_panel h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="o_expense_kpi_icon o_expense_tone_violet"><i class="fa fa-credit-card"/></span><span class="badge" t-att-class="method.active ? 'text-bg-success' : 'text-bg-light'" t-esc="method.active ? 'Enabled' : 'Disabled'"/></div><h3 class="h5 fw-bold mt-3" t-esc="method.name"/><p class="text-muted mb-0" t-esc="method.type"/></div></div></div></div>
                        <div t-else="" class="card o_expense_panel"><div class="card-header bg-white border-0"><div class="input-group input-group-sm o_expense_record_search"><span class="input-group-text"><i class="fa fa-search"/></span><input class="form-control" placeholder="Search payments" t-on-input="updateRecordSearch"/></div></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Reference</th><th>Employee</th><th t-if="state.activePage !== 'history'">Department</th><th class="text-end">Amount</th><th t-if="state.activePage !== 'history'">Days Pending</th><th t-else="">Method</th><th>Status</th></tr></thead><tbody><tr t-foreach="pageRecords" t-as="record" t-key="record.id"><td class="fw-bold" t-esc="record.name"/><td t-esc="record.employee"/><td t-if="state.activePage !== 'history'" t-esc="record.department"/><td class="text-end fw-bold" t-esc="formatMoney(record.amount)"/><td t-if="state.activePage !== 'history'" t-esc="record.days"/><td t-else="" t-esc="record.method"/><td><span class="badge rounded-pill" t-att-class="statusClass(record.state)" t-esc="record.state"/></td></tr><tr t-if="!pageRecords.length"><td colspan="7" class="text-center text-muted py-5">No payment records on this page.</td></tr></tbody></table></div></div>
                    </t>

                    <t t-elif="isPettyCash">
                        <div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h2 class="h3 fw-black mb-1" t-esc="activePage?.label"/><p class="text-muted">Funds, expenses, cash counts, replenishments, and custodians</p></div><div class="d-flex gap-2"><button t-if="state.activePage === 'accounts' and state.data.role.finance" class="btn btn-primary" t-on-click="() => this.openPettyCashAction('hr_claims.action_hr_petty_cash_funds')">Create Fund</button><button t-if="state.activePage === 'transactions'" class="btn btn-primary" t-on-click="() => this.openPettyCashAction('hr_claims.action_hr_petty_cash_transactions')">Record Expense</button><button t-if="state.activePage === 'reconciliation'" class="btn btn-primary" t-on-click="() => this.openPettyCashAction('hr_claims.action_hr_petty_cash_reconciliations')">Start Reconciliation</button><button t-if="state.activePage === 'replenishment'" class="btn btn-primary" t-on-click="() => this.openPettyCashAction('hr_claims.action_hr_petty_cash_replenishments')">Request Replenishment</button></div></div>
                        <div class="row g-3 mb-4"><div class="col-6 col-xl-3"><ExpenseKpiCard label="Active Funds" value="pageKpis.funds || 0" hint="Visible accounts" icon="fa-briefcase" tone="pink"/></div><div class="col-6 col-xl-3"><ExpenseKpiCard label="Total Balance" value="formatMoney(pageKpis.balance)" hint="Cash on hand" icon="fa-money" tone="success"/></div><div class="col-6 col-xl-3"><ExpenseKpiCard label="Need Replenishment" value="pageKpis.low || 0" hint="Below threshold" icon="fa-exclamation-triangle" tone="warning"/></div><div class="col-6 col-xl-3"><ExpenseKpiCard label="Pending" t-att-value="(pageKpis.pending || 0) + (pageKpis.replenishments || 0)" hint="Awaiting Finance" icon="fa-clock-o" tone="violet"/></div></div>
                        <div class="card o_expense_panel"><div class="card-header bg-white border-0"><div class="input-group input-group-sm o_expense_record_search"><span class="input-group-text"><i class="fa fa-search"/></span><input class="form-control" placeholder="Search petty cash" t-on-input="updateRecordSearch"/></div></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Reference</th><th t-if="state.activePage === 'accounts'">Location / Custodian</th><th t-else="">Fund</th><th t-if="state.activePage === 'transactions'">Payee / Category</th><th t-if="state.activePage === 'reconciliation'">System / Physical</th><th t-if="state.activePage === 'replenishment'">Justification</th><th class="text-end">Amount / Balance</th><th>Status</th></tr></thead><tbody><tr t-foreach="pageRecords" t-as="record" t-key="record.id"><td><strong t-esc="record.code || record.name"/><div class="small text-muted" t-esc="formatDate(record.date)"/></td><td t-if="state.activePage === 'accounts'"><span t-esc="record.location"/><div class="small text-muted" t-esc="record.custodian"/></td><td t-else="" t-esc="record.fund"/><td t-if="state.activePage === 'transactions'"><span t-esc="record.payee"/><div class="small text-muted" t-esc="record.category"/></td><td t-if="state.activePage === 'reconciliation'"><t t-esc="formatMoney(record.system)"/> / <t t-esc="formatMoney(record.physical)"/></td><td t-if="state.activePage === 'replenishment'" t-esc="record.justification"/><td class="text-end fw-bold" t-esc="formatMoney(record.balance !== undefined ? record.balance : record.amount !== undefined ? record.amount : record.variance)"/><td><span class="badge rounded-pill" t-att-class="statusClass(record.state)" t-esc="record.state_label || record.state"/></td></tr><tr t-if="!pageRecords.length"><td colspan="7" class="text-center text-muted py-5">No records on this page.</td></tr></tbody></table></div></div>
                    </t>

                    <t t-else="">
                        <div class="o_expense_page_intro mb-4"><h2 class="h3 fw-black mb-1" t-esc="activePage?.label || activeModule?.label"/><p class="text-muted mb-0"><t t-esc="activeModule?.label"/> is part of the corrected full Figma scope.</p></div>
                        <div class="card o_expense_panel"><div class="card-body text-center py-5"><span class="o_expense_large_icon"><i t-att-class="'fa ' + (activeModule?.icon || 'fa-cubes')"/></span><h3 class="h5 fw-bold mt-3">Implementation phase in progress</h3><p class="text-muted mx-auto mb-0" style="max-width: 620px">This page is now represented in the OWL application shell and capability map. Its records, workflow actions, analytics, and creation flow will activate with the corresponding corrected phase recorded in PROGRESS.md.</p></div></div>
                    </t>
                </main>
            </section>

            <div t-if="state.modal" class="o_expense_modal_backdrop" t-on-click.self="closeModal">
                <div class="card o_expense_modal shadow-lg border-0">
                    <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between"><h3 class="h5 fw-black mb-0"><t t-if="state.modal.type === 'request'">New Request</t><t t-elif="state.modal.type === 'decision'"><t t-esc="state.modal.action"/> <t t-esc="state.modal.kind"/></t><t t-else="">Retire Advance</t></h3><button class="btn btn-light rounded-circle" t-on-click="closeModal"><i class="fa fa-times"/></button></div>
                    <div t-if="state.modal.type === 'request'" class="card-body"><div class="row g-3"><div class="col-12"><label class="form-label">Request type</label><select class="form-select" data-field="request_type_id" t-on-change="updateModalValue"><option t-foreach="state.pageData.request_types || []" t-as="item" t-key="item.id" t-att-value="item.id" t-esc="item.name"/></select></div><div class="col-12"><label class="form-label">Purpose</label><input class="form-control" data-field="purpose" t-on-input="updateModalValue" placeholder="What is this expense for?"/></div><div class="col-md-6"><label class="form-label">Amount</label><input type="number" min="0" class="form-control" data-field="amount" t-on-input="updateModalValue"/></div><div class="col-md-6"><label class="form-label">Needed by</label><input type="date" class="form-control" data-field="needed_date" t-on-input="updateModalValue"/></div><div class="col-12"><label class="form-label">Details</label><textarea class="form-control" rows="4" data-field="description" t-on-input="updateModalValue"/></div></div></div>
                    <div t-elif="state.modal.type === 'decision'" class="card-body"><p>Record a decision for <strong t-esc="state.modal.record.reference || state.modal.record.name"/>.</p><label class="form-label"><t t-esc="state.modal.action === 'approve' ? 'Approval note (optional)' : 'Reason'"/></label><textarea class="form-control" rows="4" data-field="comment" t-on-input="updateModalValue"/></div>
                    <div t-else="" class="card-body"><p>Outstanding balance: <strong t-esc="formatMoney(state.modal.record.outstanding)"/></p><div class="mb-3"><label class="form-label">Amount retired</label><input type="number" min="0" class="form-control" data-field="amount" t-att-value="state.modal.values.amount" t-on-input="updateModalValue"/></div><div><label class="form-label">Reference / note</label><input class="form-control" data-field="reference" t-on-input="updateModalValue"/></div></div>
                    <div class="card-footer bg-white border-0 d-flex justify-content-end gap-2"><button class="btn btn-light" t-on-click="closeModal">Cancel</button><t t-if="state.modal.type === 'request'"><button class="btn btn-outline-primary" t-on-click="() => this.createRequest(false)">Save Draft</button><button class="btn btn-primary" t-on-click="() => this.createRequest(true)">Submit Request</button></t><button t-elif="state.modal.type === 'decision'" class="btn btn-primary text-capitalize" t-on-click="submitDecision" t-esc="state.modal.action"/><button t-else="" class="btn btn-primary" t-on-click="retireAdvance">Post Retirement</button></div>
                </div>
            </div>
        </div>
    </t>
</templates>
