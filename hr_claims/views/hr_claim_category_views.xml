<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_claim_category_tree" model="ir.ui.view">
        <field name="name">hr.claim.category.tree</field>
        <field name="model">hr.claim.category</field>
        <field name="arch" type="xml">
            <tree string="Claim Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_claim_category_form" model="ir.ui.view">
        <field name="name">hr.claim.category.form</field>
        <field name="model">hr.claim.category</field>
        <field name="arch" type="xml">
            <form string="Claim Category">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group><field name="name"/><field name="code"/><field name="sequence"/></group>
                        <group><field name="company_id" groups="base.group_multi_company"/><field name="color"/><field name="active"/></group>
                    </group>
                    <field name="description" placeholder="Purpose and usage of this category..."/>
                    <field name="claim_type_ids" readonly="1">
                        <tree><field name="name"/><field name="code"/><field name="amount_type"/><field name="receipt_policy"/><field name="active"/></tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_claim_categories" model="ir.actions.act_window">
        <field name="name">Claim Categories</field>
        <field name="res_model">hr.claim.category</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
