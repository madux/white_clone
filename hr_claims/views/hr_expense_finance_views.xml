    <record id="view_hr_petty_cash_transaction_tree" model="ir.ui.view"><field name="name">hr.petty.cash.transaction.tree</field><field name="model">hr.petty.cash.transaction</field><field name="arch" type="xml"><tree><field name="date"/><field name="name"/><field name="fund_id"/><field name="transaction_type"/><field name="payee"/><field name="category"/><field name="amount" sum="Total"/><field name="state" widget="badge"/></tree></field></record>
    <record id="view_hr_petty_cash_transaction_form" model="ir.ui.view"><field name="name">hr.petty.cash.transaction.form</field><field name="model">hr.petty.cash.transaction</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve &amp; Post" class="oe_highlight" groups="hr_claims.group_hr_claim_finance" invisible="state != 'submitted'"/><field name="state" widget="statusbar"/></header><sheet><field name="company_id" invisible="1"/><group><group><field name="fund_id"/><field name="transaction_type"/><field name="date"/></group><group><field name="payee"/><field name="category"/><field name="amount"/></group></group><field name="description"/><field name="receipt_attachment_id"/></sheet><chatter/></form></field></record>
    <record id="action_hr_petty_cash_transactions" model="ir.actions.act_window"><field name="name">Petty Cash Transactions</field><field name="res_model">hr.petty.cash.transaction</field><field name="view_mode">tree,form</field></record>

    <record id="view_hr_petty_cash_reconciliation_tree" model="ir.ui.view"><field name="name">hr.petty.cash.reconciliation.tree</field><field name="model">hr.petty.cash.reconciliation</field><field name="arch" type="xml"><tree><field name="date"/><field name="name"/><field name="fund_id"/><field name="system_balance"/><field name="physical_count"/><field name="variance"/><field name="state" widget="badge"/><field name="reconciled_by_id"/></tree></field></record>
