<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_expense_payment_batch_tree" model="ir.ui.view"><field name="name">hr.expense.payment.batch.tree</field><field name="model">hr.expense.payment.batch</field><field name="arch" type="xml"><tree><field name="name"/><field name="method_id"/><field name="claim_count"/><field name="total_amount" sum="Total"/><field name="processed_date"/><field name="state" widget="badge"/></tree></field></record>
    <record id="view_hr_expense_payment_batch_form" model="ir.ui.view"><field name="name">hr.expense.payment.batch.form</field><field name="model">hr.expense.payment.batch</field><field name="arch" type="xml"><form><header><button name="action_validate" type="object" string="Validate" class="oe_highlight" invisible="state != 'draft'"/><button name="action_process" type="object" string="Process" class="oe_highlight" invisible="state != 'validated'"/><field name="state" widget="statusbar"/></header><sheet><field name="company_id" invisible="1"/><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="method_id"/><field name="reference"/></group><group><field name="claim_count"/><field name="total_amount"/><field name="processed_by_id"/><field name="processed_date"/></group></group><field name="claim_ids" domain="[('state', '=', 'approved'), ('residual_amount', '&gt;', 0)]"><tree><field name="name"/><field name="employee_id"/><field name="residual_amount"/></tree></field><field name="result_log" invisible="not result_log"/></sheet><chatter/></form></field></record>
