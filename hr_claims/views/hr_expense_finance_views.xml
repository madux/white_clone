    <record id="action_hr_petty_cash_reconciliations" model="ir.actions.act_window"><field name="name">Petty Cash Reconciliations</field><field name="res_model">hr.petty.cash.reconciliation</field><field name="view_mode">tree,form</field></record>

    <record id="view_hr_petty_cash_replenishment_tree" model="ir.ui.view"><field name="name">hr.petty.cash.replenishment.tree</field><field name="model">hr.petty.cash.replenishment</field><field name="arch" type="xml"><tree><field name="request_date"/><field name="name"/><field name="fund_id"/><field name="requested_amount"/><field name="urgent"/><field name="state" widget="badge"/><field name="requested_by_id"/></tree></field></record>
    <record id="view_hr_petty_cash_replenishment_form" model="ir.ui.view"><field name="name">hr.petty.cash.replenishment.form</field><field name="model">hr.petty.cash.replenishment</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" class="oe_highlight" groups="hr_claims.group_hr_claim_finance" invisible="state != 'submitted'"/><button name="action_issue" type="object" string="Issue" class="oe_highlight" groups="hr_claims.group_hr_claim_finance" invisible="state != 'approved'"/><field name="state" widget="statusbar"/></header><sheet><field name="company_id" invisible="1"/><group><group><field name="fund_id"/><field name="request_date"/><field name="requested_amount"/><field name="urgent"/></group><group><field name="requested_by_id"/><field name="approved_by_id"/><field name="issued_amount"/><field name="issued_date"/><field name="reference"/></group></group><field name="justification"/></sheet><chatter/></form></field></record>
    <record id="action_hr_petty_cash_replenishments" model="ir.actions.act_window"><field name="name">Petty Cash Replenishments</field><field name="res_model">hr.petty.cash.replenishment</field><field name="view_mode">tree,form</field></record>
</odoo>
