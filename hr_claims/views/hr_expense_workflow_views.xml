<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_expense_request_search" model="ir.ui.view">
        <field name="name">hr.expense.request.search</field>
        <field name="model">hr.expense.request</field>
        <field name="arch" type="xml">
            <search string="Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_type_id"/>
                <field name="purpose"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', 'in', ('approved', 'fulfilled'))]"/>
                <filter name="my_requests" string="My Requests" domain="[('employee_id.user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'request_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_hr_expense_request_tree" model="ir.ui.view">
        <field name="name">hr.expense.request.tree</field>
        <field name="model">hr.expense.request</field>
        <field name="arch" type="xml">
            <tree decoration-warning="state == 'submitted'" decoration-success="state in ('approved', 'fulfilled')" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_type_id"/>
                <field name="purpose"/>
                <field name="needed_date"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_expense_request_form" model="ir.ui.view">
        <field name="name">hr.expense.request.form</field>
        <field name="model">hr.expense.request</field>
        <field name="arch" type="xml">
            <form string="Expense Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state not in ('draft', 'returned')"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" groups="hr_claims.group_hr_claim_manager" invisible="state != 'submitted'"/>
                    <button name="action_issue_advance" type="object" string="Issue Advance" class="oe_highlight" groups="hr_claims.group_hr_claim_finance" invisible="state != 'approved' or not request_type_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submitted', 'returned')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,fulfilled,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state not in ('draft', 'returned')"/>
                            <field name="request_type_id" readonly="state not in ('draft', 'returned')"/>
                            <field name="needed_date" readonly="state not in ('draft', 'returned')"/>
                        </group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="amount" readonly="state not in ('draft', 'returned')"/>
                            <field name="submitted_date" invisible="not submitted_date"/>
                            <field name="advance_id" invisible="not advance_id"/>
                        </group>
                    </group>
                    <group><field name="purpose" readonly="state not in ('draft', 'returned')"/></group>
                    <notebook>
                        <page string="Details"><field name="description" readonly="state not in ('draft', 'returned')"/></page>
                        <page string="Documents"><field name="attachment_ids" widget="many2many_binary" readonly="state not in ('draft', 'returned')"/></page>
                        <page string="Approval Route"><field name="approval_step_ids" readonly="1"><tree><field name="sequence"/><field name="rule_line_id"/><field name="approver_user_id"/><field name="approver_group_id"/><field name="state" widget="badge"/><field name="decision_date"/></tree></field></page>
                        <page string="Decision" invisible="not decision_date"><group><field name="decided_by_id"/><field name="decision_date"/><field name="decision_comment"/></group></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_expense_requests" model="ir.actions.act_window">
        <field name="name">Requests</field><field name="res_model">hr.expense.request</field>
        <field name="view_mode">tree,form</field><field name="search_view_id" ref="view_hr_expense_request_search"/>
    </record>
    <record id="action_hr_expense_requests_pending" model="ir.actions.act_window">
        <field name="name">Pending Requests</field><field name="res_model">hr.expense.request</field>
        <field name="view_mode">tree,form</field><field name="domain">[('state', '=', 'submitted')]</field>
        <field name="search_view_id" ref="view_hr_expense_request_search"/>
    </record>

    <record id="view_hr_expense_request_type_tree" model="ir.ui.view">
        <field name="name">hr.expense.request.type.tree</field><field name="model">hr.expense.request.type</field>
        <field name="arch" type="xml"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="creates_advance"/><field name="minimum_amount"/><field name="maximum_amount"/><field name="active"/></tree></field>
    </record>
    <record id="view_hr_expense_request_type_form" model="ir.ui.view">
        <field name="name">hr.expense.request.type.form</field><field name="model">hr.expense.request.type</field>
        <field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="code"/><field name="active"/></group><group><field name="creates_advance"/><field name="retirement_days" invisible="not creates_advance"/><field name="minimum_amount"/><field name="maximum_amount"/></group></group><field name="description"/></sheet></form></field>
    </record>
    <record id="action_hr_expense_request_types" model="ir.actions.act_window">
        <field name="name">Request Types</field><field name="res_model">hr.expense.request.type</field><field name="view_mode">tree,form</field>
    </record>

    <record id="view_hr_cash_advance_tree" model="ir.ui.view">
        <field name="name">hr.cash.advance.tree</field><field name="model">hr.cash.advance</field>
        <field name="arch" type="xml"><tree decoration-danger="days_outstanding &gt; 90 and outstanding_amount &gt; 0" decoration-warning="state == 'partial'" decoration-success="state == 'retired'"><field name="name"/><field name="employee_id"/><field name="issue_date"/><field name="issued_amount" sum="Issued"/><field name="outstanding_amount" sum="Outstanding"/><field name="days_outstanding"/><field name="age_bracket" widget="badge"/><field name="state" widget="badge"/></tree></field>
    </record>
    <record id="view_hr_cash_advance_form" model="ir.ui.view">
        <field name="name">hr.cash.advance.form</field><field name="model">hr.cash.advance</field>
        <field name="arch" type="xml"><form><header><button name="action_issue" type="object" string="Issue" class="oe_highlight" invisible="state != 'draft'"/><field name="state" widget="statusbar" statusbar_visible="draft,outstanding,partial,retired"/></header><sheet><field name="company_id" invisible="1"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="request_id"/><field name="employee_id"/><field name="issue_date"/><field name="retirement_due_date"/></group><group><field name="issued_amount"/><field name="retired_amount"/><field name="outstanding_amount"/><field name="payment_method"/><field name="reference"/></group></group><notebook><page string="Retirements"><field name="retirement_ids" readonly="1"><tree><field name="date"/><field name="amount"/><field name="reference"/><field name="processed_by_id"/><field name="state" widget="badge"/></tree></field></page><page string="Notes"><field name="notes"/></page></notebook></sheet><chatter/></form></field>
    </record>
    <record id="action_hr_cash_advances" model="ir.actions.act_window">
        <field name="name">Cash Advances</field><field name="res_model">hr.cash.advance</field><field name="view_mode">tree,form</field>
    </record>

    <record id="view_hr_expense_approval_rule_tree" model="ir.ui.view">
        <field name="name">hr.expense.approval.rule.tree</field><field name="model">hr.expense.approval.rule</field>
        <field name="arch" type="xml"><tree><field name="sequence" widget="handle"/><field name="name"/><field name="target"/><field name="department_id"/><field name="minimum_amount"/><field name="maximum_amount"/><field name="active"/></tree></field>
    </record>
    <record id="view_hr_expense_approval_rule_form" model="ir.ui.view">
        <field name="name">hr.expense.approval.rule.form</field><field name="model">hr.expense.approval.rule</field>
        <field name="arch" type="xml"><form><sheet><field name="company_id" invisible="1"/><group><group><field name="name"/><field name="target"/><field name="department_id"/></group><group><field name="minimum_amount"/><field name="maximum_amount"/><field name="active"/></group></group><field name="line_ids"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="approver_type"/><field name="user_id" invisible="approver_type != 'user'"/><field name="group_id" invisible="approver_type != 'group'"/></tree></field></sheet></form></field>
    </record>
    <record id="action_hr_expense_approval_rules" model="ir.actions.act_window">
        <field name="name">Approval Rules</field><field name="res_model">hr.expense.approval.rule</field><field name="view_mode">tree,form</field>
    </record>
</odoo>
