<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="cleon_license.AttendanceClockWidget">
        <div class="o_attendance_clock_widget">

            <!-- ── Top summary row: date + total ────────────────────── -->
            <div class="profile-meta-row">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <path d="M16 2v4M8 2v4M3 10h18"/>
                </svg>
                <span t-esc="todayDateLabel"/>

                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 8v4l3 3"/>
                </svg>
                <span t-esc="sessionTimeLabel"/>

                <span t-attf-class="profile-meta-dot {{ isPresent ? 'is-online' : 'is-offline' }}"/>
            </div>

            <!-- ── Big ticking clock ─────────────────────────────────── -->
            <div class="profile-clock-display">
                <t t-esc="hh"/> : <t t-esc="mm"/> : <t t-esc="ss"/>
            </div>
            <div class="profile-clock-labels">
                <span class="profile-clock-label-item">HRS</span>
                <span class="profile-clock-label-item"></span>
                <span class="profile-clock-label-item">MINS</span>
                <span class="profile-clock-label-item"></span>
                <span class="profile-clock-label-item">SECS</span>
            </div>

            <!-- ── Session time ──────────────────────────────────────── -->
            <div class="profile-session-label">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 7v5l3 3"/>
                </svg>
                SESSION TIME
            </div>
            <div class="profile-session-time" t-esc="sessionTimeLabel"/>

            <!-- ── Today's wall-clock time ───────────────────────────── -->
            <div class="profile-today-label">Today's Time</div>
            <div class="profile-today-time" t-esc="todayTimeLabel"/>

            <!-- ── Shift + online status ─────────────────────────────── -->
            <div class="profile-shift-row">
                <t t-esc="shiftLabel"/><br/>
                <span t-attf-class="profile-shift-online {{ isPresent ? '' : 'is-offline' }}">
                    ● <t t-esc="onlineLabel"/>
                </span>
            </div>

            <!-- ── Stats row ──────────────────────────────────────────── -->
            <div class="profile-stats-row">
                <div class="profile-stat-card">
                    <div class="profile-stat-value" t-esc="todayStat"/>
                    <div class="profile-stat-label">TODAY</div>
                </div>
                <div class="profile-stat-card" style="text-align:center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7a8494" stroke-width="2" style="display:block;margin:0 auto 2px">
                        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                        <polyline points="16 7 22 7 22 13"/>
                    </svg>
                    <div class="profile-stat-value" t-esc="overtimeStat"/>
                    <div class="profile-stat-label">OVERTIME</div>
                </div>
                <div class="profile-stat-card">
                    <div class="profile-stat-value" t-esc="weekStat"/>
                    <div class="profile-stat-label">THIS WEEK</div>
                </div>
            </div>

        </div>
    </t>

</templates>