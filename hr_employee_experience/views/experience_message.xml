<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ══════════════════════════════════════════════════
         TREE / LIST VIEW
    ══════════════════════════════════════════════════ -->
    <record id="view_hr_experience_message_tree" model="ir.ui.view">
        <field name="name">hr.experience.message.tree</field>
        <field name="model">hr.experience.message</field>
        <field name="arch" type="xml">
            <tree
                string="List"
                class="o_exp_list"
                decoration-warning="state == 'draft'" 
                decoration-success="state == 'sent'"
                decoration-danger="state == 'read'">

                <field name="name" readonly="0"/>
                <field name="employee_id" readonly="0"/>
                <field name="sender_employee_id" readonly="0"/>
                <field name="message" readonly="0"/>
                <field name="sent_date" readonly="0"/>
                <field name="read_date" readonly="1"/> 
                <field name="active" readonly="1"/> 
                <field name="is_read" readonly="1"/>  
                <field name="attachment_ids" readonly="1" widget="many2many_tags"/> 
                <!-- <field name="state" readonly="1"/> -->
                <field name="state" widget="badge"
                    decoration-warning="state == 'draft'" 
                    decoration-success="state == 'sent'"
                    decoration-danger="state == 'read'" 
                    />
            </tree>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         SEARCH VIEW
    ══════════════════════════════════════════════════ -->
    <record id="view_hr_experience_message_search" model="ir.ui.view">
        <field name="name">hr.experience.message.search</field>
        <field name="model">hr.experience.message</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name" readonly="0"/>
                <field name="employee_id" readonly="0"/>
                <field name="sender_employee_id" readonly="0"/>
                <field name="message" readonly="0"/>
                <field name="sent_date" readonly="0"/>
                <field name="read_date" readonly="1"/> 
                <field name="active" readonly="1"/> 
                <field name="is_read" readonly="1"/>  
                
                <separator/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         FORM VIEW  — Modern Card-based UI
    ══════════════════════════════════════════════════ -->
    <record id="view_hr_experience_message_form" model="ir.ui.view">
        <field name="name">hr.experience.message.form</field>
        <field name="model">hr.experience.message</field>
        <field name="arch" type="xml">
            <form string="Form" class="o_exp_form">
                <!-- ══ STATUS BAR ══ -->
                <header>

                    <button name="action_send" string="✓ Send "
                            type="object" class="btn btn-success"
                            confirm="Are you sure you want to send"
                            invisible="state not in ('draft')"/>

                    <button name="action_mark_as_read" string="✓ Mark As read"
                            type="object" class="btn btn-success"
                            confirm="Are you sure you want to mark as read"
                            invisible="state not in ('sent')"/>

					<field name="state" widget="statusbar" force_save="1" readonly="1"/>
                </header>
                <sheet>
                    <!-- ══ HERO HEADER BANNER ══ -->
                    <div class="exp-header-hero">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="exp-hero-ref">
                                    <field name="name" readonly="0" class="d-inline"/>
                                </div>
                                <div class="exp-hero-sub">State</div>
                                <div class="exp-badge-row">
                                    <field name="state" widget="badge"/>
                                </div>
                            </div>
                            <div class="text-end" style="color:rgba(255,255,255,.7); font-size:12px;">
                                <div>
                                     
                                </div>
                                <div style="margin-top:4px;">
                                     
                                </div>
                            </div>
                        </div>
                    </div>
 

                    <!-- ══ CARD: IDENTIFICATION ══ -->
                    <div class="exp-card">
                        <div class="exp-card-header">
                            <div class="exp-card-icon">
                                <svg viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            </div>
                            <span class="exp-card-title">message</span>
                        </div>
                        <div class="exp-card-body">
                            <group col="4">
                                <group col="4"> 
                                    <field name="employee_id" readonly="0"/>
                                    <field name="sender_employee_id" readonly="0"/>
                                    <field name="message" readonly="0"/>
                                    
                                    
                                </group>
                                <div class="exp-divider"/>
                                <group col="4">
                                    <field name="sent_date" readonly="0"/>
                                    <field name="read_date" readonly="1"/> 
                                    <field name="active" readonly="1"/> 
                                    <field name="is_read" readonly="1"/>
                                    <field name="attachment_ids" readonly="1" widget="many2many_tags"/> 
                                    <!-- <field name="state" readonly="1"/> -->
                                    <field name="state" widget="badge"
                                        decoration-warning="state == 'draft'" 
                                        decoration-success="state == 'sent'"
                                        decoration-danger="state == 'read'" 
                                        />  
                                </group>
                            </group>
                        </div>
                    </div> 
                </sheet> 
                <!-- <chatter/> --> 
            </form>
        </field>
    </record>  
    <!-- ══════════════════════════════════════════════════
         MENU
    ══════════════════════════════════════════════════ -->
     
    <!-- Sub-menu: -->
    <menuitem
        id="menu_hr_experience_message"
        name="📂 Messages"
        parent="hr_employee_experience.menu_employee_experience"
        action="action_hr_experience_message"
        sequence="15"/>

         <!-- <record id="cleon_license.menu_hr_experience_video_watch" model="ir.ui.menu">
            <field name="icon_class">fa fa-credit-card</field>
            <field name="category_name">CleonHR-License</field>
        </record> -->
</odoo>
