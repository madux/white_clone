<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_hr_claim" model="ir.sequence">
        <field name="name">Claim</field>
        <field name="code">hr.claim</field>
        <field name="prefix">CLM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_hr_claim_payment" model="ir.sequence">
        <field name="name">Claim Payment</field>
        <field name="code">hr.claim.payment</field>
        <field name="prefix">PAY/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_hr_expense_request" model="ir.sequence">
        <field name="name">Expense Request</field>
        <field name="code">hr.expense.request</field>
        <field name="prefix">REQ/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_hr_cash_advance" model="ir.sequence">
        <field name="name">Cash Advance</field>
        <field name="code">hr.cash.advance</field>
        <field name="prefix">ADV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_hr_expense_payment_batch" model="ir.sequence"><field name="name">Expense Payment Batch</field><field name="code">hr.expense.payment.batch</field><field name="prefix">PB/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="seq_hr_petty_cash_transaction" model="ir.sequence"><field name="name">Petty Cash Transaction</field><field name="code">hr.petty.cash.transaction</field><field name="prefix">PTX/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="seq_hr_petty_cash_reconciliation" model="ir.sequence"><field name="name">Petty Cash Reconciliation</field><field name="code">hr.petty.cash.reconciliation</field><field name="prefix">REC/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="seq_hr_petty_cash_replenishment" model="ir.sequence"><field name="name">Petty Cash Replenishment</field><field name="code">hr.petty.cash.replenishment</field><field name="prefix">REP/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="seq_hr_expense_journal" model="ir.sequence">
        <field name="name">Expense Journal</field>
        <field name="code">hr.expense.journal</field>
        <field name="prefix">EJ/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
