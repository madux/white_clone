    <record id="rule_hr_expense_integration_company" model="ir.rule"><field name="name">Expense integrations: allowed companies</field><field name="model_id" ref="model_hr_expense_integration"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_hr_expense_theme_company" model="ir.rule"><field name="name">Expense themes: allowed companies</field><field name="model_id" ref="model_hr_expense_theme"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
