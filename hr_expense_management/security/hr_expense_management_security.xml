    <record id="rule_hr_expense_scheduled_report_company" model="ir.rule"><field name="name">Scheduled reports: allowed companies</field><field name="model_id" ref="model_hr_expense_scheduled_report"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_hr_cash_advance_writeoff_company" model="ir.rule"><field name="name">Advance write-offs: allowed companies</field><field name="model_id" ref="model_hr_cash_advance_writeoff"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>
