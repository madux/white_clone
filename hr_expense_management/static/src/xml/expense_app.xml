<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
    <t t-name="hr_expense_management.ExpenseKpiCard" owl="1">
        <button class="o_expense_kpi card border-0 text-start h-100 w-100" t-att-class="props.onClick ? 'o_expense_clickable' : ''" t-on-click="click">
            <div class="card-body d-flex align-items-start gap-3">
                <span class="o_expense_kpi_icon" t-att-class="'o_expense_tone_' + (props.tone || 'pink')">
                    <i t-att-class="'fa ' + props.icon"/>
                </span>
                <div class="min-w-0">
                    <div class="small text-uppercase text-muted fw-bold" t-esc="props.label"/>
                    <div class="h2 fw-black mb-0 text-dark" t-esc="props.value"/>
                    <div t-if="props.hint" class="small text-muted text-truncate" t-esc="props.hint"/>
                </div>
            </div>
        </button>
    </t>
    <t t-name="hr_expense_management.ExpenseApp" owl="1">
        <div class="o_expense_app" t-att-class="(state.sidebarCollapsed ? 'o_expense_sidebar_collapsed ' : '') + themeClass" t-att-style="themeStyle">
            <aside class="o_expense_sidebar">
                <div class="o_expense_brand d-flex align-items-center gap-3 px-3 py-3">
                    <span class="o_expense_logo">C</span>
                    <div t-if="!state.sidebarCollapsed" class="min-w-0">
                        <div class="fw-black text-white text-truncate">Expense Management</div>
                        <div class="small text-white-50">Community ERP</div>
                    </div>
                </div>
                <div t-if="!state.sidebarCollapsed" class="px-3 pb-2">
                    <div class="input-group input-group-sm o_expense_module_search">
                        <span class="input-group-text border-0">
                            <i class="fa fa-search"/>
                        </span>
                        <input class="form-control border-0" placeholder="Search modules" t-att-value="state.moduleSearch" t-on-input="updateModuleSearch"/>
                    </div>
                </div>
                <nav class="o_expense_module_nav px-2 py-2">
                    <div t-foreach="modules" t-as="module" t-key="module.key" class="o_expense_module_row d-flex align-items-center">
                        <button class="o_expense_module_btn btn flex-grow-1 d-flex align-items-center gap-3 text-start" t-att-class="state.activeModule === module.key ? 'active' : ''" t-att-title="module.label" t-on-click="() =&gt; this.selectModule(module.key)">
                            <i t-att-class="'fa ' + module.icon"/>
                            <span t-if="!state.sidebarCollapsed" class="flex-grow-1" t-esc="module.label"/>
                        </button>
                        <div t-if="!state.sidebarCollapsed" class="o_expense_module_tools d-flex">
                            <button class="btn btn-sm" t-att-title="state.favoriteModules.includes(module.key) ? 'Remove favorite' : 'Favorite'" t-on-click="() =&gt; this.toggleFavorite(module.key)">
                                <i t-att-class="state.favoriteModules.includes(module.key) ? 'fa fa-star text-warning' : 'fa fa-star-o'"/>
                            </button>
                            <button class="btn btn-sm" title="Move up" t-on-click="() =&gt; this.moveModule(module.key, -1)">
                                <i class="fa fa-angle-up"/>
                            </button>
                            <button class="btn btn-sm" title="Move down" t-on-click="() =&gt; this.moveModule(module.key, 1)">
                                <i class="fa fa-angle-down"/>
                            </button>
                        </div>
                    </div>
                </nav>
                <div class="mt-auto p-2">
                    <button class="btn o_expense_collapse_btn w-100" t-on-click="toggleSidebar">
                        <i t-att-class="state.sidebarCollapsed ? 'fa fa-angle-double-right' : 'fa fa-angle-double-left'"/>
                        <span t-if="!state.sidebarCollapsed" class="ms-2">Collapse</span>
                    </button>
                </div>
            </aside>
            <section class="o_expense_workspace">
                <header class="o_expense_header px-3 px-lg-4 py-3 d-flex align-items-center justify-content-between gap-3">
                    <div class="min-w-0">
                        <div class="small text-muted">
                            <t t-esc="state.data?.company.name || ''"/> / <t t-esc="activeModule?.label || 'Dashboard'"/>
                        </div>
                        <h1 class="h4 fw-black mb-0 text-truncate" t-esc="activePage?.label || activeModule?.label || 'Dashboard'"/>
                    </div>
                    <div class="d-flex align-items-center gap-2 gap-lg-3">
                        <div class="input-group input-group-sm d-none d-lg-flex o_expense_global_search">
                            <span class="input-group-text border-0 bg-light">
                                <i class="fa fa-search"/>
                            </span>
                            <input class="form-control border-0 bg-light" placeholder="Search this page" t-att-value="state.recordSearch" t-on-input="updateRecordSearch"/>
                        </div>
                        <button class="btn btn-light rounded-circle" title="My tasks" t-on-click="openTasks">
                            <i class="fa fa-bell-o"/>
                        </button>
                        <button class="btn btn-light rounded-circle" title="Messages" t-on-click="() =&gt; this.openGlobalAction('mail.action_discuss')">
                            <i class="fa fa-comments-o"/>
                        </button>
                        <button class="btn btn-light rounded-circle" title="Documents" t-on-click="() =&gt; this.openGlobalAction('base.action_attachment')">
                            <i class="fa fa-paperclip"/>
                        </button>
                        <button t-if="!isDashboard and filteredRecords.length" class="btn btn-light rounded-circle" t-att-title="state.sortAscending ? 'Sort descending' : 'Sort ascending'" t-on-click="toggleSort">
                            <i t-att-class="state.sortAscending ? 'fa fa-sort-alpha-asc' : 'fa fa-sort-alpha-desc'"/>
                        </button>
                        <button t-if="!isDashboard and filteredRecords.length" class="btn btn-light rounded-circle" title="Export filtered CSV" t-on-click="exportPage">
                            <i class="fa fa-download"/>
                        </button>
                        <button class="btn btn-light rounded-circle" title="Refresh" t-on-click="refresh">
                            <i class="fa fa-refresh"/>
                        </button>
                        <span class="badge rounded-pill o_expense_role_badge" t-esc="state.data?.role_label || ''"/>
                        <div class="d-none d-md-block text-end">
                            <div class="small fw-bold" t-esc="state.data?.user.name || ''"/>
                            <div class="text-muted" style="font-size: .72rem">Signed in</div>
                        </div>
                    </div>
                </header>
                <div t-if="activeModule?.pages.length &gt; 1" class="o_expense_subnav px-3 px-lg-4">
                    <button t-foreach="activeModule.pages" t-as="page" t-key="page.key" class="btn o_expense_subnav_btn" t-att-class="state.activePage === page.key ? 'active' : ''" t-on-click="() =&gt; this.selectPage(page.key)" t-esc="page.label"/>
                </div>
                <main class="o_expense_content p-3 p-lg-4">
                    <div t-if="state.loading" class="o_expense_state card border-0">
                        <div class="card-body text-center py-5">
                            <span class="spinner-border text-primary"/>
                            <p class="text-muted mt-3 mb-0">Loading your workspace…</p>
                        </div>
                    </div>
                    <div t-elif="state.error" class="o_expense_state card border-0">
                        <div class="card-body text-center py-5">
                            <i class="fa fa-exclamation-triangle fa-2x text-danger"/>
                            <h2 class="h5 mt-3">We could not load Expense Management</h2>
                            <button class="btn btn-primary mt-2" t-on-click="refresh">Try again</button>
                        </div>
                    </div>
                    <t t-elif="isDashboard">
                        <t t-call="hr_expense_management.ExpenseDashboardPage"/>
                    </t>
                    <t t-elif="moduleView === 'claims'">
                        <t t-call="hr_expense_management.ExpenseClaimsPage"/>
                    </t>
                    <t t-elif="moduleView === 'requests'">
                        <t t-call="hr_expense_management.ExpenseRequestsPage"/>
                    </t>
                    <t t-elif="moduleView === 'advances'">
                        <t t-call="hr_expense_management.ExpenseAdvancesPage"/>
                    </t>
                    <t t-elif="moduleView === 'workflow'">
                        <t t-call="hr_expense_management.ExpenseWorkflowPage"/>
                    </t>
                    <t t-elif="moduleView === 'payments'">
                        <t t-call="hr_expense_management.ExpensePaymentsPage"/>
                    </t>
                    <t t-elif="moduleView === 'petty_cash'">
                        <t t-call="hr_expense_management.ExpensePettyCashPage"/>
                    </t>
                    <t t-elif="moduleView === 'accounts'">
                        <t t-call="hr_expense_management.ExpenseAccountsPage"/>
                    </t>
                    <t t-elif="moduleView === 'vendors'">
                        <t t-call="hr_expense_management.ExpenseVendorsPage"/>
                    </t>
                    <t t-elif="moduleView === 'budget'">
                        <t t-call="hr_expense_management.ExpenseBudgetPage"/>
                    </t>
                    <t t-elif="moduleView === 'governance'">
                        <t t-call="hr_expense_management.ExpenseGovernancePage"/>
                    </t>
                    <t t-else="">
                        <div class="card o_expense_panel">
                            <div class="card-body text-center py-5">
                                <span class="o_expense_large_icon">
                                    <i class="fa fa-lock"/>
                                </span>
                                <h3 class="h5 fw-bold mt-3">Page unavailable</h3>
                                <p class="text-muted mb-0">Your current role cannot load this page.</p>
                            </div>
                        </div>
                    </t>
                    <div t-if="!isDashboard and featureChartRows.length" class="card o_expense_panel mt-4">
                        <div class="card-body">
                            <h3 class="h6 fw-black mb-1">Analytics</h3>
                            <p class="small text-muted">Live totals for the current page and allowed company records</p>
                            <div class="o_expense_chart">
                                <canvas t-ref="pageChart"/>
                            </div>
                        </div>
                    </div>
                    <div t-if="filteredRecords.length &gt; state.pageSize" class="d-flex align-items-center justify-content-between mt-3 px-2">
                        <span class="small text-muted">Page <t t-esc="state.page"/> of <t t-esc="pageCount"/> · <t t-esc="filteredRecords.length"/> records</span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-light" t-att-disabled="state.page &lt;= 1" t-on-click="() =&gt; this.changePage(-1)">
                                <i class="fa fa-chevron-left me-1"/>Previous</button>
                            <button class="btn btn-light" t-att-disabled="state.page &gt;= pageCount" t-on-click="() =&gt; this.changePage(1)">Next<i class="fa fa-chevron-right ms-1"/>
                            </button>
                        </div>
                    </div>
                </main>
            </section>
            <t t-call="hr_expense_management.ExpenseDrawer"/>
            <t t-call="hr_expense_management.ExpenseModalShell"/>
        </div>
    </t>
</templates>
