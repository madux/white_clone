<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_expense_account_tree" model="ir.ui.view">
        <field name="name">hr.expense.account.list</field>
        <field name="model">hr.expense.account</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="account_type"/>
                <field name="subtype"/>
                <field name="parent_id" optional="show"/>
                <field name="is_header"/>
                <field name="debit" sum="Debit" optional="hide"/>
                <field name="credit" sum="Credit" optional="hide"/>
                <field name="balance" sum="Balance"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>
    <record id="view_hr_expense_account_form" model="ir.ui.view">
        <field name="name">hr.expense.account.form</field>
        <field name="model">hr.expense.account</field>
        <field name="arch" type="xml">
            <form string="Expense Account">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="code"/><field name="account_type"/><field name="subtype"/></group>
                        <group><field name="parent_id"/><field name="is_header"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/></group>
                    </group>
                    <group string="Posted Balance" invisible="not id">
                        <field name="debit"/><field name="credit"/><field name="balance"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hr_expense_accounts" model="ir.actions.act_window">
        <field name="name">Chart of Accounts</field><field name="res_model">hr.expense.account</field><field name="view_mode">tree,form</field>
    </record>

    <record id="view_hr_expense_gl_map_tree" model="ir.ui.view">
        <field name="name">hr.expense.gl.map.list</field><field name="model">hr.expense.gl.map</field>
        <field name="arch" type="xml"><tree><field name="sequence" widget="handle"/><field name="name"/><field name="source_type"/><field name="claim_category_id" optional="show"/><field name="debit_account_id"/><field name="credit_account_id"/><field name="active" widget="boolean_toggle"/><field name="company_id" groups="base.group_multi_company"/></tree></field>
    </record>
    <record id="view_hr_expense_gl_map_form" model="ir.ui.view">
        <field name="name">hr.expense.gl.map.form</field><field name="model">hr.expense.gl.map</field>
        <field name="arch" type="xml"><form string="GL Mapping"><sheet><field name="company_id" invisible="1"/><group><group><field name="name"/><field name="source_type"/><field name="claim_category_id"/><field name="sequence"/></group><group><field name="debit_account_id"/><field name="credit_account_id"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/></group></group></sheet></form></field>
    </record>
    <record id="action_hr_expense_gl_maps" model="ir.actions.act_window">
        <field name="name">GL Mapping</field><field name="res_model">hr.expense.gl.map</field><field name="view_mode">tree,form</field>
    </record>

    <record id="view_hr_expense_journal_tree" model="ir.ui.view">
        <field name="name">hr.expense.journal.list</field><field name="model">hr.expense.journal</field>
        <field name="arch" type="xml"><tree decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="date"/><field name="description"/><field name="source_reference" optional="show"/><field name="total_debit" sum="Debit"/><field name="total_credit" sum="Credit"/><field name="balanced"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></tree></field>
    </record>
    <record id="view_hr_expense_journal_form" model="ir.ui.view">
        <field name="name">hr.expense.journal.form</field><field name="model">hr.expense.journal</field>
        <field name="arch" type="xml">
            <form string="Expense Journal">
                <header><button name="action_post" type="object" string="Post" class="oe_highlight" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header>
                <sheet><field name="company_id" invisible="1"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="date"/><field name="description"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="source_reference" readonly="1"/><field name="posted_by_id"/><field name="posted_date"/></group></group>
                    <field name="line_ids" readonly="state != 'draft'"><tree editable="bottom"><field name="company_id" column_invisible="True"/><field name="account_id"/><field name="label"/><field name="department_id" optional="hide"/><field name="employee_id" optional="hide"/><field name="vendor_id" optional="hide"/><field name="debit" sum="Debit"/><field name="credit" sum="Credit"/></tree></field>
                    <group class="oe_subtotal_footer oe_right"><field name="total_debit"/><field name="total_credit"/><field name="balanced"/></group>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="action_hr_expense_journals" model="ir.actions.act_window">
        <field name="name">Expense Journals</field><field name="res_model">hr.expense.journal</field><field name="view_mode">tree,form</field>
    </record>
</odoo>
