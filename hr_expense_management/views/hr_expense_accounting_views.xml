<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hr_expense_accounts" model="ir.actions.act_window">
        <field name="name">Chart of Accounts</field>
        <field name="res_model">account.account</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="view_hr_expense_gl_map_tree" model="ir.ui.view">
        <field name="name">hr.expense.gl.map.list</field>
        <field name="model">hr.expense.gl.map</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="source_type"/>
                <field name="claim_category_id" optional="show"/>
                <field name="journal_id"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_expense_gl_map_form" model="ir.ui.view">
        <field name="name">hr.expense.gl.map.form</field>
        <field name="model">hr.expense.gl.map</field>
        <field name="arch" type="xml">
            <form string="Accounting Mapping">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="source_type"/>
                            <field name="claim_category_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="debit_account_id"/>
                            <field name="credit_account_id"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_expense_gl_maps" model="ir.actions.act_window">
        <field name="name">Accounting Mapping</field>
        <field name="res_model">hr.expense.gl.map</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_hr_expense_journals" model="ir.actions.act_window">
        <field name="name">Expense Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form,activity</field>
        <field name="domain">[('move_type', '=', 'entry'), ('expense_source_model', '!=', False)]</field>
        <field name="context">{'default_move_type': 'entry', 'view_no_maturity': True}</field>
    </record>
</odoo>
