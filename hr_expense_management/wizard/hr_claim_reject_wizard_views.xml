<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_claim_reject_wizard_form" model="ir.ui.view">
        <field name="name">hr.claim.reject.wizard.form</field>
        <field name="model">hr.claim.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Claim Decision">
                <group>
                    <field name="claim_id"/>
                    <field name="decision"/>
                    <field name="reason" placeholder="Explain the decision to the employee..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

