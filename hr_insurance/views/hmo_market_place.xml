<?xml version="1.0" encoding="utf-8"?>
<odoo>

    
    <!-- ══════════════════════════════════════════════════
         TREE / LIST VIEW
    ══════════════════════════════════════════════════ -->
    <record id="view_hmo_marketplace_tree" model="ir.ui.view">
        <field name="name">hmo.marketplace.tree</field>
        <field name="model">hmo.marketplace</field>
        <field name="arch" type="xml">
            <tree
                string="Marketplace"
                decoration-muted="is_registered == False"
                decoration-success="is_registered"
                multi_edit="1"
                class="o_qms_list">

                <field name="name" string="Name" optional="show"/>
                <field name="is_registered" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         SEARCH VIEW
    ══════════════════════════════════════════════════ -->
    <record id="view_hmo_marketplace_search" model="ir.ui.view">
        <field name="name">hmo.marketplace.search</field>
        <field name="model">hmo.marketplace</field>
        <field name="arch" type="xml">
            <search string="Marketplace search">
                <field name="name" string="Reference"/>
                <field name="is_registered"/>
                <field name="total_hospital"/>
                <filter string="Registered" name="is_registered" domain="[('is_registered','=', True)]"/>
                <filter string="Not Registered" name="is_registered" domain="[('is_registered','=', False)]"/>
                <separator/>
                <!-- <filter string="My Requests" name="my_requests"
                        domain="[('responsible_id','=',uid)]"/> -->
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         FORM VIEW  — Modern Card-based UI
    ══════════════════════════════════════════════════ -->
    <record id="view_hmo_marketplace_form" model="ir.ui.view">
        <field name="name">hmo.marketplace.form</field>
        <field name="model">hmo.marketplace</field>
        <field name="arch" type="xml">
            <form string="HMO Market Place" class="o_qms_form">
                <div class="o_hr_dashboard_layout">

                    <!-- SIDEBAR -->
                    <aside class="hd-sidebar">
                        <div class="hd-sb-brand">
                            <div class="hd-sb-mark">
                                <i class="fa fa-user"/>
                            </div>
                            <div>
                                <div class="hd-brand-name">HR Admin</div>
                                <div class="hd-brand-sub">Workforce Management</div>
                            </div>
                        </div>

                        <nav class="hd-sb-nav">
                            <div class="hd-nav-label">Main</div>

                            <a href="#" class="hd-nl active">
                                <i class="fa fa-th-large"/>
                                Dashboard
                            </a>

                            <a type="action" name="%(hr_administration.action_view_employee_kanban_custom)d" class="hd-nl">
                                <i class="fa fa-users"/>
                                Employees
                                <span class="hd-nl-badge">24</span>
                            </a>

                            <a type="action" name="hr_insurance.action_hmo_marketplace" class="hd-nl">
                                <i class="fa fa-shopping-cart"/>
                                HMO Marketplace
                                <span class="hd-nl-badge">-</span>
                            </a>

                            <a type="action" name="hr_insurance.action_hmo_marketplace" class="hd-nl">
                                <i class="fa fa-building"/>
                                Company HMO
                                <span class="hd-nl-badge">-</span>
                            </a>

                            <a type="action" name="hr_insurance.action_hmo_hospital" class="hd-nl">
                                <i class="fa fa-h-square"/>
                                Hospital Listing
                                <span class="hd-nl-badge">-</span>
                            </a>

                            <a type="action" name="hr_insurance.action_hmo_enrollment" class="hd-nl">
                                <i class="fa fa-check-circle"/>
                                Approvals
                                <span class="hd-nl-badge">-</span>
                            </a>

                            <a type="action" name="hr_insurance.action_hmo_tree_checklist" class="hd-nl">
                                <i class="fa fa-map-marker"/>
                                Checklist
                                <span class="hd-nl-badge">-</span>
                            </a>

                            <a type="action" name="hr_insurance.action_hmo_marketplace" class="hd-nl">
                                <i class="fa fa-bar-chart"/>
                                Reports
                                <span class="hd-nl-badge">-</span>
                            </a>

                            <a type="action" name="hr_insurance.action_hmo_tree_checklist" class="hd-nl">
                                <i class="fa fa-cog"/>
                                Settings
                                <span class="hd-nl-badge">-</span>
                            </a>

                            <a type="action" name="hr_insurance.action_hmo_marketplace" class="hd-nl">
                                <i class="fa fa-list-alt"/>
                                Audit Logs
                                <span class="hd-nl-badge">-</span>
                            </a>
                        </nav>

                        <div class="hd-sb-footer">
                            <div class="hd-user-card">
                                <div class="hd-user-av">HR</div>
                                <div>
                                    <div class="hd-user-name">Administrator</div>
                                    <div class="hd-user-role">HR Administrator</div>
                                </div>
                            </div>
                        </div>

                    </aside>

                    <!-- MAIN CONTENT -->
                    <div class="hd-main">
                 
                    <sheet>
                        
                        <!-- ══ HERO HEADER BANNER ══ -->
                        <div class="qms-header-hero">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="qms-hero-ref">
                                        <field name="name" readonly="1" class="d-inline"/>
                                    </div>
                                    <div class="qms-hero-sub">HMO MarketPlace</div>
                                    <div class="qms-badge-row">
                                        <field name="is_registered" widget="boolean_toggle"/>
                                    </div>
                                </div>
                                <div class="text-end" style="color:rgba(255,255,255,.7); font-size:12px;">
                                    <div style="margin-top:4px;">
                                        Responsible: <field name="create_uid" readonly="1"
                                                            style="color:#FFC940; font-weight:600;"/></div>
                                                        
                                    
                                </div>
                            </div>
                        </div>

                        <!-- ══ KPI STRIP ══ -->
                        <div class="qms-kpi-strip">
                            <div class="qms-kpi-box">
                                <div class="qms-kpi-label">Hospitals</div>
                                <div class="qms-kpi-value">
                                    <field name="total_hospital" readonly="1"/>
                                </div>
                            </div>
                            <div class="qms-kpi-box">
                                <div class="qms-kpi-label">Employees</div>
                                <div class="qms-kpi-value">
                                    <field name="total_employee"/>
                                </div>
                            </div>
                            <div class="qms-kpi-box kpi-info">
                                <div class="qms-kpi-label">Expiry date</div>
                                <div class="qms-kpi-value">
                                    <field name="date_expiry" readonly="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="qms-card">
                            <div class="qms-card-header">
                                <div class="qms-card-icon">
                                    <svg viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                </div>
                                <span class="qms-card-title">Details</span>
                            </div>
                            <div class="qms-card-body">
                                <group>
                                    <group>
                                        <field name="name" placeholder="Add description" readonly="0"/>
                                        <field name="email" placeholder="Madukachris@gmail.com" readonly="0"/>
                                        <field name="phone" placeholder="+234902929999" readonly="0" size="14" widget="phone"/>
                                        <field name="street" placeholder="No 92 Godwin Maduka Street" readonly="0"/>
                                        <field name="country_id" readonly="0" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                                        <field name="state_id" readonly="0" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                                    </group>
                                    <group>
                                        <field name="hmo_tag_ids" string="Coverage type" widget="many2many_tags"/>
                                        <field name="hmo_tag_ids" string="Coverage type" widget="many2many_tags"/>
                                        <field name="date_expiry"/>
                                    </group>
                                </group>
                                <group>
                                    <group>
                                        <field name="start_date" readonly="0" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                                        <field name="years_of_operation" readonly="0" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                                    </group>
                                    <group>
                                        <field name="service_area_ids" string="Service Areas" widget="many2many_tags"/>
                                        <!-- <field name="insurance_benefits" widget="many2many_avatar"/> -->
                                        <field name="insurance_benefits" widget="insurance_benefits"/>
                                    </group>
                                </group>
                            </div>
                        </div> 

                        <!-- ══ NOTEBOOKS / TABS ══ -->
                        <notebook> 
                            <page string="🏢 Hospital Network" name="hospital_line">
                                <div class="qms-card" style="margin-bottom:0;">
                                    <div class="qms-card-header">
                                        <div class="qms-card-icon" style="background:#DC3545;">
                                            <svg viewBox="0 0 24 24"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                                        </div>
                                        <span class="qms-card-title">Section line</span>
                                    </div>
                                    <div class="qms-card-body" style="padding:0;">
                                        <field name="hmo_hospital_ids"
                                            widget="many2many">
                                            <tree editable="bottom">
                                                <field name="hospital_name" readonly="0"/>
                                                <field name="hospital_no" optional="show" readonly="1"/>
                                                <field name="phone" readonly="0"/>
                                                <field name="email" readonly="0"/>
                                                <field name="street" readonly="0" optional="show"/>
                                                <field name="state_id" readonly="0" optional="show"/>
                                            </tree>
                                        </field>
                                    </div>
                                </div>
                                
                            </page>

                            <page string="📝 Enrolled Employee" name="employees">
                                <field name="hmo_employee_ids"
                                        widget="many2many" readonly="0">
                                    <tree>
                                        <field name="name"/>
                                        <field name="work_email" string="Email" optional="show" readonly="0"/>
                                        <field name="work_phone" string="Phone" optional="show" readonly="0"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="💰 Plans &amp; Pricing" name="plans">
                                <field name="hmo_plan_ids" readonly="0">
                                    <tree>
                                        <field name="name"/>
                                        <field name="hmo_marketplace_id" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                                        <field name="hmo_plan_value_ids" widget="many2many_tags" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                                        <field name="plan_price"/>
                                        <field name="max_person"/>

                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </div>
                </div>
                <!-- ── Chatter ── -->
                <!-- <chatter/> -->
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         ACTION
    ══════════════════════════════════════════════════ -->
    <record id="action_hmo_marketplace" model="ir.actions.act_window">
        <field name="name">HMO Market place</field>
        <field name="res_model">hmo.marketplace</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_hmo_marketplace_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No HMO found
            </p>
            <p>
                Create a new HMO
            </p>
        </field>
    </record> 

    <record id="view_hmo_marketplace_kanban" model="ir.ui.view">
    <field name="name">hmo.marketplace.kanban</field>
    <field name="model">hmo.marketplace</field>

    <field name="arch" type="xml">

        <kanban class="o_hmo_marketplace_kanban" create="1" records_draggable="0">

            <field name="name"/>
            <field name="street"/>
            <field name="phone"/>
            <field name="email"/>
            <field name="state_id"/>
            <field name="total_hospital"/>
            <field name="hmo_tag_ids"/>
            <field name="hmo_plan_ids"/>
            <field name="code"/>

            <!-- STATIC HEADER (unchanged) -->
            <header>
                <div class="marketplace-header">
                    <div class="topbar">
                        <div>
                            <h1>HMO Marketplace</h1>
                            <p>Browse and compare health insurance providers</p>
                        </div>
                        <div class="top-actions">
                            <button type="object" name="not_open_button" class="btn-hmo btn-primary-hmo">＋ Onboard Your HMO</button>
                            <button type="object" name="not_open_button" class="btn-hmo btn-outline-hmo">⤴ Bulk Upload</button>
                            <button name="not_open_button" type="object" class="btn-hmo btn-light-hmo">🛡 Take Tour</button>
                        </div>
                    </div>
                    <div class="toolbar">
                        <div class="search-box">🔍</div>
                        <div class="toolbar-actions">
                            <button name="not_open_button" type="object" class="icon-btn active">▦</button>
                            <button name="not_open_button" type="object" class="icon-btn">☰</button>
                        </div>
                    </div>
                </div>
            </header>

            <!-- CARD TEMPLATE -->
            <templates>
                <t t-name="kanban-box">

                    <div class="oe_kanban_card ins_provider_card">

                        <!-- Top row: avatar, name/contact, verified badge -->
                        <div class="ins_card_top">

                            <div class="ins_avatar ins_avatar_pink">
                                <t t-esc="record.code.value or (record.name.value and record.name.value.substring(0,2).toUpperCase())"/>
                            </div>

                            <div class="ins_provider_info">
                                <h3 class="ins_provider_name">
                                    <field name="name" readonly="1"/>
                                </h3>

                                <p class="ins_contact_line">
                                    <i class="fa fa-map-marker ins_contact_icon"/>
                                    <field name="street" readonly="1"/><t t-if="record.state_id.value">, <field name="state_id" readonly="1"/></t>
                                </p>

                                <p class="ins_contact_line">
                                    <i class="fa fa-phone ins_contact_icon"/>
                                    <field name="phone" readonly="1"/>
                                </p>

                                <p class="ins_contact_line">
                                    <i class="fa fa-envelope ins_contact_icon"/>
                                    <field name="email" readonly="1"/>
                                </p>
                            </div>

                            <div class="ins_verified_badge" title="Verified provider">
                                <i class="fa fa-check-circle"/>
                            </div>

                        </div>

                        <!-- Tags: category tags (blue) + plan tags (purple) -->
                        <div class="ins_tags_row">
                            <div class="ins_tag_group ins_tag_group_type">
                                <field name="hmo_tag_ids" widget="many2many_tags" readonly="1"/>
                            </div>
                            <div class="ins_tag_group ins_tag_group_plan">
                                <field name="hmo_plan_ids" widget="many2many_tags" readonly="1"/>
                            </div>
                        </div>

                        <div class="ins_divider"/>

                        <!-- Footer -->
                        <div class="ins_card_footer">
                            <span class="ins_hospital_count">
                                <i class="fa fa-hospital-o ins_contact_icon"/>
                                <field name="total_hospital" readonly="1"/> hospitals
                            </span>

                            <button name="open_action_hmo_marketplace" type="object" class="ins_view_details_btn">
                                View Details
                            </button>
                        </div>

                    </div>

                </t>
            </templates>

        </kanban>

    </field>
</record>
    

