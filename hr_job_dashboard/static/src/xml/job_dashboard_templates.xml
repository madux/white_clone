    <t t-name="hr_job_dashboard.JobSideBar">
    <div class="jobsidebar">
        <div class="o_cc_sidebar_header">
            <span class="o_cc_header_dot"/>
            <span class="o_cc_header_title">Job Management</span>
            <button class="btn btn-sm o_cc_collapse_btn" title="Collapse sidebar" t-on-click="onCollapse">
                <i class="fa fa-th-large"/>
            </button>
        </div>
        <nav class="o_cc_nav">
            <a class="o_cc_nav_item" t-att-class="isActive('dashboard') ? 'o_cc_nav_active' : ''" t-on-click="openDashboard">
                <span class="o_cc_nav_icon"><i class="fa fa-calendar"/></span>
                <span class="o_cc_nav_label">Dashboard</span>
            </a>
            <a class="o_cc_nav_item" t-att-class="isActive('get_started') ? 'o_cc_nav_active' : ''" t-on-click="openGetStarted">
                <span class="o_cc_nav_icon"><i class="fa fa-comment-o"/></span>
                <span class="o_cc_nav_label">Get Started</span>
                <i class="fa fa-chevron-right o_cc_nav_arrow"/>
            </a>
            <a class="o_cc_nav_item" t-att-class="isActive('jobs') ? 'o_cc_nav_active' : ''" t-on-click="openJobs">
                <span class="o_cc_nav_icon"><i class="fa fa-briefcase"/></span>
                <span class="o_cc_nav_label">Jobs</span>
            </a>
            <a class="o_cc_nav_item" t-att-class="isActive('candidates') ? 'o_cc_nav_active' : ''" t-on-click="openCandidates">
                <span class="o_cc_nav_icon"><i class="fa fa-users"/></span>
                <span class="o_cc_nav_label">Candidates</span>
                <span class="o_cc_nav_badge">1</span>
                <i class="fa fa-chevron-right o_cc_nav_arrow"/>
            </a>
            <ul>
                <li>
                    <a class="o_cc_nav_item" t-att-class="isActive('offers_hired') ? 'o_cc_nav_active' : ''" t-on-click="openOffersHired">
                        <span class="o_cc_nav_icon"><i class="fa fa-check-circle"/></span>
                        <span class="o_cc_nav_label">Offers and Hired</span>
                    </a>
                </li>
                <li>
                    <a class="o_cc_nav_item" t-att-class="isActive('vendors') ? 'o_cc_nav_active' : ''" t-on-click="openVendors">
                        <span class="o_cc_nav_icon"><i class="fa fa-store"/></span>
                        <span class="o_cc_nav_label">Vendors</span>
                    </a>
                </li>
            </ul>
            <p class="sidebar-section-label">Workflow</p>
            <ul>
                <a class="o_cc_nav_item" t-att-class="isActive('requisition') ? 'o_cc_nav_active' : ''" t-on-click="openRequisition">
                    <span class="o_cc_nav_icon"><i class="sidebar-nav-icon fa fa-shirtsinbulk"/></span>
                    <span class="o_cc_nav_label">Requisition</span>
                </a>
                <a class="o_cc_nav_item" t-att-class="isActive('cbt_test') ? 'o_cc_nav_active' : ''" t-on-click="openCbtTest">
                    <span class="o_cc_nav_icon"><i class="fa fa-bar-chart"/></span>
                    <span class="o_cc_nav_label">CBT Test</span>
                </a>
                <a class="o_cc_nav_item" t-att-class="isActive('talent_mobility') ? 'o_cc_nav_active' : ''" t-on-click="openTalentMobility">
                    <span class="o_cc_nav_icon"><i class="sidebar-nav-icon fa fa-grav"/></span>
                    <span class="o_cc_nav_label">Talent Mobility</span>
                </a>
                <a class="o_cc_nav_item" t-att-class="isActive('settings') ? 'o_cc_nav_active' : ''" t-on-click="openSettings">
                    <span class="o_cc_nav_icon"><i class="fa fa-cog"/></span>
                    <span class="o_cc_nav_label">Settings</span>
                </a>
            </ul>
        </nav>
        <div class="o_cc_sidebar_footer">
            <span class="o_cc_footer_label">Solution By MaachSoft</span>
            <div class="o_cc_footer_status">
                <span class="o_cc_status_dot o_cc_status_green"/>
                All integrations active
            </div>
        </div>
    </div>
</t>

    <!-- ============================ JobDashboard (root) ============================ -->
    <t t-name="hr_job_dashboard.JobDashboard">
        
        <div class="jobapp">
            <JobSideBar activeSection="state.activeSection" onNavigate.bind="onSidebarNavigate"/>
            <div class="jd-dashboard">
                <div t-if="state.loading" class="jd-loading">Loading job dashboard…</div>
                <t t-else="">
                    <JobHeader job="state.job" activeTab="state.activeTab"
                            onTabChange.bind="onTabChange" onBack.bind="onBack" onAddCandidate.bind="onAddCandidate"/>

                    <div class="jd-grid jd-grid--two">
                        <JobHealthScore score="state.health.score" candidates="state.health.candidates" daysOpen="state.health.daysOpen"/>
                        <JobTimeline postedDaysAgo="state.timeline.postedDaysAgo"
                                    totalCandidates="state.timeline.totalCandidates"
                                    daysToClose="state.timeline.daysToClose"/>
                    </div>

                    <div class="jd-grid jd-grid--pipeline">
                        <PipelineOverview stages="state.pipeline"/>
                        <CleonAIPanel candidateCount="state.job.candidateCount"
                                    interviewCount="0"
                                    onAction.bind="onCleonAction"/>
                    </div>

                    <div class="jd-grid jd-grid--two">
                        <HiringTeam members="state.team"/>
                        <RecentActivity activities="state.activity"/>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
