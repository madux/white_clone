<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ============================ JobHeader ============================ -->
    <t t-name="hr_job_dashboard.JobHeader">
        <div class="jd-header">
            <div class="jd-header__top">
                <button class="jd-back-btn" t-on-click="() => this.props.onBack &amp;&amp; this.props.onBack()">
                    <i class="fa fa-arrow-left"/> Back
                </button>
                <div class="jd-job-avatar"><i class="fa fa-building"/></div>
                <h2 class="jd-job-title" t-esc="props.job.name"/>
                <span class="jd-badge" t-att-class="props.job.published ? 'jd-badge--published' : 'jd-badge--draft'">
                    <i class="fa fa-check-circle"/>
                    <t t-esc="props.job.published ? 'Published' : 'Draft'"/>
                </span>
                <span class="jd-meta">
                    · <t t-esc="props.job.department"/>
                    · <t t-esc="props.job.city"/>
                    · <t t-esc="props.job.candidateCount"/> Candidates
                    · <t t-esc="props.job.daysOpen"/> days open
                </span>
                <div class="jd-header__actions">
                    <button class="jd-icon-btn" title="List view"><i class="fa fa-list"/></button>
                    <button class="jd-icon-btn" title="Grid view"><i class="fa fa-th"/></button>
                    <button class="jd-add-candidate-btn" t-on-click="() => this.props.onAddCandidate &amp;&amp; this.props.onAddCandidate()">
                        <i class="fa fa-user-plus"/> Add Candidate
                    </button>
                </div>
            </div>

            <div class="jd-tabs">
                <button t-foreach="tabs" t-as="tab" t-key="tab.key"
                        class="jd-tab"
                        t-att-class="isActive(tab.key) ? 'jd-tab--active' : ''"
                        t-on-click="() => this.props.onTabChange(tab.key)">
                    <i t-attf-class="fa {{tab.icon}}"/>
                    <t t-esc="tab.label"/>
                </button>
            </div>
        </div>
    </t>

    <!-- ========================= JobHealthScore ========================= -->
    <t t-name="hr_job_dashboard.JobHealthScore">
        <div class="jd-card jd-health-card">
            <div class="jd-card__header">
                <h3 class="jd-card__title">Job Health Score</h3>
                <i class="fa fa-heartbeat jd-card__header-icon"/>
            </div>
            <div class="jd-health-gauge">
                <canvas t-ref="gaugeCanvas"/>
                <div class="jd-health-gauge__center">
                    <span class="jd-health-gauge__score" t-esc="props.score"/>
                    <span class="jd-health-gauge__label">Score</span>
                </div>
            </div>
            <div class="jd-health-stats">
                <div class="jd-health-stat">
                    <span class="jd-health-stat__label">Candidates</span>
                    <span class="jd-health-stat__value" t-esc="props.candidates"/>
                </div>
                <div class="jd-health-stat">
                    <span class="jd-health-stat__label">Days Open</span>
                    <span class="jd-health-stat__value" t-esc="props.daysOpen"/>
                </div>
            </div>
        </div>
    </t>

    <!-- ============================ JobTimeline ============================ -->
    <t t-name="hr_job_dashboard.JobTimeline">
        <div class="jd-card jd-timeline-card">
            <div class="jd-card__header">
                <h3 class="jd-card__title">Job Timeline</h3>
                <i class="fa fa-calendar jd-card__header-icon"/>
            </div>
            <div class="jd-timeline-list">
                <div class="jd-timeline-item">
                    <div class="jd-timeline-item__rail">
                        <div class="jd-timeline-item__icon jd-timeline-item__icon--posted"><i class="fa fa-check"/></div>
                        <div class="jd-timeline-item__connector"/>
                    </div>
                    <div class="jd-timeline-item__content jd-timeline-item__content--posted">
                        <p class="jd-timeline-item__label">Job Posted</p>
                        <p class="jd-timeline-item__meta jd-timeline-item__meta--posted" t-esc="postedLabel"/>
                    </div>
                </div>
                <div class="jd-timeline-item">
                    <div class="jd-timeline-item__rail">
                        <div class="jd-timeline-item__icon jd-timeline-item__icon--applicants"><i class="fa fa-users"/></div>
                        <div class="jd-timeline-item__connector"/>
                    </div>
                    <div class="jd-timeline-item__content jd-timeline-item__content--applicants">
                        <p class="jd-timeline-item__label">First Applicants</p>
                        <p class="jd-timeline-item__meta jd-timeline-item__meta--applicants" t-esc="candidatesLabel"/>
                    </div>
                </div>
                <div class="jd-timeline-item">
                    <div class="jd-timeline-item__rail">
                        <div class="jd-timeline-item__icon jd-timeline-item__icon--target"><i class="fa fa-bullseye"/></div>
                    </div>
                    <div class="jd-timeline-item__content jd-timeline-item__content--target">
                        <p class="jd-timeline-item__label">Target Close Date</p>
                        <p class="jd-timeline-item__meta jd-timeline-item__meta--target" t-esc="closeLabel"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- ========================= PipelineOverview ========================= -->
    <t t-name="hr_job_dashboard.PipelineOverview">
        <div class="jd-card jd-pipeline-card">
            <div class="jd-card__header">
                <h3 class="jd-card__title">Pipeline Overview</h3>
                <i class="fa fa-columns jd-card__header-icon"/>
            </div>
            <div class="jd-pipeline-chart">
                <canvas t-ref="barCanvas"/>
            </div>
            <div class="jd-pipeline-legend">
                <div class="jd-pipeline-legend__item" t-foreach="props.stages" t-as="stage" t-key="stage.label">
                    <span class="jd-pipeline-legend__count" t-esc="stage.count"/>
                    <span class="jd-pipeline-legend__label" t-esc="stage.label"/>
                </div>
            </div>
        </div>
    </t>

    <!-- ============================ CleonAIPanel ============================ -->
    <t t-name="hr_job_dashboard.CleonAIPanel">
        <div class="jd-card jd-cleon-card">
            <div class="jd-cleon-header">
                <i class="fa fa-magic"/>
                <span class="jd-cleon-title">CleonAI</span>
                <span class="jd-cleon-live">LIVE</span>
            </div>
            <button class="jd-cleon-item" t-on-click="() => this.onActionClick('rank_candidates')">
                <div class="jd-cleon-item__text">
                    <span class="jd-cleon-item__title"><i class="fa fa-star"/> Rank All Candidates</span>
                    <span class="jd-cleon-item__sub" t-esc="props.candidateCount + ' candidates · AI scoring'"/>
                </div>
                <i class="fa fa-line-chart"/>
            </button>
            <button class="jd-cleon-item" t-on-click="() => this.onActionClick('bias_audit')">
                <div class="jd-cleon-item__text">
                    <span class="jd-cleon-item__title"><i class="fa fa-balance-scale"/> Run JD Bias Audit</span>
                    <span class="jd-cleon-item__sub">Scan job description for exclusionary language</span>
                </div>
            </button>
            <button class="jd-cleon-item" t-on-click="() => this.onActionClick('detect_duplicates')">
                <div class="jd-cleon-item__text">
                    <span class="jd-cleon-item__title"><i class="fa fa-clone"/> Detect Duplicate Applicants</span>
                    <span class="jd-cleon-item__sub">Find candidates who applied multiple times</span>
                </div>
            </button>
            <button class="jd-cleon-item" t-on-click="() => this.onActionClick('pipeline_insight')">
                <div class="jd-cleon-item__text">
                    <span class="jd-cleon-item__title"><i class="fa fa-bar-chart"/> Pipeline Insight</span>
                    <span class="jd-cleon-item__sub"
                          t-esc="props.candidateCount + ' applicants · ' + props.interviewCount + ' in interview · CleonAI recommends shortlisting top ' + props.shortlistSize"/>
                </div>
            </button>
            <div class="jd-cleon-footer">Powered by CleonAI</div>
        </div>
    </t>

    <!-- ============================ HiringTeam ============================ -->
    <t t-name="hr_job_dashboard.HiringTeam">
        <div class="jd-card jd-team-card">
            <div class="jd-card__header">
                <h3 class="jd-card__title">Hiring Team</h3>
                <i class="fa fa-users jd-card__header-icon"/>
            </div>
            <div class="jd-team-list">
                <div class="jd-team-member" t-foreach="props.members" t-as="member" t-key="member.id">
                    <div class="jd-team-avatar" t-attf-style="background:{{member.color}}" t-esc="member.initials"/>
                    <div class="jd-team-member__text">
                        <span class="jd-team-member__name" t-esc="member.name"/>
                        <span class="jd-team-member__role" t-esc="member.role"/>
                    </div>
                    <span class="jd-team-status" t-att-class="member.online ? 'jd-team-status--online' : 'jd-team-status--offline'"/>
                </div>
                <div t-if="!props.members.length" class="jd-empty">No team members assigned yet</div>
            </div>
        </div>
    </t>

    <!-- ============================ RecentActivity ============================ -->
    <t t-name="hr_job_dashboard.RecentActivity">
        <div class="jd-card jd-activity-card">
            <div class="jd-card__header">
                <h3 class="jd-card__title">Recent Activity</h3>
                <i class="fa fa-heartbeat jd-card__header-icon"/>
            </div>
            <div class="jd-activity-list">
                <div class="jd-activity-item" t-foreach="props.activities" t-as="act" t-key="act.id">
                    <div class="jd-activity-icon" t-att-class="act.colorClass">
                        <i t-attf-class="fa {{act.icon}}"/>
                    </div>
                    <div class="jd-activity-item__text">
                        <span class="jd-activity-item__title" t-esc="act.title"/>
                        <span class="jd-activity-item__time" t-esc="act.timeLabel"/>
                    </div>
                </div>
                <div t-if="!props.activities.length" class="jd-empty">No recent activity</div>
            </div>
        </div>
    </t>

