<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_leave_approval_escalation" model="ir.cron">
        <field name="name">Leave: Escalate overdue approval stages</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="state">code</field>
        <field name="code">model._cron_escalate_overdue_approval_stages()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_process_leave_policy_accruals" model="ir.cron">
        <field name="name">Leave: Process policy accruals</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_type"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_policy_accruals()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
