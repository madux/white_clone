<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_leave_management" model="ir.module.category">
        <field name="name">Leave Management</field>
        <field name="description">Role-aware access to CleonHR Leave Management.</field>
        <field name="sequence">16</field>
    </record>

    <record id="module_category_leave_permissions" model="ir.module.category">
        <field name="name">Leave Management Permissions</field>
        <field name="description">Granular capabilities inherited by configurable Leave Management roles.</field>
        <field name="sequence">17</field>
    </record>

    <!--
        Permission groups are the stable contract used by Python, menus and
        record rules. Roles below are only XML-loaded defaults which imply a
        set of permissions. Administrators can create another res.groups role
        and inherit any combination without changing application code.
    -->
    <record id="group_leave_permission_personal" model="res.groups">
        <field name="name">Leave: Personal workspace</field>
        <field name="category_id" ref="module_category_leave_permissions"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_leave_permission_team" model="res.groups">
        <field name="name">Leave: Team visibility</field>
        <field name="category_id" ref="module_category_leave_permissions"/>
    </record>
    <record id="group_leave_permission_approve" model="res.groups">
        <field name="name">Leave: Decide assigned approvals</field>
        <field name="category_id" ref="module_category_leave_permissions"/>
    </record>
    <record id="group_leave_permission_operations" model="res.groups">
        <field name="name">Leave: Organisation operations</field>
        <field name="category_id" ref="module_category_leave_permissions"/>
    </record>
    <record id="group_leave_permission_configuration" model="res.groups">
        <field name="name">Leave: Configure policies and settings</field>
        <field name="category_id" ref="module_category_leave_permissions"/>
    </record>
    <record id="group_leave_permission_operational_reports" model="res.groups">
        <field name="name">Leave: Operational reports</field>
        <field name="category_id" ref="module_category_leave_permissions"/>
    </record>
    <record id="group_leave_permission_strategic_reports" model="res.groups">
        <field name="name">Leave: Strategic reports</field>
        <field name="category_id" ref="module_category_leave_permissions"/>
    </record>
    <record id="group_leave_permission_audit" model="res.groups">
        <field name="name">Leave: Read audit trail</field>
        <field name="category_id" ref="module_category_leave_permissions"/>
    </record>
    <record id="group_leave_permission_ai_config" model="res.groups">
        <field name="name">Leave: Configure AI</field>
        <field name="category_id" ref="module_category_leave_permissions"/>
    </record>
    <record id="group_leave_permission_ai_insights" model="res.groups">
        <field name="name">Leave: View AI Insights</field>
        <field name="category_id" ref="module_category_leave_permissions"/>
    </record>
    <record id="group_leave_permission_executive_analytics" model="res.groups">
        <field name="name">Leave: Executive Analytics</field>
        <field name="category_id" ref="module_category_leave_permissions"/>
    </record>

    <!--
        Leave roles are deliberately additive.  A user can be an employee,
        manager/approver and HR operator at the same time; the web client
        renders the union of those capabilities rather than selecting a mode.
    -->
    <record id="group_leave_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="category_id" ref="module_category_leave_management"/>
        <field name="implied_ids" eval="[(4, ref('hr_leave_dashboard.group_leave_permission_personal'))]"/>
    </record>

    <record id="group_leave_line_manager" model="res.groups">
        <field name="name">Line Manager</field>
        <field name="category_id" ref="module_category_leave_management"/>
        <field name="implied_ids" eval="[(4, ref('hr_leave_dashboard.group_leave_employee')), (4, ref('hr_leave_dashboard.group_leave_permission_team')), (4, ref('hr_leave_dashboard.group_leave_permission_approve'))]"/>
    </record>

    <record id="group_leave_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_leave_management"/>
        <field name="implied_ids" eval="[(4, ref('hr_leave_dashboard.group_leave_employee')), (4, ref('hr_leave_dashboard.group_leave_permission_approve')), (4, ref('hr_leave_dashboard.group_leave_permission_ai_insights'))]"/>
    </record>

    <record id="group_leave_hr_officer" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="category_id" ref="module_category_leave_management"/>
        <field name="implied_ids" eval="[(4, ref('hr_leave_dashboard.group_leave_employee')), (4, ref('hr_leave_dashboard.group_leave_permission_operations')), (4, ref('hr_leave_dashboard.group_leave_permission_operational_reports'))]"/>
    </record>

    <record id="group_leave_administrator" model="res.groups">
        <field name="name">HR / Leave Administrator</field>
        <field name="category_id" ref="module_category_leave_management"/>
        <field name="implied_ids" eval="[(4, ref('hr_leave_dashboard.group_leave_hr_officer')), (4, ref('hr_leave_dashboard.group_leave_permission_approve')), (4, ref('hr_leave_dashboard.group_leave_permission_configuration')), (4, ref('hr_leave_dashboard.group_leave_permission_audit')), (4, ref('hr_leave_dashboard.group_leave_permission_strategic_reports')), (4, ref('hr_leave_dashboard.group_leave_permission_ai_config')), (4, ref('hr_leave_dashboard.group_leave_permission_ai_insights')), (4, ref('hr_leave_dashboard.group_leave_permission_executive_analytics')), (4, ref('hr_holidays.group_hr_holidays_manager'))]"/>
    </record>

    <record id="group_leave_auditor" model="res.groups">
        <field name="name">Auditor (Read Only)</field>
        <field name="category_id" ref="module_category_leave_management"/>
        <field name="implied_ids" eval="[(4, ref('hr_leave_dashboard.group_leave_employee')), (4, ref('hr_leave_dashboard.group_leave_permission_audit')), (4, ref('hr_leave_dashboard.group_leave_permission_operational_reports')), (4, ref('hr_leave_dashboard.group_leave_permission_strategic_reports'))]"/>
    </record>

    <record id="group_leave_executive" model="res.groups">
        <field name="name">Executive / HR Director</field>
        <field name="category_id" ref="module_category_leave_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('hr_leave_dashboard.group_leave_permission_strategic_reports')), (4, ref('hr_leave_dashboard.group_leave_permission_executive_analytics'))]"/>
    </record>

    <record id="group_role_ceo" model="res.groups">
        <field name="name">Approval Role: CEO / Managing Director</field>
        <field name="category_id" ref="module_category_leave_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_role_finance_director" model="res.groups">
        <field name="name">Approval Role: Finance Director</field>
        <field name="category_id" ref="module_category_leave_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_role_hr_director" model="res.groups">
        <field name="name">Approval Role: HR Director</field>
        <field name="category_id" ref="module_category_leave_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Map existing Odoo roles to the same capability contract. -->
    <record id="hr_holidays.group_hr_holidays_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_leave_dashboard.group_leave_permission_operations')), (4, ref('hr_leave_dashboard.group_leave_permission_operational_reports'))]"/>
    </record>
    <record id="hr_holidays.group_hr_holidays_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_leave_dashboard.group_leave_permission_approve')), (4, ref('hr_leave_dashboard.group_leave_permission_configuration')), (4, ref('hr_leave_dashboard.group_leave_permission_audit')), (4, ref('hr_leave_dashboard.group_leave_permission_strategic_reports')), (4, ref('hr_leave_dashboard.group_leave_permission_ai_config')), (4, ref('hr_leave_dashboard.group_leave_permission_ai_insights')), (4, ref('hr_leave_dashboard.group_leave_permission_executive_analytics'))]"/>
    </record>
    <!-- Development requirement: Settings/System users receive every Leave capability. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_leave_dashboard.group_leave_permission_personal')), (4, ref('hr_leave_dashboard.group_leave_permission_team')), (4, ref('hr_leave_dashboard.group_leave_permission_approve')), (4, ref('hr_leave_dashboard.group_leave_permission_operations')), (4, ref('hr_leave_dashboard.group_leave_permission_configuration')), (4, ref('hr_leave_dashboard.group_leave_permission_operational_reports')), (4, ref('hr_leave_dashboard.group_leave_permission_strategic_reports')), (4, ref('hr_leave_dashboard.group_leave_permission_audit')), (4, ref('hr_leave_dashboard.group_leave_permission_ai_config')), (4, ref('hr_leave_dashboard.group_leave_permission_ai_insights')), (4, ref('hr_leave_dashboard.group_leave_permission_executive_analytics'))]"/>
    </record>

    <record id="rule_hr_leave_setup_progress_company" model="ir.rule">
        <field name="name">Leave setup progress: allowed companies</field>
        <field name="model_id" ref="model_hr_leave_setup_progress"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_manager')), (4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_hr_leave_balance_transaction_company" model="ir.rule">
        <field name="name">Leave balance transactions: allowed companies</field>
        <field name="model_id" ref="model_hr_leave_balance_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_manager')), (4, ref('base.group_system')), (4, ref('hr_leave_dashboard.group_leave_permission_audit'))]"/>
    </record>
    <record id="rule_hr_leave_audit_log_company" model="ir.rule">
        <field name="name">Leave audit log: allowed companies</field>
        <field name="model_id" ref="model_hr_leave_audit_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_manager')), (4, ref('base.group_system')), (4, ref('hr_leave_dashboard.group_leave_permission_audit'))]"/>
    </record>
    <record id="rule_hr_leave_absence_risk_company" model="ir.rule">
        <field name="name">Leave absence risk: allowed companies</field>
        <field name="model_id" ref="model_hr_leave_absence_risk"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_leave_dashboard.group_leave_administrator')), (4, ref('hr_leave_dashboard.group_role_hr_director'))]"/>
    </record>
    <record id="rule_hr_leave_policy_company" model="ir.rule">
        <field name="name">Leave policies: allowed companies</field>
        <field name="model_id" ref="model_hr_leave_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_leave_dashboard.group_leave_permission_configuration'))]"/>
    </record>
    <record id="rule_hr_leave_policy_line_company" model="ir.rule">
        <field name="name">Leave policy lines: allowed companies</field>
        <field name="model_id" ref="model_hr_leave_policy_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_leave_dashboard.group_leave_permission_configuration'))]"/>
    </record>
    <record id="rule_hr_leave_policy_assignment_company" model="ir.rule">
        <field name="name">Leave policy assignments: allowed companies</field>
        <field name="model_id" ref="model_hr_leave_policy_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_leave_dashboard.group_leave_permission_configuration')), (4, ref('hr_leave_dashboard.group_leave_permission_operations'))]"/>
    </record>

    <record id="rule_leave_hr_officer_read_scope" model="ir.rule">
        <field name="name">Leave HR Officer: company records (read)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('hr_leave_dashboard.group_leave_permission_operations'))]"/>
    </record>

    <record id="rule_leave_assigned_approver_read" model="ir.rule">
        <field name="name">Leave Approver: assigned requests (read)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('approval_line_ids.approver_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('hr_leave_dashboard.group_leave_permission_approve'))]"/>
    </record>

    <record id="rule_leave_auditor_read_all" model="ir.rule">
        <field name="name">Leave Auditor: allowed companies (read)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('hr_leave_dashboard.group_leave_permission_audit'))]"/>
    </record>

    <record id="rule_leave_allocation_auditor_read_all" model="ir.rule">
        <field name="name">Leave Allocation Auditor: allowed companies (read)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('hr_leave_dashboard.group_leave_permission_audit'))]"/>
    </record>
</odoo>
