        <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_manager')), (4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_hr_leave_audit_log_company" model="ir.rule">
        <field name="name">Leave audit log: allowed companies</field>
        <field name="model_id" ref="model_hr_leave_audit_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_manager')), (4, ref('base.group_system'))]"/>
    </record>
</odoo>
