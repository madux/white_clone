<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="hr_leave_dashboard.AdminBookTimeOffModal" owl="1">
    <!-- Backdrop -->
    <div class="cleon-welcome-backdrop" t-on-click="props.close"/>
    <div class="cleon-create-modal" role="dialog" aria-modal="true">
      <button type="button" class="cleon-welcome-close" t-on-click="props.close"><i class="fa fa-times"/></button>

      <div class="cleon-detail-header">
        <h4>Book Time Off</h4>
        <span class="text-muted">Submit a leave request on behalf of an employee</span>
      </div>

      <!-- Loading -->
      <t t-if="state.loading">
        <div class="p-4 text-center text-muted"><i class="fa fa-spinner fa-spin me-1"/> Loading employees…</div>
      </t>

      <t t-else="">
        <div class="cleon-create-body">

          <!-- ═══ Employee Picker ═══ -->
          <div class="mb-3 admin-employee-picker">
            <label class="form-label font-weight-bold">Employee *</label>

            <t t-if="state.selectedEmployee">
              <div class="selected-employee-card">
                <div class="selected-employee-info">
                  <strong class="selected-employee-name"><t t-esc="state.selectedEmployee.name"/></strong>
                  <span class="selected-employee-meta">
                    <t t-esc="state.selectedEmployee.department"/> · <t t-esc="state.selectedEmployee.job_title"/>
                  </span>
                </div>
                <button type="button" class="selected-employee-change-btn" t-on-click="clearEmployee" title="Change employee">
                  <i class="fa fa-times me-1"/> Change
                </button>
              </div>
            </t>
            <t t-else="">
              <div class="employee-combobox-wrap">
                <div class="employee-input-box">
                  <i class="fa fa-search employee-search-icon"/>
                  <input type="text"
                         class="form-control employee-search-input"
                         placeholder="Search employee by name, department, or job title..."
                         autocomplete="off"
                         t-att-value="state.employeeSearch"
                         t-on-focus="openEmployeeDropdown"
                         t-on-input="onEmployeeSearchInput"/>
                  <i class="fa fa-chevron-down employee-dropdown-chevron"/>
                </div>
                <t t-if="state.employeeDropdownOpen">
                  <div class="employee-dropdown-menu">
                    <t t-foreach="this.filteredEmployees" t-as="emp" t-key="emp.id">
                      <button type="button"
                              class="employee-option-item"
                              t-on-click="() => this.selectEmployee(emp)">
                        <strong class="employee-option-name"><t t-esc="emp.name"/></strong>
                        <span class="employee-option-meta">
                          <t t-esc="emp.department"/> · <t t-esc="emp.job_title"/>
                        </span>
                      </button>
                    </t>
                    <t t-if="!this.filteredEmployees.length">
                      <div class="employee-no-results">
                        No matching employees found.
                      </div>
                    </t>
                  </div>
                </t>
              </div>
            </t>
          </div>

          <!-- ═══ Leave Type ═══ -->
          <div class="mb-3" t-if="state.form.employee_id">
            <label class="form-label font-weight-bold">Leave Type *</label>
            <select class="form-select" t-model="state.form.leave_type_id" t-on-change="previewRequest">
              <option value="">Select Leave Type...</option>
              <t t-foreach="state.leaveTypes" t-as="leaveType" t-key="leaveType.id">
                <option t-att-value="leaveType.id">
                  <t t-esc="leaveType.name"/>
                </option>
              </t>
            </select>
            <t t-if="this.selectedLeaveTypeInfo">
              <small t-att-class="this.selectedLeaveTypeInfo.balance > 0 ? 'text-success d-block mt-1 font-weight-bold' : 'text-danger d-block mt-1 font-weight-bold'">
                Available balance: <t t-esc="this.selectedLeaveTypeInfo.balance"/> days
              </small>
            </t>
          </div>

          <!-- ═══ Dates ═══ -->
          <div class="row g-2 mb-3" t-if="state.form.leave_type_id">
            <div class="col-6">
              <label class="form-label font-weight-bold">Start Date *</label>
              <input type="date" class="form-control" t-model="state.form.date_from" t-on-change="onStartChange"/>
            </div>
            <div class="col-6">
              <label class="form-label font-weight-bold">End Date *</label>
              <input type="date" class="form-control" t-model="state.form.date_to" t-on-change="previewRequest"/>
            </div>
          </div>

          <!-- ═══ Duration Preview ═══ -->
          <t t-if="state.preview">
            <div class="alert alert-info py-2 px-3 mb-3 font-weight-bold">
              Calculated Duration: <t t-esc="state.preview.duration"/> working day(s)
            </div>
          </t>

          <!-- ═══ Half Day ═══ -->
          <div class="form-check mb-3" t-if="state.form.leave_type_id">
            <input type="checkbox" class="form-check-input" id="admin_half_day_chk" t-model="state.form.half_day" t-on-change="previewRequest"/>
            <label class="form-check-label" for="admin_half_day_chk">Half-day Request</label>
            <t t-if="state.form.half_day">
              <div class="mt-2 d-flex gap-3">
                <label class="form-check-label"><input type="radio" name="admin_period_radio" value="am" t-model="state.form.period" t-on-change="previewRequest"/> Morning (AM)</label>
                <label class="form-check-label"><input type="radio" name="admin_period_radio" value="pm" t-model="state.form.period" t-on-change="previewRequest"/> Afternoon (PM)</label>
              </div>
            </t>
          </div>

          <!-- ═══ Overlap Warning ═══ -->
          <t t-if="state.showOverlapWarning">
            <div class="alert alert-warning mb-3">
              <h6 class="alert-heading mb-1"><i class="fa fa-exclamation-triangle me-1"/> Overlapping Request Warning</h6>
              <p class="mb-2 fs-7">This employee already has an active leave request overlapping these dates.</p>
              <div class="form-check">
                <input type="checkbox" class="form-check-input" id="admin_override_chk" t-model="state.overrideConflict"/>
                <label class="form-check-label font-weight-bold" for="admin_override_chk">Acknowledge &amp; Override Conflict</label>
              </div>
            </div>
          </t>

          <!-- ═══ Admin Note ═══ -->
          <div class="mb-3" t-if="state.form.leave_type_id">
            <label class="form-label font-weight-bold">Admin Note / Reason * <small class="text-muted">(min 10 characters)</small></label>
            <textarea class="form-control" rows="3"
                      placeholder="Specify administrative reason for creating this request..."
                      t-model="state.form.admin_note"/>
          </div>

          <!-- ═══ Error ═══ -->
          <t t-if="state.error">
            <div class="alert alert-danger py-2 px-3 mb-3"><t t-esc="state.error"/></div>
          </t>

        </div>

        <!-- Footer -->
        <div class="cleon-detail-footer">
          <button type="button" class="btn btn-secondary" t-on-click="props.close">Cancel</button>
          <button type="button" class="btn btn-primary ms-2" t-on-click="submit"
                  t-att-disabled="!this.isFormValid || state.submitting">
            <i t-att-class="state.submitting ? 'fa fa-spinner fa-spin me-1' : 'fa fa-check me-1'"/>
            <t t-if="state.submitting">Submitting…</t>
            <t t-else="">Submit Request</t>
          </button>
        </div>
      </t>
    </div>
  </t>
</templates>
