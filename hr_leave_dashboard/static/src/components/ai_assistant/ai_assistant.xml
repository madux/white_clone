<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="hr_leave_dashboard.CleonAiAssistant" owl="1">
    <div class="o_cai_root">
      <button class="o_cai_fab" t-on-click="toggle" title="CleonAI — aware of your current screen"><i class="fa fa-magic"/></button>
      <aside t-if="state.open" class="o_cai_panel">
        <header><div><h3>CleonAI</h3><p t-esc="state.context?.title || 'Current screen assistant'"/></div><button t-on-click="toggle">&#215;</button></header>
        <div class="o_cai_body">
          <div t-if="!state.context" class="o_cai_empty"><i class="fa fa-compass"/><b>Screen context not available yet</b><span>Open a supported workspace such as Leave Calendar.</span></div>
          <t t-elif="state.context.screen === 'leave_calendar'">
            <div class="o_cai_scope"><i class="fa fa-shield"/> Answers are restricted to your <b t-esc="state.summary?.scope || state.context.perspective"/> visibility.</div>
            <div t-if="state.loading" class="o_cai_loading"><i class="fa fa-spinner fa-spin"/> Summarizing the current calendar…</div>
            <t t-elif="state.summary">
              <section class="o_cai_summary"><h4>Current calendar summary</h4><ul><li t-foreach="state.summary.bullets" t-as="bullet" t-key="bullet" t-esc="bullet"/></ul></section>
              <div t-if="!state.summary.provider.configured or !state.summary.provider.live_calls_enabled" class="o_cai_provider"><i class="fa fa-plug"/> Live provider not enabled. The secure context and tool boundary are ready.</div>
              <div class="o_cai_suggestions"><button t-foreach="state.summary.suggestions" t-as="suggestion" t-key="suggestion" t-on-click="() => this.ask(suggestion)" t-esc="suggestion"/></div>
              <div class="o_cai_messages"><p t-foreach="state.messages" t-as="message" t-key="message_index" t-att-class="message.role" t-esc="message.text"/></div>
            </t>
          </t>
          <div t-else="" class="o_cai_empty"><i class="fa fa-wrench"/><b>Foundation active</b><span>This module has not published an assistant context yet.</span></div>
        </div>
        <div class="o_cai_input"><input t-model="state.question" t-on-keydown="onQuestionKeydown" placeholder="Ask about the current screen…"/><button t-on-click="() => this.ask()"><i class="fa fa-paper-plane"/></button></div>
        <footer><button t-on-click="refreshSummary"><i class="fa fa-refresh"/> Refresh</button><button t-on-click="copySummary"><i class="fa fa-copy"/> Copy</button><button t-on-click="emailSummary"><i class="fa fa-envelope-o"/> Email</button></footer>
      </aside>
    </div>
  </t>
</templates>
