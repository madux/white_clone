<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="hr_leave_dashboard.CalendarSidebar" owl="1">
    <div t-att-class="'leavesidebar ' + (state.collapsed ? 'is-collapsed' : '')">
      <div class="o_cc_sidebar_header">
        <span class="o_cc_header_dot"/>
        <span class="o_cc_header_title">Leave Management</span>
        <button type="button" class="btn btn-sm o_cc_collapse_btn" t-on-click="toggleCollapsed" t-att-title="state.collapsed ? 'Expand sidebar' : 'Collapse sidebar'">
          <i t-att-class="state.collapsed ? 'fa fa-chevron-right' : 'fa fa-chevron-left'"/>
        </button>
      </div>

      <nav class="o_cc_nav">
        <t t-foreach="navigationSections" t-as="section" t-key="section.key">
          <p t-if="section.label" class="sidebar-section-label" t-esc="section.label"/>
          <a t-foreach="section.items" t-as="item" t-key="item.key"
             t-att-class="'o_cc_nav_item ' + (props.activeMenu === item.key || (props.activeMenu === 'operations_requests' and item.key === 'requests') || (props.activeMenu === 'approvals' and item.key === 'requests') ? 'o_cc_nav_active' : '')"
             t-att-title="item.description" t-att-aria-label="item.label + ': ' + item.description"
             t-on-click="() => this.navigate(item)">
            <span class="o_cc_nav_icon"><i t-att-class="'fa ' + item.icon"/></span>
            <span class="o_cc_nav_label" t-esc="item.label"/>
            <span t-if="item.pending" class="o_cc_pending_badge" t-esc="item.pending"/>
          </a>
        </t>
      </nav>

      <div class="o_cc_sidebar_footer">
        <button t-on-click="openTour"><i class="fa fa-map-o"/><span>Take a Tour</span><em>Guide</em></button>
        <button t-if="state.access.canConfigure" t-on-click="openSetupExperience"><i class="fa fa-magic"/><span>Setup Wizard</span></button>
      </div>
    </div>
  </t>
</templates>
