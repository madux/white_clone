<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="hr_leave_dashboard.ResourceToolbar">
    <header class="o_cr_header"><div><h2 t-esc="title"/><p t-esc="subtitle"/></div><div><input t-model="state.search" placeholder="Search..."/><button class="btn btn-primary" t-on-click="add">+ <t t-esc="buttonLabel"/></button></div></header>
  </t>
  <t t-name="hr_leave_dashboard.ResourceActions"><div class="o_cr_actions"><button t-on-click="() => this.edit(row)">View / Edit</button><button t-on-click="() => this.duplicate(row)">Duplicate</button><button t-on-click="() => this.change(row)">Change Status</button><button class="text-danger" t-on-click="() => this.remove(row)">Delete</button></div></t>
  <t t-name="hr_leave_dashboard.OfficialHolidaysPage">
    <section class="o_cr_page"><t t-call="hr_leave_dashboard.ResourceToolbar"><t t-set="title">Official Holidays</t><t t-set="subtitle">Public, religious, regional, and organisation holidays used by leave calculations.</t><t t-set="buttonLabel">Add Public Holiday</t></t>
      <table><thead><tr><th>Holiday Name</th><th>Dates</th><th>Type</th><th>Applies To</th><th>Repeats</th><th>Country / Region</th><th>Status</th><th>Created By</th><th>Last Updated</th><th>Actions</th></tr></thead><tbody><tr t-foreach="visibleRows" t-as="row" t-key="row.id"><td t-esc="row.name"/><td><t t-esc="row.date_from"/> – <t t-esc="row.date_to"/></td><td t-esc="row.type"/><td t-esc="row.locations"/><td t-esc="row.repeats"/><td t-esc="row.country_region"/><td t-esc="row.active ? 'Active' : 'Inactive'"/><td t-esc="row.created_by"/><td t-esc="row.last_updated"/><td><t t-call="hr_leave_dashboard.ResourceActions"/></td></tr></tbody></table>
      <div t-if="state.form" class="o_lp_overlay" t-on-click.self="close"><aside class="o_lp_drawer"><header><h3><t t-esc="state.form.id ? 'Edit' : 'Add'"/> Official Holiday</h3><button t-on-click="close">×</button></header><div class="o_lp_form o_lp_grid"><label>Holiday Name<input maxlength="255" t-model="state.form.name"/></label><label>Holiday Type<select t-model="state.form.type"><option value="public">Public Holiday</option><option value="religious">Religious Holiday</option><option value="regional">Regional Holiday</option><option value="observance">Observance</option></select></label><label>Start Date<input type="date" t-model="state.form.date_from" t-on-change="onStartDateChange"/></label><label>End Date<input type="date" t-model="state.form.date_to"/></label><label>Applies To<select t-model="state.form.applies_to"><option value="all">All Employees</option><option value="locations">Specific Locations</option></select></label><label>Repeats<select t-model="state.form.repeats"><option value="once">One-off</option><option value="annually">Annually</option></select></label><label>Country<select t-model="state.form.country_id" t-on-change="onHolidayCountryChange"><option value="">Select country</option><option t-foreach="state.catalog.countries || []" t-as="item" t-key="item.id" t-att-value="item.id" t-esc="item.name"/></select></label><label>Region / State<select t-model="state.form.state_id"><option value="">Select region</option><option t-foreach="holidayStates" t-as="item" t-key="item.id" t-att-value="item.id" t-esc="item.name"/></select></label><label>Status<select t-model="state.form.active"><option t-att-value="true">Active</option><option t-att-value="false">Inactive</option></select></label><label class="full">Description (<t t-esc="(state.form.description || '').length"/>/255)<textarea maxlength="255" t-model="state.form.description"/></label><div t-if="state.form.applies_to === 'locations'" class="full o_cr_checks"><label t-foreach="state.options" t-as="item" t-key="item.id"><input type="checkbox" t-att-checked="state.form.location_ids.includes(item.id)" t-on-change="() => this.toggle('location_ids', item.id)"/><t t-esc="item.name"/></label></div></div><footer><button t-on-click="close">Cancel</button><button class="o_lp_primary" t-on-click="save">Save Holiday</button></footer></aside></div>
    </section>
  </t>
  <t t-name="hr_leave_dashboard.BlackoutWindowsPage">
    <section class="o_cr_page"><t t-call="hr_leave_dashboard.ResourceToolbar"><t t-set="title">Blackout Windows</t><t t-set="subtitle">Periods when employees cannot apply for leave.</t><t t-set="buttonLabel">Add Blackout Window</t></t>
      <table><thead><tr><th>Window Name</th><th>Dates</th><th>Duration</th><th>Applies To</th><th>Reason</th><th>Status</th><th>Created By</th><th>Last Updated</th><th>Actions</th></tr></thead><tbody><tr t-foreach="visibleRows" t-as="row" t-key="row.id"><td t-esc="row.name"/><td><t t-esc="row.date_from"/> – <t t-esc="row.date_to"/></td><td><t t-esc="row.duration"/> days</td><td t-esc="row.departments"/><td t-esc="row.reason"/><td t-esc="row.state"/><td t-esc="row.created_by"/><td t-esc="row.last_updated"/><td><t t-call="hr_leave_dashboard.ResourceActions"/></td></tr></tbody></table>
      <div t-if="state.form" class="o_lp_overlay" t-on-click.self="close"><aside class="o_lp_drawer"><header><h3><t t-esc="state.form.id ? 'Edit' : 'Add'"/> Blackout Window</h3><button t-on-click="close">×</button></header><div class="o_lp_form o_lp_grid"><label>Window Name<input t-model="state.form.name"/></label><label>Status<select t-model="state.form.state"><option value="draft">Draft</option><option value="scheduled">Scheduled</option><option value="active">Active</option></select></label><label>Start Date<input type="date" t-model="state.form.date_from"/></label><label>End Date<input type="date" t-model="state.form.date_to"/></label><label>Applies To<select t-model="state.form.applies_to"><option value="all">All Employees</option><option value="departments">Specific Departments</option><option value="policies">Specific Leave Policies</option><option value="groups">Specific Groups</option></select></label><label>Exception Behaviour<select t-model="state.form.exception_mode"><option value="hard_block">Block completely</option><option value="approval">Permit authorised exception</option></select></label><label t-if="state.form.exception_mode === 'approval'">Exception Approval Flow<select t-model.number="state.form.exception_chain_id"><option value="">Select flow</option><option t-foreach="state.catalog.chains || []" t-as="item" t-key="item.id" t-att-value="item.id" t-esc="item.name"/></select></label><label class="full">Reason (<t t-esc="(state.form.reason || '').length"/>/255)<textarea maxlength="255" t-model="state.form.reason"/></label><div t-if="state.form.applies_to === 'departments'" class="full o_cr_checks"><label t-foreach="state.options" t-as="item" t-key="item.id"><input type="checkbox" t-att-checked="state.form.department_ids.includes(item.id)" t-on-change="() => this.toggle('department_ids', item.id)"/><t t-esc="item.name"/></label></div><div t-if="state.form.applies_to === 'policies'" class="full o_cr_checks"><label t-foreach="state.catalog.policies || []" t-as="item" t-key="item.id"><input type="checkbox" t-att-checked="state.form.policy_ids.includes(item.id)" t-on-change="() => this.toggle('policy_ids', item.id)"/><t t-esc="item.name"/></label></div><div t-if="state.form.applies_to === 'groups'" class="full o_cr_checks"><label t-foreach="state.catalog.groups || []" t-as="item" t-key="item.id"><input type="checkbox" t-att-checked="state.form.group_ids.includes(item.id)" t-on-change="() => this.toggle('group_ids', item.id)"/><t t-esc="item.name"/></label></div><section class="full"><b>Live Preview</b><p><t t-esc="state.form.name || 'Untitled window'"/> · <t t-esc="state.form.date_from || 'Start'"/> – <t t-esc="state.form.date_to || 'End'"/> · <t t-esc="state.form.state"/> · <t t-esc="state.form.exception_mode === 'approval' ? 'Exception route' : 'Hard block'"/></p></section></div><footer><button t-on-click="close">Cancel</button><button class="o_lp_primary" t-on-click="save">Save Blackout Window</button></footer></aside></div>
    </section>
  </t>
</templates>
