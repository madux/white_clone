<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="hr_leave_dashboard.DashboardRouter" owl="1">
    <div class="leaveapp o_leave_unified_dashboard">
      <CalendarSidebar activeMenu="'dashboard'"/>
      <main class="o_leave_unified_main">
        <header class="o_leave_unified_header">
          <button type="button" class="cleon-header-plain-btn" t-on-click="toggleSidebar" title="Toggle Leave navigation">
            <i class="fa fa-columns"/>
          </button>
          <div>
            <h2>Dashboard</h2>
            <p>Your personal, team, and organisation leave information in one workspace</p>
          </div>
        </header>
        <div t-if="state.loading" class="p-5 text-center text-muted">
          <i class="fa fa-spinner fa-spin"/> Loading leave dashboard...
        </div>
        <t t-else="">
          <section class="o_leave_unified_actions">
            <button t-if="state.access.has_personal_scope" t-on-click="requestLeave"><i class="fa fa-plus-circle"/><span><b>Request Leave</b><small>Submit time off</small></span></button>
            <button t-if="state.access.has_personal_scope" t-on-click="openMyRequests"><i class="fa fa-file-text-o"/><span><b>My Requests</b><small>Track my leave</small></span></button>
            <button t-if="state.access.can_approve" t-on-click="openApprovals"><i class="fa fa-check-circle-o"/><span><b>Approvals</b><small><t t-esc="state.access.pending_approvals"/> awaiting me</small></span></button>
            <button t-on-click="openCalendar"><i class="fa fa-calendar"/><span><b>Leave Calendar</b><small>View schedules</small></span></button>
            <button t-if="state.access.can_operate" t-on-click="openBalances"><i class="fa fa-balance-scale"/><span><b>Manage Balances</b><small>Allocate and amend</small></span></button>
            <button t-if="state.access.can_configure" t-on-click="openLeaveTypes"><i class="fa fa-tags"/><span><b>Leave Configuration</b><small>Types and policies</small></span></button>
            <button t-if="state.access.can_view_operational_reports or state.access.can_view_strategic_reports" t-on-click="openReports"><i class="fa fa-bar-chart"/><span><b>Reports</b><small>Leave analytics</small></span></button>
            <button t-if="state.access.can_view_audit" t-on-click="openAudit"><i class="fa fa-shield"/><span><b>Audit Trail</b><small>Compliance history</small></span></button>
          </section>
          <EmployeeLeaveDashboard t-key="'personal-'+state.revision" t-if="state.access.has_personal_scope" embedded="true"/>
          <HrLeaveDashboard t-key="'organisation-'+state.revision" t-if="state.access.show_organisation_dashboard" embedded="true" access="state.access"/>
          <div t-if="!state.access.has_personal_scope and !state.access.show_organisation_dashboard" class="o_leave_dashboard_empty_access">
            You do not currently have a personal employee profile or an organisation dashboard permission.
          </div>
        </t>
      </main>
      <EmployeeRequestModal t-if="state.requestOpen" close.bind="closeRequest" submitted.bind="requestSubmitted"/>
    </div>
  </t>
</templates>
