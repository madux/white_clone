<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="hr_leave_dashboard.EmployeeDashboard" owl="1">
  <div class="o_ed_page">
    <aside class="o_ed_sidebar"><div class="o_ed_side_title"><i class="fa fa-circle"/> Leave Management</div><nav><a class="active"><i class="fa fa-th-large"/> Dashboard</a><a t-on-click="openCalendar"><i class="fa fa-calendar"/> Leave Calendar</a><a t-on-click="openRequests"><i class="fa fa-file-text-o"/> My Leave Requests</a><a t-on-click="openRequests"><i class="fa fa-line-chart"/> Reports</a></nav></aside>
    <main class="o_ed_main">
      <header class="o_ed_header"><div class="o_ed_heading"><i class="fa fa-columns"/><div><h2>Dashboard</h2><p>View and manage your leave requests</p></div></div><div class="o_ed_header_actions" t-if="state.data.can_admin"><button title="Section Tour" t-on-click="openTour"><i class="fa fa-paper-plane-o"/></button><button title="Help / Guide" t-on-click="openHelp"><i class="fa fa-question-circle-o"/></button><button title="Setup Wizard" t-on-click="openSetup"><i class="fa fa-magic"/></button><div class="o_ed_switch"><button t-on-click="openAdmin"><i class="fa fa-shield"/> Admin View</button><button class="active"><i class="fa fa-user-o"/> Employee View</button></div></div></header>
      <div t-if="state.loading" class="o_ed_loading"><i class="fa fa-spinner fa-spin"/> Loading your dashboard...</div>
      <t t-else="">
        <section class="o_ed_welcome"><div><h3>Welcome back, <t t-esc="state.data.employee.name"/>! 👋</h3><p>You have <b t-esc="state.data.kpis.total_balance || 0"/> days of leave available</p></div><button t-on-click="requestLeave"><i class="fa fa-plus"/> Request Leave</button></section>
        <section class="o_ed_kpis"><article class="blue"><i class="fa fa-calendar"/><b t-esc="state.data.kpis.total_balance || 0"/><strong>Total Leave Balance</strong><small>days available</small></article><article class="amber"><i class="fa fa-clock-o"/><b t-esc="state.data.kpis.pending_requests || 0"/><strong>Pending Requests</strong><small>awaiting approval</small></article><article class="green"><i class="fa fa-check-circle-o"/><b t-esc="state.data.kpis.approved_this_year || 0"/><strong>Approved Leaves</strong><small>this year</small></article><article class="teal"><i class="fa fa-check-circle-o"/><b t-esc="state.data.kpis.at_work ? 'Yes' : 'No'"/><strong t-esc="state.data.kpis.at_work ? 'At Work' : 'On Leave Today'"/><small t-esc="state.data.kpis.at_work ? 'Working day' : 'Approved leave'"/></article></section>
        <div class="o_ed_grid"><div class="o_ed_left">
          <section class="o_ed_card"><div class="o_ed_card_head"><h3>Leave Balance by Type</h3><a t-on-click="openRequests">View All Requests →</a></div><div t-if="!state.data.balances.length" class="o_ed_empty">No leave allocation has been assigned yet.</div><div class="o_ed_balance" t-foreach="state.data.balances" t-as="balance" t-key="balance.id"><div><strong><i t-att-style="'background:'+balance.color"/> <t t-esc="balance.name"/></strong><span><t t-esc="balance.remaining"/> / <t t-esc="balance.allocated"/> days</span></div><div class="o_ed_track"><i t-att-style="'width:'+balance.percent+'%;background:'+balance.color"/></div><small>Used: <t t-esc="balance.used"/> days <em>Pending: <t t-esc="balance.pending"/> days</em></small></div></section>
          <section class="o_ed_card"><h3>Recent Request History</h3><div t-if="!state.data.recent.length" class="o_ed_empty">You have not submitted any leave requests.</div><div class="o_ed_request" t-foreach="state.data.recent" t-as="request" t-key="request.id"><div><strong t-esc="request.type"/><small><t t-esc="formatDate(request.start)"/> – <t t-esc="formatDate(request.end)"/> · <t t-esc="request.days"/> days</small></div><span t-att-class="'o_ed_status '+statusClass(request.state)" t-esc="request.status"/></div></section>
        </div><div class="o_ed_right">
          <section class="o_ed_card"><h3>Upcoming Leave</h3><div t-if="!state.data.upcoming_leave.length" class="o_ed_empty">No approved upcoming leave.</div><div class="o_ed_upcoming" t-foreach="state.data.upcoming_leave" t-as="leave" t-key="leave.start"><i class="fa fa-plane"/><div><strong t-esc="leave.type"/><small><t t-esc="formatDate(leave.start)"/> – <t t-esc="formatDate(leave.end)"/></small></div><b><t t-esc="leave.days"/>d</b></div></section>
          <section class="o_ed_card"><h3>Upcoming Holidays</h3><div t-if="!state.data.holidays.length" class="o_ed_empty">No public holidays in the next 90 days.</div><div class="o_ed_holiday" t-foreach="state.data.holidays" t-as="holiday" t-key="holiday.date"><div><strong t-esc="holiday.name"/><small t-esc="formatDate(holiday.date)"/></div><span><t t-esc="holiday.days_away"/>d</span></div></section>
          <section class="o_ed_card"><h3>Quick Actions</h3><button class="o_ed_quick" t-on-click="requestLeave"><i class="fa fa-plus-circle"/> Request Leave</button><button class="o_ed_quick" t-on-click="openRequests"><i class="fa fa-file-text-o"/> View My Requests</button><button class="o_ed_quick" t-on-click="openCalendar"><i class="fa fa-calendar"/> View Calendar</button></section>
        </div></div>
      </t>
    </main><EmployeeRequestModal t-if="state.requestOpen" close.bind="closeRequest" submitted.bind="load"/>
  </div>
</t>
</templates>
