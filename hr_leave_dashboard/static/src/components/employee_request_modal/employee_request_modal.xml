<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve"><t t-name="hr_leave_dashboard.EmployeeRequestModal" owl="1"><div class="o_er_overlay"><section class="o_er_modal" role="dialog" aria-modal="true"><header><div><h3>Request Leave</h3><p>Submit a new leave request for approval</p></div><button t-on-click="props.close">×</button></header><div class="o_er_body">
<div t-if="state.loading" class="o_er_loading"><i class="fa fa-spinner fa-spin"/> Loading leave policies...</div><t t-else="">
<section class="o_er_balances"><h4>Your Leave Balance</h4><div><span t-foreach="state.balances.slice(0,4)" t-as="item" t-key="item.id"><b t-esc="item.name"/><strong t-esc="item.unlimited ? 'Unlimited' : ((item.allocated-item.used)+' / '+item.allocated+' days')"/></span></div></section>
<h4>Basic Information</h4><label>Leave Type <em>*</em><select t-model="state.form.leave_type_id" t-on-change="preview"><option value="">Select leave type...</option><option t-foreach="state.types" t-as="item" t-key="item.id" t-att-value="item.id" t-esc="item.name"/></select></label><div class="o_er_dates"><label>Start Date <em>*</em><input type="date" t-model="state.form.date_from" t-on-change="onStartChange"/></label><label>End Date <em>*</em><input type="date" t-model="state.form.date_to" t-att-min="state.form.date_from" t-on-change="preview"/></label></div>
<div class="o_er_half"><label><input type="checkbox" t-model="state.form.half_day" t-on-change="preview" t-att-disabled="selectedType and !selectedType.allow_half_day"/> Half-Day Leave</label><div t-if="state.form.half_day"><label><input type="radio" value="am" t-model="state.form.period" t-on-change="preview"/> Morning</label><label><input type="radio" value="pm" t-model="state.form.period" t-on-change="preview"/> Afternoon</label></div></div>
<div t-if="state.preview" class="o_er_preview"><div><span>Duration</span><b><t t-esc="state.preview.duration"/> working day(s)</b></div><div><span>Current Balance</span><b t-esc="state.preview.unlimited ? 'Unlimited' : state.preview.current_balance+' days'"/></div><div><span>After Request</span><b t-esc="state.preview.unlimited ? 'Unlimited' : state.preview.projected_balance+' days'"/></div><p t-if="state.preview.holiday_count"><i class="fa fa-calendar"/> <t t-esc="state.preview.holiday_count"/> public holiday(s) excluded from duration.</p></div>
<div t-if="state.preview and state.preview.team_overlap and state.preview.team_overlap.exceeded" class="o_er_notice warning"><i class="fa fa-users"/> Team availability: <t t-esc="state.preview.team_overlap.percentage"/>% of the department would be on leave.</div><div class="o_er_notice warning" t-foreach="state.preview ? state.preview.warnings : []" t-as="warning" t-key="warning" t-esc="warning"/><div class="o_er_notice error" t-foreach="state.preview ? state.preview.errors : []" t-as="error" t-key="error" t-esc="error"/><div t-if="state.error" class="o_er_notice error" t-esc="state.error"/>
<h4>Details</h4><label>Reason <em>*</em><textarea t-model="state.form.reason" placeholder="Please provide a reason for your leave request"/></label><label t-att-class="state.preview and state.preview.document_required ? 'required':''">Attachment <t t-if="state.preview and state.preview.document_required"><em>* Required by policy</em></t><input type="file" accept=".pdf,.jpg,.jpeg,.png" t-on-change="onFileChange"/><small>PDF, JPG or PNG · maximum 10 MB</small><b t-if="state.form.attachment" t-esc="state.form.attachment.name"/></label><label>Emergency Contact (Optional)<input t-model="state.form.emergency_contact" placeholder="Phone number or email"/></label>
</t></div><footer><button t-on-click="props.close">Cancel</button><button class="primary" t-on-click="submit" t-att-disabled="!canSubmit"><i t-if="state.submitting" class="fa fa-spinner fa-spin"/> Submit Request</button></footer></section></div></t></templates>
