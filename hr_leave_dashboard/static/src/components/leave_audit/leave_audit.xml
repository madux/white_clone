<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve"><t t-name="hr_leave_dashboard.LeaveAuditPage" owl="1"><div class="leaveapp o_la_page"><CalendarSidebar activeMenu="'audit'"/><main class="o_leave_dashboard o_la_main">
  <header class="o_la_header"><div><h2>Audit Log</h2><p>Track all leave management actions and changes</p></div><div class="o_la_view"><button class="active">Admin View</button><button>Employee View</button></div></header>
  <section class="o_la_toolbar"><div class="o_la_search"><i class="fa fa-search"/><input t-model="state.filters.search" t-on-keydown="onSearchKeydown" placeholder="Search by entity, user, action, IP..."/></div><button t-on-click="() => state.filtersOpen=true"><i class="fa fa-sliders"/> Filters <b t-if="activeFilterCount" t-esc="activeFilterCount"/></button><div class="o_la_columns"><button t-on-click="() => state.columnsOpen=!state.columnsOpen"><i class="fa fa-columns"/> Columns</button><div t-if="state.columnsOpen" class="o_la_columns_menu"><label t-foreach="columnEntries" t-as="column" t-key="column[0]"><input type="checkbox" t-att-checked="column[1]" t-on-change="() => toggleColumn(column[0])"/> <t t-esc="column[0].replace('_',' ')"/></label></div></div><span class="o_la_count"><t t-esc="state.total"/> entries</span><button class="o_la_export" t-on-click="exportCsv"><i class="fa fa-download"/> Export</button><button t-on-click="refresh"><i t-att-class="state.loading ? 'fa fa-refresh fa-spin':'fa fa-refresh'"/></button></section>
  <div class="o_la_summary"><b><t t-esc="state.total"/> Total Entries</b><span><t t-esc="state.summary.requests || 0"/> Requests</span><span><t t-esc="state.summary.policies || 0"/> Policies</span><span><t t-esc="state.summary.leave_types || 0"/> Leave Types</span><span><t t-esc="state.summary.accrual || 0"/> Accrual</span><span class="failed"><t t-esc="state.summary.failed || 0"/> Failed</span><em><i class="fa fa-circle"/> Real-time</em></div>
  <section class="o_la_table_wrap"><table><thead><tr><th/><th t-if="state.columns.timestamp" t-on-click="() => sortBy('occurred_at')">Timestamp <i t-att-class="'fa '+sortIcon('occurred_at')"/></th><th t-if="state.columns.action" t-on-click="() => sortBy('action')">Action Type <i t-att-class="'fa '+sortIcon('action')"/></th><th t-if="state.columns.module" t-on-click="() => sortBy('module_area')">Module Area <i t-att-class="'fa '+sortIcon('module_area')"/></th><th t-if="state.columns.entity" t-on-click="() => sortBy('entity_type')">Entity Type / Name</th><th t-if="state.columns.actor" t-on-click="() => sortBy('actor_label')">Performed By</th><th t-if="state.columns.employee">Affected Employee</th><th t-if="state.columns.department">Department</th><th t-if="state.columns.diff">Before / After</th><th t-if="state.columns.ip">IP Address</th><th t-if="state.columns.device">Device / Browser</th><th t-if="state.columns.source" t-on-click="() => sortBy('source')">Source</th><th t-if="state.columns.status" t-on-click="() => sortBy('event_status')">Status</th></tr></thead><tbody>
    <t t-foreach="state.rows" t-as="row" t-key="row.id"><tr t-att-class="state.expandedId === row.id ? 'expanded':''" t-on-click="() => toggleExpanded(row.id)"><td><i t-att-class="state.expandedId === row.id ? 'fa fa-chevron-down':'fa fa-chevron-right'"/></td><td t-if="state.columns.timestamp"><t t-set="stamp" t-value="formatTimestamp(row.timestamp)"/><b t-esc="stamp.date"/><small t-esc="stamp.time"/></td><td t-if="state.columns.action"><span t-att-class="'o_la_action '+actionClass(row.action)" t-esc="row.action_label"/></td><td t-if="state.columns.module"><span class="o_la_module" t-esc="row.module_label"/></td><td t-if="state.columns.entity"><span class="o_la_entity_type" t-esc="row.entity_type_label"/><b t-esc="row.entity_name"/><small t-esc="row.entity_reference"/></td><td t-if="state.columns.actor"><b t-esc="row.actor"/><small t-esc="row.actor_role"/></td><td t-if="state.columns.employee"><b t-esc="row.employee || '—'"/><small t-esc="row.employee_code"/></td><td t-if="state.columns.department"><i class="fa fa-building-o"/> <t t-esc="row.department || '—'"/></td><td t-if="state.columns.diff" class="o_la_diff"><div t-if="diffEntries(row.before).length"><b class="before">Before</b><small t-foreach="diffEntries(row.before).slice(0,2)" t-as="entry" t-key="entry.key"><t t-esc="entry.key"/>: <t t-esc="entry.value"/></small></div><div t-if="diffEntries(row.after).length"><b class="after">After</b><small t-foreach="diffEntries(row.after).slice(0,3)" t-as="entry" t-key="entry.key"><t t-esc="entry.key"/>: <t t-esc="entry.value"/></small></div><span t-if="!diffEntries(row.before).length and !diffEntries(row.after).length" t-esc="row.description || '—'"/></td><td t-if="state.columns.ip"><i class="fa fa-sitemap"/> <t t-esc="row.ip_address || '—'"/></td><td t-if="state.columns.device"><i class="fa fa-desktop"/> <t t-esc="deviceLabel(row.device_browser)"/></td><td t-if="state.columns.source"><span t-att-class="'o_la_source '+row.source" t-esc="row.source"/></td><td t-if="state.columns.status"><span t-att-class="'o_la_status '+row.status"><i t-att-class="row.status === 'success' ? 'fa fa-check-circle-o' : row.status === 'failed' ? 'fa fa-times-circle-o':'fa fa-clock-o'"/> <t t-esc="row.status"/></span></td></tr>
      <tr t-if="state.expandedId === row.id" class="o_la_details"><td t-att-colspan="visibleColumnCount"><div><section><h4>Event Details</h4><p><b>Action:</b> <t t-esc="row.action_label"/></p><p><b>Entity:</b> <t t-esc="row.entity_type_label"/> — <t t-esc="row.entity_name"/> <t t-esc="row.entity_reference"/></p><p><b>Description:</b> <t t-esc="row.description || '—'"/></p></section><section><h4>Before</h4><p t-if="!diffEntries(row.before).length">No previous values captured.</p><p t-foreach="diffEntries(row.before)" t-as="entry" t-key="entry.key"><b t-esc="entry.key"/>: <t t-esc="entry.value"/></p></section><section><h4>After</h4><p t-if="!diffEntries(row.after).length">No resulting values captured.</p><p t-foreach="diffEntries(row.after)" t-as="entry" t-key="entry.key"><b t-esc="entry.key"/>: <t t-esc="entry.value"/></p></section><section><h4>Request Context</h4><p><b>Actor:</b> <t t-esc="row.actor"/> (<t t-esc="row.actor_role"/>)</p><p><b>IP:</b> <t t-esc="row.ip_address || '—'"/></p><p><b>Device:</b> <t t-esc="row.device_browser || '—'"/></p></section></div></td></tr></t>
    <tr t-if="!state.loading and !state.rows.length"><td t-att-colspan="visibleColumnCount" class="o_la_empty">No audit entries match the selected filters.</td></tr><tr t-if="state.loading"><td t-att-colspan="visibleColumnCount" class="o_la_empty"><i class="fa fa-spinner fa-spin"/> Loading audit entries...</td></tr>
  </tbody></table></section>
  <footer class="o_la_pager"><label>Rows per page: <select t-model.number="state.perPage" t-on-change="changePerPage"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select></label><span>Showing <t t-esc="state.total ? ((state.page-1)*state.perPage)+1 : 0"/>–<t t-esc="displayEnd"/> of <t t-esc="state.total"/></span><nav><button t-on-click="() => goToPage(state.page-1)" t-att-disabled="state.page === 1">‹</button><button t-foreach="pages" t-as="page" t-key="page" t-att-class="state.page === page ? 'active':''" t-on-click="() => goToPage(page)" t-esc="page"/><button t-on-click="() => goToPage(state.page+1)" t-att-disabled="state.page === pageCount">›</button></nav></footer>
  <div t-if="state.filtersOpen" class="o_la_overlay" t-on-click.self="() => state.filtersOpen=false"><aside class="o_la_filter_drawer"><header><div><h3>Filters</h3><small><t t-esc="activeFilterCount"/> active</small></div><button t-on-click="() => state.filtersOpen=false">×</button></header><div class="o_la_filter_body"><label>Action Type<select t-model="state.filters.action"><option value="">All Actions</option><option t-foreach="state.actions" t-as="item" t-key="item.key" t-att-value="item.key" t-esc="item.label"/></select></label><label>Module Area<select t-model="state.filters.module_area"><option value="">All Areas</option><option value="requests">Requests</option><option value="policies">Policies</option><option value="balance">Balance</option><option value="accrual">Accrual</option><option value="leave_types">Leave Types</option><option value="calendar">Calendar</option><option value="settings">Settings</option></select></label><label>Entity Type<select t-model="state.filters.entity_type"><option value="">All Entities</option><option value="leave_request">Leave Request</option><option value="leave_type">Leave Type</option><option value="policy">Policy</option><option value="balance">Balance</option><option value="accrual_plan">Accrual Plan</option><option value="eligibility_rule">Eligibility Rule</option><option value="system">System</option></select></label><label>Status<select t-model="state.filters.event_status"><option value="">All Statuses</option><option value="success">Success</option><option value="failed">Failed</option><option value="pending">Pending</option></select></label><label>Source<select t-model="state.filters.source"><option value="">All Sources</option><option value="web">Web</option><option value="mobile">Mobile</option><option value="api">API</option><option value="system">System</option></select></label><label>Department<select t-model="state.filters.department_id"><option value="">All Departments</option><option t-foreach="state.departments" t-as="department" t-key="department.id" t-att-value="department.id" t-esc="department.name"/></select></label><label>Performer Role<select t-model="state.filters.actor_role"><option value="">All Roles</option><option t-foreach="state.roles" t-as="role" t-key="role" t-att-value="role" t-esc="role"/></select></label><div class="o_la_dates"><label>From<input type="date" t-model="state.filters.date_from"/></label><label>To<input type="date" t-model="state.filters.date_to"/></label></div></div><footer><button t-on-click="clearFilters">Clear All</button><button class="primary" t-on-click="applyFilters">Apply Filters</button></footer></aside></div>
</main></div></t></templates>
