<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="hr_leave_dashboard.LeavePoliciesPage" owl="1">
    <section class="o_lp_page" t-on-click.self="() => state.menuId=false">
      <header class="o_lp_toolbar">
        <div><h3>Leave Policies</h3><p>Create and manage policies that define leave types, entitlement, eligibility, and rules.</p></div>
        <button class="o_lp_primary" t-on-click="openChooser"><i class="fa fa-plus"/> Add Leave Policy</button>
      </header>
      <div class="o_lp_filters">
        <label><i class="fa fa-search"/><input t-model="state.search" placeholder="Search policies, codes, or leave types…"/></label>
        <div class="o_lp_segment"><button t-att-class="state.listState === 'current' ? 'active' : ''" t-on-click="() => this.setListState('current')">Current Policies</button><button t-att-class="state.listState === 'archived' ? 'active' : ''" t-on-click="() => this.setListState('archived')">Archived Policies</button></div>
      </div>
      <div t-if="state.loading" class="o_lp_empty"><i class="fa fa-spinner fa-spin"/> Loading policies…</div>
      <div t-elif="!visibleRows.length" class="o_lp_empty"><i class="fa fa-file-text-o"/><h4>No policies found</h4><p>Create the first policy or change the current search.</p></div>
      <div t-else="" class="o_lp_table_wrap"><table class="o_lp_table"><thead><tr><th>Policy Name</th><th>Leave Type(s)</th><th>Category</th><th>Compensation</th><th>Unit</th><th>Default Entitlement</th><th>Applicability</th><th>Status</th><th>Assigned To</th><th>Actions</th></tr></thead>
        <tbody><tr t-foreach="visibleRows" t-as="row" t-key="row.id">
          <td><b t-esc="row.name"/><small t-esc="row.code"/></td>
          <td><span class="o_lp_type" t-foreach="row.leave_types" t-as="line" t-key="line.id" t-esc="line.name"/></td>
          <td><span class="o_lp_category" t-att-style="'--tag:' + row.color" t-esc="row.category"/></td>
          <td t-esc="row.leave_types.length === 1 ? row.leave_types[0].compensation.replace('_', ' ') : 'Mixed'"/>
          <td t-esc="row.default_unit || 'Mixed'"/><td t-esc="row.default_entitlement !== false ? row.default_entitlement + ' ' + row.default_unit : 'Per leave type'"/>
          <td t-esc="row.applicability"/><td><span t-att-class="'o_lp_status ' + row.state" t-esc="row.state"/></td>
          <td><span class="o_lp_avatar"><i class="fa fa-users"/> <t t-esc="row.employee_count"/></span></td>
          <td class="o_lp_actions"><button t-on-click.stop="() => state.menuId = state.menuId === row.id ? false : row.id"><i class="fa fa-ellipsis-v"/></button>
            <div t-if="state.menuId === row.id" class="o_lp_menu">
              <button t-on-click="() => this.view(row)"><i class="fa fa-eye"/> View Details</button><button t-on-click="() => this.edit(row)"><i class="fa fa-pencil"/> Edit Policy</button>
              <button t-on-click="() => this.duplicate(row)"><i class="fa fa-copy"/> Duplicate Policy</button><button t-on-click="() => this.openAssign(row)"><i class="fa fa-user-plus"/> Assign Policy</button>
              <button t-if="row.state !== 'archived'" t-on-click="() => this.changeStatus(row)"><i class="fa fa-toggle-on"/> Change Status</button><button class="danger" t-on-click="() => this.remove(row)"><i class="fa fa-trash"/> Delete Policy</button>
            </div>
          </td>
        </tr></tbody></table></div>

      <div t-if="state.chooser" class="o_lp_overlay" t-on-click.self="closeWizard"><aside class="o_lp_drawer"><header><div><h3>Add Leave Policy</h3><p>Choose how you want to create this policy.</p></div><button t-on-click="closeWizard">×</button></header>
        <div class="o_lp_choice"><button t-on-click="() => this.chooseMode('simple')"><i class="fa fa-file-text-o"/><b>Simple Policy</b><span>Basic settings, standard eligibility, and a quick setup.</span></button><button t-on-click="() => this.chooseMode('advanced')"><i class="fa fa-sliders"/><b>Advanced Policy</b><span>Detailed eligibility, per-type accrual, restrictions, documents, blackout periods, and custom approval.</span></button></div>
      </aside></div>

      <div t-if="state.wizard" class="o_lp_overlay" t-on-click.self="closeWizard"><aside class="o_lp_drawer wide"><header><div><h3><t t-esc="state.form.id ? 'Edit' : 'Add'"/> Leave Policy <span t-esc="'(' + state.form.mode + ')'"/></h3><p>Step <t t-esc="state.step"/> of <t t-esc="steps.length"/> · <t t-esc="currentStepLabel"/></p></div><button t-on-click="closeWizard">×</button></header>
        <nav class="o_lp_steps"><button t-foreach="steps" t-as="label" t-key="label_index" t-att-class="state.step === label_index + 1 ? 'active' : (state.step > label_index + 1 ? 'done' : '')" t-on-click="() => this.goStep(label_index + 1)"><i t-esc="label_index + 1"/><span t-esc="label"/></button></nav>
        <div class="o_lp_form">
          <t t-if="(state.form.mode === 'simple' and state.step === 1) or (state.form.mode === 'advanced' and state.step === 1)">
            <h4>Basic Information<t t-if="state.form.mode === 'advanced'"> &amp; Eligibility</t></h4><div class="o_lp_grid"><label>Policy Name *<input t-model="state.form.name"/></label><label>Policy Code<input t-model="state.form.code" placeholder="Generated if blank"/></label><label>Category / Label<input t-model="state.form.category"/></label><label>Colour<input type="color" t-model="state.form.color"/></label><label class="full">Description<textarea t-model="state.form.description"/></label></div>
            <div t-if="state.form.mode === 'advanced'" class="o_lp_section"><h4>Eligibility</h4><div class="o_lp_radio"><label><input type="radio" value="all" t-model="state.form.apply_to"/> All Employees</label><label><input type="radio" value="selected" t-model="state.form.apply_to"/> Select Employees / Groups</label><label><input type="radio" value="conditions" t-model="state.form.apply_to"/> Add Conditions</label></div><t t-call="hr_leave_dashboard.PolicyEligibility"/></div>
            <div t-if="state.form.mode === 'simple'" class="o_lp_section"><t t-call="hr_leave_dashboard.PolicyLines"/><h4>Assign To</h4><p class="hint">Leave blank to make this policy available to all employees.</p><t t-call="hr_leave_dashboard.PolicyEligibility"/></div>
          </t>
          <t t-if="state.form.mode === 'advanced' and state.step === 2"><t t-call="hr_leave_dashboard.PolicyLines"/></t>
          <t t-if="state.form.mode === 'advanced' and state.step === 3"><h4>Rules &amp; Restrictions</h4><div class="o_lp_line" t-foreach="state.form.lines" t-as="line" t-key="line_index"><h5 t-esc="line.leave_type || 'Leave Type ' + (line_index + 1)"/><div class="o_lp_grid"><label>Minimum Notice (days)<input type="number" min="0" t-model.number="line.minimum_notice_days"/></label><label>Minimum Duration<input type="number" min="0" step="0.5" t-model.number="line.minimum_duration"/></label><label>Maximum Duration<input type="number" min="0" step="0.5" t-model.number="line.maximum_duration"/></label><label>Documents required after<input type="number" min="0" t-model.number="line.document_required_after_days"/></label><label class="full">Accepted document types<input t-model="line.accepted_document_types" placeholder="Medical certificate, supporting letter"/></label><label><input type="checkbox" t-model="line.allow_half_day"/> Allow half-day</label><label><input type="checkbox" t-model="line.allow_backdated"/> Allow backdated requests</label><label><input type="checkbox" t-model="line.allow_overlap"/> Allow overlapping requests</label><div class="full"><b>Blackout restrictions</b><p class="hint">Select existing blackout windows. Leave empty for no policy-specific blackout restriction.</p><label t-foreach="state.options.blackout_periods || []" t-as="period" t-key="period.id"><input type="checkbox" t-att-checked="line.blackout_period_ids.includes(period.id)" t-on-change="() => this.toggleBlackout(line, period.id)"/><span t-esc="period.name"/></label></div></div></div></t>
          <t t-if="(state.form.mode === 'simple' and state.step === 2) or (state.form.mode === 'advanced' and state.step === 4)"><h4>Carry Forward</h4><label class="o_lp_switch"><input type="checkbox" t-model="state.form.carry.enabled"/> Allow unused leave to be carried forward</label><div t-if="state.form.carry.enabled" class="o_lp_grid"><label>Maximum Carry Forward<input type="number" min="0" t-model.number="state.form.carry.maximum"/></label><label>Expiry<input type="number" min="0" t-model.number="state.form.carry.expiry_value"/></label><label>Expiry Unit<select t-model="state.form.carry.expiry_unit"><option value="days">Days</option><option value="months">Months</option></select></label><label>Balance Usage Priority<select t-model="state.form.carry.priority"><option value="current">Current balance first</option><option value="carried">Carried-forward first</option></select></label></div><h4>Approval Settings</h4><label class="o_lp_switch"><input type="checkbox" t-model="state.form.approval.required"/> Approval required</label><div t-if="state.form.approval.required" class="o_lp_grid"><label>Workflow<select t-model="state.form.approval.workflow"><option value="default">Default workflow</option><option value="custom">Custom workflow</option></select></label><label t-if="state.form.approval.workflow === 'custom'">Approval Route<select t-model.number="state.form.approval.chain_id"><option value="">Select route</option><option t-foreach="state.options.approval_chains || []" t-as="item" t-key="item.id" t-att-value="item.id" t-esc="item.name"/></select></label></div><h4>Additional Rules</h4><div class="o_lp_checks"><label><input type="checkbox" t-model="state.form.rules.multiple"/> Allow multiple future requests</label><label><input type="checkbox" t-model="state.form.rules.withdrawal"/> Allow withdrawal of pending requests</label><label><input type="checkbox" t-model="state.form.rules.half_day"/> Allow half-day leave</label></div></t>
          <t t-if="isReview"><h4>Review &amp; Save</h4><div class="o_lp_summary"><section><b>Basic Information</b><button t-on-click="() => this.goStep(1)">Edit</button><p><strong t-esc="state.form.name"/> · <t t-esc="state.form.code || 'Code generated on save'"/></p><p t-esc="state.form.description || 'No description'"/></section><section><b>Leave Types &amp; Entitlement</b><button t-on-click="() => this.goStep(state.form.mode === 'advanced' ? 2 : 1)">Edit</button><p t-foreach="state.form.lines" t-as="line" t-key="line_index"><t t-esc="line.leave_type || line.new_leave_type_name || 'Selected Leave Type'"/> — <t t-esc="line.accrual_amount"/> <t t-esc="line.unit"/> / <t t-esc="line.accrual_period"/></p></section><section><b>Carry Forward &amp; Approval</b><button t-on-click="() => this.goStep(state.form.mode === 'advanced' ? 4 : 2)">Edit</button><p>Carry forward: <t t-esc="state.form.carry.enabled ? 'Yes' : 'No'"/> · Approval: <t t-esc="state.form.approval.required ? state.form.approval.workflow : 'Not required'"/></p></section></div><label>When employee assignment conflicts are found<select t-model="state.form.conflict_resolution"><option value="review">Review conflicts (save is blocked)</option><option value="keep">Keep existing assignments; remove conflicting employees</option><option value="replace">Replace existing assignments from effective date</option></select></label></t>
        <table t-if="isReview and state.conflicts.length" class="table"><thead><tr><th>Employee</th><th>Leave Type</th><th>Existing Policy</th><th>Effective From</th><th>Entitlement</th></tr></thead><tbody><tr t-foreach="state.conflicts" t-as="conflict" t-key="conflict.id"><td t-esc="conflict.employee"/><td t-esc="conflict.leave_type"/><td t-esc="conflict.existing_policy"/><td t-esc="conflict.effective_date"/><td t-esc="conflict.entitlement"/></tr></tbody></table></div><footer><button t-on-click="closeWizard">Cancel</button><button t-if="isReview" t-att-disabled="state.saving" t-on-click="() => this.save(true)">Save Draft</button><button t-if="state.step > 1" t-on-click="back">Back</button><button t-if="!isReview" class="o_lp_primary" t-on-click="next">Next: <t t-esc="steps[state.step]"/> →</button><button t-else="" class="o_lp_primary" t-att-disabled="state.saving" t-on-click="() => this.save(false)"><i t-if="state.saving" class="fa fa-spinner fa-spin"/> Save Policy</button></footer>
      </aside></div>

      <div t-if="state.detail" class="o_lp_overlay" t-on-click.self="() => state.detail=false"><aside class="o_lp_drawer"><header><div><h3 t-esc="state.detail.name"/><p><t t-esc="state.detail.code"/> · <t t-esc="state.detail.state"/></p></div><button t-on-click="() => state.detail=false">×</button></header><div class="o_lp_form o_lp_details"><section><h4>Description</h4><p t-esc="state.detail.description || 'No description'"/></section><section><h4>Leave Types</h4><p t-foreach="state.detail.lines" t-as="line" t-key="line.id"><b t-esc="line.leave_type"/> — <t t-esc="line.accrual_amount"/> <t t-esc="line.unit"/> / <t t-esc="line.accrual_period"/></p></section><section><h4>Applicability</h4><p t-esc="state.detail.applicability"/></section><section><h4>Carry Forward &amp; Approval</h4><p>Carry forward: <t t-esc="state.detail.carry.enabled ? 'Enabled' : 'Disabled'"/> · Approval: <t t-esc="state.detail.approval.required ? state.detail.approval.workflow : 'Not required'"/></p></section></div><footer><button class="o_lp_primary" t-on-click="() => state.detail=false">Done</button></footer></aside></div>

      <div t-if="state.assign" class="o_lp_overlay" t-on-click.self="() => state.assign=false"><aside class="o_lp_drawer"><header><div><h3>Assign Policy</h3><p t-esc="state.assign.name"/></div><button t-on-click="() => state.assign=false">×</button></header><div class="o_lp_form"><label>Effective Date<input type="date" t-model="state.assignDate"/></label><label>Conflict action<select t-model="state.assignResolution"><option value="review">Review — make no change</option><option value="keep">Keep existing; skip conflicting employees</option><option value="replace">Replace existing assignment</option></select></label><h4>Employees</h4><div class="o_lp_select_list"><label t-foreach="state.options.employees || []" t-as="employee" t-key="employee.id"><input type="checkbox" t-att-checked="state.assignEmployeeIds.includes(employee.id)" t-on-change="() => this.toggleAssignEmployee(employee.id)"/><span t-esc="employee.name"/></label></div></div><footer><button t-on-click="() => state.assign=false">Cancel</button><button class="o_lp_primary" t-on-click="assignPolicy">Assign Policy</button></footer></aside></div>
    </section>
  </t>

  <t t-name="hr_leave_dashboard.PolicyEligibility">
    <div t-if="state.form.apply_to !== 'all'" class="o_lp_eligibility"><label>Match<select t-model="state.form.condition_match"><option value="all">All selected conditions</option><option value="any">Any selected condition</option></select></label><label>Minimum tenure (months)<input type="number" min="0" t-model.number="state.form.minimum_tenure_months"/></label><div class="o_lp_multi" t-foreach="[['department_ids','Departments','departments'],['unit_ids','Units','units'],['grade_ids','Grades','grades'],['location_ids','Locations','locations'],['employee_type_ids','Employment Types','employee_types'],['job_ids','Job Roles','jobs'],['employee_ids','Employees','employees']]" t-as="group" t-key="group[0]"><b t-esc="group[1]"/><label t-foreach="state.options[group[2]] || []" t-as="item" t-key="item.id"><input type="checkbox" t-att-checked="isSelected(group[0], item.id)" t-on-change="() => this.toggleSelected(group[0], item.id)"/><span t-esc="item.name"/></label></div></div>
  </t>
  <t t-name="hr_leave_dashboard.PolicyLines">
    <h4>Leave Types &amp; Accrual</h4><div class="o_lp_line" t-foreach="state.form.lines" t-as="line" t-key="line_index"><div class="o_lp_line_head"><b>Leave Type <t t-esc="line_index + 1"/></b><button t-if="state.form.lines.length > 1" t-on-click="() => this.removeLine(line_index)"><i class="fa fa-trash"/></button></div><div class="o_lp_grid"><label>Existing Leave Type<select t-model.number="line.leave_type_id"><option value="">Create a custom type below</option><option t-foreach="state.options.leave_types || []" t-as="item" t-key="item.id" t-att-value="item.id" t-esc="item.name"/></select></label><label>+ Add Leave Type<input t-model="line.new_leave_type_name" placeholder="Custom leave type name" t-att-disabled="line.leave_type_id"/></label><label>Compensation<select t-model="line.compensation"><option value="paid">Paid</option><option value="unpaid">Unpaid</option><option value="partially_paid">Partially Paid</option></select></label><label>Unit<select t-model="line.unit"><option value="days">Days</option><option value="hours">Hours</option></select></label><label>Entitlement Type<select t-model="line.entitlement_type"><option value="fixed">Fixed</option><option value="accrued">Accrued</option></select></label><label>Accrual Period<select t-model="line.accrual_period"><option value="annually">Annually</option><option value="monthly">Monthly</option><option value="weekly">Weekly</option></select></label><label>Accrual Basis / Start Date<select t-model="line.accrual_basis"><option value="join_date">Joined Date</option><option value="calendar">Calendar Year</option><option value="anniversary">Anniversary</option></select></label><label>Accrual Amount<input type="number" min="0" step="0.5" t-model.number="line.accrual_amount"/></label><label>Waiting Period (days)<input type="number" min="0" t-model.number="line.waiting_period_days"/></label><label><input type="checkbox" t-model="line.exclude_public_holidays"/> Exclude public holidays</label><label><input type="checkbox" t-model="line.exclude_non_working_days"/> Exclude non-working days</label></div></div><button class="o_lp_add_line" t-on-click="addLine"><i class="fa fa-plus"/> Add another Leave Type</button>
  </t>
</templates>
