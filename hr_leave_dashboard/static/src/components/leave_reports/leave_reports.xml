<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="hr_leave_dashboard.LeaveReportsPage" owl="1">
    <div class="leaveapp o_lr_page o_lra_page">
      <CalendarSidebar activeMenu="'reports'"/>
      <main class="o_leave_dashboard o_lr_main o_lra_main">
        <header class="o_lra_header">
          <div>
            <p class="o_lra_eyebrow">Reporting &amp; Analytics</p>
            <h2>Leave Reports</h2>
            <p>Live, permission-scoped analysis of leave activity, balances, approval performance and absence patterns.</p>
          </div>
          <div class="o_lra_header_meta">
            <span><i class="fa fa-shield"/> <t t-esc="state.data.meta.scope_label || 'Authorised scope'"/></span>
            <small><t t-esc="state.data.meta.employee_count || 0"/> employees · refreshed <t t-esc="state.lastRefreshed || '—'"/></small>
          </div>
        </header>

        <section class="o_lra_toolbar">
          <label class="o_lra_picker">
            <span>Report</span>
            <select t-model="state.activeReport" t-on-change="(ev) => this.setReport(ev.target.value)">
              <option t-foreach="reports" t-as="report" t-key="report.key" t-att-value="report.key" t-esc="report.label"/>
            </select>
          </label>
          <label t-if="usesDateRange" class="o_lra_picker o_lra_period">
            <span>Date range</span>
            <select t-model="state.filters.date_range" t-on-change="setDateRange">
              <option value="this_month">This Month</option>
              <option value="last_quarter">Last Quarter</option>
              <option value="this_quarter">This Quarter</option>
              <option value="this_year">This Year</option>
              <option value="custom">Custom</option>
            </select>
          </label>
          <t t-if="usesDateRange and state.filters.date_range === 'custom'">
            <input class="o_lra_date" type="date" t-model="state.filters.start_date"/>
            <span>to</span>
            <input class="o_lra_date" type="date" t-model="state.filters.end_date"/>
            <button class="o_lra_apply" t-on-click="refresh">Apply</button>
          </t>
          <div class="o_lra_filter_control">
            <button class="o_lra_filter_button" t-on-click="() => this.state.filtersOpen = !this.state.filtersOpen">
              <i class="fa fa-filter"/> Filters <b t-if="activeFilterCount" t-esc="activeFilterCount"/>
            </button>
            <div t-if="state.filtersOpen" class="o_lra_filter_popover">
              <header><strong>Filter report</strong><button t-if="activeFilterCount" t-on-click="clearFilters">Clear all</button></header>
              <div class="o_lra_filter_groups">
                <section t-foreach="filterGroups" t-as="group" t-key="group.key">
                  <h4 t-esc="group.label"/>
                  <label t-foreach="group.rows" t-as="row" t-key="row.id">
                    <input type="checkbox" t-att-checked="isSelected(group.key, row.id)" t-on-change="() => this.toggleFilter(group.key, row.id)"/>
                    <span t-esc="row.name"/>
                  </label>
                  <small t-if="!group.rows.length">No options in your scope</small>
                </section>
              </div>
              <footer><button t-on-click="() => this.state.filtersOpen = false">Cancel</button><button class="primary" t-on-click="applyFilters">Apply filters</button></footer>
            </div>
          </div>
          <div class="o_lra_export">
            <button class="o_lra_export_button" t-on-click="() => this.state.exportOpen = !this.state.exportOpen" t-att-disabled="state.exporting">
              <i t-att-class="state.exporting ? 'fa fa-spinner fa-spin' : 'fa fa-download'"/> Export <i class="fa fa-caret-down"/>
            </button>
            <div t-if="state.exportOpen" class="o_lra_export_menu">
              <button t-on-click="() => this.exportReport('xlsx')"><i class="fa fa-file-excel-o"/> Excel (.xlsx)</button>
              <button t-on-click="() => this.exportReport('csv')"><i class="fa fa-file-text-o"/> CSV</button>
              <button t-on-click="() => this.exportReport('pdf')"><i class="fa fa-file-pdf-o"/> PDF</button>
            </div>
          </div>
        </section>

        <div t-if="activeChips.length" class="o_lra_chips">
          <span t-foreach="activeChips" t-as="chip" t-key="chip.key + '_' + chip.id"><t t-esc="chip.label"/><button t-on-click="() => this.removeChip(chip)">×</button></span>
          <button t-on-click="clearFilters">Clear all</button>
        </div>

        <nav class="o_lra_tabs">
          <button t-foreach="reports" t-as="report" t-key="report.key" t-att-class="state.activeReport === report.key ? 'active' : ''" t-on-click="() => this.setReport(report.key)">
            <i t-att-class="'fa ' + report.icon"/><span t-esc="report.label"/>
          </button>
        </nav>

        <div t-if="state.loading" class="o_lra_loading"><i class="fa fa-spinner fa-spin"/><strong>Building authorised report…</strong><span>Calculating from current leave and balance records.</span></div>
        <t t-else="">
          <section class="o_lra_report_heading">
            <div><h3 t-esc="activeDefinition.label"/><p t-if="usesDateRange"><t t-esc="state.data.meta.period.start"/> – <t t-esc="state.data.meta.period.end"/></p><p t-else="" t-esc="state.data.meta.metric_basis"/></div>
            <button t-if="state.activeReport === 'absence_risk' and state.data.meta.can_configure_risk" t-on-click="openRiskSettings"><i class="fa fa-cog"/> Configure scoring</button>
          </section>

          <section t-if="['request_volume','utilisation','turnaround','trends','frequency','absence_risk'].includes(state.activeReport)" class="o_lra_chart_card">
            <div class="o_lra_chart"><canvas t-ref="reportChart"/></div>
          </section>

          <t t-if="state.activeReport === 'request_volume'">
            <div class="o_lra_kpis">
              <article><small>Submitted</small><strong t-esc="state.data.reports.request_volume.total"/><span><t t-esc="state.data.reports.request_volume.change_percent"/>% vs prior period</span></article>
              <article class="good"><small>Approved</small><strong t-esc="state.data.reports.request_volume.counts.approved || 0"/></article>
              <article class="warn"><small>Pending</small><strong t-esc="state.data.reports.request_volume.counts.pending || 0"/></article>
              <article class="bad"><small>Rejected / Cancelled</small><strong><t t-esc="(state.data.reports.request_volume.counts.rejected || 0) + (state.data.reports.request_volume.counts.cancelled || 0)"/></strong></article>
            </div>
            <section class="o_lra_table_card"><h4>Monthly request volume</h4><div class="o_lra_table_wrap"><table><thead><tr><th>Month</th><th>Submitted</th><th>Approved</th><th>Pending</th><th>Changes Requested</th><th>Rejected</th><th>Cancelled</th></tr></thead><tbody><tr t-foreach="state.data.reports.request_volume.monthly" t-as="row" t-key="row.month"><td><b t-esc="row.month"/></td><td t-esc="row.submitted"/><td t-esc="row.approved"/><td t-esc="row.pending"/><td t-esc="row.changes_requested"/><td t-esc="row.rejected"/><td t-esc="row.cancelled"/></tr></tbody></table></div></section>
          </t>

          <t t-elif="state.activeReport === 'utilisation'">
            <div class="o_lra_split">
              <section class="o_lra_table_card"><h4>Utilisation by Leave Type</h4><div class="o_lra_table_wrap"><table><thead><tr><th>Leave Type</th><th>Allocated</th><th>Used</th><th>Pending</th><th>Available</th><th>Utilisation</th></tr></thead><tbody><tr t-foreach="state.data.reports.utilisation.by_type" t-as="row" t-key="row.id"><td><b t-esc="row.name"/></td><td t-esc="row.allocated"/><td t-esc="row.used"/><td t-esc="row.pending"/><td t-esc="row.available"/><td><div class="o_lra_meter"><i t-att-style="'width:' + Math.min(row.utilisation, 100) + '%'"/></div><span><t t-esc="row.utilisation"/>%</span></td></tr></tbody></table></div></section>
              <section class="o_lra_table_card"><h4>Utilisation by Employee</h4><div class="o_lra_table_wrap"><table><thead><tr><th>Employee</th><th>Department</th><th>Allocated</th><th>Used</th><th>Available</th><th>Utilisation</th></tr></thead><tbody><tr t-foreach="state.data.reports.utilisation.by_employee" t-as="row" t-key="row.id"><td><b t-esc="row.name"/></td><td t-esc="row.department"/><td t-esc="row.allocated"/><td t-esc="row.used"/><td t-esc="row.available"/><td><span class="o_lra_percent"><t t-esc="row.utilisation"/>%</span></td></tr></tbody></table></div></section>
            </div>
          </t>

          <t t-elif="state.activeReport === 'balances'">
            <div class="o_lra_kpis five"><article><small>Available</small><strong t-esc="state.data.reports.balances.totals.available || 0"/></article><article><small>Used</small><strong t-esc="state.data.reports.balances.totals.used || 0"/></article><article><small>Pending</small><strong t-esc="state.data.reports.balances.totals.pending || 0"/></article><article><small>Carried Forward</small><strong t-esc="state.data.reports.balances.totals.carried_forward || 0"/></article><article class="warn"><small>Expiring</small><strong t-esc="state.data.reports.balances.totals.expiring || 0"/></article></div>
            <section class="o_lra_table_card"><h4>Current balance detail</h4><div class="o_lra_table_wrap"><table><thead><tr><th>Employee</th><th>Department</th><th>Leave Type</th><th>Available</th><th>Used</th><th>Pending</th><th>Carried Forward</th><th>Expiring</th><th>Expiry</th></tr></thead><tbody><tr t-foreach="state.data.reports.balances.rows" t-as="row" t-key="row.employee_id + '_' + row.leave_type_id"><td><b t-esc="row.employee"/></td><td t-esc="row.department"/><td t-esc="row.leave_type"/><td t-esc="row.available"/><td t-esc="row.used"/><td t-esc="row.pending"/><td t-esc="row.carried_forward"/><td t-esc="row.expiring"/><td t-esc="formatDate(row.expiry_date)"/></tr></tbody></table></div></section>
          </t>

          <t t-elif="state.activeReport === 'turnaround'">
            <div class="o_lra_kpis"><article><small>Average turnaround</small><strong><t t-esc="state.data.reports.turnaround.average_hours"/>h</strong></article><article class="warn"><small>Longest decision</small><strong><t t-esc="state.data.reports.turnaround.longest_hours"/>h</strong></article><article><small>Completed decisions</small><strong t-esc="state.data.reports.turnaround.decisions"/></article></div>
            <div class="o_lra_split"><section class="o_lra_table_card"><h4>By approver</h4><table><thead><tr><th>Approver</th><th>Decisions</th><th>Average</th><th>Longest</th></tr></thead><tbody><tr t-foreach="state.data.reports.turnaround.by_approver" t-as="row" t-key="row.name"><td><b t-esc="row.name"/></td><td t-esc="row.decisions"/><td><t t-esc="row.average_hours"/>h</td><td><t t-esc="row.longest_hours"/>h</td></tr></tbody></table></section><section class="o_lra_table_card"><h4>By Leave Type</h4><table><thead><tr><th>Leave Type</th><th>Decisions</th><th>Average</th><th>Longest</th></tr></thead><tbody><tr t-foreach="state.data.reports.turnaround.by_type" t-as="row" t-key="row.name"><td><b t-esc="row.name"/></td><td t-esc="row.decisions"/><td><t t-esc="row.average_hours"/>h</td><td><t t-esc="row.longest_hours"/>h</td></tr></tbody></table></section></div>
          </t>

          <t t-elif="state.activeReport === 'trends'">
            <div class="o_lra_info"><i class="fa fa-calendar"/><span><b t-esc="state.data.reports.trends.holiday_adjacent_requests || 0"/> approved request(s) begin or end adjacent to a public holiday in this period.</span></div>
            <section class="o_lra_table_card"><h4>Monthly absence trend</h4><table><thead><tr><th>Month</th><th>Approved Requests</th><th>Approved Days</th></tr></thead><tbody><tr t-foreach="state.data.reports.trends.monthly" t-as="row" t-key="row.month"><td><b t-esc="row.month"/></td><td t-esc="row.requests"/><td t-esc="row.days"/></tr></tbody></table></section>
          </t>

          <t t-elif="state.activeReport === 'frequency'">
            <div class="o_lra_segmented"><button t-foreach="['department','location','unit']" t-as="dimension" t-key="dimension" t-att-class="state.frequencyDimension === dimension ? 'active' : ''" t-on-click="() => this.setFrequencyDimension(dimension)"><t t-esc="dimension.charAt(0).toUpperCase() + dimension.slice(1)"/></button></div>
            <section class="o_lra_table_card"><h4>Ranked Leave Frequency</h4><p>Raw volume and normalised rate are shown together. Select a row to see its individual requests.</p><div class="o_lra_table_wrap"><table class="clickable"><thead><tr><th>Rank</th><th><t t-esc="state.frequencyDimension.charAt(0).toUpperCase() + state.frequencyDimension.slice(1)"/></th><th>Requests</th><th>Total Days Taken</th><th>Headcount</th><th>Requests / Employee</th><th/></tr></thead><tbody><tr t-foreach="currentFrequencyRows" t-as="row" t-key="row.id" t-on-click="() => this.openDrilldown(row)"><td><span class="o_lra_rank" t-esc="row.rank"/></td><td><b t-esc="row.name"/></td><td t-esc="row.requests"/><td t-esc="row.days"/><td t-esc="row.headcount"/><td><span class="o_lra_rate" t-esc="row.requests_per_employee"/></td><td><i class="fa fa-chevron-right"/></td></tr></tbody></table></div></section>
          </t>

          <t t-elif="state.activeReport === 'policy_usage'">
            <section class="o_lra_table_card"><h4>Policy usage and configured limits</h4><p>The current build stores these policy controls on Leave Types pending the versioned Leave Policy migration.</p><div class="o_lra_table_wrap"><table><thead><tr><th>Policy / Leave Type</th><th>Covered Employees</th><th>Requests</th><th>Avg Notice</th><th>Notice Limit</th><th>Longest Request</th><th>Consecutive Limit</th><th>Blackout Rules</th></tr></thead><tbody><tr t-foreach="state.data.reports.policy_usage" t-as="row" t-key="row.id"><td><b t-esc="row.name"/></td><td t-esc="row.employees"/><td t-esc="row.requests"/><td><t t-esc="row.average_notice"/> days</td><td><t t-esc="row.notice_limit"/> days</td><td><t t-esc="row.longest_request"/> days</td><td><t t-esc="row.consecutive_limit || 'No limit'"/></td><td t-esc="row.blackout_periods"/></tr></tbody></table></div></section>
          </t>

          <t t-elif="state.activeReport === 'absence_risk'">
            <div class="o_lra_privacy"><i class="fa fa-lock"/><div><b>Privacy-controlled workforce signal</b><p t-if="state.data.reports.absence_risk.mode === 'detail'">You can view the formula inputs and numeric score because you hold an HR Administrator or HR Director role.</p><p t-elif="state.data.reports.absence_risk.mode === 'team_flags'">Managers see only Low/Watch flags for their own team; numeric scores, spell dates and day counts remain private.</p><p t-else="">This view is aggregated. Individual employees and scores are not exposed to this reporting role.</p></div></div>
            <div t-if="state.data.reports.absence_risk.mode !== 'team_flags'" class="o_lra_band_cards"><article class="low"><small>Low</small><strong t-esc="state.data.reports.absence_risk.bands.low || 0"/></article><article class="caution"><small>Caution</small><strong t-esc="state.data.reports.absence_risk.bands.caution || 0"/></article><article class="concern"><small>Concern</small><strong t-esc="state.data.reports.absence_risk.bands.concern || 0"/></article><article class="serious"><small>Serious</small><strong t-esc="state.data.reports.absence_risk.bands.serious || 0"/></article><article class="critical"><small>Critical</small><strong t-esc="state.data.reports.absence_risk.bands.critical || 0"/></article></div>
            <section t-if="state.data.reports.absence_risk.mode === 'detail'" class="o_lra_table_card"><h4>Bradford Factor detail</h4><p>S² × D over the configured rolling window. This is advisory only and never triggers an automatic decision.</p><table><thead><tr><th>Employee</th><th>Department</th><th>Location</th><th>Score</th><th>Band</th><th>Spells</th><th>Days</th></tr></thead><tbody><tr t-foreach="state.data.reports.absence_risk.rows" t-as="row" t-key="row.employee_id"><td><b t-esc="row.employee"/></td><td t-esc="row.department"/><td t-esc="row.location"/><td><strong t-esc="row.score"/></td><td><span t-att-class="'o_lra_band ' + row.band" t-esc="formatBand(row.band)"/></td><td t-esc="row.spells"/><td t-esc="row.days"/></tr></tbody></table></section>
            <section t-if="state.data.reports.absence_risk.mode === 'team_flags'" class="o_lra_table_card"><h4>Team attendance pattern flags</h4><table><thead><tr><th>Employee</th><th>Department</th><th>Attendance Pattern</th></tr></thead><tbody><tr t-foreach="state.data.reports.absence_risk.rows" t-as="row" t-key="row.employee_id"><td><b t-esc="row.employee"/></td><td t-esc="row.department"/><td><span t-att-class="'o_lra_flag ' + row.flag" t-esc="row.flag === 'watch' ? 'Attendance pattern under review' : 'Low'"/></td></tr></tbody></table></section>
          </t>

          <t t-elif="state.activeReport === 'anomalies'">
            <div class="o_ano_filters_card">
              <div class="o_ano_filters_grid">
                <label class="o_ano_filter_field">
                  <span>Severity</span>
                  <select t-att-value="state.anomalyFilters.severity" t-on-change="(ev) => this.setAnomalyFilter('severity', ev.target.value)">
                    <option value="all">All Severities</option>
                    <option value="high">High</option>
                    <option value="medium">Medium</option>
                    <option value="low">Low</option>
                  </select>
                </label>
                <label class="o_ano_filter_field">
                  <span>Department</span>
                  <select t-att-value="state.anomalyFilters.department_id" t-on-change="(ev) => this.setAnomalyFilter('department_id', ev.target.value)">
                    <option value="">All Departments</option>
                    <option t-foreach="state.data.options.departments || []" t-as="dept" t-key="dept.id" t-att-value="dept.id" t-esc="dept.name"/>
                  </select>
                </label>
                <label class="o_ano_filter_field">
                  <span>Pattern Type</span>
                  <select t-att-value="state.anomalyFilters.pattern_type" t-on-change="(ev) => this.setAnomalyFilter('pattern_type', ev.target.value)">
                    <option value="all">All Pattern Types</option>
                    <option value="mon_fri_cluster">Frequent Monday/Friday leave</option>
                    <option value="adjacent_to_holiday">Short-notice sick leave adjacent to holiday</option>
                    <option value="high_short_absence">High frequency short absences</option>
                  </select>
                </label>
                <label class="o_ano_filter_field">
                  <span>Status</span>
                  <select t-att-value="state.anomalyFilters.status" t-on-change="(ev) => this.setAnomalyFilter('status', ev.target.value)">
                    <option value="all">All Statuses</option>
                    <option value="open">Open</option>
                    <option value="reviewed">Reviewed</option>
                    <option value="escalated">Escalated</option>
                  </select>
                </label>
              </div>
            </div>

            <div class="o_lra_info">
              <i class="fa fa-shield"/>
              <span><b>Fraud &amp; Anomaly Detection (Advisory)</b> — All flags are pattern-based indicators for HR investigation. Employees never see anomaly alerts raised about themselves, and no automatic disciplinary action is ever taken.</span>
            </div>

            <section class="o_lra_table_card">
              <div class="o_ano_table_header">
                <div>
                  <h4>Anomaly Alerts</h4>
                  <p>Active pattern alerts crossing configured sensitivity thresholds in the rolling 180-day window.</p>
                </div>
                <div class="o_ano_counts">
                  <span>Total alerts: <strong t-esc="state.data.reports.anomalies.total || (state.data.reports.anomalies.rows and state.data.reports.anomalies.rows.length) || 0"/></span>
                </div>
              </div>
              <div class="o_lra_table_wrap">
                <table class="o_ano_table">
                  <thead>
                    <tr>
                      <th>Employee</th>
                      <th>Department</th>
                      <th>Pattern Type</th>
                      <th>Severity</th>
                      <th>Last Detected</th>
                      <th>Occurrences</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="state.data.reports.anomalies.rows || []" t-as="row" t-key="row.id">
                      <td><b t-esc="row.employee"/></td>
                      <td t-esc="row.department"/>
                      <td>
                        <span t-esc="row.pattern_type_label"/>
                        <small class="o_ano_supporting_hint" t-if="row.supporting_data" t-esc="row.supporting_data"/>
                      </td>
                      <td>
                        <span t-att-class="'o_ano_badge o_ano_sev_' + row.severity" t-esc="row.severity_label"/>
                      </td>
                      <td t-esc="row.last_detected"/>
                      <td><span class="o_ano_occ" t-esc="row.occurrences"/></td>
                      <td>
                        <span t-att-class="'o_ano_badge o_ano_status_' + row.status" t-esc="row.status"/>
                      </td>
                      <td>
                        <div class="o_ano_action_btns">
                          <button class="o_ano_btn_review" t-on-click="() => this.openAnomalyAction(row, 'review')" title="Mark as Reviewed">
                            <i class="fa fa-check"/> Review
                          </button>
                          <button class="o_ano_btn_escalate" t-on-click="() => this.openAnomalyAction(row, 'escalate')" title="Escalate to HR">
                            <i class="fa fa-exclamation-circle"/> Escalate
                          </button>
                        </div>
                      </td>
                    </tr>
                    <tr t-if="!(state.data.reports.anomalies.rows and state.data.reports.anomalies.rows.length)">
                      <td colspan="8" class="o_lr_no_data">
                        <i class="fa fa-check-circle-o" style="font-size: 28px; color: #16a36a; margin-bottom: 8px; display: block;"/>
                        No anomaly alerts found for the selected filters.
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </section>
          </t>

          <t t-elif="state.activeReport === 'executive_brief'">
            <div class="o_eb_toolbar">
              <div class="o_eb_month_nav">
                <button class="o_eb_nav_btn" t-on-click="prevMonth" title="Previous month"><i class="fa fa-chevron-left"/></button>
                <span class="o_eb_month_title"><i class="fa fa-calendar"/> <t t-esc="state.data.reports.executive_brief.period_title || state.briefMonth"/></span>
                <button class="o_eb_nav_btn" t-on-click="nextMonth" title="Next month"><i class="fa fa-chevron-right"/></button>
                <input type="month" class="o_eb_month_input" t-att-value="state.briefMonth" t-on-change="(ev) => this.setBriefMonth(ev.target.value)"/>
              </div>
              <label class="o_lra_picker">
                <span>Department</span>
                <select t-att-value="state.briefDepartmentId" t-on-change="(ev) => this.setBriefDepartment(ev.target.value)">
                  <option value="">All Business Units</option>
                  <option t-foreach="state.data.options.departments || []" t-as="dept" t-key="dept.id" t-att-value="dept.id" t-esc="dept.name"/>
                </select>
              </label>
              <div class="o_eb_toolbar_actions">
                <button class="o_eb_btn_generate" t-on-click="refresh">
                  <i class="fa fa-magic"/> Generate Brief
                </button>
              </div>
            </div>

            <div class="o_eb_brief_container">
              <header class="o_eb_brief_header">
                <div>
                  <span class="o_eb_badge"><i class="fa fa-line-chart"/> AI Executive Brief</span>
                  <h3 t-esc="(state.data.reports.executive_brief.period_title || state.briefMonth) + ' Workforce Summary'"/>
                  <p>Consolidated workforce leave health, approval SLAs, department concentration, and proactive staffing recommendations.</p>
                </div>
                <div class="o_eb_export_btns">
                  <button class="o_eb_btn_dl" t-on-click="() => this.exportReport('pdf')">
                    <i class="fa fa-file-pdf-o"/> Download PDF
                  </button>
                </div>
              </header>

              <div class="o_eb_kpi_grid">
                <div class="o_eb_kpi_card">
                  <span class="o_eb_kpi_num" t-esc="state.data.reports.executive_brief.kpis?.requests_approved || 0"/>
                  <strong class="o_eb_kpi_label">Leave Requests Approved</strong>
                  <small class="o_eb_kpi_sub good"><i class="fa fa-arrow-up"/> Approved in period</small>
                </div>
                <div class="o_eb_kpi_card">
                  <span class="o_eb_kpi_num warn" t-esc="state.data.reports.executive_brief.kpis?.pending_approvals || 0"/>
                  <strong class="o_eb_kpi_label">Pending Approvals</strong>
                  <small class="o_eb_kpi_sub warn">Awaiting approver decision</small>
                </div>
                <div class="o_eb_kpi_card">
                  <span class="o_eb_kpi_num good"><t t-esc="state.data.reports.executive_brief.kpis?.sla_achieved_percent || 0"/>%</span>
                  <strong class="o_eb_kpi_label">Approval SLA Achieved</strong>
                  <small class="o_eb_kpi_sub">Target SLA: 95%</small>
                </div>
                <div class="o_eb_kpi_card">
                  <span class="o_eb_kpi_num primary"><t t-esc="state.data.reports.executive_brief.kpis?.avg_days_to_approve || 0"/></span>
                  <strong class="o_eb_kpi_label">Avg Days to Approve</strong>
                  <small class="o_eb_kpi_sub">Decision turnaround time</small>
                </div>
              </div>

              <div class="o_eb_columns">
                <section class="o_eb_insights_card">
                  <header>
                    <i class="fa fa-lightbulb-o"/>
                    <div>
                      <h4>Key Insights</h4>
                      <p>Patterns detected across requests, approvals, and absences.</p>
                    </div>
                  </header>
                  <ul class="o_eb_bullet_list">
                    <li t-foreach="state.data.reports.executive_brief.key_insights || []" t-as="insight" t-key="insight">
                      <i class="fa fa-circle"/>
                      <span t-esc="insight"/>
                    </li>
                  </ul>
                </section>

                <section class="o_eb_recommendations_card">
                  <header>
                    <i class="fa fa-magic"/>
                    <div>
                      <div class="o_eb_rec_heading">
                        <h4>AI Recommendations</h4>
                        <span class="o_eb_advisory_tag">Advisory</span>
                      </div>
                      <p>Suggestions to optimize team coverage, mitigate burnout, and balance approvals.</p>
                    </div>
                  </header>
                  <ul class="o_eb_bullet_list advisory">
                    <li t-foreach="state.data.reports.executive_brief.ai_recommendations || []" t-as="rec" t-key="rec">
                      <i class="fa fa-check-circle"/>
                      <span t-esc="rec"/>
                    </li>
                  </ul>
                  <div class="o_eb_advisory_footer">
                    <small><i class="fa fa-info-circle"/> Advisory only: Approvers and HR administrators retain final decision authority.</small>
                  </div>
                </section>
              </div>
            </div>
          </t>
        </t>
      </main>

      <t t-if="state.drilldown">
        <div class="o_lra_backdrop" t-on-click="closeDrilldown"/>
        <aside class="o_lra_drawer"><header><div><small>Underlying requests</small><h3 t-esc="state.drilldown.title"/></div><button t-on-click="closeDrilldown">×</button></header><div t-if="state.drilldown.loading" class="o_lra_loading"><i class="fa fa-spinner fa-spin"/> Loading…</div><div t-else="" class="o_lra_table_wrap"><table><thead><tr><th>Request</th><th>Employee</th><th>Leave Type</th><th>Dates</th><th>Days</th><th>Status</th></tr></thead><tbody><tr t-foreach="state.drilldown.rows" t-as="row" t-key="row.id"><td><b t-esc="row.reference"/></td><td t-esc="row.employee"/><td t-esc="row.leave_type"/><td><t t-esc="row.date_from"/> – <t t-esc="row.date_to"/></td><td t-esc="row.days"/><td><span t-att-class="'o_lra_status ' + row.status" t-esc="row.status"/></td></tr><tr t-if="!state.drilldown.rows.length"><td colspan="6">No matching requests.</td></tr></tbody></table></div></aside>
      </t>

      <t t-if="state.riskSettingsOpen">
        <div class="o_lra_backdrop" t-on-click="closeRiskSettings"/>
        <section class="o_lra_modal"><header><div><small>Absence Risk</small><h3>Bradford Factor settings</h3></div><button t-on-click="closeRiskSettings">×</button></header><div class="o_lra_modal_body"><label class="toggle"><input type="checkbox" t-model="state.riskForm.enabled"/><span>Enable Bradford scoring</span></label><div class="o_lra_form_grid"><label><span>Rolling window (weeks)</span><input type="number" min="1" t-model.number="state.riskForm.window_weeks"/></label><label><span>Minimum spell (days)</span><input type="number" min="1" t-model.number="state.riskForm.minimum_spell_days"/></label><label><span>Caution starts</span><input type="number" min="1" t-model.number="state.riskForm.thresholds.caution"/></label><label><span>Concern starts</span><input type="number" min="1" t-model.number="state.riskForm.thresholds.concern"/></label><label><span>Serious starts</span><input type="number" min="1" t-model.number="state.riskForm.thresholds.serious"/></label><label><span>Critical starts</span><input type="number" min="1" t-model.number="state.riskForm.thresholds.critical"/></label></div><h4>Leave Type treatment</h4><div class="o_lra_type_modes"><label t-foreach="state.riskForm.leave_type_modes || []" t-as="item" t-key="item.id"><span t-esc="item.name"/><select t-model="item.mode" t-att-disabled="item.locked"><option value="exclude">Excluded</option><option value="short_notice">Short-notice only</option><option value="all">All approved absences</option></select></label></div><p class="o_lra_notice">Changes take effect on the next calculation and do not create automatic disciplinary or leave decisions.</p></div><footer><button t-on-click="closeRiskSettings">Cancel</button><button class="primary" t-on-click="saveRiskSettings">Save settings</button></footer></section>
      </t>

      <t t-if="state.anomalyModal">
        <div class="o_lra_backdrop" t-on-click="closeAnomalyAction"/>
        <section class="o_lra_modal o_ano_modal">
          <header>
            <div>
              <small>Leave Anomaly Investigation</small>
              <h3 t-esc="state.anomalyModal.action === 'escalate' ? 'Escalate Anomaly to HR' : 'Mark Anomaly as Reviewed'"/>
            </div>
            <button t-on-click="closeAnomalyAction">×</button>
          </header>
          <div class="o_lra_modal_body">
            <div class="o_ano_modal_summary">
              <div><strong>Employee:</strong> <span t-esc="state.anomalyModal.anomaly.employee"/> (<t t-esc="state.anomalyModal.anomaly.department"/>)</div>
              <div><strong>Pattern:</strong> <span t-esc="state.anomalyModal.anomaly.pattern_type_label"/></div>
              <div><strong>Severity:</strong> <span t-att-class="'o_ano_badge o_ano_sev_' + state.anomalyModal.anomaly.severity" t-esc="state.anomalyModal.anomaly.severity_label"/></div>
              <div><strong>Evidence:</strong> <span t-esc="state.anomalyModal.anomaly.supporting_data"/></div>
            </div>
            <label class="o_ano_modal_field">
              <span>Investigation Note / Comments</span>
              <textarea rows="3" t-model="state.anomalyModal.note" placeholder="Add optional notes for the audit trail..."/>
            </label>
            <p class="o_lra_notice">All reviews and escalations are logged immutably into the Leave Audit Log. No automatic disciplinary action is taken.</p>
          </div>
          <footer>
            <button t-on-click="closeAnomalyAction">Cancel</button>
            <button class="primary" t-on-click="submitAnomalyAction" t-att-disabled="state.anomalyModal.saving">
              <i t-att-class="state.anomalyModal.saving ? 'fa fa-spinner fa-spin' : (state.anomalyModal.action === 'escalate' ? 'fa fa-exclamation-circle' : 'fa fa-check')"/>
              <t t-esc="state.anomalyModal.action === 'escalate' ? 'Escalate to HR' : 'Confirm Reviewed'"/>
            </button>
          </footer>
        </section>
      </t>
    </div>
  </t>
</templates>
