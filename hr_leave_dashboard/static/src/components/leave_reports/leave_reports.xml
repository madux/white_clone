<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="hr_leave_dashboard.LeaveReportsPage" owl="1">
    <div class="leaveapp o_lr_page">
      <CalendarSidebar activeMenu="'reports'"/>
      <main class="o_leave_dashboard o_lr_main">
        
        <!-- Module Header -->
        <header class="o_lr_page_header">
          <div>
            <h2>Reports</h2>
            <p>Generate and export leave management reports</p>
          </div>
          <div class="o_lr_header_actions"><button title="Section Tour" t-on-click="openTour"><i class="fa fa-paper-plane-o"/></button><button title="Help / Guide" t-on-click="openHelp"><i class="fa fa-question-circle-o"/></button><button title="Setup Wizard" t-on-click="openSetup"><i class="fa fa-magic"/></button><div class="o_lr_view_toggle">
            <button t-att-class="state.viewMode === 'admin' ? 'active':''" t-on-click="() => setViewMode('admin')">
              <i class="fa fa-user-circle-o"/> Admin View
            </button>
            <button t-att-class="state.viewMode === 'employee' ? 'active':''" t-on-click="() => setViewMode('employee')">
              <i class="fa fa-user"/> Employee View
            </button>
          </div></div>
        </header>

        <section class="o_lr_panel">
          <!-- Section Title & Actions Header -->
          <div class="o_lr_section_header">
            <div>
              <h3>Leave Reports</h3>
              <p>Generate and export leave management reports</p>
              <small class="text-muted"><i class="fa fa-clock-o"/> Last refreshed: <t t-esc="state.lastRefreshed || '—'"/></small>
            </div>
            <div class="o_lr_actions">
              <button class="o_lr_btn_action" t-on-click="refresh" t-att-disabled="state.loading">
                <i t-att-class="state.loading ? 'fa fa-refresh fa-spin':'fa fa-refresh'"/> Refresh
              </button>
              <button class="o_lr_btn_action" t-on-click="printReport">
                <i class="fa fa-print"/> Print
              </button>
              <div class="o_lr_export">
                <button class="o_lr_btn_primary" t-on-click="() => state.exportOpen = !state.exportOpen">
                  <i class="fa fa-download"/> Export <i class="fa fa-caret-down"/>
                </button>
                <div t-if="state.exportOpen" class="o_lr_export_menu">
                  <button t-on-click="() => exportReport('csv')"><i class="fa fa-file-text-o"/> Export CSV</button>
                  <button t-on-click="() => exportReport('excel')"><i class="fa fa-file-excel-o"/> Export Excel</button>
                </div>
              </div>
            </div>
          </div>

          <!-- FR-316 to FR-320: Global Filter Bar (In a single horizontal row) -->
          <div class="o_lr_filters_row">
            <span class="o_lr_filter_label"><i class="fa fa-filter"/> Filters:</span>
            
            <!-- Date Range Filter (FR-317) -->
            <select class="o_lr_filter_select" t-model="state.filters.date_range" t-on-change="refresh">
              <option value="this_week">This Week</option>
              <option value="this_month">This Month</option>
              <option value="last_month">Last Month</option>
              <option value="this_quarter">This Quarter</option>
              <option value="this_year">This Year</option>
              <option value="custom">Custom Range</option>
            </select>

            <!-- Department Filter (FR-318) -->
            <select class="o_lr_filter_select" t-model="state.filters.department_id" t-on-change="refresh">
              <option value="">All Departments</option>
              <option t-foreach="state.data.departments" t-as="department" t-key="department.id" t-att-value="department.id" t-esc="department.name"/>
            </select>

            <!-- Leave Type Filter (FR-319) -->
            <select class="o_lr_filter_select" t-model="state.filters.leave_type_id" t-on-change="refresh">
              <option value="">All Leave Types</option>
              <option t-foreach="state.data.leave_types" t-as="leaveType" t-key="leaveType.id" t-att-value="leaveType.id" t-esc="leaveType.name"/>
            </select>

            <!-- Inline Custom Date Range Pickers -->
            <t t-if="state.filters.date_range === 'custom'">
              <input type="date" class="o_lr_filter_date" t-model="state.filters.start_date"/>
              <span class="text-muted">to</span>
              <input type="date" class="o_lr_filter_date" t-model="state.filters.end_date"/>
              <button class="o_lr_btn_apply" t-on-click="refresh">Apply</button>
            </t>
          </div>

          <!-- FR-321: Five Report Tabs Navigation -->
          <nav class="o_lr_tabs">
            <button t-foreach="tabs" t-as="tab" t-key="tab.key"
                    t-att-class="state.activeTab === tab.key ? 'active':''"
                    t-on-click="() => setTab(tab.key)">
              <i t-att-class="'fa ' + tab.icon"/>
              <t t-esc="tab.label"/>
            </button>
            <button t-if="state.activeTab === 'types'" class="o_lr_today_link" t-on-click="viewToday">
              <i class="fa fa-calendar-check-o"/> View Today's Status
            </button>
          </nav>

          <!-- Loading State -->
          <div t-if="state.loading" class="o_lr_loading">
            <i class="fa fa-spinner fa-spin"/> Loading report data...
          </div>

          <!-- Tab 1: Overview (FR-322 to FR-325) -->
          <div t-elif="state.activeTab === 'overview'" class="o_lr_overview">
            
            <!-- FR-322: Overview 4 KPI Summary Tiles -->
            <div class="o_lr_kpis">
              <article class="o_lr_kpi_card">
                <div>
                  <small>Total Requests</small>
                  <strong t-esc="state.data.kpis.total || 0"/>
                  <em>All statuses</em>
                </div>
                <span class="o_lr_kpi_icon blue"><i class="fa fa-file-text-o"/></span>
              </article>

              <article class="o_lr_kpi_card">
                <div>
                  <small>Approved</small>
                  <strong t-esc="state.data.kpis.approved || 0"/>
                  <em><t t-esc="state.data.kpis.approval_rate || 0"/>% approval rate</em>
                </div>
                <span class="o_lr_kpi_icon green"><i class="fa fa-check-circle-o"/></span>
              </article>

              <article class="o_lr_kpi_card">
                <div>
                  <small>Pending</small>
                  <strong t-esc="state.data.kpis.pending || 0"/>
                  <em>Awaiting approval</em>
                </div>
                <span class="o_lr_kpi_icon amber"><i class="fa fa-clock-o"/></span>
              </article>

              <article class="o_lr_kpi_card">
                <div>
                  <small>Total Days</small>
                  <strong t-esc="state.data.kpis.total_days || 0"/>
                  <em>Avg: <t t-esc="state.data.kpis.average_days || 0"/> days/request</em>
                </div>
                <span class="o_lr_kpi_icon rose"><i class="fa fa-calendar"/></span>
              </article>
            </div>

            <!-- Charts Row (FR-323 & FR-324) -->
            <div class="o_lr_charts">
              <article class="o_lr_chart_card">
                <h4>Leave Distribution by Type</h4>
                <div class="o_lr_canvas">
                  <canvas t-ref="typeChart"/>
                </div>
              </article>
              <article class="o_lr_chart_card">
                <h4>Monthly Request Trend</h4>
                <div class="o_lr_canvas">
                  <canvas t-ref="trendChart"/>
                </div>
              </article>
            </div>

            <!-- FR-325: Request Status Breakdown Tiles -->
            <article class="o_lr_status_breakdown">
              <h4>Request Status Breakdown</h4>
              <div class="o_lr_status_grid">
                <div class="o_lr_status_tile approved">
                  <b t-esc="state.data.status.approved || 0"/>
                  <span>Approved</span>
                </div>
                <div class="o_lr_status_tile pending">
                  <b t-esc="state.data.status.pending || 0"/>
                  <span>Pending</span>
                </div>
                <div class="o_lr_status_tile rejected">
                  <b t-esc="state.data.status.rejected || 0"/>
                  <span>Rejected</span>
                </div>
                <div class="o_lr_status_tile cancelled">
                  <b t-esc="state.data.status.cancelled || 0"/>
                  <span>Cancelled</span>
                </div>
              </div>
            </article>

          </div>

          <!-- Tab 2: Leave Type Summary -->
          <div t-elif="state.activeTab === 'types'" class="o_lr_types">
            <div class="o_lr_info">
              <i class="fa fa-info-circle"/> <b>Daily Leave Status Report — <t t-esc="dailyStatusLabel"/>:</b> Breakdown of requests per leave type. Select Today in the filter above to view today's live daily status.
            </div>
            <div class="o_lr_type_kpis">
              <article><div><small>Active Types</small><strong t-esc="state.data.type_kpis.active_types || 0"/><em>Configured &amp; active</em></div><span class="rose"><i class="fa fa-tags"/></span></article>
              <article><div><small>Total Requests</small><strong t-esc="state.data.type_kpis.total_requests || 0"/><em>All leave types · selected period</em></div><span class="blue"><i class="fa fa-file-text-o"/></span></article>
              <article><div><small>Days Taken</small><strong t-esc="state.data.type_kpis.days_taken || 0"/><em>Approved leave days</em></div><span class="purple"><i class="fa fa-calendar"/></span></article>
              <article><div><small>Most Used</small><strong class="o_lr_type_name" t-esc="state.data.type_kpis.most_used_name || 'None'"/><em><t t-esc="state.data.type_kpis.most_used_days || 0"/> days · <t t-esc="state.data.type_kpis.most_used_employees || 0"/> emp.</em></div><span class="green"><i class="fa fa-line-chart"/></span></article>
            </div>
            <section class="o_lr_usage">
              <header>
                <div>
                  <h3>Leave Types Usage Report</h3>
                  <small>Period: <t t-esc="state.data.period.start"/> – <t t-esc="state.data.period.end"/> · Generated <t t-esc="dailyStatusLabel"/></small>
                </div>
                <span class="o_lr_badge_count"><t t-esc="state.data.type_usage.length"/> type(s)</span>
              </header>
              <div class="o_lr_usage_totals">
                <span><b t-esc="state.data.type_totals.employees || 0"/>Employees</span>
                <span><b t-esc="state.data.type_totals.requests || 0"/>Requests</span>
                <span class="good"><b t-esc="state.data.type_totals.approved || 0"/>Approved</span>
                <span class="warn"><b t-esc="state.data.type_totals.pending || 0"/>Pending</span>
                <span class="bad"><b t-esc="state.data.type_totals.rejected || 0"/>Rejected</span>
                <span class="pink"><b t-esc="state.data.type_totals.days_taken || 0"/>Days Taken</span>
              </div>
              <div class="o_lr_usage_table">
                <table>
                  <thead>
                    <tr>
                      <th>#</th><th>Leave Type</th><th>Category</th><th>Entitlement</th><th>Employees</th><th>Requests</th><th>Approved</th><th>Pending</th><th>Rejected</th><th>Cancelled</th><th>Days Taken</th><th>Avg Days</th><th>Share</th><th>Usage Bar</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="state.data.type_usage" t-as="row" t-key="row.id">
                      <td><b t-esc="row.rank"/></td>
                      <td><span class="o_lb_dot" t-att-style="'background:'+row.color"/><b t-esc="row.name"/></td>
                      <td><span t-att-class="'o_lr_category '+row.category" t-esc="row.category_label"/></td>
                      <td t-esc="row.entitlement"/>
                      <td><i class="fa fa-users"/> <t t-esc="row.employees"/></td>
                      <td><b t-esc="row.requests"/></td>
                      <td><span class="o_lr_count good" t-esc="row.approved"/></td>
                      <td><span class="o_lr_count warn" t-esc="row.pending"/></td>
                      <td><span class="o_lr_count bad" t-esc="row.rejected"/></td>
                      <td><span class="o_lr_count neutral" t-esc="row.cancelled"/></td>
                      <td>
                        <t t-if="row.days_taken &gt; 0">
                          <span class="o_lr_days" t-att-style="'background:'+row.color" t-esc="row.days_taken+'d'"/>
                        </t>
                        <t t-else="">
                          <span class="o_lr_days_zero">0d</span>
                        </t>
                      </td>
                      <td><t t-esc="row.average_days"/>d</td>
                      <td><t t-esc="row.share"/>%</td>
                      <td><div class="o_lr_usage_bar"><i t-att-style="'width:'+row.share+'%;background:'+row.color"/></div></td>
                    </tr>
                    <tr class="o_lr_grand">
                      <td colspan="4">GRAND TOTAL</td>
                      <td t-esc="state.data.type_totals.employees || 0"/>
                      <td t-esc="state.data.type_totals.requests || 0"/>
                      <td t-esc="state.data.type_totals.approved || 0"/>
                      <td t-esc="state.data.type_totals.pending || 0"/>
                      <td t-esc="state.data.type_totals.rejected || 0"/>
                      <td t-esc="state.data.type_totals.cancelled || 0"/>
                      <td><span class="o_lr_days_total"><t t-esc="state.data.type_totals.days_taken || 0"/>d</span></td>
                      <td>—</td>
                      <td>100%</td>
                      <td/>
                    </tr>
                  </tbody>
                </table>
              </div>
              <footer class="o_lr_snapshot">
                <b>Quick Snapshot — Days Taken per Type</b>
                <div>
                  <span t-foreach="state.data.type_usage" t-as="row" t-key="row.id">
                    <span class="o_lb_dot" t-att-style="'background:'+row.color"/>
                    <b t-esc="row.name"/> <t t-esc="row.days_taken"/>d (<t t-esc="row.share"/>%)
                  </span>
                </div>
              </footer>
            </section>
          </div>

          <!-- Tab 3: Department Analysis -->
          <div t-elif="state.activeTab === 'departments'" class="o_lr_department">
            <section class="o_lr_chart_panel">
              <h3>Leave Days by Department</h3>
              <div class="o_lr_department_canvas">
                <canvas t-ref="departmentChart"/>
              </div>
            </section>
            <section class="o_lr_table">
              <h3>Department Breakdown</h3>
              <table>
                <thead>
                  <tr><th>Department</th><th>Total Requests</th><th>Total Days</th><th>Avg Days/Request</th></tr>
                </thead>
                <tbody>
                  <tr t-foreach="state.data.department_summary" t-as="row" t-key="row.id"
                      t-att-class="state.selectedDepartmentId === row.id ? 'o_lr_selected_row':''"
                      t-on-click="() => selectDepartment(row.id)">
                    <td><i class="fa fa-building-o"/> <b t-esc="row.name"/></td>
                    <td t-esc="row.total"/>
                    <td t-esc="row.days"/>
                    <td t-esc="row.average_days"/>
                  </tr>
                  <tr t-if="!state.data.department_summary.length">
                    <td colspan="4">No department data for this report scope.</td>
                  </tr>
                </tbody>
              </table>
            </section>
          </div>

          <!-- Tab 4: Balance Report -->
          <div t-elif="state.activeTab === 'balances'" class="o_lr_balance">
            <div class="o_lr_balance_kpis">
              <article><small>Total Allocated</small><strong t-esc="state.data.balance.allocated || 0"/><em>days across all employees</em></article>
              <article class="used"><small>Total Used</small><strong t-esc="state.data.balance.used || 0"/><em><t t-esc="state.data.balance.utilisation || 0"/>% utilisation</em></article>
              <article class="pending"><small>Pending</small><strong t-esc="state.data.balance.pending || 0"/><em>days pending approval</em></article>
              <article class="remaining"><small>Remaining</small><strong t-esc="state.data.balance.remaining || 0"/><em>days available</em></article>
            </div>
            <section class="o_lr_chart_panel">
              <h3>Leave Balance Overview</h3>
              <div class="o_lr_balance_canvas">
                <canvas t-ref="balanceChart"/>
              </div>
            </section>
            <section class="o_lr_table">
              <h3>Balance Summary Table</h3>
              <table>
                <thead>
                  <tr><th>Metric</th><th>Days</th><th>% of Allocated</th></tr>
                </thead>
                <tbody>
                  <tr t-foreach="state.data.balance.rows" t-as="row" t-key="row.key">
                    <td><span class="o_lb_dot" t-att-style="'background:'+row.color"/><b t-esc="row.label"/></td>
                    <td t-att-style="'color:'+row.color" t-esc="row.days"/>
                    <td><t t-esc="row.percentage"/>%</td>
                  </tr>
                </tbody>
              </table>
            </section>
          </div>

          <!-- Tab 5: Employee Summary -->
          <div t-else="" class="o_lr_employees">
            <section class="o_lr_table">
              <header class="o_lr_employee_title">
                <div>
                  <h3>Top 10 Leave Takers</h3>
                  <p>Employees with the most approved leave days</p>
                </div>
                <span class="o_lr_badge_count"><t t-esc="state.data.employee_summary.length"/> ranked employee(s)</span>
              </header>
              <table>
                <thead>
                  <tr><th>Rank</th><th>Employee</th><th>Department</th><th>Total Days</th><th>Requests</th><th>Avg Days/Request</th></tr>
                </thead>
                <tbody>
                  <tr t-foreach="state.data.employee_summary" t-as="row" t-key="row.id">
                    <td><span t-att-class="'o_lr_rank ' + (row.rank === 1 ? 'first':'')" t-esc="row.rank"/></td>
                    <td>
                      <div class="o_lr_employee_cell">
                        <img t-att-src="row.avatar_url"/>
                        <span><b t-esc="row.name"/><small t-esc="row.code"/></span>
                      </div>
                    </td>
                    <td t-esc="row.department"/>
                    <td><span t-att-class="'o_lr_day_volume ' + row.volume"><t t-esc="row.total_days"/> days</span></td>
                    <td t-esc="row.requests"/>
                    <td t-esc="row.average_days"/>
                  </tr>
                  <tr t-if="!state.data.employee_summary.length">
                    <td colspan="6" class="o_lr_no_data">No approved leave exists for the selected scope.</td>
                  </tr>
                </tbody>
              </table>
            </section>
          </div>

        </section>
      </main>
    </div>
  </t>
</templates>
