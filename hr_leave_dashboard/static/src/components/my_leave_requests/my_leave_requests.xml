<?xml version="1.0" encoding="UTF-8"?><templates xml:space="preserve"><t t-name="hr_leave_dashboard.MyLeaveRequestsPage" owl="1"><div t-att-class="props.embedded ? 'o_mlr_page o_mlr_embedded' : 'o_mlr_page'"><CalendarSidebar t-if="!props.embedded" activeMenu="'requests'" mode="'employee'"/><main><header><div><h2>My Leave Requests</h2><p>Track and manage your submitted leave requests</p></div><span t-if="!props.embedded" class="employee"><i class="fa fa-user-o"/> Employee View</span></header>
<section class="o_mlr_tabs"><button t-foreach="[['all','All Requests'],['pending','Pending'],['approved','Approved'],['rejected','Rejected'],['cancelled','Cancelled']]" t-as="tab" t-key="tab[0]" t-att-class="state.status===tab[0]?'active':''" t-on-click="()=>setStatus(tab[0])"><b t-esc="state.counts[tab[0]]||0"/><span t-esc="tab[1]"/></button></section>
<section class="o_mlr_toolbar"><div><i class="fa fa-search"/><input t-model="state.search" t-on-keydown="onSearchKeydown" placeholder="Search by leave type or reason..."/></div><select t-model="state.typeId" t-on-change="load"><option value="">All Types</option><option t-foreach="state.types" t-as="type" t-key="type.id" t-att-value="type.id" t-esc="type.name"/></select><button t-on-click="exportCsv"><i class="fa fa-download"/> Export</button><button class="primary" t-on-click="openNew"><i class="fa fa-plus"/> New Request</button></section>
<section class="o_mlr_table"><table><thead><tr><th>Leave Type</th><th>Dates</th><th>Duration</th><th>Reason</th><th>Status</th><th>Approver</th><th>Submitted</th><th>Actions</th></tr></thead><tbody><tr t-foreach="state.rows" t-as="row" t-key="row.id"><td><i class="dot" t-att-style="'background:'+row.color"/><b t-esc="row.leave_type"/></td><td><i class="fa fa-calendar-o"/> <t t-esc="formatDate(row.date_from)"/> – <t t-esc="formatDate(row.date_to)"/></td><td><t t-esc="row.duration"/> days</td><td t-esc="row.reason||'—'"/><td><span t-att-class="'status '+row.status" t-esc="row.status"/><small t-if="row.escalated" class="ms-1 text-warning"><i class="fa fa-level-up"/> Escalated</small></td><td><i class="approver-dot"/><t t-esc="row.approver"/></td><td t-esc="formatSubmitted(row.submitted)"/><td><button t-on-click="()=>view(row.id)"><i class="fa fa-eye"/> View</button><button t-if="row.can_escalate" t-on-click="()=>openEscalate(row.id)">Escalate</button><button t-if="row.can_cancel" class="cancel" t-on-click="()=>openCancel(row.id)">Cancel</button><button t-if="row.can_resubmit" class="resubmit" t-on-click="()=>resubmit(row)">Re-submit</button></td></tr></tbody></table><div t-if="!state.loading and !state.rows.length" class="empty"><i class="fa fa-calendar-times-o"/><h3>No leave requests found</h3><p t-if="state.status==='all'">Submit your first leave request to begin tracking it here.</p><p t-else="">No requests match this filter.</p><button t-if="state.status==='all'" t-on-click="openNew">Submit Your First Request</button></div><div t-if="state.loading" class="empty"><i class="fa fa-spinner fa-spin"/> Loading requests...</div></section>
<EmployeeRequestModal t-if="state.requestOpen" close.bind="closeNew" submitted.bind="load" initial="state.initial"/><LeaveRequestDetailModal t-if="state.detailId" requestId="state.detailId" close.bind="closeDetail" onChanged.bind="load" readOnly="true"/><div t-if="state.cancelId" class="o_mlr_overlay"><section class="o_mlr_cancel"><h3>Cancel Leave Request</h3><p>Please tell us why you are cancelling this request. Pending or approved days will be restored to your remaining balance.</p><textarea t-model="state.cancelReason" placeholder="Cancellation reason..."/><div t-if="state.cancelError" class="error" t-esc="state.cancelError"/><footer><button t-on-click="closeCancel">Keep Request</button><button class="danger" t-on-click="cancel" t-att-disabled="state.cancelReason.trim().length&lt;3">Confirm Cancellation</button></footer></section></div><div t-if="state.escalateId" class="o_mlr_overlay"><section class="o_mlr_cancel"><h3>Escalate Request</h3><p>This flags the pending request for priority review. Explain why follow-up is needed.</p><textarea maxlength="300" t-model="state.escalationNote" placeholder="Escalation note (maximum 300 characters)..."/><small><t t-esc="state.escalationNote.length"/> / 300</small><div t-if="state.escalationError" class="error" t-esc="state.escalationError"/><footer><button t-on-click="closeEscalate">Back</button><button class="primary" t-on-click="escalate" t-att-disabled="!state.escalationNote.trim()">Send Escalation</button></footer></section></div>
</main></div></t></templates>
