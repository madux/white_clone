<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <!-- Shared drawer shell used by policy, holiday and other configuration screens. -->
  <t t-name="hr_leave_dashboard.SettingsPanel">
    <div class="o_lp_overlay" t-on-click.self="props.close">
      <aside t-att-class="'o_lp_drawer ' + (props.wide ? 'wide' : '')" role="dialog" aria-modal="true">
        <header class="o_lp_drawer_header"><t t-slot="header"/></header>
        <t t-slot="default"/>
        <footer class="o_lp_drawer_footer"><t t-slot="footer"/></footer>
      </aside>
    </div>
  </t>
  <t t-name="hr_leave_dashboard.TagsPicker">
    <div class="o_settings_tags" t-on-focusout="blur">
      <div class="o_settings_tags_field" t-on-click="focus">
        <span t-foreach="props.selected" t-as="item" t-key="item.id" class="o_settings_tag"><img t-if="props.employee" class="o_settings_employee_avatar" t-att-src="avatarUrl(item.id)" alt="" loading="lazy"/><t t-esc="item.name"/><button type="button" t-on-click.stop="() => props.toggle(item.id)" t-att-aria-label="'Remove ' + item.name">×</button></span>
        <input t-ref="input" t-att-value="state.query" t-on-focus="() => state.open=true" t-on-input="search" t-on-keydown="keydown" t-att-placeholder="props.selected.length ? '' : (props.placeholder || 'Select…')" aria-label="Search options" role="combobox" aria-autocomplete="list" t-att-aria-expanded="state.open" autocomplete="off"/>
        <i class="fa fa-caret-down o_settings_tags_caret" aria-hidden="true"/>
      </div>
      <div t-if="state.open" t-ref="options" class="o_settings_tags_options" role="listbox" t-on-mousedown.prevent="() => {}">
        <button t-foreach="matches" t-as="item" t-key="item.id" type="button" role="option" tabindex="-1" t-att-aria-selected="state.active === item_index" t-att-class="state.active === item_index ? 'is-active' : ''" t-on-click="() => this.pick(item)"><img t-if="props.employee" class="o_settings_employee_avatar" t-att-src="avatarUrl(item.id)" alt="" loading="lazy"/><t t-esc="item.name"/></button>
        <button t-if="canCreate" type="button" tabindex="-1" t-att-class="state.active === matches.length ? 'is-active' : ''" t-on-click="create">Create “<t t-esc="state.query"/>”</button>
        <span t-if="!matches.length and !canCreate">No matching options</span>
      </div>
    </div>
  </t>
</templates>
