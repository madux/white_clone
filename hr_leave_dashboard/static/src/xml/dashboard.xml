<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_leave_dashboard.Dashboard">
        <div class="leaveapp">

            <!-- ════════════════════════════════════════════════════
                 WELCOME MODAL  (Screen 1 — FR-001 to FR-009)
                 ════════════════════════════════════════════════════ -->
            <t t-if="state.showWelcomeModal">
                <!-- Blurred backdrop -->
                <div class="cleon-welcome-backdrop" t-on-click="closeWelcomeModal"/>

                <div class="cleon-welcome-modal" role="dialog" aria-modal="true" aria-labelledby="cleon-welcome-title">

                    <!-- X close -->
                    <button class="cleon-welcome-close" t-on-click="closeWelcomeModal" aria-label="Close welcome modal">
                        <i class="fa fa-times"/>
                    </button>

                    <!-- Icon + title + description -->
                    <div class="cleon-welcome-header">
                        <div class="cleon-welcome-icon">
                            <i class="fa fa-random"/>
                        </div>
                        <div class="cleon-welcome-intro">
                            <h2 id="cleon-welcome-title" class="cleon-welcome-title">Welcome to Leave Management</h2>
                            <p class="cleon-welcome-desc">
                                CleonHR's Leave Management module gives you everything you need to define
                                policies, process requests, track balances, and generate reports — all in one place.
                                This wizard will walk you through the essentials.
                            </p>
                        </div>
                    </div>

                    <!-- Feature grid -->
                    <div class="cleon-welcome-features">
                        <p class="cleon-features-label">WHAT'S INCLUDED</p>
                        <div class="cleon-features-grid">
                            <button type="button" class="cleon-feature-tile" t-on-click="openLeaveTypes">
                                <div class="cleon-feature-icon cleon-fi-orange"><i class="fa fa-tags"/></div>
                                <span class="cleon-feature-name">Leave Types</span>
                            </button>
                            <button type="button" class="cleon-feature-tile" t-on-click="openLeaveRequests">
                                <div class="cleon-feature-icon cleon-fi-blue"><i class="fa fa-file-text-o"/></div>
                                <span class="cleon-feature-name">Leave Requests</span>
                            </button>
                            <button type="button" class="cleon-feature-tile" t-on-click="openLeaveCalendar">
                                <div class="cleon-feature-icon cleon-fi-teal"><i class="fa fa-calendar"/></div>
                                <span class="cleon-feature-name">Leave Calendar</span>
                            </button>
                            <button type="button" class="cleon-feature-tile" t-on-click="openLeaveBalances">
                                <div class="cleon-feature-icon cleon-fi-green"><i class="fa fa-globe"/></div>
                                <span class="cleon-feature-name">Balance Management</span>
                            </button>
                            <button type="button" class="cleon-feature-tile" t-on-click="openReports">
                                <div class="cleon-feature-icon cleon-fi-purple"><i class="fa fa-bar-chart"/></div>
                                <span class="cleon-feature-name">Reports</span>
                            </button>
                            <button type="button" class="cleon-feature-tile" t-on-click="openSettings">
                                <div class="cleon-feature-icon cleon-fi-pink"><i class="fa fa-cog"/></div>
                                <span class="cleon-feature-name">Settings</span>
                            </button>
                        </div>
                    </div>

                    <!-- FR-004 + FR-005: Action buttons -->
                    <div class="cleon-welcome-actions">
                        <button class="cleon-btn-secondary" t-on-click="exploreOnMyOwn">Explore on my own</button>
                        <button class="cleon-btn-primary" t-on-click="startSetupGuide">
                            <i class="fa fa-play-circle"/> Start Setup Guide (5 steps)
                        </button>
                    </div>

                    <!-- Time estimate -->
                    <p class="cleon-welcome-hint">
                        Takes about 2 minutes · You can re-open this guide any time
                    </p>

                </div>
            </t>
            <!-- ════ END WELCOME MODAL ════════════════════════════ -->

            <LeaveSetupWizard t-if="state.showWizard"
                initialStep="state.wizardStep"
                reviewMode="state.reviewMode"
                onClose.bind="closeWizard"
                onBackAtFirst.bind="backFromWizardStart"
                onCompleted.bind="wizardCompleted"
                onSkipped.bind="wizardSkipped"/>

            <LeaveSetupCompletion t-if="state.showCompletionScreen"
                checklist="state.checklist"
                completedCount="state.completedChecklistCount"
                onToggle.bind="toggleChecklistItem"
                onReview.bind="reviewWizardSteps"
                onDone.bind="doneGoToDashboard"
                onClose.bind="closeCompletionScreen"/>

            <!-- Shared Module Sidebar -->
            <CalendarSidebar activeMenu="'dashboard'"/>

            <!-- ════════════════════════════════════════════════════
                 MAIN DASHBOARD AREA (Screen 8 — FR-055 to FR-072)
                 ════════════════════════════════════════════════════ -->
            <div class="o_leave_dashboard">

                <!-- FR-071 and FR-072: Header -->
                <div class="cleon-dash-header">
                    <div class="cleon-dash-header-left">
                        <button type="button" class="cleon-header-plain-btn" t-on-click="toggleLeaveSidebar" title="Toggle Leave navigation">
                            <i class="fa fa-columns"/>
                        </button>
                        <div>
                            <h4 class="cleon-dash-title">Dashboard</h4>
                            <span class="cleon-dash-subtitle">Manage leave requests, policies, and employee balances</span>
                        </div>
                    </div>
                    <div class="cleon-dash-header-right">
                        <button type="button" class="cleon-header-plain-btn" title="Take a Tour">
                            <i class="fa fa-paper-plane-o"/>
                        </button>
                        <!-- Re-open the setup experience from the help icon. -->
                        <button type="button" class="cleon-header-plain-btn" t-on-click="openSetupExperience" title="Help / Guide">
                            <i class="fa fa-question-circle-o"/>
                        </button>
                        <button type="button" class="cleon-header-plain-btn" t-on-click="openSetupExperience" title="Setup Wizard">
                            <i class="fa fa-magic"/>
                        </button>

                        <!-- View Switcher -->
                        <div class="cleon-view-toggle">
                            <button t-att-class="state.viewMode === 'admin' ? 'cleon-view-option active' : 'cleon-view-option'"
                                    t-on-click="() => this.setViewMode('admin')">
                                <i class="fa fa-circle-o"/> Admin View
                            </button>
                            <button t-att-class="state.viewMode === 'employee' ? 'cleon-view-option active' : 'cleon-view-option'"
                                    t-on-click="() => this.setViewMode('employee')">
                                <i class="fa fa-user-o"/> Employee View
                            </button>
                        </div>
                    </div>
                </div>

                <!-- KPI ROW (FR-055 to FR-060) -->
                <div class="kpi-row">
                    <button type="button" class="kpi-card kpi-card-button" t-on-click="openStaffContext" title="View employee balances and staff directory">
                        <div class="kpi-top">
                            <span class="kpi-label">TOTAL EMPLOYEES</span>
                            <span class="kpi-icon blue"><i class="fa fa-users"/></span>
                        </div>
                        <div class="kpi-value"><t t-esc="state.kpis.total_employees"/></div>
                        <div class="kpi-sub"><t t-esc="state.kpis.on_leave_today"/> on leave today</div>
                    </button>

                    <button type="button" class="kpi-card kpi-card-button" t-on-click="openLeaveRequests" title="View pending leave requests">
                        <t t-if="state.kpis.pending_approvals gt 0">
                            <span class="kpi-new-badge"><t t-esc="state.kpis.pending_approvals"/> new</span>
                        </t>
                        <div class="kpi-top">
                            <span class="kpi-label">PENDING APPROVALS</span>
                            <span class="kpi-icon orange"><i class="fa fa-clock-o"/></span>
                        </div>
                        <div class="kpi-value"><t t-esc="state.kpis.pending_approvals"/></div>
                        <div class="kpi-sub">
                            <t t-if="state.kpis.pending_approvals gt 0">Awaiting review</t>
                            <t t-else="">All clear</t>
                        </div>
                    </button>

                    <button type="button" class="kpi-card kpi-card-button" t-on-click="openLeaveCalendar" title="View who is on leave today">
                        <div class="kpi-top">
                            <span class="kpi-label">ON LEAVE TODAY</span>
                            <span class="kpi-icon purple"><i class="fa fa-calendar"/></span>
                        </div>
                        <div class="kpi-value"><t t-esc="state.kpis.on_leave_today"/></div>
                        <div class="kpi-sub"><t t-esc="state.kpis.on_leave_pct"/>% of workforce</div>
                    </button>

                    <button type="button" class="kpi-card kpi-card-button" t-on-click="openLeaveCalendar" title="View approved upcoming leave in calendar">
                        <div class="kpi-top">
                            <span class="kpi-label">UPCOMING (7 DAYS)</span>
                            <span class="kpi-icon teal"><i class="fa fa-line-chart"/></span>
                        </div>
                        <div class="kpi-value"><t t-esc="state.kpis.upcoming_7_days"/></div>
                        <div class="kpi-sub">Approved upcoming leave</div>
                    </button>

                    <button type="button" class="kpi-card kpi-card-button" t-on-click="openReports" title="View leave utilisation reports">
                        <div class="kpi-top">
                            <span class="kpi-label">UTILISATION RATE</span>
                            <span class="kpi-icon pink"><i class="fa fa-heartbeat"/></span>
                        </div>
                        <div class="kpi-value"><t t-esc="state.kpis.utilisation_rate"/>%</div>
                        <div class="kpi-sub">Leave days consumed</div>
                    </button>

                    <button type="button" t-att-class="state.kpis.coverage_alerts gt 0 ? 'kpi-card kpi-card-button coverage-alert-active' : 'kpi-card kpi-card-button'" t-on-click="openCoverageContext" title="View department coverage breakdown">
                        <div class="kpi-top">
                            <span class="kpi-label">COVERAGE ALERTS</span>
                            <span t-att-class="state.kpis.coverage_alerts gt 0 ? 'kpi-icon red' : 'kpi-icon green'">
                                <i class="fa fa-exclamation-triangle"/>
                            </span>
                        </div>
                        <div class="kpi-value"><t t-esc="state.kpis.coverage_alerts"/></div>
                        <div class="kpi-sub">
                            <t t-if="state.kpis.coverage_alerts gt 0">Coverage needs attention</t>
                            <t t-else="">Coverage healthy</t>
                        </div>
                    </button>
                </div>

                <!-- TRENDS (FR-061 to FR-063) + BY TYPE (FR-064) -->
                <div class="grid-2">
                    <div class="panel">
                        <div class="panel-head">
                            <div>
                                <h5>Leave Trends</h5>
                                <small>Monthly request volume and outcomes</small>
                            </div>
                            <!-- Range toggle -->
                            <div class="range-toggle">
                                <button t-att-class="state.months === 6 ? 'range-btn active' : 'range-btn'"
                                        t-on-click="() => this.setTrendMonths(6)">
                                    6 months
                                </button>
                                <button t-att-class="state.months === 12 ? 'range-btn active' : 'range-btn'"
                                        t-on-click="() => this.setTrendMonths(12)">
                                    12 months
                                </button>
                            </div>
                        </div>
                        <!-- Mini stat tiles (OWL rendered with colored text) -->
                        <div class="stat-row">
                            <div class="stat-box">
                                <div class="stat-value stat-value-pink"><t t-esc="state.trends.summary.total || 0"/></div>
                                <div class="stat-label">Total</div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-value stat-value-green"><t t-esc="state.trends.summary.approved || 0"/></div>
                                <div class="stat-label">Approved</div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-value stat-value-amber"><t t-esc="state.trends.summary.pending || 0"/></div>
                                <div class="stat-label">Pending</div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-value stat-value-red"><t t-esc="state.trends.summary.rejected || 0"/></div>
                                <div class="stat-label">Rejected</div>
                            </div>
                        </div>
                        <canvas t-ref="trendsChart" height="90"/>
                    </div>

                    <!-- By Leave Type donut with empty state handling -->
                    <div class="panel">
                        <div class="panel-head">
                            <div><h5>By Leave Type</h5><small>All-time request distribution</small></div>
                        </div>
                        <t t-if="state.byType.length">
                            <div class="donut-wrap">
                                <canvas t-ref="byTypeChart" width="160" height="160"/>
                            </div>
                            <div class="legend-list">
                                <div class="legend-row" t-foreach="state.byType" t-as="item" t-key="item.name">
                                    <span class="legend-dot" t-att-style="'background:' + this.getPaletteColor(item_index)"/>
                                    <span class="legend-name"><t t-esc="item.name"/></span>
                                    <span class="legend-count"><t t-esc="item.count"/></span>
                                    <span class="legend-pct"><t t-esc="item.percent"/>%</span>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="dashboard-empty dashboard-empty-chart">
                                <i class="fa fa-pie-chart d-block fs-3 mb-2 text-muted"/>
                                <span>No leave requests to analyse yet.</span>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- BALANCE  + APPROVAL -->
                <div class="grid-2">
                    <!-- Balance by type with empty state handling -->
                    <div class="panel">
                        <div class="panel-head">
                            <div>
                                <h5>Leave Balance by Type</h5>
                                <small>Allocation vs utilisation across all employees</small>
                            </div>
                            <button type="button" class="panel-link-btn" t-on-click="openLeaveBalances">
                                Manage ›
                            </button>
                        </div>
                        <t t-if="state.balance.length">
                            <div class="balance-list">
                                <div class="balance-row" t-foreach="state.balance" t-as="item" t-key="item.name">
                                    <div class="balance-header">
                                        <span class="legend-dot" t-att-style="'background:' + item.type_color"/>
                                        <span class="balance-name"><t t-esc="item.name"/></span>
                                        <span class="balance-figures">
                                            <t t-esc="item.used"/> used / <t t-esc="item.allocated"/> allocated · <t t-esc="item.percent"/>%
                                        </span>
                                    </div>
                                    <div class="balance-track">
                                        <div class="balance-fill" t-att-style="'width:' + item.percent + '%;background:' + item.bar_color"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="dashboard-empty">
                                No leave balances have been allocated yet.
                            </div>
                        </t>
                    </div>

                    <!-- Approval Overview -->
                    <div class="panel">
                        <div class="panel-head">
                            <div><h5>Approval Overview</h5><small>Request resolution summary</small></div>
                        </div>
                        <div class="approval-wrap">
                            <div class="approval-chart-box">
                                <canvas t-ref="approvalChart" width="140" height="140"/>
                                <div class="approval-center">
                                    <div class="approval-rate" data-approval="rate"><t t-esc="state.approval.approval_rate"/>%</div>
                                    <small>Approval</small>
                                </div>
                            </div>
                        </div>
                        <div class="approval-rows">
                            <div class="approval-row approved"><span>✓ Approved</span><span><t t-esc="state.approval.approved"/></span></div>
                            <div class="approval-row pending"><span>⏱ Pending</span><span><t t-esc="state.approval.pending"/></span></div>
                            <div class="approval-row rejected"><span>✕ Rejected</span><span><t t-esc="state.approval.rejected"/></span></div>
                        </div>
                        <div class="panel-footer-btn-wrap">
                            <button type="button" class="cleon-btn-review-all" t-on-click="openLeaveRequests">
                                Review All Requests
                            </button>
                        </div>
                    </div>
                </div>

                <!-- DEPARTMENT COVERAGE  + RECENT REQUESTS -->
                <div class="grid-2 dashboard-lower-row">
                    <!-- Department Coverage Heatmap -->
                    <div class="panel">
                        <div class="panel-head">
                            <div>
                                <h5>Department Coverage</h5>
                                <small>This week's workforce availability</small>
                            </div>
                            <button type="button" class="panel-link-btn" t-on-click="openLeaveCalendar">
                                Calendar ›
                            </button>
                        </div>

                        <div class="coverage-table-wrap">
                            <table class="coverage-table">
                                <thead>
                                    <tr>
                                        <th>Department</th>
                                        <th>Mon</th>
                                        <th>Tue</th>
                                        <th>Wed</th>
                                        <th>Thu</th>
                                        <th>Fri</th>
                                        <th>Sat</th>
                                        <th>Sun</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.departmentCoverage" t-as="row" t-key="row.department">
                                        <td class="coverage-department"><t t-esc="row.department"/></td>
                                        <t t-foreach="row.values" t-as="val" t-key="val_index">
                                            <td>
                                                <t t-if="val === null">
                                                    <span class="coverage-weekend">—</span>
                                                </t>
                                                <t t-else="">
                                                    <span t-att-class="'coverage-cell ' + this.getCoverageClass(val)">
                                                        <t t-esc="val"/>%
                                                    </span>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="dashboard-empty" t-if="!state.departmentCoverage.length">
                                No department coverage data yet.
                            </div>
                        </div>

                        <div class="coverage-legend">
                            <span><i class="legend-dot coverage-good-dot"/> Good (≥85%)</span>
                            <span><i class="legend-dot coverage-medium-dot"/> Medium (70–84%)</span>
                            <span><i class="legend-dot coverage-low-dot"/> Low (&lt;70%)</span>
                        </div>
                    </div>

                    <!-- Recent Requests List -->
                    <div class="panel">
                        <div class="panel-head">
                            <div>
                                <h5>Recent Requests</h5>
                                <small>Latest leave submissions</small>
                            </div>
                            <button type="button" class="panel-link-btn" t-on-click="openLeaveRequests">
                                View all ›
                            </button>
                        </div>

                        <div class="recent-request-list">
                            <button type="button"
                                    class="recent-request-row"
                                    t-foreach="state.recentRequests"
                                    t-as="req"
                                    t-key="req.id"
                                    t-on-click="openLeaveRequests">
                                <span class="recent-avatar"><t t-esc="this.getInitials(req.employee)"/></span>
                                <span class="recent-request-main">
                                    <span class="recent-request-name"><t t-esc="req.employee"/></span>
                                    <span class="recent-request-meta"><t t-esc="req.leave_type"/> · <t t-esc="req.duration"/>d</span>
                                </span>
                                <span t-att-class="'request-status ' + req.status"><t t-esc="req.status"/></span>
                                <span class="recent-request-date"><t t-esc="req.submitted_date"/></span>
                            </button>

                            <div class="dashboard-empty" t-if="!state.recentRequests.length">
                                No leave requests have been submitted yet.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions Bar -->
                <div class="panel quick-actions-panel">
                    <div class="panel-head">
                        <h5><i class="fa fa-bolt"/> Quick Actions</h5>
                    </div>
                    <div class="quick-actions">
                        <button class="quick-action quick-pink" t-on-click="openLeaveRequests">
                            <i class="fa fa-check-circle-o"/>
                            <strong>Review Pending</strong>
                            <small><t t-esc="state.kpis.pending_approvals"/> awaiting</small>
                        </button>

                        <button class="quick-action quick-blue" t-on-click="openLeaveCalendar">
                            <i class="fa fa-calendar"/>
                            <strong>Leave Calendar</strong>
                            <small>View schedule</small>
                        </button>

                        <button class="quick-action quick-green" t-on-click="openLeaveBalances">
                            <i class="fa fa-globe"/>
                            <strong>Manage Balances</strong>
                            <small>Allocations</small>
                        </button>

                        <button class="quick-action quick-purple" t-on-click="openLeaveTypes">
                            <i class="fa fa-tags"/>
                            <strong>Leave Types</strong>
                            <small>Configure</small>
                        </button>

                        <button class="quick-action quick-orange" t-on-click="openReports">
                            <i class="fa fa-bar-chart"/>
                            <strong>Reports</strong>
                            <small>Analytics</small>
                        </button>

                        <button class="quick-action quick-dark" t-on-click="openAuditLog">
                            <i class="fa fa-file-text-o"/>
                            <strong>Audit Log</strong>
                            <small>Activity trail</small>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>
