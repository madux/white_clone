<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_leave_dashboard.Dashboard">
        <div class="leaveapp">

            <!-- ════════════════════════════════════════════════════
                 WELCOME MODAL  (Screen 1 — FR-001 to FR-009)
                 ════════════════════════════════════════════════════ -->
            <t t-if="state.showWelcomeModal">
                <!-- FR-009: Blurred backdrop -->
                <div class="cleon-welcome-backdrop" t-on-click="closeWelcomeModal"/>

                <div class="cleon-welcome-modal" role="dialog" aria-modal="true" aria-labelledby="cleon-welcome-title">

                    <!-- FR-006: X close -->
                    <button class="cleon-welcome-close" t-on-click="closeWelcomeModal" aria-label="Close welcome modal">
                        <i class="fa fa-times"/>
                    </button>

                    <!-- FR-002: Icon + title + description -->
                    <div class="cleon-welcome-header">
                        <div class="cleon-welcome-icon">
                            <i class="fa fa-random"/>
                        </div>
                        <div class="cleon-welcome-intro">
                            <h2 id="cleon-welcome-title" class="cleon-welcome-title">Welcome to Leave Management</h2>
                            <p class="cleon-welcome-desc">
                                CleonHR's Leave Management module gives you everything you need to define
                                policies, process requests, track balances, and generate reports — all in one place.
                                This wizard will walk you through the essentials.
                            </p>
                        </div>
                    </div>

                    <!-- FR-003: Feature grid -->
                    <div class="cleon-welcome-features">
                        <p class="cleon-features-label">WHAT'S INCLUDED</p>
                        <div class="cleon-features-grid">
                            <button type="button" class="cleon-feature-tile" t-on-click="openLeaveTypes">
                                <div class="cleon-feature-icon cleon-fi-orange"><i class="fa fa-tags"/></div>
                                <span class="cleon-feature-name">Leave Types</span>
                            </button>
                            <button type="button" class="cleon-feature-tile" t-on-click="openLeaveRequests">
                                <div class="cleon-feature-icon cleon-fi-blue"><i class="fa fa-file-text-o"/></div>
                                <span class="cleon-feature-name">Leave Requests</span>
                            </button>
                            <button type="button" class="cleon-feature-tile" t-on-click="openLeaveCalendar">
                                <div class="cleon-feature-icon cleon-fi-teal"><i class="fa fa-calendar"/></div>
                                <span class="cleon-feature-name">Leave Calendar</span>
                            </button>
                            <button type="button" class="cleon-feature-tile" t-on-click="openLeaveBalances">
                                <div class="cleon-feature-icon cleon-fi-green"><i class="fa fa-globe"/></div>
                                <span class="cleon-feature-name">Balance Management</span>
                            </button>
                            <button type="button" class="cleon-feature-tile" t-on-click="openReports">
                                <div class="cleon-feature-icon cleon-fi-purple"><i class="fa fa-bar-chart"/></div>
                                <span class="cleon-feature-name">Reports</span>
                            </button>
                            <button type="button" class="cleon-feature-tile" t-on-click="openSettings">
                                <div class="cleon-feature-icon cleon-fi-pink"><i class="fa fa-cog"/></div>
                                <span class="cleon-feature-name">Settings</span>
                            </button>
                        </div>
                    </div>

                    <!-- FR-004 + FR-005: Action buttons -->
                    <div class="cleon-welcome-actions">
                        <button class="cleon-btn-secondary" t-on-click="exploreOnMyOwn">Explore on my own</button>
                        <button class="cleon-btn-primary" t-on-click="startSetupGuide">
                            <i class="fa fa-play-circle"/> Start Setup Guide (5 steps)
                        </button>
                    </div>

                    <!-- FR-007: Time estimate -->
                    <p class="cleon-welcome-hint">
                        Takes about 2 minutes · You can re-open this guide any time
                    </p>

                </div>
            </t>
            <!-- ════ END WELCOME MODAL ════════════════════════════ -->


            <!-- ════════════════════════════════════════════════════
                 SETUP WIZARD  (Screen 2 — FR-010 to FR-017)
                 Steps 1–5 rendered inside one modal; content swapped
                 by wizardStep state. Backdrop shared with welcome modal.
                 ════════════════════════════════════════════════════ -->
            <t t-if="state.showWizard">
                <!-- Blurred backdrop — click closes without dismissing -->
                <div class="cleon-welcome-backdrop" t-on-click="closeWizard"/>

                <div class="cleon-wizard-modal" role="dialog" aria-modal="true" aria-labelledby="cleon-wizard-title">

                    <!-- FR-010: Step Progress Bar ─────────────────────── -->
                    <div class="cleon-wizard-progress" aria-label="Setup progress">
                        <t t-foreach="[1,2,3,4,5]" t-as="s" t-key="s">
                            <div t-att-class="{
                                'cleon-wiz-step': true,
                                'cleon-wiz-step-active': state.wizardStep === s,
                                'cleon-wiz-step-done': state.wizardStep > s
                            }">
                                <div class="cleon-wiz-dot">
                                    <t t-if="state.wizardStep > s">
                                        <i class="fa fa-check"/>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="s"/>
                                    </t>
                                </div>
                                <t t-if="s_index lt 4">
                                    <div class="cleon-wiz-connector"/>
                                </t>
                            </div>
                        </t>
                    </div>

                    <!-- ── STEP 1: Configure Leave Types ─────────────── -->
                    <t t-if="state.wizardStep === 1">

                        <!-- FR-011: Step label + icon + title -->
                        <div class="cleon-wizard-step-header">
                            <div class="cleon-wizard-icon">
                                <i class="fa fa-tags"/>
                            </div>
                            <div class="cleon-wizard-step-meta">
                                <span class="cleon-wiz-step-label">STEP 1 OF 5</span>
                                <h2 id="cleon-wizard-title" class="cleon-wizard-title">Configure Leave Types</h2>
                            </div>
                        </div>

                        <!-- FR-012: Step description -->
                        <p class="cleon-wizard-desc">
                            Define every leave category your organisation offers — Annual Leave, Sick Leave,
                            Maternity/Paternity, Compassionate, and any custom types. Each type carries its
                            own entitlement, carry-over rules, accrual method, and approval workflow.
                        </p>

                        <!-- FR-013: Key Actions -->
                        <div class="cleon-key-actions">
                            <p class="cleon-key-actions-label">KEY ACTIONS</p>
                            <div class="cleon-key-action-item">
                                <div class="cleon-ka-icon cleon-ka-add">
                                    <i class="fa fa-plus-circle"/>
                                </div>
                                <span class="cleon-ka-text">
                                    Click <strong>"Add Leave Type"</strong> on the Leave Types page to create your first policy.
                                </span>
                            </div>
                            <div class="cleon-key-action-item">
                                <div class="cleon-ka-icon cleon-ka-check">
                                    <i class="fa fa-check-circle"/>
                                </div>
                                <span class="cleon-ka-text">
                                    Set entitlements (days per year) and whether days can be carried forward.
                                </span>
                            </div>
                            <div class="cleon-key-action-item">
                                <div class="cleon-ka-icon cleon-ka-accrual">
                                    <i class="fa fa-refresh"/>
                                </div>
                                <span class="cleon-ka-text">
                                    Choose an accrual method: <strong>Monthly</strong>, <strong>Pro-rated</strong>,
                                    or <strong>Full Allocation at year start</strong>.
                                </span>
                            </div>
                        </div>

                    </t>
                    <!-- ── END STEP 1 ─────────────────────────────────── -->


                    <!-- ── STEPS 2–5 placeholders (implemented per screen) -->
                    <!-- ── STEP 2: Set Up Approval Workflows ──────────────── -->
                    <t t-if="state.wizardStep === 2">

                        <!-- FR-018: Step label + icon + title -->
                        <div class="cleon-wizard-step-header">
                            <div class="cleon-wizard-icon cleon-wiz-icon-blue">
                                <i class="fa fa-shield"/>
                            </div>
                            <div class="cleon-wizard-step-meta">
                                <span class="cleon-wiz-step-label">STEP 2 OF 5</span>
                                <h2 id="cleon-wizard-title" class="cleon-wizard-title">Set Up Approval Workflows</h2>
                            </div>
                        </div>

                        <!-- FR-018: Step description -->
                        <p class="cleon-wizard-desc">
                            Control how leave requests are reviewed and authorised. Choose between
                            single-level (direct manager only) or multi-level approval chains. Configure
                            escalation timers so requests are never left waiting.
                        </p>

                        <!-- FR-019 / FR-020 / FR-021: Key Actions -->
                        <div class="cleon-key-actions">
                            <p class="cleon-key-actions-label">KEY ACTIONS</p>

                            <!-- FR-019: Single-level approval -->
                            <div class="cleon-key-action-item">
                                <div class="cleon-ka-icon cleon-ka-single">
                                    <i class="fa fa-user-circle-o"/>
                                </div>
                                <span class="cleon-ka-text">
                                    <strong>Single-level</strong>: one approver
                                    (e.g., <strong>Direct Manager</strong>) signs off the request.
                                </span>
                            </div>

                            <!-- FR-020: Multi-level chain -->
                            <div class="cleon-key-action-item">
                                <div class="cleon-ka-icon cleon-ka-multi">
                                    <i class="fa fa-sitemap"/>
                                </div>
                                <span class="cleon-ka-text">
                                    <strong>Multi-level chain</strong> approvers
                                    (<strong>Manager → HR → Director</strong>) for strict governance.
                                </span>
                            </div>

                            <!-- FR-021: Escalation timers -->
                            <div class="cleon-key-action-item">
                                <div class="cleon-ka-icon cleon-ka-escalation">
                                    <i class="fa fa-clock-o"/>
                                </div>
                                <span class="cleon-ka-text">
                                    Set <strong>escalation timers</strong> — requests auto-escalate
                                    if not actioned within your chosen window.
                                </span>
                            </div>

                        </div>

                    </t>
                    <!-- ── END STEP 2 ─────────────────────────────────────── -->

                    <t t-if="state.wizardStep === 3">
                        <div class="cleon-wizard-step-header">
                            <div class="cleon-wizard-icon cleon-wiz-icon-teal">
                                <i class="fa fa-users"/>
                            </div>
                            <div class="cleon-wizard-step-meta">
                                <span class="cleon-wiz-step-label">STEP 3 OF 5</span>
                                <h2 id="cleon-wizard-title" class="cleon-wizard-title">Configure Approvals</h2>
                            </div>
                        </div>
                        <div class="cleon-wiz-placeholder">
                            <i class="fa fa-cogs cleon-wiz-placeholder-icon"/>
                            <p>Approval workflow setup — coming in the next screen.</p>
                        </div>
                    </t>

                    <t t-if="state.wizardStep === 4">
                        <div class="cleon-wizard-step-header">
                            <div class="cleon-wizard-icon cleon-wiz-icon-orange">
                                <i class="fa fa-balance-scale"/>
                            </div>
                            <div class="cleon-wizard-step-meta">
                                <span class="cleon-wiz-step-label">STEP 4 OF 5</span>
                                <h2 id="cleon-wizard-title" class="cleon-wizard-title">Import Leave Balances</h2>
                            </div>
                        </div>
                        <div class="cleon-wiz-placeholder">
                            <i class="fa fa-cogs cleon-wiz-placeholder-icon"/>
                            <p>Balance import — coming in the next screen.</p>
                        </div>
                    </t>

                    <t t-if="state.wizardStep === 5">
                        <div class="cleon-wizard-step-header">
                            <div class="cleon-wizard-icon cleon-wiz-icon-pink">
                                <i class="fa fa-flag-checkered"/>
                            </div>
                            <div class="cleon-wizard-step-meta">
                                <span class="cleon-wiz-step-label">STEP 5 OF 5</span>
                                <h2 id="cleon-wizard-title" class="cleon-wizard-title">Review &amp; Finish</h2>
                            </div>
                        </div>
                        <div class="cleon-wiz-placeholder">
                            <i class="fa fa-cogs cleon-wiz-placeholder-icon"/>
                            <p>Final review — coming in the next screen.</p>
                        </div>
                    </t>
                    <!-- ── END STEP PLACEHOLDERS ──────────────────────── -->


                    <!-- ── WIZARD FOOTER ──────────────────────────────── -->
                    <div class="cleon-wizard-footer">

                        <!-- FR-015 / FR-023: Back / Previous button -->
                        <button class="cleon-wiz-btn-back" t-on-click="goBackFromWizard">
                            <i class="fa fa-arrow-left"/>
                            <t t-if="state.wizardStep === 1">Back</t>
                            <t t-else="">Previous</t>
                        </button>

                        <!-- FR-014 / FR-022: Go to Leave Types shortcut (Steps 1 and 2) -->
                        <t t-if="state.wizardStep === 1 || state.wizardStep === 2">
                            <button class="cleon-wiz-btn-shortcut" t-on-click="goToLeaveTypesFromWizard">
                                <i class="fa fa-arrow-right"/> Go to Leave Types
                            </button>
                        </t>
                        <t t-else="">
                            <div/><!-- spacer to keep Next aligned right -->
                        </t>

                        <!-- FR-016: Next button -->
                        <button class="cleon-wiz-btn-next" t-on-click="nextWizardStep">
                            <t t-if="state.wizardStep lt 5">
                                Next <i class="fa fa-arrow-right"/>
                            </t>
                            <t t-else="">
                                <i class="fa fa-check"/> Finish Setup
                            </t>
                        </button>

                    </div>

                    <!-- FR-017: Skip link -->
                    <div class="cleon-wiz-skip-row">
                        <button class="cleon-skip-link" t-on-click="skipWizard">
                            Skip and explore on my own
                        </button>
                    </div>

                </div>
            </t>
            <!-- ════ END SETUP WIZARD ════════════════════════════ -->


            <!-- ════════════════════════════════════════════════════
                 SIDEBAR
                 ════════════════════════════════════════════════════ -->
            <div class="leavesidebar">
                <div class="o_cc_sidebar_header">
                    <span class="o_cc_header_dot"/>
                    <span class="o_cc_header_title">Leave Management</span>
                    <button class="btn btn-sm o_cc_collapse_btn" title="Collapse sidebar">
                        <i class="fa fa-th-large"/>
                    </button>
                </div>

                <nav class="o_cc_nav">
                    <a class="o_cc_nav_item o_cc_nav_active" t-on-click="openDashboard">
                        <span class="o_cc_nav_icon"><i class="fa fa-calendar"/></span>
                        <span class="o_cc_nav_label">Dashboard</span>
                    </a>
                    <a class="o_cc_nav_item" t-on-click="openWelcomeModal">
                        <span class="o_cc_nav_icon"><i class="fa fa-magic"/></span>
                        <span class="o_cc_nav_label">Get Started</span>
                        <i class="fa fa-chevron-right o_cc_nav_arrow"/>
                    </a>
                    <a class="o_cc_nav_item" t-on-click="openLeaveCalendar">
                        <span class="o_cc_nav_icon"><i class="fa fa-calendar-o"/></span>
                        <span class="o_cc_nav_label">Leave Calendar</span>
                    </a>
                    <a class="o_cc_nav_item" t-on-click="openLeaveRequests">
                        <span class="o_cc_nav_icon"><i class="fa fa-check-square-o"/></span>
                        <span class="o_cc_nav_label">Leave Request</span>
                        <i class="fa fa-chevron-right o_cc_nav_arrow"/>
                    </a>
                    <p class="sidebar-section-label">Leave Configuration</p>
                    <ul>
                        <li>
                            <a class="o_cc_nav_item" t-on-click="openLeaveTypes">
                                <span class="o_cc_nav_icon"><i class="fa fa-tags"/></span>
                                <span class="o_cc_nav_label">Leave Types</span>
                            </a>
                        </li>
                        <li>
                            <a class="o_cc_nav_item" t-on-click="openLeaveBalances">
                                <span class="o_cc_nav_icon"><i class="fa fa-file-text-o"/></span>
                                <span class="o_cc_nav_label">Leave Balances</span>
                            </a>
                        </li>
                    </ul>
                    <p class="sidebar-section-label">Reports</p>
                    <ul>
                        <a class="o_cc_nav_item" t-on-click="openReports">
                            <span class="o_cc_nav_icon"><i class="fa fa-line-chart"/></span>
                            <span class="o_cc_nav_label">Leave Analytics</span>
                        </a>
                        <a class="o_cc_nav_item" t-on-click="openSettings">
                            <span class="o_cc_nav_icon"><i class="fa fa-cog"/></span>
                            <span class="o_cc_nav_label">Settings</span>
                        </a>
                    </ul>
                </nav>

                <div class="o_cc_sidebar_footer">
                    <span class="o_cc_footer_label">Solution By MaachSoft</span>
                    <div class="o_cc_footer_status">
                        <span class="o_cc_status_dot o_cc_status_green"/>
                        All integrations active
                    </div>
                </div>
            </div>

            <!-- ════════════════════════════════════════════════════
                 MAIN DASHBOARD AREA
                 ════════════════════════════════════════════════════ -->
            <div class="o_leave_dashboard">

                <!-- Header with FR-008 re-open icons -->
                <div class="cleon-dash-header">
                    <div class="cleon-dash-header-left">
                        <h4 class="cleon-dash-title">Leave Management</h4>
                        <span class="cleon-dash-subtitle">Overview and analytics</span>
                    </div>
                    <div class="cleon-dash-header-right">
                        <!-- Setup Wizard icon (✦) -->
                        <button class="cleon-header-icon-btn cleon-wizard-btn"
                                t-on-click="startSetupGuide"
                                title="Open Setup Wizard">
                            <i class="fa fa-magic"/>
                        </button>
                        <!-- Help (?) icon -->
                        <button class="cleon-header-icon-btn cleon-help-btn"
                                t-on-click="openWelcomeModal"
                                title="Help — Re-open Setup Guide">
                            ?
                        </button>
                    </div>
                </div>

                <!-- KPI ROW -->
                <div class="kpi-row">
                    <div class="kpi-card">
                        <div class="kpi-top"><span class="kpi-label">TOTAL EMPLOYEES</span><span class="kpi-icon blue">👥</span></div>
                        <div class="kpi-value" data-kpi="total_employees"><t t-esc="state.kpis.total_employees"/></div>
                        <div class="kpi-sub">0 on leave today</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top"><span class="kpi-label">PENDING APPROVALS</span><span class="kpi-icon orange">⏱</span></div>
                        <div class="kpi-value" data-kpi="pending_approvals"><t t-esc="state.kpis.pending_approvals"/></div>
                        <div class="kpi-sub">Awaiting review</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top"><span class="kpi-label">ON LEAVE TODAY</span><span class="kpi-icon purple">📅</span></div>
                        <div class="kpi-value" data-kpi="on_leave_today"><t t-esc="state.kpis.on_leave_today"/></div>
                        <div class="kpi-sub">0% of workforce</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top"><span class="kpi-label">UPCOMING (7 DAYS)</span><span class="kpi-icon teal">📈</span></div>
                        <div class="kpi-value" data-kpi="upcoming"><t t-esc="state.kpis.upcoming_7_days"/></div>
                        <div class="kpi-sub">Approved upcoming leave</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top"><span class="kpi-label">UTILISATION RATE</span><span class="kpi-icon pink">📊</span></div>
                        <div class="kpi-value" data-kpi="utilisation"><t t-esc="state.kpis.utilisation_rate"/></div>
                        <div class="kpi-sub">Leave days consumed</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top"><span class="kpi-label">COVERAGE ALERTS</span><span class="kpi-icon green">⚠</span></div>
                        <div class="kpi-value" data-kpi="coverage"><t t-esc="state.kpis.coverage_alerts"/></div>
                        <div class="kpi-sub">Coverage healthy</div>
                    </div>
                </div>

                <!-- TRENDS + BY TYPE -->
                <div class="grid-2">
                    <div class="panel">
                        <div class="panel-head">
                            <div>
                                <h5>Leave Trends</h5>
                                <small>Monthly request volume and outcomes</small>
                            </div>
                            <div class="range-toggle">
                                <button class="range-btn active" data-months="6">6 months</button>
                                <button class="range-btn" data-months="12">12 months</button>
                            </div>
                        </div>
                        <div class="stat-row">
                            <div class="stat-box"><div class="stat-value pink" data-summary="total">-</div><div class="stat-label">Total</div></div>
                            <div class="stat-box"><div class="stat-value green" data-summary="approved">-</div><div class="stat-label">Approved</div></div>
                            <div class="stat-box"><div class="stat-value orange" data-summary="pending">-</div><div class="stat-label">Pending</div></div>
                            <div class="stat-box"><div class="stat-value red" data-summary="rejected">-</div><div class="stat-label">Rejected</div></div>
                        </div>
                        <canvas t-ref="trendsChart" height="90"/>
                    </div>
                    <div class="panel">
                        <div class="panel-head">
                            <div><h5>By Leave Type</h5><small>All-time request distribution</small></div>
                        </div>
                        <div class="donut-wrap">
                            <canvas t-ref="byTypeChart" width="160" height="160"/>
                        </div>
                        <div class="legend-list">
                            <div class="legend-row" t-foreach="state.byType" t-as="item" t-key="item.name">
                                <span class="legend-dot" t-att-style="'background:' + this.getPaletteColor(item_index)"/>
                                <span class="legend-name"><t t-esc="item.name"/></span>
                                <span class="legend-count"><t t-esc="item.count"/></span>
                                <span class="legend-pct"><t t-esc="item.percent"/>%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BALANCE + APPROVAL -->
                <div class="grid-2">
                    <div class="panel">
                        <div class="panel-head">
                            <div><h5>Leave Balance by Type</h5><small>Allocation vs utilisation across all employees</small></div>
                        </div>
                        <div class="balance-list">
                            <div class="balance-row" t-foreach="state.balance" t-as="item" t-key="item.name">
                                <div class="balance-header">
                                    <span class="legend-dot" t-att-style="'background:' + item.color"/>
                                    <span class="balance-name"><t t-esc="item.name"/></span>
                                    <span class="balance-figures">
                                        <t t-esc="item.used"/> used / <t t-esc="item.allocated"/> allocated · <t t-esc="item.percent"/>%
                                    </span>
                                </div>
                                <div class="balance-track">
                                    <div class="balance-fill" t-att-style="'width:' + item.percent + '%;background:' + item.color"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="panel">
                        <div class="panel-head">
                            <div><h5>Approval Overview</h5><small>Request resolution summary</small></div>
                        </div>
                        <div class="approval-wrap">
                            <div class="approval-chart-box">
                                <canvas t-ref="approvalChart" width="140" height="140"/>
                                <div class="approval-center">
                                    <div class="approval-rate" data-approval="rate">-</div>
                                    <small>Approval</small>
                                </div>
                            </div>
                        </div>
                        <div class="approval-rows">
                            <div class="approval-row approved"><span>✓ Approved</span><span data-approval="approved">-</span></div>
                            <div class="approval-row pending"><span>⏱ Pending</span><span data-approval="pending">-</span></div>
                            <div class="approval-row rejected"><span>✕ Rejected</span><span data-approval="rejected">-</span></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>
