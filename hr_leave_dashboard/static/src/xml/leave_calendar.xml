<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_leave_dashboard.LeaveCalendarPage" owl="1">
        <div t-att-class="props.embedded ? 'leaveapp leaveapp-embedded' : 'leaveapp'">

            <!-- Shared Sidebar -->
            <CalendarSidebar t-if="!props.embedded" activeMenu="'calendar'"/>

            <!-- Main Content Area -->
            <div class="o_leave_dashboard">

                <CleonCalendar
                    events="calendarEvents"
                    date="state.currentDate"
                    view="state.viewMode"
                    views="availableViews"
                    loading="state.loading"
                    error="state.loadError"
                    selectable="canSelectDates"
                    showDayContent="state.coverageMode"
                    dayTitle="state.employeeView ? 'Click for day details; drag to request a date range' : 'Click for roster; drag to book a date range'"
                    emptyText="state.viewMode === 'day' ? 'No employees are on leave on this day.' : 'No leaves'"
                    dayHeading="'Schedules for'"
                    yearDayCount.bind="yearDayCount"
                    onRangeChange.bind="onRangeChange"
                    onDayClick.bind="onDayClick"
                    onSelectRange.bind="onSelectRange"
                    onEventClick.bind="onCalendarEventClick"
                    onMoreClick.bind="openDayPanel"
                    onRetry.bind="loadCalendarData">

                    <t t-set-slot="toolbarStart">
                        <div t-if="state.canSwitchPerspective" class="o_cc_perspective me-2">
                            <button t-if="state.canUseOrganisation" t-att-class="state.calendarScope === 'organisation' ? 'active' : ''" t-on-click="() => this.setPerspective('organisation')">Organisation</button>
                            <button t-if="state.canUseTeam" t-att-class="state.calendarScope === 'team' ? 'active' : ''" t-on-click="() => this.setPerspective('team')">Team</button>
                            <button t-if="state.canUsePersonal" t-att-class="state.calendarScope === 'personal' ? 'active' : ''" t-on-click="() => this.setPerspective('personal')">My Calendar</button>
                        </div>
                    </t>

                    <t t-set-slot="actions">
                        <!-- Coverage Analysis Toggle Button -->
                        <button t-if="state.canViewCoverage and state.calendarScope !== 'personal'" type="button"
                                t-att-class="'btn btn-sm ' + (state.coverageMode ? 'btn-pink-active' : 'btn-outline-secondary')"
                                t-on-click="toggleCoverageMode">
                            <i class="fa fa-line-chart me-1"/> Coverage Analysis
                        </button>

                        <!-- AI Summary Button (LM-044) -->
                        <button t-if="state.canViewAiSummary"
                                type="button"
                                t-att-class="'btn btn-sm ' + (state.aiSummary.open ? 'btn-pink-active' : 'btn-outline-secondary')"
                                t-on-click="showAiSummary"
                                title="AI Calendar &amp; Availability Summary">
                            <i class="fa fa-magic me-1"/> AI Summary
                        </button>

                        <!-- Smart Date Recommendations (LM-040) -->
                        <button t-if="state.canDateRec"
                                type="button"
                                class="btn btn-sm btn-outline-secondary"
                                t-on-click="() => this.state.showDateRecModal = true"
                                title="Smart Leave Date Recommendations">
                            <i class="fa fa-calendar-check-o me-1 text-purple"/> Suggest Best Dates
                        </button>

                        <!-- Filters Button -->
                        <button type="button" class="btn btn-sm btn-outline-secondary position-relative" t-on-click="openFilters">
                            <i class="fa fa-filter me-1"/> Filters
                            <t t-if="this.activeFilterCount > 0">
                                <span class="badge rounded-pill bg-danger ms-1"><t t-esc="this.activeFilterCount"/></span>
                            </t>
                        </button>

                        <!-- Download Dropdown Button -->
                        <button t-if="state.canRequest and state.employeeView" type="button" class="btn btn-sm btn-pink-active cleon-calendar-request-slot" t-on-click="openEmployeeRequest"><i class="fa fa-plus"/> Request Leave</button>
                        <button t-if="state.canBook and state.calendarScope === 'organisation'" type="button" class="btn btn-sm btn-pink-active cleon-calendar-request-slot" t-on-click="() => this.openAdminBooking()"><i class="fa fa-plus"/> Book Time Off</button>
                        <div t-if="state.canExport" class="dropdown d-inline-block">
                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" t-on-click="toggleDownloadDropdown">
                                <i class="fa fa-download me-1"/> Download
                            </button>
                            <ul t-att-class="'dropdown-menu dropdown-menu-end ' + (state.downloadDropdownOpen ? 'show' : '')">
                                <li><a class="dropdown-item small" href="#" t-on-click="() => this.exportCalendar('pdf')"><i class="fa fa-file-pdf-o me-2 text-danger"/> Export PDF</a></li>
                                <li><a class="dropdown-item small" href="#" t-on-click="() => this.exportCalendar('excel')"><i class="fa fa-file-excel-o me-2 text-success"/> Export Excel (.xlsx)</a></li>
                                <li><a class="dropdown-item small" href="#" t-on-click="() => this.exportCalendar('ics')"><i class="fa fa-calendar-check-o me-2 text-primary"/> Export iCal (.ics)</a></li>
                            </ul>
                        </div>
                    </t>

                    <t t-set-slot="banner">
                        <!-- AI Calendar Summary Panel (LM-044) -->
                        <div t-if="state.aiSummary.open" class="o_cal_ai_summary">
                            <div class="o_cal_ai_summary_header">
                                <span><i class="fa fa-magic text-purple"/> <strong t-esc="state.aiSummary.heading || 'Calendar Summary'"/></span>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" class="btn btn-xs btn-outline-secondary" t-on-click="refreshAiSummary" title="Refresh Summary">
                                        <i class="fa fa-refresh"/> Refresh
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary" t-on-click="copyAiSummary" title="Copy to Clipboard">
                                        <i class="fa fa-clipboard"/> Copy
                                    </button>
                                    <button type="button" t-on-click="closeAiSummary" class="o_cal_ai_close" title="Close"><i class="fa fa-times"/></button>
                                </div>
                            </div>
                            <div t-if="state.aiSummary.loading" class="o_cal_ai_loading">
                                <i class="fa fa-spinner fa-spin"/> Generating summary…
                            </div>
                            <div t-elif="state.aiSummary.error" class="o_cal_ai_error">
                                <i class="fa fa-exclamation-circle"/> <t t-esc="state.aiSummary.error"/>
                            </div>
                            <ul t-else="" class="o_cal_ai_bullets_list">
                                <li t-foreach="state.aiSummary.bullets" t-as="bullet" t-key="bullet_index"
                                    t-att-class="bullet.includes('risk') || bullet.includes('coverage') ? 'o_cal_ai_risk_bullet' : ''"
                                    t-esc="bullet"/>
                            </ul>
                        </div>
                    </t>

                    <!-- COVERAGE ANALYSIS OVERLAY MODE (Fig 11.2) -->
                    <t t-set-slot="dayContent" t-slot-scope="cell">
                        <t t-set="cov" t-value="this.getDayCoverageInfo(cell.day.ymd)"/>
                        <div t-att-class="'coverage-tile-cell ' + cov.level">
                            <strong class="coverage-avail-text"><t t-esc="cov.percentage"/>% Available</strong>
                            <span class="coverage-absent-text"><t t-esc="cov.absentCount"/> on leave</span>
                        </div>
                    </t>

                    <!-- YEAR VIEW extras (Fig 11.4, FR-162 to FR-168) -->
                    <t t-set-slot="yearHeader">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="h5 font-weight-bold mb-0"><t t-esc="state.currentDate.getFullYear()"/> Annual Leave Overview</h3>
                            <div class="country-region-selector d-flex align-items-center gap-2">
                                <span class="small font-weight-bold text-muted"><i class="fa fa-globe"/> Region:</span>
                                <select class="form-select form-select-sm w-auto" t-on-change="(ev) => this.selectCountry(ev.target.value)">
                                    <t t-foreach="state.yearData and state.yearData.all_countries ? state.yearData.all_countries : []" t-as="c" t-key="c.id">
                                        <option t-att-value="c.id" t-att-selected="state.yearData and state.yearData.country and c.id === state.yearData.country.id">
                                            <t t-esc="c.name"/> (<t t-esc="c.code"/>)
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>
                    </t>
                    <t t-set-slot="yearMonthSummary" t-slot-scope="scope">
                        <t t-set="summary" t-value="this.getYearMonthSummary(scope.month.number)"/>
                        <div class="month-summary-line small text-muted mb-2">
                            <span class="dot-approved">• <t t-esc="summary.approved"/> approved</span>
                            <span class="dot-pending ms-2">• <t t-esc="summary.pending"/> pending</span>
                            <span class="dot-holiday ms-2">• <t t-esc="summary.holidays"/> holidays</span>
                        </div>
                    </t>
                    <t t-set-slot="yearMonthFooter" t-slot-scope="scope">
                        <t t-set="monthHolidays" t-value="this.getYearMonthHolidays(scope.month.number)"/>
                        <div t-if="monthHolidays.length" class="holiday-annotations-box mt-2 pt-2 border-top">
                            <t t-foreach="monthHolidays" t-as="h" t-key="h.date">
                                <div class="holiday-annotation-item text-muted">
                                    • <t t-esc="h.date.split('-')[2]"/> <t t-esc="h.name"/>
                                </div>
                            </t>
                        </div>
                        <div t-else="" class="holiday-annotations-box mt-2 pt-2 border-top text-muted small italic">
                            No public holidays configured
                        </div>
                    </t>

                    <!-- CALENDAR LEGEND BAR (FR-153, FR-156) -->
                    <t t-set-slot="legend">
                        <div class="legend-title font-weight-bold small mb-2 text-uppercase text-muted">Legend</div>
                        <div class="d-flex align-items-center gap-3 flex-wrap small">
                            <t t-foreach="state.leaveTypes" t-as="leaveType" t-key="leaveType.id">
                                <div class="legend-item d-flex align-items-center gap-1">
                                    <span class="legend-dot" t-att-style="'background-color: ' + this.getLeaveTypeColor(leaveType.color_hex)"/>
                                    <span><t t-esc="leaveType.name"/></span>
                                </div>
                            </t>
                            <div class="legend-item d-flex align-items-center gap-1">
                                <span class="legend-dot pending-pattern"/>
                                <span>Pending Request</span>
                            </div>
                            <div class="legend-item d-flex align-items-center gap-1">
                                <span class="legend-dot holiday-dot"/>
                                <span>Public Holiday</span>
                            </div>
                            <t t-if="state.coverageMode">
                                <div class="legend-item d-flex align-items-center gap-1 text-danger font-weight-bold">
                                    <i class="fa fa-exclamation-triangle me-1"/>
                                    <span>Low Coverage (&lt;70%)</span>
                                </div>
                            </t>
                        </div>
                    </t>
                </CleonCalendar>

            </div>

            <!-- ════════════════════════════════════════════════════
                 FILTERS SIDE PANEL (Fig 11.5, FR-169 to FR-177)
                 ════════════════════════════════════════════════════ -->
            <t t-if="state.filterPanelOpen">
                <div class="cleon-welcome-backdrop" style="z-index: 1060;" t-on-click="closeFilters"/>
                <div class="filters-slide-panel shadow-lg bg-white" style="z-index: 1070;" role="dialog" aria-modal="true">
                    <div class="filter-panel-header border-bottom p-3 d-flex justify-content-between align-items-center">
                        <h4 class="h6 font-weight-bold mb-0"><i class="fa fa-filter me-2"/> Filters</h4>
                        <button type="button" class="btn-close" t-on-click="closeFilters"/>
                    </div>
                    <div class="filter-panel-body p-3 overflow-y-auto">

                        <div t-if="state.employeeView" class="filter-section mb-4">
                            <label class="form-label font-weight-bold small text-uppercase text-muted">Show Events</label>
                            <div class="filter-checkbox-list">
                                <label class="form-check small mb-2"><input class="form-check-input" type="checkbox" t-att-checked="state.employeeEventFilters.includes('all')" t-on-change="() => this.toggleEmployeeEventFilter('all')"/> All Events</label>
                                <label class="form-check small mb-2"><input class="form-check-input" type="checkbox" t-att-checked="state.employeeEventFilters.includes('mine')" t-on-change="() => this.toggleEmployeeEventFilter('mine')"/> My Leave</label>
                                <label class="form-check small mb-2"><input class="form-check-input" type="checkbox" t-att-checked="state.employeeEventFilters.includes('team')" t-on-change="() => this.toggleEmployeeEventFilter('team')"/> Team Leave</label>
                                <label class="form-check small mb-2"><input class="form-check-input" type="checkbox" t-att-checked="state.employeeEventFilters.includes('holidays')" t-on-change="() => this.toggleEmployeeEventFilter('holidays')"/> Public Holidays</label>
                            </div>
                        </div>

                        <t t-if="!state.employeeView">

                        <!-- Date Range -->
                        <div class="filter-section mb-4">
                            <label class="form-label font-weight-bold small text-uppercase text-muted">Date Range</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="date" class="form-control form-control-sm" t-model="state.filterDraft.dateFrom" placeholder="mm/dd/yyyy"/>
                                </div>
                                <div class="col-6">
                                    <input type="date" class="form-control form-control-sm" t-model="state.filterDraft.dateTo" placeholder="mm/dd/yyyy"/>
                                </div>
                            </div>
                        </div>

                        <!-- Department Checkboxes -->
                        <div class="filter-section mb-4">
                            <label class="form-label font-weight-bold small text-uppercase text-muted">Department</label>
                            <div class="filter-checkbox-list">
                                <t t-foreach="state.departments" t-as="dept" t-key="dept.id">
                                    <div class="form-check small mb-1">
                                        <input class="form-check-input" type="checkbox"
                                               t-att-id="'filter_dept_' + dept.id"
                                               t-att-checked="state.filterDraft.departmentIds.includes(dept.id)"
                                               t-on-change="() => this.toggleDraftDepartment(dept.id)"/>
                                        <label class="form-check-label" t-att-for="'filter_dept_' + dept.id">
                                            <t t-esc="dept.name"/>
                                        </label>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Leave Type Checkboxes -->
                        <div class="filter-section mb-4">
                            <label class="form-label font-weight-bold small text-uppercase text-muted">Leave Type</label>
                            <div class="filter-checkbox-list">
                                <t t-foreach="state.leaveTypes" t-as="leaveType" t-key="leaveType.id">
                                    <div class="form-check small mb-1">
                                        <input class="form-check-input" type="checkbox"
                                               t-att-id="'filter_lt_' + leaveType.id"
                                               t-att-checked="state.filterDraft.leaveTypeIds.includes(leaveType.id)"
                                               t-on-change="() => this.toggleDraftLeaveType(leaveType.id)"/>
                                        <label class="form-check-label" t-att-for="'filter_lt_' + leaveType.id">
                                            <t t-esc="leaveType.name"/>
                                        </label>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Status Checkboxes -->
                        <div class="filter-section mb-4">
                            <label class="form-label font-weight-bold small text-uppercase text-muted">Status</label>
                            <div class="filter-checkbox-list">
                                <div class="form-check small mb-1">
                                    <input class="form-check-input" type="checkbox" id="filter_st_approved"
                                           t-att-checked="state.filterDraft.statuses.includes('approved')"
                                           t-on-change="() => this.toggleDraftStatus('approved')"/>
                                    <label class="form-check-label" for="filter_st_approved">Approved</label>
                                </div>
                                <div class="form-check small mb-1">
                                    <input class="form-check-input" type="checkbox" id="filter_st_pending"
                                           t-att-checked="state.filterDraft.statuses.includes('pending')"
                                           t-on-change="() => this.toggleDraftStatus('pending')"/>
                                    <label class="form-check-label" for="filter_st_pending">Pending</label>
                                </div>
                                <div class="form-check small mb-1">
                                    <input class="form-check-input" type="checkbox" id="filter_st_cancelled"
                                           t-att-checked="state.filterDraft.statuses.includes('cancelled')"
                                           t-on-change="() => this.toggleDraftStatus('cancelled')"/>
                                    <label class="form-check-label" for="filter_st_cancelled">Cancelled</label>
                                </div>
                            </div>
                        </div>

                        <!-- Searchable Employee List -->
                        <div class="filter-section mb-4">
                            <label class="form-label font-weight-bold small text-uppercase text-muted">Employees</label>
                            <input type="text" class="form-control form-control-sm mb-2"
                                   placeholder="Search employees..."
                                   t-model="state.filterDraft.employeeSearch"/>
                            <div class="filter-scrollable-emp-list border rounded p-2" style="max-height: 180px; overflow-y: auto;">
                                <t t-foreach="this.visibleFilterEmployees" t-as="emp" t-key="emp.id">
                                    <div class="form-check small mb-1">
                                        <input class="form-check-input" type="checkbox"
                                               t-att-id="'filter_emp_' + emp.id"
                                               t-att-checked="state.filterDraft.employeeIds.includes(emp.id)"
                                               t-on-change="() => this.toggleDraftEmployee(emp.id)"/>
                                        <label class="form-check-label" t-att-for="'filter_emp_' + emp.id">
                                            <t t-esc="emp.name"/> <span class="text-muted">• <t t-esc="emp.department"/></span>
                                        </label>
                                    </div>
                                </t>
                            </div>
                        </div>

                        </t>

                    </div>
                    <div class="filter-panel-footer border-top p-3 d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-sm btn-link text-muted p-0" t-on-click="clearAllFilters">Clear All</button>
                        <button type="button" class="btn btn-sm btn-pink-active px-4" t-on-click="applyFilters">Apply Filters</button>
                    </div>
                </div>
            </t>

            <!-- Reused Leave Request Detail Modal -->
            <t t-if="state.detailRequestId">
                <LeaveRequestDetailModal
                    requestId="state.detailRequestId"
                    close.bind="closeDetailModal"
                    onChanged.bind="loadCalendarData"/>
            </t>
            <EmployeeRequestModal t-if="state.employeeRequestOpen" close.bind="closeEmployeeRequest" submitted.bind="loadCalendarData" initial="state.employeeRequestInitial"/>
            <CalendarDayPanel t-if="state.dayPanelOpen" dateFrom="state.dayPanelDateFrom" dateTo="state.dayPanelDateTo" leaves="dayPanelLeaves" holidays="dayPanelHolidays" canRequest="state.canRequest" canBook="state.canBook" isOrganisation="state.calendarScope === 'organisation'" openRequest.bind="openRequestRange" openAdminBooking.bind="openAdminBooking" openDetail.bind="openLeaveDetail" close.bind="closeDayPanel"/>
            <AdminBookTimeOffModal t-if="state.adminBookOpen" close.bind="closeAdminBooking" submitted.bind="loadCalendarData" initialDateFrom="state.adminBookDateFrom" initialDateTo="state.adminBookDateTo"/>
            <SmartDateRecommendationsModal t-if="state.showDateRecModal" close="() => this.state.showDateRecModal = false" onSelect="(item) => this.onSelectRecommendedDate(item)" types="state.leaveTypes"/>

        </div>
    </t>

</templates>
