<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Minimal backend list/form as an admin-only fallback / data
         inspection view. The primary UI is the custom dashboard pages
         below, opened via the actions further down. -->
    <record id="view_hr_onboarding_list" model="ir.ui.view">
        <field name="name">hr.onboarding.list</field>
        <field name="model">hr.onboarding</field>
        <field name="arch" type="xml">
            <tree string="Onboarding">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="start_date"/>
                <field name="day_number"/>
                <field name="progress_percent"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_onboarding_form" model="ir.ui.view">
        <field name="name">hr.onboarding.form</field>
        <field name="model">hr.onboarding</field>
        <field name="arch" type="xml">
            <form string="Onboarding">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="department_id" readonly="1"/>
                        <field name="job_id" readonly="1"/>
                        <field name="start_date"/>
                        <field name="duration_days"/>
                        <field name="state" widget="badge"/>
                    </group>
                    <notebook>
                        <page string="Tasks">
                            <field name="task_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="due_date"/>
                                    <field name="is_done"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_onboarding_backend" model="ir.actions.act_window">
        <field name="name">Onboarding Records (Admin)</field>
        <field name="res_model">hr.onboarding</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Act_url entries open the custom QWeb dashboard pages -->
    <record id="action_open_onboarding_dashboard" model="ir.actions.act_url">
        <field name="name">All Onboarding</field>
        <field name="url">/onboarding</field>
        <field name="target">self</field>
    </record>

    <record id="action_open_new_employee" model="ir.actions.act_url">
        <field name="name">Add New Employee</field>
        <field name="url">/onboarding/new</field>
        <field name="target">self</field>
    </record>

    <record id="action_open_probation_tracking" model="ir.actions.act_url">
        <field name="name">Probation Tracking</field>
        <field name="url">/onboarding/probation</field>
        <field name="target">self</field>
    </record>

    <!-- <menuitem id="menu_hr_onboarding_root" name="Onboarding" sequence="25"/> -->
    <menuitem id="menu_hr_onboarding_dashboard" name="All Onboarding"
              parent="hr_preonboarding.menu_hr_preonboarding_root"
              action="action_open_onboarding_dashboard" sequence="10"/>
    <menuitem id="menu_hr_onboarding_new" name="Add New Employee"
              parent="menu_hr_onboarding_dashboard"
              action="action_open_new_employee" sequence="20"/>
    <menuitem id="menu_hr_onboarding_probation" name="Probation Tracking"
              parent="menu_hr_onboarding_dashboard"
              action="action_open_probation_tracking" sequence="30"/>
    <menuitem id="menu_hr_onboarding_admin" name="Onboarding Records (Admin)"
              parent="menu_hr_onboarding_dashboard"
              action="action_hr_onboarding_backend" sequence="90"
              groups="base.group_system"/>
    <!-- <record id="hr_onboarding.menu_hr_onboarding_dashboard" model="ir.ui.menu">
        <field name="icon_class">fa fa-user</field>
        <field name="category_name">CleonHR-HR Worklife cycle</field>
    </record> -->

</odoo>
