<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="probation_template" name="Probation Tracking">
        <t t-call="hr_onboarding.layout">
            <t t-set="active_tab" t-value="'probation'"/>

            <h4 class="mb-3">Probation Tracking <span class="badge badge-pink"><t t-esc="len(contracts)"/> on probation</span></h4>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="ob-card p-0">
                        <t t-foreach="contracts" t-as="c">
                            <a t-attf-href="/onboarding/probation/#{c.id}"
                               t-attf-class="d-block p-3 text-decoration-none text-dark border-bottom #{selected and selected.id == c.id and 'bg-light' or ''}">
                                <div class="d-flex justify-content-between">
                                    <strong t-esc="c.employee_id.name"/>
                                    <span class="badge bg-info text-dark">On Probation</span>
                                </div>
                                <div class="text-muted small" t-esc="c.employee_id.job_id.name or ''"/>
                                <div class="text-muted small mt-1">
                                    <t t-esc="(c.trial_date_end - today).days"/>d left
                                </div>
                            </a>
                        </t>
                        <div t-if="not contracts" class="p-4 text-center text-muted">No one currently on probation.</div>
                    </div>
                </div>

                <div class="col-md-8" t-if="selected">
                    <div class="ob-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="mb-0" t-esc="selected.employee_id.name"/>
                                <span class="text-muted" t-esc="selected.employee_id.job_id.name or ''"/>
                            </div>
                            <div class="d-flex gap-2">
                                <form method="post" t-attf-action="/onboarding/probation/#{selected.id}/extend">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="days" value="30"/>
                                    <button class="btn btn-outline-secondary btn-sm" type="submit">Extend 30d</button>
                                </form>
                                <form method="post" t-attf-action="/onboarding/probation/#{selected.id}/pip">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button class="btn btn-outline-warning btn-sm" type="submit">PIP</button>
                                </form>
                                <form method="post" t-attf-action="/onboarding/probation/#{selected.id}/confirm">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button class="btn btn-accent btn-sm" type="submit">✓ Confirm</button>
                                </form>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="text-center">
                                    <div class="ob-stat-num"><t t-esc="(selected.trial_date_end - today).days"/></div>
                                    <div class="text-muted small">days left</div>
                                </div>
                                <div class="d-flex justify-content-between mt-3 small text-muted">
                                    <span>Start: <strong t-esc="selected.trial_date_start"/></span>
                                    <span>End: <strong t-esc="selected.trial_date_end"/></span>
                                </div>
                                <div class="progress mt-2" style="height:8px;">
                                    <t t-set="total_days" t-value="max((selected.trial_date_end - selected.trial_date_start).days, 1)"/>
                                    <t t-set="elapsed_days" t-value="max((today - selected.trial_date_start).days, 0)"/>
                                    <t t-set="pct" t-value="min(100, round(elapsed_days * 100 / total_days))"/>
                                    <div class="progress-bar bg-success" t-attf-style="width: #{pct}%"/>
                                </div>
                            </div>
                            <div class="col-md-6" t-if="selected_onboarding">
                                <div class="text-center">
                                    <div class="ob-stat-num"><t t-esc="selected_onboarding.progress_percent"/>%</div>
                                    <div class="text-muted small">onboarding tasks completed</div>
                                </div>
                                <div class="text-center text-muted small mt-2">
                                    <t t-esc="selected_onboarding.tasks_done"/>/<t t-esc="selected_onboarding.task_count"/> tasks done
                                    <span t-if="selected.on_pip" class="badge bg-warning text-dark ms-2">On PIP</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-8" t-else="">
                    <div class="ob-card text-center text-muted py-5">Select an employee to view probation details.</div>
                </div>
            </div>
        </t>
    </template>

</odoo>
