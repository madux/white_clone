<odoo>
    <record id="rule_overtime_company_global" model="ir.rule">
        <field name="name">Overtime Global Company Rule</field>
        <field name="model_id" ref="model_cleon_overtime_request" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_overtime_employee_own" model="ir.rule">
        <field name="name">Employees manage their own overtime requests</field>
        <field name="model_id" ref="model_cleon_overtime_request" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_user')), (4, ref('base.group_user'))]" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_overtime_line_manager_team" model="ir.rule">
        <field name="name">Line Managers manage team overtime</field>
        <field name="model_id" ref="model_cleon_overtime_request" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_line_manager'))]" />
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_overtime_hr_manager_company" model="ir.rule">
        <field name="name">HR Managers manage company overtime</field>
        <field name="model_id" ref="model_cleon_overtime_request" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_hr_manager')), (4, ref('hr_time_management.group_time_management_hr_admin')), (4, ref('base.group_system'))]" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>
