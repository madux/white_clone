<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_preonboarding_form" model="ir.ui.view">
        <field name="name">hr.preonboarding.form</field>
        <field name="model">hr.preonboarding</field>
        <field name="arch" type="xml">
            <form string="Pre-Onboarding">
                <header>
                    <button name="action_submit_for_approval" type="object"
                            string="Submit for Approval" class="btn-primary"
                            invisible="state != 'initiation'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'awaiting_approval'"/>
                    <button name="action_next_stage" type="object"
                            string="Move to Next Stage" class="btn-primary"
                            invisible="state not in ('offer_accepted','document_request','document_received','under_verification','cleared')"/>
                    <button name="action_reject" type="object"
                            string="Reject"
                            invisible="state in ('rejected','cancelled','converted_to_employee')"
                            confirm="Are you sure you want to reject this candidate?"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('rejected','cancelled','converted_to_employee')"
                            confirm="Are you sure you want to cancel this pre-onboarding?"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Initiation"
                            invisible="state not in ('rejected','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="initiation,awaiting_approval,offer_accepted,document_request,document_received,under_verification,cleared,converted_to_employee"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="candidate_id"/>
                            <field name="job_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="employee_id" readonly="1"
                                   invisible="not employee_id"/>
                            <field name="follower_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="document_name"/>
                                    <field name="document" filename="document_filename"/>
                                    <field name="document_filename" column_invisible="1"/>
                                    <field name="state"/>
                                    <button name="action_send_request" type="object"
                                            string="Send Request" icon="fa-envelope"
                                            invisible="state != 'draft'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hr_preonboarding_list" model="ir.ui.view">
        <field name="name">hr.preonboarding.list</field>
        <field name="model">hr.preonboarding</field>
        <field name="arch" type="xml">
            <list string="Pre-Onboarding">
                <field name="candidate_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'converted_to_employee'"
                       decoration-danger="state in ('rejected','cancelled')"
                       decoration-info="state not in ('converted_to_employee','rejected','cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_hr_preonboarding_search" model="ir.ui.view">
        <field name="name">hr.preonboarding.search</field>
        <field name="model">hr.preonboarding</field>
        <field name="arch" type="xml">
            <search string="Pre-Onboarding">
                <field name="candidate_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <filter string="Incomplete" name="incomplete"
                        domain="[('state','not in',['converted_to_employee','rejected','cancelled'])]"/>
                <filter string="Converted to Employee" name="converted"
                        domain="[('state','=','converted_to_employee')]"/>
                <filter string="Rejected/Cancelled" name="closed_out"
                        domain="[('state','in',['rejected','cancelled'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Department" name="group_department" context="{'group_by':'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_preonboarding" model="ir.actions.act_window">
        <field name="name">Pre-Onboarding</field>
        <field name="res_model">hr.preonboarding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_incomplete': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a pre-onboarding record for a new candidate
            </p>
        </field>
    </record>

    <record id="action_hr_preonboarding_incomplete" model="ir.actions.act_window">
        <field name="name">Incomplete Pre-Onboardings</field>
        <field name="res_model">hr.preonboarding</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','not in',['converted_to_employee','rejected','cancelled'])]</field>
    </record>

    <menuitem id="menu_hr_preonboarding_root" name="Pre-Onboarding" sequence="20"/>
    <menuitem id="menu_hr_preonboarding_all" name="All Pre-Onboardings"
              parent="menu_hr_preonboarding_root" action="action_hr_preonboarding" sequence="10"/>
    <menuitem id="menu_hr_preonboarding_incomplete" name="Incomplete"
              parent="menu_hr_preonboarding_root" action="action_hr_preonboarding_incomplete" sequence="20"/>

</odoo>
