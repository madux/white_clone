<odoo>
    <record id="rule_cleon_shift_company" model="ir.rule">
        <field name="name">Shift Company Rule</field>
        <field name="model_id" ref="model_cleon_hr_shift" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_cleon_shift_assignment_company" model="ir.rule">
        <field name="name">Shift Assignment Company Rule</field>
        <field name="model_id" ref="model_cleon_hr_shift_assignment" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_cleon_shift_swap_company" model="ir.rule">
        <field name="name">Shift Swap Global Company Rule</field>
        <field name="model_id" ref="model_cleon_shift_swap_request" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_shift_swap_employee_own" model="ir.rule">
        <field name="name">Employees manage their own shift swap requests</field>
        <field name="model_id" ref="model_cleon_shift_swap_request" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_user')), (4, ref('base.group_user'))]" />
        <field name="domain_force">['|', ('requester_id.user_id', '=', user.id), ('target_employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_shift_swap_line_manager_team" model="ir.rule">
        <field name="name">Line Managers manage team shift swap requests</field>
        <field name="model_id" ref="model_cleon_shift_swap_request" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_line_manager'))]" />
        <field name="domain_force">['|', '|', ('requester_id.user_id', '=', user.id), ('target_employee_id.user_id', '=', user.id), ('requester_id.parent_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_shift_swap_hr_manager_company" model="ir.rule">
        <field name="name">HR Managers manage company shift swap requests</field>
        <field name="model_id" ref="model_cleon_shift_swap_request" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_hr_manager')), (4, ref('base.group_system'))]" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_cleon_shift_segment_company" model="ir.rule">
        <field name="name">Cleon Shift Segment Company Rule</field>
        <field name="model_id" ref="model_cleon_hr_shift_segment" />
        <field name="domain_force">[('shift_id.company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>
