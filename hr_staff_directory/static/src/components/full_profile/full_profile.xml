<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_staff_directory.StaffDirectoryFullProfile">
        <div class="sdir-fp-wrapper">
            <div class="sdir-fp-header">
                <button class="sdir-fp-back-btn" t-on-click="() => props.closeFullProfile()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> 
                    Back to Directory
                </button>
                <div class="sdir-fp-header-actions">
                    <button class="sdir-fp-header-btn" t-on-click="() => this.mailModalService.show(props.activeProfile)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg> 
                        Message
                    </button>
                    <button class="sdir-fp-header-btn" t-on-click="() => this.messageService.show(props.activeProfile, { startVideoCall: true })">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path><path d="M14.05 2a9 9 0 0 1 8 7.94"></path><path d="M14.05 6A5 5 0 0 1 18 10"></path></svg> 
                        Call
                    </button>
                </div>
            </div>

            <div class="sdir-fp-body">
                <div class="sdir-fp-sidebar">
                    <div class="sdir-fp-sidebar-inner">
                        <div class="sdir-fp-avatar-section">
                            <div class="sdir-fp-avatar-wrapper">
                                <div class="sdir-fp-avatar" t-att-style="props.activeProfile.has_image ? '' : 'background-color:' + this.avatarColor(props.activeProfile.name)">
                                    <img t-if="props.activeProfile.has_image" t-attf-src="/web/image?model=hr.employee&amp;id={{props.activeProfile.id}}&amp;field=avatar_128&amp;unique={{props.activeProfile.avatar_cache_key}}" alt="Avatar"/>
                                    <span t-else=""><t t-esc="this.initials(props.activeProfile.name)"/></span>
                                </div>
                                <div class="sdir-fp-status-dot"></div>
                            </div>
                            <h2 class="sdir-fp-name"><t t-esc="props.activeProfile.name"/></h2>
                            <p class="sdir-fp-job"><t t-esc="props.activeProfile.job_title"/></p>
                            <p class="sdir-fp-dept"><t t-esc="props.activeProfile.department"/></p>
                            <span class="sdir-fp-emp-ref"><t t-esc="props.activeProfile.emp_ref"/></span>
                        </div>

                        <div class="sdir-fp-contact-section">
                            <div class="sdir-fp-contact-item" t-on-click="() => this.mailModalService.show(props.activeProfile)" style="cursor: pointer;">
                                <div class="sdir-fp-contact-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                                </div>
                                <span class="sdir-fp-contact-text" style="color: #2563EB; text-decoration: underline;"><t t-esc="props.activeProfile.work_email"/></span>
                            </div>
                            <div class="sdir-fp-contact-item" t-on-click="() => this.messageService.show(props.activeProfile, { startVideoCall: true })" style="cursor: pointer;">
                                <div class="sdir-fp-contact-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                </div>
                                <span class="sdir-fp-contact-text" style="color: #2563EB; text-decoration: underline;"><t t-esc="props.activeProfile.work_phone"/></span>
                            </div>
                            <div class="sdir-fp-contact-item">
                                <div class="sdir-fp-contact-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                </div>
                                <span class="sdir-fp-contact-text"><t t-esc="props.activeProfile.work_location"/></span>
                            </div>
                        </div>

                        <div class="sdir-fp-manager-section">
                            <p class="sdir-fp-manager-label">Manager</p>
                            <t t-if="props.activeProfile.manager_name">
                                <div class="sdir-fp-manager-item" t-on-click="() => props.openFullProfileById(props.activeProfileManager.id)" style="cursor: pointer;">
                                    <div class="sdir-fp-manager-avatar" t-att-style="'background-color:' + this.avatarColor(props.activeProfile.manager_name)">
                                        <img t-if="props.activeProfileManager and props.activeProfileManager.has_image" t-attf-src="/web/image?model=hr.employee&amp;id={{props.activeProfileManager.id}}&amp;field=avatar_128" alt="Avatar"/>
                                        <span t-else=""><t t-esc="this.initials(props.activeProfile.manager_name)"/></span>
                                    </div>
                                    <div class="sdir-fp-manager-info">
                                        <p class="sdir-fp-manager-name"><t t-esc="props.activeProfile.manager_name"/></p>
                                        <p class="sdir-fp-manager-job"><t t-esc="(props.activeProfileManager and props.activeProfileManager.job_title) || ''"/></p>
                                    </div>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="m9 18 6-6-6-6"></path></svg>
                                </div>
                            </t>
                            <t t-else="">
                                <p class="sdir-fp-no-manager">No manager assigned</p>
                            </t>
                        </div>
                    </div>
                </div>

                <div class="sdir-fp-main">
                    <div class="sdir-fp-tabs-bar">
                        <div class="sdir-fp-tabs-container">
                            <button class="sdir-fp-tab active"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>Overview</button>
                            <button class="sdir-fp-tab"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>Activity</button>
                            <button class="sdir-fp-tab"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>Org Chart</button>
                            <button class="sdir-fp-tab"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>Time Off</button>
                        </div>
                        <div style="position: relative; flex-shrink: 0;">
                            <button class="sdir-fp-visibility-btn"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9"></path><path d="M14 17H5"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg> Visibility</button>
                        </div>
                    </div>

                    <div class="sdir-fp-content">
                        <div class="sdir-fp-content-inner">
                            <div class="sdir-fp-cards">
                                
                                <div class="sdir-fp-card">
                                    <div class="sdir-fp-card-header">
                                        <div class="sdir-fp-card-title-group">
                                            <div class="sdir-fp-card-icon pink"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
                                            <h3 class="sdir-fp-card-title">About <t t-esc="props.activeProfile.name.split(' ')[0]"/></h3>
                                        </div>
                                    </div>
                                    <p class="sdir-fp-text">
                                        <t t-esc="props.activeProfile.name.split(' ')[0]"/> is a <t t-esc="props.activeProfile.job_title"/> within <t t-esc="props.activeProfile.department"/>, bringing <t t-esc="props.activeProfile.tenure"/> of dedicated service to the organisation. Reporting to <t t-esc="props.activeProfile.manager_name"/>, they are known for a collaborative approach, strong stakeholder alignment, and driving results across the <t t-esc="props.activeProfile.work_location"/>.
                                    </p>
                                </div>

                                <div class="sdir-fp-card">
                                    <div class="sdir-fp-card-header">
                                        <div class="sdir-fp-card-title-group">
                                            <div class="sdir-fp-card-icon purple"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path><rect width="20" height="14" x="2" y="6" rx="2"></rect></svg></div>
                                            <h3 class="sdir-fp-card-title">Employment Overview</h3>
                                        </div>
                                        <span class="sdir-fp-card-badge"><svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg> EMS-managed</span>
                                    </div>
                                    <div class="sdir-fp-grid">
                                        <div class="sdir-fp-grid-item">
                                            <div class="sdir-fp-grid-label-group">
                                                <div class="sdir-fp-grid-icon pink"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#E91E8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg></div>
                                                <span class="sdir-fp-grid-label">Department</span>
                                            </div>
                                            <p class="sdir-fp-grid-val"><t t-esc="props.activeProfile.department"/></p>
                                        </div>
                                        <div class="sdir-fp-grid-item">
                                            <div class="sdir-fp-grid-label-group">
                                                <div class="sdir-fp-grid-icon purple"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"></path><circle cx="12" cy="8" r="6"></circle></svg></div>
                                                <span class="sdir-fp-grid-label">Grade &amp; Level</span>
                                            </div>
                                            <p class="sdir-fp-grid-val"><t t-esc="props.activeProfile.grade"/></p>
                                        </div>
                                        <div class="sdir-fp-grid-item">
                                            <div class="sdir-fp-grid-label-group">
                                                <div class="sdir-fp-grid-icon blue"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path><rect width="20" height="14" x="2" y="6" rx="2"></rect></svg></div>
                                                <span class="sdir-fp-grid-label">Employment Type</span>
                                            </div>
                                            <p class="sdir-fp-grid-val"><t t-esc="props.activeProfile.employment_type"/></p>
                                        </div>
                                        <div class="sdir-fp-grid-item" style="border-bottom: none;">
                                            <div class="sdir-fp-grid-label-group">
                                                <div class="sdir-fp-grid-icon green"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg></div>
                                                <span class="sdir-fp-grid-label">Start Date</span>
                                            </div>
                                            <p class="sdir-fp-grid-val"><t t-esc="props.activeProfile.start_date"/></p>
                                        </div>
                                        <div class="sdir-fp-grid-item" style="border-bottom: none;">
                                            <div class="sdir-fp-grid-label-group">
                                                <div class="sdir-fp-grid-icon amber"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
                                                <span class="sdir-fp-grid-label">Tenure</span>
                                            </div>
                                            <p class="sdir-fp-grid-val"><t t-esc="props.activeProfile.tenure"/></p>
                                        </div>
                                        <div class="sdir-fp-grid-item" style="border-bottom: none;">
                                            <div class="sdir-fp-grid-label-group">
                                                <div class="sdir-fp-grid-icon teal"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" x2="16" y1="21" y2="21"></line><line x1="12" x2="12" y1="17" y2="21"></line></svg></div>
                                                <span class="sdir-fp-grid-label">Work Mode</span>
                                            </div>
                                            <p class="sdir-fp-grid-val"><t t-esc="props.activeProfile.work_mode"/></p>
                                        </div>
                                    </div>
                                </div>

                                <div class="sdir-fp-card">
                                    <div class="sdir-fp-card-header">
                                        <div class="sdir-fp-card-title-group">
                                            <div class="sdir-fp-card-icon pink"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg></div>
                                            <h3 class="sdir-fp-card-title">Reporting Structure</h3>
                                        </div>
                                    </div>
                                    <t t-if="props.activeProfile.manager_name">
                                        <div class="sdir-fp-reporting">
                                            <div class="sdir-fp-reporting-manager" t-on-click="() => props.openFullProfileById(props.activeProfileManager.id)" style="cursor: pointer;">
                                                <div class="sdir-fp-reporting-manager-avatar" t-att-style="'background-color:' + this.avatarColor(props.activeProfile.manager_name)">
                                                    <img t-if="props.activeProfileManager and props.activeProfileManager.has_image" t-attf-src="/web/image?model=hr.employee&amp;id={{props.activeProfileManager.id}}&amp;field=avatar_128" alt="Manager Avatar"/>
                                                    <span t-else=""><t t-esc="this.initials(props.activeProfile.manager_name)"/></span>
                                                </div>
                                                <div>
                                                    <p class="sdir-fp-reporting-name"><t t-esc="props.activeProfile.manager_name"/></p>
                                                    <p class="sdir-fp-reporting-job"><t t-esc="(props.activeProfileManager and props.activeProfileManager.job_title) || ''"/></p>
                                                    <span class="sdir-fp-reporting-badge">Manager</span>
                                                </div>
                                            </div>
                                            <div class="sdir-fp-reporting-arrow">
                                                <div class="sdir-fp-reporting-dot"></div><div class="sdir-fp-reporting-dot"></div><div class="sdir-fp-reporting-dot"></div><div class="sdir-fp-reporting-dot"></div><div class="sdir-fp-reporting-dot"></div>
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
                                            </div>
                                            <div class="sdir-fp-reporting-desc">
                                                <div class="sdir-fp-reporting-desc-inner">
                                                    <div class="sdir-fp-reporting-icon"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E91E8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
                                                    <p class="sdir-fp-text">
                                                        <t t-esc="props.activeProfile.name.split(' ')[0]"/> reports to <strong style="color: rgb(17, 24, 39);"><t t-esc="props.activeProfile.manager_name"/></strong> and is part of the <strong style="color: rgb(17, 24, 39);"><t t-esc="props.activeProfile.department"/></strong> department. They lead a team of <t t-esc="props.activeProfile.direct_reports"/> direct reports.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="sdir-fp-reporting-empty">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D1D5DB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sdir-fp-reporting-empty-icon"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                            <p class="sdir-fp-reporting-empty-title">No reporting manager assigned</p>
                                            <p class="sdir-fp-reporting-empty-subtitle"><t t-esc="props.activeProfile.name.split(' ')[0]"/> may be at the top of the reporting chain</p>
                                        </div>
                                    </t>
                                </div>



                                <div class="sdir-fp-card">
                                    <div class="sdir-fp-card-header">
                                        <div class="sdir-fp-card-title-group">
                                            <div class="sdir-fp-card-icon purple"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg></div>
                                            <h3 class="sdir-fp-card-title">Skills &amp; Expertise</h3>
                                        </div>
                                    </div>
                                    <t t-if="props.activeProfile.skills and props.activeProfile.skills.length > 0">
                                        <div class="sdir-fp-skills">
                                            <t t-if="typeof props.activeProfile.skills === 'string'">
                                                <t t-foreach="props.activeProfile.skills.split(',')" t-as="skill" t-key="skill">
                                                    <span class="sdir-fp-skill-badge"><t t-esc="skill.trim()"/></span>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <t t-foreach="props.activeProfile.skills" t-as="skill" t-key="skill">
                                                    <span class="sdir-fp-skill-badge"><t t-esc="skill"/></span>
                                                </t>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="sdir-fp-reporting-empty">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D1D5DB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sdir-fp-reporting-empty-icon"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg>
                                            <p class="sdir-fp-reporting-empty-title">No skills added yet</p>
                                            <p class="sdir-fp-reporting-empty-subtitle"><t t-esc="props.activeProfile.name.split(' ')[0]"/> hasn't listed any skills or expertise</p>
                                        </div>
                                    </t>
                                </div>


                                <!-- Languages Card -->
                                <div class="sdir-fp-card">
                                    <div class="sdir-fp-card-header">
