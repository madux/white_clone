<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_staff_directory.OrgAnalysis">
        <div class="sdir-oa-container" id="__FPSC_ID_1_1787311835854">
            <div class="sdir-oa-header">
                <button class="sdir-oa-btn-back" t-on-click="props.closeAnalysis">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                    Back to Organizational Structure
                </button>
                <div class="sdir-oa-title-wrap">
                    <h2 class="sdir-oa-title">Organization Analysis</h2>
                    <p class="sdir-oa-subtitle">Analyze and compare your organizational data across multiple dimensions</p>
                </div>
                <div style="position: relative; flex-shrink: 0;">
                    <button class="sdir-oa-btn-date">
                        Jan 1 – Dec 31, 2026
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"></path></svg>
                    </button>
                </div>
                <button class="sdir-oa-btn-export">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
                    Export
                </button>
            </div>
            
            <div class="sdir-oa-content">
                <!-- KPI Grid -->
                <div class="sdir-oa-kpi-grid">
                    <div class="sdir-oa-kpi-card">
                        <div class="sdir-oa-kpi-title">Total Headcount</div>
                        <div class="sdir-oa-kpi-val-wrap">
                            <div class="sdir-oa-kpi-icon-wrap sdir-oa-kpi-icon-blue">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </div>
                            <span class="sdir-oa-kpi-value"><t t-esc="state.kpi.headcount"/></span>
                        </div>
                        <div class="sdir-oa-kpi-subtext">— No historical comparison</div>
                    </div>
                    
                    <div class="sdir-oa-kpi-card">
                        <div class="sdir-oa-kpi-title">Total Departments</div>
                        <div class="sdir-oa-kpi-val-wrap">
                            <div class="sdir-oa-kpi-icon-wrap sdir-oa-kpi-icon-green">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2 lucide-building-2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg>
                            </div>
                            <span class="sdir-oa-kpi-value"><t t-esc="state.kpi.departments"/></span>
                        </div>
                        <div class="sdir-oa-kpi-subtext">— No historical comparison</div>
                    </div>
                    
                    <div class="sdir-oa-kpi-card">
                        <div class="sdir-oa-kpi-title">Total Teams</div>
                        <div class="sdir-oa-kpi-val-wrap">
                            <div class="sdir-oa-kpi-icon-wrap sdir-oa-kpi-icon-orange">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-git-branch"><line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>
                            </div>
                            <span class="sdir-oa-kpi-value"><t t-esc="state.kpi.teams"/></span>
                        </div>
                        <div class="sdir-oa-kpi-subtext">— No historical comparison</div>
                    </div>
                    
                    <div class="sdir-oa-kpi-card">
                        <div class="sdir-oa-kpi-title">Avg. Span of Control</div>
                        <div class="sdir-oa-kpi-val-wrap">
                            <div class="sdir-oa-kpi-icon-wrap sdir-oa-kpi-icon-purple">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path><rect width="20" height="14" x="2" y="6" rx="2"></rect></svg>
                            </div>
                            <span class="sdir-oa-kpi-value"><t t-esc="state.kpi.spanOfControl"/></span>
                        </div>
                        <div class="sdir-oa-kpi-subtext">— No historical comparison</div>
                    </div>
                </div>
                
                <!-- Chart Grid Top -->
                <div class="sdir-oa-chart-grid-top">
                    <!-- Headcount by Dept -->
                    <div class="sdir-oa-chart-card sdir-oa-chart-card-lg">
                        <div class="sdir-oa-chart-header">
                            <div class="sdir-oa-chart-title">Headcount by Department</div>
                            <div class="sdir-oa-chart-subtitle">Active employees per department</div>
                        </div>
                        <div class="sdir-oa-chart-body">
                            <div style="position: relative; width: 100%; height: 250px;">
                                <canvas t-ref="deptChart"></canvas>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Grade Distribution -->
                    <div class="sdir-oa-chart-card sdir-oa-chart-card-lg">
                        <div class="sdir-oa-chart-header">
                            <div class="sdir-oa-chart-title">Grade Distribution</div>
                            <div class="sdir-oa-chart-subtitle">Employees by grade level</div>
                        </div>
                        <div class="sdir-oa-chart-body">
                            <div style="display: flex; gap: 20px; align-items: center; height: 100%;">
                                <div style="position: relative; width: 150px; height: 150px; flex-shrink: 0;">
                                    <canvas t-ref="gradeChart"></canvas>
                                    <div style="position: absolute; inset: 0px; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none;">
                                        <span style="font-size: 22px; font-weight: 800; color: rgb(17, 24, 39); line-height: 1;"><t t-esc="state.kpi.headcount"/></span>
                                        <span style="font-size: 10px; color: rgb(156, 163, 175); margin-top: 2px;">total</span>
                                    </div>
                                </div>
                                <div style="flex: 1 1 0%; min-width: 0px;">
                                    <t t-foreach="state.gradeData" t-as="item" t-key="item.name">
                                        <div style="display: flex; align-items: center; gap: 7px; margin-bottom: 7px;">
                                            <div t-attf-style="width: 8px; height: 8px; border-radius: 50%; background-color: {{ item.color }}; flex-shrink: 0;"></div>
                                            <span style="flex: 1 1 0%; font-size: 11px; color: rgb(55, 65, 81); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><t t-esc="item.name"/></span>
                                            <span style="font-size: 11px; font-weight: 700; color: rgb(17, 24, 39); flex-shrink: 0;"><t t-esc="item.count"/></span>
                                            <span style="font-size: 10px; color: rgb(156, 163, 175); width: 36px; text-align: right; flex-shrink: 0;"><t t-esc="item.pct"/>%</span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Location Distribution (SVG Map) -->
                    <div class="sdir-oa-chart-card sdir-oa-chart-card-lg">
                        <div class="sdir-oa-chart-header">
                            <div class="sdir-oa-chart-title">Headcount by Location</div>
                            <div class="sdir-oa-chart-subtitle">Employee distribution across offices</div>
                        </div>
                        <div class="sdir-oa-chart-body">
                            <svg viewBox="0 0 400 200" style="width: 100%; height: auto; display: block;">
                                <rect width="400" height="200" fill="#EEF3F8" rx="6"></rect>
                                <path d="M 107,8 L 140,4 L 158,10 L 152,24 L 128,28 L 104,22 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 22,18 L 148,18 L 152,34 L 142,47 L 132,54 L 120,68 L 106,87 L 93,90 L 75,83 L 55,77 L 43,62 L 22,40 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 93,90 L 108,92 L 104,104 L 94,102 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 100,104 L 163,98 L 166,118 L 150,133 L 125,148 L 109,152 L 102,140 L 98,118 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 148,26 L 160,24 L 165,30 L 156,35 L 144,32 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 162,22 L 196,12 L 220,10 L 244,20 L 246,36 L 238,50 L 216,54 L 198,58 L 180,52 L 162,40 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 176,64 L 212,56 L 248,58 L 264,66 L 260,90 L 248,104 L 222,118 L 196,118 L 172,94 L 170,72 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 238,50 L 270,46 L 282,58 L 278,80 L 264,84 L 246,76 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 244,20 L 262,14 L 308,10 L 372,12 L 400,18 L 395,36 L 372,48 L 358,62 L 330,72 L 304,80 L 286,84 L 278,80 L 268,64 L 248,58 L 246,36 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 278,80 L 298,75 L 310,88 L 302,106 L 284,108 L 270,94 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 304,80 L 324,77 L 332,88 L 320,96 L 300,90 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 356,58 L 364,50 L 370,56 L 367,65 L 358,66 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 325,130 L 374,122 L 386,136 L 383,158 L 360,168 L 328,165 L 316,150 L 318,136 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path><path d="M 382,158 L 390,152 L 395,160 L 390,166 Z" fill="#D2DCE8" stroke="#C4CDD9" stroke-width="0.5"></path>
                                <t t-foreach="state.locationData" t-as="loc" t-key="loc.name">
                                    <t t-if="!loc.isOther">
                                        <g>
                                            <circle t-att-cx="loc.cx" t-att-cy="loc.cy" r="16.3" t-att-fill="loc.color" opacity="0.12"></circle>
                                            <circle t-att-cx="loc.cx" t-att-cy="loc.cy" r="12.3" t-att-fill="loc.color" opacity="0.85"></circle>
                                            <circle t-att-cx="loc.cx" t-att-cy="loc.cy" r="2.5" fill="#fff"></circle>
                                        </g>
                                    </t>
                                </t>
                            </svg>
                            <div style="margin-top: 10px;">
                                <t t-foreach="state.locationData" t-as="loc" t-key="loc.name">
                                    <div style="display: flex; align-items: center; gap: 7px; margin-bottom: 5px;">
                                        <div t-attf-style="width: 8px; height: 8px; border-radius: 50%; background-color: {{ loc.color }}; flex-shrink: 0;"></div>
                                        <span t-attf-style="flex: 1 1 0%; font-size: 11px; {{ loc.isOther ? 'color: rgb(156, 163, 175);' : 'color: rgb(55, 65, 81);' }} overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><t t-esc="loc.name"/></span>
                                        <span t-attf-style="font-size: 11px; font-weight: 700; {{ loc.isOther ? 'color: rgb(156, 163, 175);' : 'color: rgb(17, 24, 39);' }} flex-shrink: 0;"><t t-esc="loc.count"/></span>
                                        <t t-if="!loc.isOther">
                                            <span style="font-size: 10px; color: rgb(156, 163, 175); width: 32px; text-align: right; flex-shrink: 0;"><t t-esc="loc.pct"/>%</span>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Chart Grid Bottom -->
                <div class="sdir-oa-chart-grid-bottom">
                    <!-- Employment Type -->
                    <div class="sdir-oa-chart-card sdir-oa-chart-card-sm">
                        <div class="sdir-oa-chart-header">
                            <div class="sdir-oa-chart-title">Employment Type Mix</div>
                            <div class="sdir-oa-chart-subtitle">Breakdown by contract type</div>
                        </div>
                        <div class="sdir-oa-chart-body">
                            <div style="display: flex; gap: 20px; align-items: center; height: 100%;">
                                <div style="position: relative; width: 150px; height: 150px; flex-shrink: 0;">
                                    <canvas t-ref="typeChart"></canvas>
                                    <div style="position: absolute; inset: 0px; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none;">
                                        <span style="font-size: 22px; font-weight: 800; color: rgb(17, 24, 39); line-height: 1;"><t t-esc="state.kpi.headcount"/></span>
                                        <span style="font-size: 10px; color: rgb(156, 163, 175); margin-top: 2px;">total</span>
                                    </div>
                                </div>
                                <div style="flex: 1 1 0%; min-width: 0px;">
                                    <t t-foreach="state.typeData" t-as="item" t-key="item.name">
                                        <div style="display: flex; align-items: center; gap: 7px; margin-bottom: 7px;">
                                            <div t-attf-style="width: 8px; height: 8px; border-radius: 50%; background-color: {{ item.color }}; flex-shrink: 0;"></div>
                                            <span style="flex: 1 1 0%; font-size: 11px; color: rgb(55, 65, 81); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><t t-esc="item.name"/></span>
                                            <span style="font-size: 11px; font-weight: 700; color: rgb(17, 24, 39); flex-shrink: 0;"><t t-esc="item.count"/></span>
                                            <span style="font-size: 10px; color: rgb(156, 163, 175); width: 36px; text-align: right; flex-shrink: 0;"><t t-esc="item.pct"/>%</span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Work Mode -->
                    <div class="sdir-oa-chart-card sdir-oa-chart-card-sm">
                        <div class="sdir-oa-chart-header">
                            <div class="sdir-oa-chart-title">Work Mode Distribution</div>
                            <div class="sdir-oa-chart-subtitle">Office · Hybrid · Remote split</div>
                        </div>
                        <div class="sdir-oa-chart-body">
                            <div style="display: flex; gap: 20px; align-items: center; height: 100%;">
                                <div style="position: relative; width: 150px; height: 150px; flex-shrink: 0;">
                                    <canvas t-ref="modeChart"></canvas>
                                    <div style="position: absolute; inset: 0px; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none;">
                                        <span style="font-size: 22px; font-weight: 800; color: rgb(17, 24, 39); line-height: 1;"><t t-esc="state.kpi.headcount"/></span>
                                        <span style="font-size: 10px; color: rgb(156, 163, 175); margin-top: 2px;">total</span>
                                    </div>
                                </div>
                                <div style="flex: 1 1 0%; min-width: 0px;">
                                    <t t-foreach="state.modeData" t-as="item" t-key="item.name">
                                        <div style="display: flex; align-items: center; gap: 7px; margin-bottom: 7px;">
                                            <div t-attf-style="width: 8px; height: 8px; border-radius: 50%; background-color: {{ item.color }}; flex-shrink: 0;"></div>
                                            <span style="flex: 1 1 0%; font-size: 11px; color: rgb(55, 65, 81); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><t t-esc="item.name"/></span>
                                            <span style="font-size: 11px; font-weight: 700; color: rgb(17, 24, 39); flex-shrink: 0;"><t t-esc="item.count"/></span>
                                            <span style="font-size: 10px; color: rgb(156, 163, 175); width: 36px; text-align: right; flex-shrink: 0;"><t t-esc="item.pct"/>%</span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Span of Control -->
                    <div class="sdir-oa-chart-card sdir-oa-chart-card-sm">
                        <div class="sdir-oa-chart-header">
                            <div class="sdir-oa-chart-title">Span of Control Distribution</div>
                            <div class="sdir-oa-chart-subtitle">Number of direct reports per manager</div>
                        </div>
                        <div class="sdir-oa-chart-body">
                            <div style="position: relative; width: 100%; height: 180px;">
                                <canvas t-ref="spanChart"></canvas>
                            </div>
                            <div style="margin-top: 8px; display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
                                <span style="font-size: 11px; color: rgb(156, 163, 175);"><t t-esc="state.kpi.teams"/> total managers</span>
                                <span style="font-size: 11px; color: rgb(156, 163, 175);">avg. span: <strong style="color: rgb(55, 65, 81);"><t t-esc="state.kpi.spanOfControl"/></strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
