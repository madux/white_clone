<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Org Chart View -->
    <t t-name="hr_staff_directory.OrgChart">
        <div class="org-chart-chart-wrapper">
            <!-- Tertiary Action Bar -->
            <div class="org-chart-action-bar">
                <!-- Top-Left controls -->
                <div class="org-chart-floating-top-left">
                    <div t-att-class="'org-chart-search ' + (state.orgSearchQuery ? 'active' : '')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        <input type="text" placeholder="Search org chart..." t-att-value="state.orgSearchQuery" t-on-input="onOrgSearchInput"/>
                        <button t-if="state.orgSearchQuery" class="org-chart-search-clear" t-on-click="clearOrgSearch">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>
                </div>

                <!-- Top-Right controls -->
                <div class="org-chart-floating-top-right">
                    <button class="sdir-org-btn-icon" t-on-click="zoomOrgIn" title="Zoom In">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="11" y1="8" x2="11" y2="14"/></svg>
                    </button>
                    <span class="org-chart-zoom-pct"><t t-esc="Math.round(state.orgZoom * 100)"/>%</span>
                    <button class="sdir-org-btn-icon" t-on-click="zoomOrgOut" title="Zoom Out">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                    </button>
                    <button class="sdir-org-btn-icon" title="Fullscreen">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
                    </button>
                    <button class="sdir-org-btn-outline org-chart-export">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Export
                    </button>
                </div>
            </div>

            <!-- Canvas Wrapper -->
            <div class="org-chart-canvas-wrapper">

                <!-- Pan controls (Top-Left Floating in Canvas) -->
                <div class="org-chart-pan-controls">
                    <button class="org-chart-pan-btn" t-on-click="() => this.panOrgDirection('up')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    </button>
                    <div class="org-chart-pan-row">
                        <button class="org-chart-pan-btn" t-on-click="() => this.panOrgDirection('left')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        </button>
                        <button t-att-class="'org-chart-pan-btn org-chart-pan-center ' + (state.orgPanX === 0 &amp;&amp; state.orgPanY === 0 ? 'active' : '')" t-on-click="resetOrgZoomPan" title="Center Canvas">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                        <button class="org-chart-pan-btn" t-on-click="() => this.panOrgDirection('right')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>
                    </div>
                    <button class="org-chart-pan-btn" t-on-click="() => this.panOrgDirection('down')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </button>
                </div>

                <!-- Bottom-Left Status -->
                <div class="org-chart-status-pill">
                    Showing <t t-esc="props.people.length"/> of <t t-esc="props.people.length"/> employees
                </div>

                <!-- Bottom-Right Floating -->
                <button t-att-class="'org-chart-changes-btn ' + (state.isOrgChangesPanelOpen ? 'active' : '')" t-on-click="toggleOrgChangesPanel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-git-branch"><line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>
                    Org Changes
                </button>

                <!-- The interactive chart canvas -->
                <div class="org-chart-viewport"
                     t-on-wheel="onOrgCanvasWheel"
                     t-on-mousedown="onOrgCanvasMouseDown"
                     t-on-mousemove="onOrgCanvasMouseMove"
                     t-on-mouseup="onOrgCanvasMouseUp"
                     t-on-mouseleave="onOrgCanvasMouseUp">
                    
                    <div class="org-chart-canvas"
                         t-ref="orgCanvas"
                         t-att-style="'transform: translateX(-50%) translate(' + this.orgPanX + 'px, ' + this.orgPanY + 'px) scale(' + state.orgZoom + ');'">
                        
                        <ul class="org-chart-tree">
                            <t t-foreach="this.orgRootNodes" t-as="root" t-key="root.id">
                                <t t-call="hr_staff_directory.OrgNode">
                                    <t t-set="person" t-value="root"/>
                                </t>
                            </t>
                        </ul>
                    </div>

                    <!-- Floating Popup (Moved to viewport so it isn't affected by canvas pan/zoom and its position is stable) -->
                    <div t-if="state.orgActiveNodeId" 
                         class="org-chart-popup"
                         t-ref="orgPopup"
                         t-att-style="'transform: translate(' + this.orgPopupOffsetX + 'px, ' + this.orgPopupOffsetY + 'px); left: 0; top: 0; position: absolute; z-index: 100;'">
                        <t t-set="popupPerson" t-value="props.people.find(p => p.id === state.orgActiveNodeId)"/>
                        <t t-set="popupManager" t-value="props.people.find(p => p.id === popupPerson.manager_id)"/>
                        
                        <!-- Drag Handle Header -->
                        <div class="org-chart-popup-header" t-on-mousedown="onPopupDragStart">
                            <div class="org-chart-popup-drag">
                                <div class="org-chart-popup-drag-row">
                                    <div class="org-chart-popup-drag-dot"></div><div class="org-chart-popup-drag-dot"></div><div class="org-chart-popup-drag-dot"></div>
                                </div>
                                <div class="org-chart-popup-drag-row">
                                    <div class="org-chart-popup-drag-dot"></div><div class="org-chart-popup-drag-dot"></div><div class="org-chart-popup-drag-dot"></div>
                                </div>
                                <div class="org-chart-popup-drag-row">
                                    <div class="org-chart-popup-drag-dot"></div><div class="org-chart-popup-drag-dot"></div><div class="org-chart-popup-drag-dot"></div>
                                </div>
                            </div>
                            <button class="org-chart-popup-close" t-on-click="closeOrgPopup">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                            </button>
                        </div>

                        <!-- Body -->
                        <div class="org-chart-popup-body">
                            <div class="org-chart-popup-user">
                                <div class="org-chart-avatar org-chart-popup-avatar">
                                    <t t-if="popupPerson.has_image">
                                        <img t-attf-src="/web/image?model=hr.employee&amp;field=avatar_128&amp;id={{popupPerson.id}}" alt="Profile"/>
                                    </t>
                                    <t t-else="">
                                        <div class="org-chart-avatar-initials"><t t-esc="popupPerson.name.charAt(0)"/></div>
                                    </t>
                                </div>
                                <div>
                                    <div class="org-chart-popup-name"><t t-esc="popupPerson.name"/></div>
                                    <div class="org-chart-popup-role"><t t-esc="popupPerson.job_title"/></div>
                                    <span class="org-chart-popup-dept"><t t-esc="popupPerson.department || 'N/A'"/></span>
                                </div>
                            </div>
                            
                            <div class="org-chart-popup-contact">
                                <div class="org-chart-popup-contact-row">
                                    <div class="org-chart-icon-square bg-green-100 text-green-600">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                    </div>
                                    <span><t t-esc="popupPerson.phone || 'N/A'"/></span>
                                </div>
                                <div class="org-chart-popup-contact-row">
                                    <div class="org-chart-icon-square bg-blue-100 text-blue-600">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                                    </div>
                                    <span><t t-esc="popupPerson.email || 'N/A'"/></span>
                                </div>
                                <div class="org-chart-popup-contact-row">
                                    <div class="org-chart-icon-square bg-purple-100 text-purple-600">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    </div>
                                    <span><t t-esc="popupPerson.location || 'N/A'"/></span>
                                </div>
                            </div>
                            
                            <div class="org-chart-popup-divider"></div>
                            
                            <div class="org-chart-popup-stats">
                                <div class="org-chart-stat-row">
                                    <span class="org-chart-stat-label">Grade / Level</span>
                                    <span class="org-chart-stat-val"><t t-esc="popupPerson.grade || 'N/A'"/></span>
                                </div>
                                <div class="org-chart-stat-row">
                                    <span class="org-chart-stat-label">Manager</span>
                                    <span class="org-chart-stat-val org-chart-stat-magenta org-chart-clickable" 
                                          t-on-click="(ev) => popupManager ? this.openOrgNodePopup(popupManager.id, ev, true) : null">
                                        <t t-if="popupManager"><t t-esc="popupManager.name"/> <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></t>
                                        <t t-else="">None</t>
                                    </span>
                                </div>
                                <div class="org-chart-stat-row">
                                    <span class="org-chart-stat-label">Direct Reports</span>
                                    <span class="org-chart-stat-val">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                        <t t-esc="this.getOrgDirectReportsCount(popupPerson.id)"/>
                                    </span>
                                </div>
                                <div class="org-chart-stat-row">
                                    <span class="org-chart-stat-label">Work Mode</span>
                                    <span class="org-chart-stat-val"><t t-esc="popupPerson.work_mode"/></span>
                                </div>
                            </div>

                            <div class="org-chart-popup-divider"></div>

                            <div class="org-chart-popup-socials">
                                <button class="org-chart-social-btn bg-blue-100 text-blue-600"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg></button>
                                <button class="org-chart-social-btn bg-gray-100 text-gray-500"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></button>
                                <button class="org-chart-social-btn bg-pink-100 text-pink-500"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></button>
                            </div>
                            
                            <div class="org-chart-popup-action-wrap">
                                <button class="org-chart-popup-full-btn" t-on-click="() => props.openProfile(popupPerson.id)">
                                    View Full Profile <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div> <!-- Close org-chart-canvas-wrapper -->
            
            <!-- Right Side Panel (Org Changes) -->
            <div t-att-class="'org-chart-changes-panel ' + (state.isOrgChangesPanelOpen ? 'open' : '')">
                <div class="org-chart-changes-panel-header">
                    <span class="org-chart-changes-panel-title">Recent Org Changes</span>
                    <button class="org-chart-changes-panel-close" t-on-click="toggleOrgChangesPanel">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                    </button>
                </div>
                <div class="org-chart-changes-panel-body">
                    <div class="org-chart-changes-empty">
                        No org changes yet. Changes appear here when WL transitions are approved.
                    </div>
                </div>
                <div class="org-chart-changes-panel-footer">
                    View Full Integration Log →
                </div>
            </div>
            
        </div>
    </t>

    <!-- Recursive Template for Org Nodes -->
    <t t-name="hr_staff_directory.OrgNode">
        <li>
            <div t-att-class="'org-chart-node-card ' + 
                               (state.orgActiveNodeId === person.id ? 'org-chart-node-active ' : '') + 
                               (this.orgSearchMatches &amp;&amp; !this.orgSearchMatches.has(person.id) ? 'org-chart-dimmed' : '')"
                 t-att-data-person-id="person.id"
                 t-on-click="(ev) => this.openOrgNodePopup(person.id, ev)">
                
                <div class="org-chart-node-header">
                    <span class="org-chart-role-tag"><t t-esc="this.getRoleCode(person.job_title)"/></span>
                    <t t-if="state.orgActiveNodeId === person.id">
                        <button class="org-chart-node-close-inline" t-on-click.stop="() => this.closeOrgPopup($event)">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
                        </button>
                    </t>
                    <t t-else="">
                        <div class="org-chart-node-more">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/><circle cx="5" cy="12" r="2"/></svg>
                        </div>
                    </t>
                </div>
                
                <div class="org-chart-node-body">
                    <div class="org-chart-avatar-wrapper">
                        <div class="org-chart-avatar">
                            <t t-if="person.has_image">
                                <img t-attf-src="/web/image?model=hr.employee&amp;field=avatar_128&amp;id={{person.id}}" alt="Profile" />
                            </t>
                            <t t-else="">
                                <div class="org-chart-avatar-initials"><t t-esc="person.name.charAt(0)"/></div>
                            </t>
                        </div>
                    </div>
                    <div class="org-chart-node-info">
                        <div class="org-chart-node-role-title"><t t-esc="person.job_title || 'Employee'"/></div>
                        <div class="org-chart-node-name"><t t-esc="person.name"/></div>
                    </div>
                </div>
                
                <div class="org-chart-node-footer">
                    <div class="org-chart-node-reports">
                        <svg width="12" height="12" viewBox="0 0 24 24">
                            <circle cx="12" cy="9" r="4.5" fill="currentColor"/>
                            <path d="M 5 21 q 7 -10 14 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <span><t t-esc="this.getOrgDirectReportsCount(person.id)"/></span>
                    </div>
                    <div class="org-chart-dept-tag">
                        <t t-esc="person.department.length > 15 ? person.department.substring(0, 13) + '...' : person.department"/>
                    </div>
                </div>
                
                <t t-set="children" t-value="this.getOrgChildren(person.id)"/>
                <t t-if="children.length > 0">
                    <div class="org-chart-toggle-wrapper">
                        <button t-att-class="'org-chart-toggle ' + (state.orgCollapsedNodes[person.id] ? 'org-chart-toggle-plus' : 'org-chart-toggle-minus')"
                                t-on-click.stop="() => this.toggleOrgNodeCollapse(person.id)">
                            <t t-if="state.orgCollapsedNodes[person.id]">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </t>
                            <t t-else="">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </t>
                        </button>
                        <div t-if="state.orgCollapsedNodes[person.id]" class="org-chart-hidden-badge">
                            <t t-esc="children.length"/> hidden
                        </div>
                    </div>
                </t>
            </div>
            
            <t t-if="children.length > 0">
                <ul t-if="!state.orgCollapsedNodes[person.id]">
                    <t t-foreach="children" t-as="child" t-key="child.id">
                        <t t-call="hr_staff_directory.OrgNode">
                            <t t-set="person" t-value="child"/>
                        </t>
                    </t>
                </ul>
            </t>
        </li>
    </t>

</templates>
