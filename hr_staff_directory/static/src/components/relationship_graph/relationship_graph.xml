<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_staff_directory.RelationshipGraph">
        <div class="r_graph-container">
            <!-- Main Layout (Toolbar + Graph) -->
            <div class="r_graph-main">
                <!-- Top Toolbar -->
                <div class="r_graph-toolbar">
                <div class="r_graph-toolbar-left">
                    <div class="r_graph-search">
                        <div class="r_graph-search-wrap">
                            <svg class="r_graph-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.3-4.3"/>
                            </svg>
                            <input type="text" class="r_graph-search-input" placeholder="Focus on person..." t-att-value="state.searchQuery" t-on-input="onSearch"/>
                            <t t-if="state.searchQuery">
                                <button t-on-click="clearSearch" class="r_graph-search-clear">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                </button>
                            </t>
                        </div>
                    </div>
                    <div class="r_graph-toggles">
                        <button t-att-class="'r_graph-toggle ' + (state.modes.reporting ? 'r_graph-toggle-active' : '')" t-on-click="() => this.toggleMode('reporting')">
                            Reporting Lines
                        </button>
                        <button t-att-class="'r_graph-toggle ' + (state.modes.peer ? 'r_graph-toggle-active' : '')" t-on-click="() => this.toggleMode('peer')">
                            Peer / Team
                        </button>
                    </div>
                </div>
                <div class="r_graph-toolbar-right">
                    <span class="r_graph-stats-text">
                        <t t-esc="props.people.length"/> people · <t t-esc="state.maxConnections"/> max connections
                    </span>
                </div>
            </div>


                <!-- SVG Canvas -->
                <div class="r_graph-canvas-wrapper">
                    <div t-if="state.loading" class="r_graph-loading">
                        <span>Loading graph...</span>
                    </div>
                    <svg t-ref="graphSvg" class="r_graph-svg"></svg>
                    
                    <!-- Legend Overlay -->
                    <div class="r_graph-legend">
                        <div class="r_graph-legend-row">
                            <div class="r_graph-legend-line r_graph-legend-line-solid"></div>
                            <span>Reporting Line</span>
                        </div>
                        <div class="r_graph-legend-row">
                            <div class="r_graph-legend-line r_graph-legend-line-dashed"></div>
                            <span>Peer / Same Team</span>
                        </div>
                        <div class="r_graph-legend-note">
                            Node size = connections - color = dept
                        </div>
                    </div>
                    
                    <!-- Detail Card (Focus Mode) -->
                    <div t-if="state.focusedNodeId" class="r_graph-detail-card">
                        <div class="r_graph-detail-header">
                            <div class="r_graph-detail-avatar">
                                <t t-esc="state.focusedNodeData.name.split(' ').length &gt; 1 ? (state.focusedNodeData.name.split(' ')[0][0] + state.focusedNodeData.name.split(' ')[1][0]).toUpperCase() : state.focusedNodeData.name.substring(0, 2).toUpperCase()"/>
                            </div>
                            <div class="r_graph-detail-title">
                                <div class="r_graph-detail-name"><t t-esc="state.focusedNodeData.name"/></div>
                                <div class="r_graph-detail-job"><t t-esc="state.focusedNodeData.job_title"/></div>
                            </div>
                            <button class="r_graph-detail-close" t-on-click="clearFocus">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            </button>
                        </div>
                        <div class="r_graph-detail-body">
                            <div class="r_graph-detail-row">
                                <span class="r_graph-detail-label">Department</span>
                                <span class="r_graph-detail-val r_graph-detail-val-teal"><t t-esc="state.focusedNodeData.dept || '—'"/></span>
                            </div>
                            <div class="r_graph-detail-row">
                                <span class="r_graph-detail-label">Connections</span>
                                <span class="r_graph-detail-val"><t t-esc="state.focusedNodeData.connections"/> direct</span>
                            </div>
                            <div class="r_graph-detail-row">
                                <span class="r_graph-detail-label">Location</span>
                                <span class="r_graph-detail-val"><t t-esc="state.focusedNodeData.location"/></span>
                            </div>
                        </div>
                        <div class="r_graph-detail-tags">
                            <span class="r_graph-detail-tag" t-if="state.focusedNodeData.hasReporting">Reporting</span>
                            <span class="r_graph-detail-tag" t-if="state.focusedNodeData.hasPeer">Peer / Team</span>
                        </div>
                        <div class="r_graph-detail-footer">
                            <button class="r_graph-profile-btn" t-on-click="() => this.props.openProfile(state.focusedNodeData.id)">
                                View Profile <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Sidebar (Insights) -->
            <div class="r_graph-sidebar">
                    <div class="r_graph-sidebar-header">
                        GRAPH INSIGHTS
                    </div>
                    <div class="r_graph-sidebar-search">
                        <div class="r_graph-sidebar-search-wrap" t-att-class="state.sidebarSearchQuery ? 'r_graph-sidebar-search-active' : ''">
                            <svg class="r_graph-sidebar-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.3-4.3"/>
                            </svg>
                            <input type="text" class="r_graph-sidebar-search-input" placeholder="Search employees..." t-att-value="state.sidebarSearchQuery" t-on-input="onSidebarSearch"/>
                            <t t-if="state.sidebarSearchQuery">
                                <button t-on-click="clearSidebarSearch" class="r_graph-sidebar-search-clear">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                </button>
                            </t>
                        </div>
                    </div>
                    
                    <div class="r_graph-insights-list">
                        <!-- Most Connected -->
                        <div class="r_graph-insight-section">
                            <div class="r_graph-insight-header" t-on-click="() => this.toggleInsight('mostConnected')">
                                <div class="r_graph-insight-header-left">                                    
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#E91E8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-network"><rect x="16" y="16" width="6" height="6" rx="1"></rect><rect x="2" y="16" width="6" height="6" rx="1"></rect><rect x="9" y="2" width="6" height="6" rx="1"></rect><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"></path><path d="M12 12V8"></path></svg>
                                    <span>Most Connected</span>
                                </div>
                                <div class="r_graph-insight-header-right">
                                    <span class="r_graph-insight-count"><t t-esc="state.mostConnectedNodes.length"/></span>
                                    <svg t-attf-class="r_graph-chevron {{ state.insightsExpanded.mostConnected ? 'r_graph-chevron-open' : '' }}" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                                </div>
                            </div>
                            <div t-if="state.insightsExpanded.mostConnected" class="r_graph-insight-body">
                                <t t-set="filteredMostConnected" t-value="getFilteredNodes(state.mostConnectedNodes)"/>
                                <div t-if="filteredMostConnected.length === 0" class="r_graph-insight-nomatch">No match.</div>
                                <div class="r_graph-insight-item" t-foreach="filteredMostConnected" t-as="node" t-key="node.id" t-on-click="() => this.handleNodeClick(null, node)">
                                    <span class="r_graph-insight-rank"><t t-esc="node_index + 1"/></span>
                                    <div class="r_graph-insight-avatar" t-attf-style="background-color: {{ node.color }}">
                                        <t t-esc="node.name.split(' ').length > 1 ? (node.name.split(' ')[0][0] + node.name.split(' ')[1][0]).toUpperCase() : node.name.substring(0, 2).toUpperCase()"/>
                                    </div>
                                    <div class="r_graph-insight-text">
                                        <div class="r_graph-insight-name"><t t-esc="node.name"/></div>
                                        <div class="r_graph-insight-conns"><t t-esc="node.connections"/> connections</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Bridge Employees -->
                        <div class="r_graph-insight-section">
                            <div class="r_graph-insight-header" t-on-click="() => this.toggleInsight('bridge')">
                                <div class="r_graph-insight-header-left">
                                    <svg class="r_graph-icon-orange" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                                    </svg>
                                    <span>Bridge Employees</span>
                                </div>
                                <div class="r_graph-insight-header-right">
                                    <span class="r_graph-insight-count"><t t-esc="state.bridgeNodes.length"/></span>
                                    <svg t-attf-class="r_graph-chevron {{ state.insightsExpanded.bridge ? 'r_graph-chevron-open' : '' }}" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                                </div>
                            </div>
                            <div t-if="state.insightsExpanded.bridge" class="r_graph-insight-body">
                                <div class="r_graph-insight-desc">Remove them and the graph splits into disconnected clusters.</div>
                                <t t-set="filteredBridge" t-value="getFilteredNodes(state.bridgeNodes)"/>
                                <div t-if="filteredBridge.length === 0" class="r_graph-insight-nomatch">No match.</div>
                                <div class="r_graph-insight-item" t-foreach="filteredBridge" t-as="node" t-key="node.id" t-on-click="() => this.handleNodeClick(null, node)">
                                    <div class="r_graph-insight-avatar" t-attf-style="background-color: {{ node.color }}">
                                        <t t-esc="node.name.split(' ').length > 1 ? (node.name.split(' ')[0][0] + node.name.split(' ')[1][0]).toUpperCase() : node.name.substring(0, 2).toUpperCase()"/>
                                    </div>
                                    <div class="r_graph-insight-text">
                                        <div class="r_graph-insight-name"><t t-esc="node.name"/></div>
                                        <div class="r_graph-insight-conns"><t t-esc="node.connections"/> connections</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Isolated -->
                        <div class="r_graph-insight-section">
                            <div class="r_graph-insight-header" t-on-click="() => this.toggleInsight('isolated')">
                                <div class="r_graph-insight-header-left">
                                    <svg class="r_graph-icon-yellow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                                        <line x1="12" y1="9" x2="12" y2="13"></line>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                    <span>Isolated</span>
                                </div>
                                <div class="r_graph-insight-header-right">
                                    <span class="r_graph-insight-count"><t t-esc="state.isolatedNodes.length"/></span>
                                    <svg t-attf-class="r_graph-chevron {{ state.insightsExpanded.isolated ? 'r_graph-chevron-open' : '' }}" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                                </div>
                            </div>
                            <div t-if="state.insightsExpanded.isolated" class="r_graph-insight-body">
                                <div class="r_graph-insight-desc">Degree ≤ 1 — few or no connections in the current graph.</div>
                                <t t-set="filteredIsolated" t-value="getFilteredNodes(state.isolatedNodes)"/>
                                <div t-if="filteredIsolated.length === 0" class="r_graph-insight-nomatch">No match.</div>
                                <div class="r_graph-insight-item" t-foreach="filteredIsolated" t-as="node" t-key="node.id" t-on-click="() => this.handleNodeClick(null, node)">
                                    <div class="r_graph-insight-avatar r_graph-insight-avatar-ringed" t-attf-style="background-color: {{ node.color }}; border-color: {{ node.ringColor }};">
                                        <t t-esc="node.name.split(' ').length > 1 ? (node.name.split(' ')[0][0] + node.name.split(' ')[1][0]).toUpperCase() : node.name.substring(0, 2).toUpperCase()"/>
                                    </div>
                                    <div class="r_graph-insight-text">
                                        <div class="r_graph-insight-name"><t t-esc="node.name"/></div>
                                        <div class="r_graph-insight-conns r_graph-insight-conns-warning"><t t-esc="node.connections"/> connection<t t-if="node.connections != 1">s</t></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
    </t>
</templates>
