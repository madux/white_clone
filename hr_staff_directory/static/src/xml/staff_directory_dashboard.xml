<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_staff_directory.StaffDirectoryDashboard">
        <div class="sdir-app" t-ref="root">

            <!-- ═══ SIDEBAR ══════════════════════════════════════════════════ -->
            <aside id="sdirSidebar" t-att-class="state.sidebarCollapsed ? 'sdir-sidebar collapsed' : 'sdir-sidebar'">

                <!-- Title Section -->
                <div class="sdir-brand">
                    <div class="sdir-brand-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users size-4 text-white"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <span class="sdir-brand-name">Staff Directory</span>
                    <button type="button" class="sdir-collapse-btn" id="sdirCollapseBtn" title="Toggle sidebar" t-on-click="toggleSidebar">
                        <svg class="sdir-chevron-icon" viewBox="0 0 20 20" fill="none">
                            <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>

                <!-- Navigation -->
                <nav class="sdir-nav">
                    <a href="#" class="sdir-nav-item active" id="navDashboard">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-dashboard size-5 transition-colors text-[#EC4899]"><rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect></svg>
                        <span class="sdir-nav-label">Dashboard</span>
                    </a>
                    <a href="#" class="sdir-nav-item" id="navGetStarted">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-play size-5 transition-colors text-gray-500 group-hover:text-gray-700"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
                        <span class="sdir-nav-label">Get Started</span>
                    </a>
                    <a href="#" class="sdir-nav-item" id="navEmployees">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users size-5 transition-colors text-gray-500 group-hover:text-gray-700"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span class="sdir-nav-label">Employees</span>
                    </a>
                    <a href="#" class="sdir-nav-item" id="navSettings">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings size-5 transition-colors text-gray-500 group-hover:text-gray-700"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        <span class="sdir-nav-label">Settings</span>
                    </a>
                </nav>

                <!-- Bottom Footer -->
                <div class="sdir-sidebar-footer">
                    <div class="sdir-sidebar-footer-name">Staff Directory</div>
                    <div class="sdir-sidebar-footer-tagline">Manage your workforce</div>
                </div>
            </aside>

            <!-- ═══ MAIN ═════════════════════════════════════════════════════ -->
            <main class="sdir-main">

                <!-- Top Bar -->
                <header class="sdir-topbar">
                    <div>
                        <h1 class="sdir-topbar-title">Staff Directory Dashboard</h1>
                        <p class="sdir-topbar-sub">Discover and connect with your organisation's workforce</p>
                    </div>
                    <div class="sdir-topbar-actions">
                        <button type="button" class="sdir-btn sdir-btn-ghost" id="btnExport">
                            <svg viewBox="0 0 16 16" fill="none">
                                <rect x="2" y="2" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
                                <path d="M5 12v2h6v-2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            Export
                        </button>
                        <button type="button" class="sdir-btn sdir-btn-ghost" id="btnFilters">
                            <svg viewBox="0 0 16 16" fill="none">
                                <path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                            </svg>
                            Filters
                        </button>
                        <a href="#" class="sdir-btn sdir-btn-primary" id="btnAddEmployee">
                            <svg viewBox="0 0 16 16" fill="none">
                                <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                            Add Employee
                        </a>
                    </div>
                </header>

                <!-- Scrollable Content -->
                <div class="sdir-content" id="sdirContent">

                    <!-- ── KPI Row ─────────────────────────────────────────── -->
                    <div class="sdir-kpi-row">

                        <div class="sdir-kpi-card">
                            <div class="sdir-kpi-icon" style="background:rgba(236,72,153,.11);color:#ec4899;">
                                <svg viewBox="0 0 22 22" fill="none">
                                    <circle cx="8" cy="6.5" r="2.5" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M2 17c0-3.314 2.686-6 6-6s6 2.686 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                                    <circle cx="15.5" cy="7.5" r="2" stroke="currentColor" stroke-width="1.4"/>
                                    <path d="M13 17c0-2.21 1.343-4 3-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <div class="sdir-kpi-body">
                                <div class="sdir-kpi-val" id="kpiTotalVal" t-esc="num(state.overview.total)"/>
                                <div class="sdir-kpi-lbl">Total Employees</div>
                                <div class="sdir-kpi-trend" id="kpiTotalTrend">
                                    <span t-att-class="state.kpiTrends.total.cls" t-out="state.kpiTrends.total.label"/>
                                </div>
                            </div>
                        </div>

                        <div class="sdir-kpi-card">
                            <div class="sdir-kpi-icon" style="background:rgba(0,196,140,.11);color:#00C48C;">
                                <svg viewBox="0 0 22 22" fill="none">
                                    <circle cx="11" cy="7" r="2.8" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M4.5 18c0-3.590 2.910-6.5 6.5-6.5s6.5 2.910 6.5 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                                    <path d="M14.5 11.5l2 2 3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <div class="sdir-kpi-body">
                                <div class="sdir-kpi-val" id="kpiActiveVal" t-esc="num(state.overview.active)"/>
                                <div class="sdir-kpi-lbl">Active Employees</div>
                                <div class="sdir-kpi-trend" id="kpiActiveTrend">
                                    <span t-att-class="state.kpiTrends.active.cls" t-out="state.kpiTrends.active.label"/>
                                </div>
                            </div>
                        </div>

                        <div class="sdir-kpi-card">
                            <div class="sdir-kpi-icon" style="background:rgba(61,90,254,.11);color:#3D5AFE;">
                                <svg viewBox="0 0 22 22" fill="none">
                                    <circle cx="11" cy="7" r="2.8" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M4.5 18c0-3.590 2.910-6.5 6.5-6.5s6.5 2.910 6.5 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                                    <path d="M19 4v6M16.5 7h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <div class="sdir-kpi-body">
                                <div class="sdir-kpi-val" id="kpiNewHiresVal" t-esc="num(state.overview.new_hires)"/>
                                <div class="sdir-kpi-lbl">New Hires</div>
                                <div class="sdir-kpi-trend" id="kpiNewHiresTrend">
                                    <span class="sdir-trend-flat">Last 30 days</span>
                                </div>
                            </div>
                        </div>

                        <div class="sdir-kpi-card">
                            <div class="sdir-kpi-icon" style="background:rgba(255,143,0,.11);color:#FF8F00;">
                                <svg viewBox="0 0 22 22" fill="none">
                                    <circle cx="11" cy="7" r="2.8" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M4.5 18c0-3.590 2.910-6.5 6.5-6.5s6.5 2.910 6.5 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                                    <path d="M11 2l.6 1.8H13.5l-1.5 1 .6 1.8L11 5.5l-1.6.8.6-1.8-1.5-1H10.4z" fill="currentColor"/>
                                </svg>
                            </div>
                            <div class="sdir-kpi-body">
                                <div class="sdir-kpi-val" id="kpiExecVal" t-esc="num(state.overview.executives)"/>
                                <div class="sdir-kpi-lbl">Executives</div>
                                <div class="sdir-kpi-trend" id="kpiExecTrend">
                                    <span class="sdir-trend-flat">Senior leadership</span>
                                </div>
                            </div>
                        </div>

                    </div><!-- /.sdir-kpi-row -->

                    <!-- ── Pending Approvals Banner ─────────────────────────── -->
                    <div class="sdir-pending" id="pendingBanner" t-if="state.overview.pending_approvals &gt; 0">
                        <div>
                            <div class="sdir-pending-title">Pending Approvals</div>
                            <div class="sdir-pending-sub" id="pendingDesc" t-esc="state.pendingDesc"/>
                        </div>
                        <div class="sdir-pending-right">
                            <span class="sdir-pending-num" id="pendingCount" t-esc="num(state.overview.pending_approvals)"/>
                            <div class="sdir-pending-clock">
                                <svg viewBox="0 0 20 20" fill="none">
                                    <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.8"/>
                                    <path d="M10 6v4l2.5 2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- ── Alert Tiles ─────────────────────────────────────── -->
                    <div class="sdir-alert-row">
                        <div class="sdir-alert-tile sdir-at-blue">
                            <div class="sdir-alert-num" id="alertBirthdays" t-esc="num(state.alerts.birthdays_this_week)"/>
                            <div class="sdir-alert-lbl">Birthdays this week</div>
                        </div>
                        <div class="sdir-alert-tile sdir-at-purple">
                            <div class="sdir-alert-num" id="alertAnniversaries" t-esc="num(state.alerts.work_anniversaries)"/>
                            <div class="sdir-alert-lbl">Work anniversaries</div>
                        </div>
                        <div class="sdir-alert-tile sdir-at-amber">
                            <div class="sdir-alert-num" id="alertExpiring" t-esc="num(state.alerts.contracts_expiring)"/>
                            <div class="sdir-alert-lbl">Contracts expiring</div>
                        </div>
                        <div class="sdir-alert-tile sdir-at-green">
                            <div class="sdir-alert-num" id="alertPending" t-esc="num(state.alerts.pending_approvals)"/>
                            <div class="sdir-alert-lbl">Pending approvals</div>
                        </div>
                    </div>

                    <!-- ── Headcount Trend + Dept Distribution ─────────────── -->
                    <div class="sdir-charts-main">

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">Headcount Growth Trend</span>
                                <span class="sdir-card-meta">Last 6 months</span>
                            </div>
                            <div class="sdir-chart-wrap" style="height:180px;">
                                <canvas t-ref="chartHeadcount"></canvas>
                            </div>
                            <div class="sdir-hc-stats">
                                <div>
                                    <div class="sdir-hc-stat-lbl">Over Hires</div>
                                    <div class="sdir-hc-stat-val pink" id="statOverHires" t-esc="num(state.headcount.over_hires)"/>
                                </div>
                                <div>
                                    <div class="sdir-hc-stat-lbl">New Hires</div>
                                    <div class="sdir-hc-stat-val green" id="statNewHires" t-esc="num(state.headcount.new_hires)"/>
                                </div>
                            </div>
                        </div>

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">Department Distribution</span>
                                <a href="#" class="sdir-card-link">View All</a>
                            </div>
                            <div class="sdir-chart-wrap" style="height:230px;">
                                <canvas t-ref="chartDept"></canvas>
                            </div>
                        </div>

                    </div><!-- /.sdir-charts-main -->

                    <!-- ── Employment Type + Gender ─────────────────────────── -->
                    <div class="sdir-duo">

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">Employment Type</span>
                                <span class="sdir-card-meta">Full workforce</span>
                            </div>
                            <div class="sdir-donut-wrap">
                                <canvas t-ref="chartEmpType" width="140" height="140"></canvas>
                                <div class="sdir-donut-legend" id="legendEmpType" t-out="etLegendHTML()"/>
                            </div>
                        </div>

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">Gender Distribution</span>
                                <span class="sdir-card-meta">Full workforce</span>
                            </div>
                            <div class="sdir-donut-wrap">
                                <canvas t-ref="chartGender" width="140" height="140"></canvas>
                                <div class="sdir-donut-legend" id="legendGender" t-out="genderLegendHTML()"/>
                            </div>
                        </div>

                    </div>

                    <!-- ── Activities · Birthdays · Anniversaries ───────────── -->
                    <div class="sdir-tri">

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">Recent Activities</span>
                                <a href="#" class="sdir-card-link">View All</a>
                            </div>
                            <div class="sdir-list" id="listActivities" t-out="activitiesHTML()"/>
                        </div>

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">Upcoming Birthdays</span>
                                <span class="sdir-count-pill" id="bdayBadge" t-esc="num(state.bdayAnniv.birthdays.length)"/>
                            </div>
                            <div class="sdir-list" id="listBirthdays" t-out="birthdaysHTML()"/>
                        </div>

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">Work Anniversaries</span>
                                <span class="sdir-count-pill" id="annivBadge" t-esc="num(state.bdayAnniv.anniversaries.length)"/>
                            </div>
                            <div class="sdir-list" id="listAnniversaries" t-out="anniversariesHTML()"/>
                        </div>

                    </div>

                    <!-- ── Compliance · Training · Work Location ────────────── -->
                    <div class="sdir-tri">

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">
                                    <span class="sdir-ind sdir-ind-green"></span>
                                    Compliance Status
                                </span>
                                <span class="sdir-card-meta">Active tracking</span>
                            </div>
                            <div id="complianceList" t-out="complianceHTML()"/>
                        </div>

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">
                                    <span class="sdir-ind sdir-ind-blue"></span>
                                    Training Progress
                                </span>
                                <span class="sdir-card-meta">Across all modules</span>
                            </div>
                            <div class="sdir-chart-wrap" style="height:210px;">
                                <canvas t-ref="chartTraining"></canvas>
                            </div>
                        </div>

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">Work Location</span>
                                <span class="sdir-card-meta">Where employees work</span>
                            </div>
                            <div class="sdir-donut-wrap">
                                <canvas t-ref="chartWorkLoc" width="130" height="130"></canvas>
                                <div class="sdir-donut-legend" id="legendWorkLoc" t-out="workLocLegendHTML()"/>
                            </div>
                        </div>

                    </div>

                    <!-- ── Probation Periods · Contract Renewals ───────────── -->
                    <div class="sdir-duo">

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">
                                    <span class="sdir-ind sdir-ind-amber"></span>
                                    Probation Periods
                                </span>
                                <span class="sdir-cnt-circle" id="probationCount" t-esc="num(state.probContracts.probation.length)"/>
                            </div>
                            <div id="probationList" t-out="probationHTML()"/>
                        </div>

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">
                                    <span class="sdir-ind sdir-ind-pink"></span>
                                    Contract Renewals
                                </span>
                                <span class="sdir-cnt-circle" id="contractCount" t-esc="num(state.probContracts.renewals.length)"/>
                            </div>
                            <div id="contractList" t-out="renewalsHTML()"/>
                            <div class="sdir-card-ft">
                                <a href="#" class="sdir-btn sdir-btn-cobalt sdir-btn-full" id="btnAllContracts">
                                    Browse All Contracts
                                </a>
                            </div>
                        </div>

                    </div>

                    <!-- ── Performance Ratings · Skills Overview ────────────── -->
                    <div class="sdir-duo">

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">
                                    <span class="sdir-ind sdir-ind-green"></span>
                                    Performance Ratings
                                </span>
                                <span class="sdir-card-meta">Last performance cycle</span>
                            </div>
                            <div class="sdir-chart-wrap" style="height:160px;">
                                <canvas t-ref="chartPerformance"></canvas>
                            </div>
                            <div class="sdir-perf-stats">
                                <div class="sdir-perf-stat">
                                    <span class="sdir-perf-num" id="perfScorecard" t-esc="perfScorecard()"/>
                                    <span class="sdir-perf-lbl">Scorecard Achieved</span>
                                </div>
                                <div class="sdir-perf-stat">
                                    <span class="sdir-perf-num blue" id="perfImprovement" t-esc="perfImprovement()"/>
                                    <span class="sdir-perf-lbl">Improvement Rate</span>
                                </div>
                            </div>
                        </div>

                        <div class="sdir-card">
                            <div class="sdir-card-hd">
                                <span class="sdir-card-title">
                                    <span class="sdir-ind sdir-ind-pink"></span>
                                    Skills Overview
                                </span>
                                <span class="sdir-card-meta">Team capabilities at a glance</span>
                            </div>
                            <div id="skillsList" t-out="skillsHTML()"/>
                            <div class="sdir-card-ft">
                                <button type="button" class="sdir-btn sdir-btn-pink-outline sdir-btn-full" id="btnSkillsMap">
                                    View Skills Map
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- ── Diversity & Inclusion Metrics ────────────────────── -->
                    <div class="sdir-card">
                        <div class="sdir-card-hd">
                            <span class="sdir-card-title">Diversity &amp; Inclusion Metrics</span>
                            <span class="sdir-card-meta">Across all individuals</span>
                        </div>
                        <div class="sdir-diversity" id="diversityRow" t-out="diversityHTML()"/>
                    </div>

                    <!-- Bottom breathing room -->
                    <div style="height:20px;"></div>

                </div><!-- /.sdir-content -->
            </main><!-- /.sdir-main -->

        </div><!-- /.sdir-app -->
    </t>

</templates>
