<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_work_location_form_inherit_geocode" model="ir.ui.view">
        <field name="name">hr.work.location.form.inherit.geocode</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_geocode" string="Get Coordinates" type="object" class="btn-secondary"/>
                </header>
            </xpath>
            <xpath expr="//group" position="inside">
                <group string="Geocoding">
                    <field name="latitude"/>
                    <field name="longitude"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
