<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Remove Powered by Odoo from standard email layout -->
        <template id="mail_notification_layout_no_branding" inherit_id="mail.mail_notification_layout">
            <xpath expr="//div[span[@id='mail_unfollow']]" position="replace">
                <div style="color: #555555; font-size:11px;">
                    <span id="mail_unfollow">
                        <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                    </span>
                </div>
            </xpath>
        </template>

        <!-- Remove Powered by Odoo from light email layout -->
        <template id="mail_notification_light_no_branding" inherit_id="mail.mail_notification_light">
            <xpath expr="//td[span[@id='mail_unfollow']]" position="replace">
                <td align="center" style="min-width: 590px; padding: 0 8px 0 8px; font-size:11px;">
                    <span id="mail_unfollow">
                        <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                    </span>
                </td>
            </xpath>
        </template>
    </data>
</odoo>
