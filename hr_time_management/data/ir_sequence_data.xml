<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_cleon_shift_swap_request" model="ir.sequence">
            <field name="name">Shift Swap Request Sequence</field>
            <field name="code">cleon.shift.swap.request</field>
            <field name="prefix">SWAP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_cleon_time_period_lock" model="ir.sequence">
            <field name="name">Administrative Period Lock Sequence</field>
            <field name="code">cleon.time.period.lock</field>
            <field name="prefix">LOCK/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
