<odoo>
    <record id="module_category_time_management" model="ir.module.category">
        <field name="name">Time Management</field>
        <field name="description">Manage employee attendance, shift schedules, overtime, and time tracking.</field>
        <field name="sequence">15</field>
    </record>
    <record id="group_time_management_user" model="res.groups">
        <field name="name">Employee / User</field>
        <field name="category_id" ref="module_category_time_management" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_time_management_line_manager" model="res.groups">
        <field name="name">Line Manager</field>
        <field name="category_id" ref="module_category_time_management" />
        <field name="implied_ids" eval="[(4, ref('hr_time_management.group_time_management_user'))]" />
    </record>
    <record id="group_time_management_manager" model="res.groups">
        <field name="name">Time Management Manager (Legacy Alias)</field>
        <field name="category_id" eval="False" />
        <field name="implied_ids" eval="[(4, ref('hr_time_management.group_time_management_line_manager'))]" />
    </record>
    <record id="group_time_management_hr_manager" model="res.groups">
        <field name="name">HR Manager</field>
        <field name="category_id" ref="module_category_time_management" />
        <field name="implied_ids" eval="[(4, ref('hr_time_management.group_time_management_line_manager'))]" />
    </record>
    <record id="group_time_management_hr_admin" model="res.groups">
        <field name="name">HR Administrator</field>
        <field name="category_id" ref="module_category_time_management" />
        <field name="implied_ids" eval="[(4, ref('hr_time_management.group_time_management_hr_manager'))]" />
    </record>
    <record id="rule_cleon_time_policy_company" model="ir.rule">
        <field name="name">Time Policy Company Rule</field>
        <field name="model_id" ref="model_cleon_time_policy" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_cleon_time_audit_log_company" model="ir.rule">
        <field name="name">Time Audit Log Company Rule</field>
        <field name="model_id" ref="model_cleon_time_audit_log" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_period_lock_company_global" model="ir.rule">
        <field name="name">Period Lock Global Company Rule</field>
        <field name="model_id" ref="model_cleon_time_period_lock" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>
