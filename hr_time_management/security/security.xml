<odoo>
    <record id="group_time_management_user" model="res.groups">
        <field name="name">Time Management User</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_own_reader'))]"/>
    </record>
    <record id="group_time_management_manager" model="res.groups">
        <field name="name">Time Management Manager</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('hr_time_management.group_time_management_user')), (4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
    </record>
    <record id="rule_regularization_employee_own" model="ir.rule">
        <field name="name">Employees see their own attendance regularizations</field>
        <field name="model_id" ref="model_cleon_attendance_regularization"/>
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_user')), (4, ref('base.group_user'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_regularization_manager_all" model="ir.rule">
        <field name="name">Time managers see company attendance regularizations</field>
        <field name="model_id" ref="model_cleon_attendance_regularization"/>
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_regularization_system_all" model="ir.rule">
        <field name="name">Settings administrators see company attendance regularizations</field>
        <field name="model_id" ref="model_cleon_attendance_regularization"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>
