<templates xml:space="preserve">
<t t-name="hr_time_management.App">
    <div class="ctm-app">
        <t t-if="state.mode === 'admin'">
        <aside class="ctm-sidebar">
            <button class="ctm-module-title" t-on-click="showGateway"><strong t-esc="featureName()"/><span>⌄</span><small>Time Management</small></button>
            <p class="ctm-nav-label">MAIN</p>
            <button t-att-class="'ctm-nav ' + (state.feature === 'attendance' ? 'active' : '')" t-on-click="() => this.selectFeature('attendance')"><i class="fa fa-calendar"/>Attendance Management</button>
            <button t-att-class="'ctm-nav ' + (state.feature === 'shift' ? 'active' : '')" t-on-click="() => this.selectFeature('shift')"><i class="fa fa-clock-o"/>Shift Management</button>
            <button t-att-class="'ctm-nav ' + (state.feature === 'tracking' ? 'active' : '')" t-on-click="() => this.selectFeature('tracking')"><i class="fa fa-list-alt"/>Time Tracking</button>
            <button t-att-class="'ctm-nav ' + (state.feature === 'overtime' ? 'active' : '')" t-on-click="() => this.selectFeature('overtime')"><i class="fa fa-hourglass-half"/>Overtime Management</button>
            <t t-if="state.feature === 'attendance'">
            <p class="ctm-nav-label">ATTENDANCE</p>
            <button t-att-class="'ctm-nav ' + (state.page === 'dashboard' ? 'active' : '')" t-on-click="() => this.setPage('dashboard')"><i class="fa fa-th-large"/>Dashboard</button>
            <button class="ctm-nav"><i class="fa fa-rocket"/>Get Started</button>
            <p class="ctm-nav-label">MANAGEMENT</p>
            <button t-att-class="'ctm-nav ' + (state.page === 'sheet' ? 'active' : '')" t-on-click="() => this.setPage('sheet')"><i class="fa fa-clipboard"/>Attendance Sheets</button>
            <button class="ctm-nav"><i class="fa fa-file-text-o"/>Regularization Requests <span class="ctm-count">0</span></button>
            <p class="ctm-nav-label">SYSTEM</p>
            <button class="ctm-nav"><i class="fa fa-bar-chart"/>Reports</button>
            <button t-att-class="'ctm-nav ' + (state.page === 'settings' ? 'active' : '')" t-on-click="openSettings"><i class="fa fa-cog"/>Policy &amp; Settings</button>
            <button class="ctm-nav"><i class="fa fa-shield"/>Audit Trail</button>
            </t>
        </aside>
        <main class="ctm-main">
            <div class="ctm-view-switch" t-if="state.isManager"><button class="active"><i class="fa fa-shield"/> Admin View</button><button t-on-click="() => this.setMode('employee')"><i class="fa fa-user-o"/> Employee View</button></div>
            <t t-if="state.feature !== 'attendance'">
                <div class="ctm-heading"><div><nav class="ctm-breadcrumb"><span>HR Admin</span><b>›</b><button t-on-click="showGateway">Time Management</button><b>›</b><span t-esc="featureName()"/></nav><h1><i t-att-class="'fa '+featureIcon()"/> <t t-esc="featureName()"/></h1><p>Dedicated workspace for <t t-esc="featureName().toLowerCase()"/></p></div><button class="ctm-btn" t-on-click="showGateway"><i class="fa fa-exchange"/> Change Feature</button></div>
                <section class="ctm-empty-state"><i t-att-class="'fa '+featureIcon()"/><h2><t t-esc="featureName()"/> foundation</h2><p>This dedicated page and navigation route are ready. Detailed controls will be implemented from the corresponding approved screen specification.</p></section>
            </t>
            <t t-elif="state.page === 'dashboard'">
                <div class="ctm-heading"><div><nav class="ctm-breadcrumb"><span>HR Admin</span><b>›</b><button t-on-click="showGateway">Time Management</button><b>›</b><span>Attendance Management</span></nav><h1><i class="fa fa-calendar"/> Attendance Dashboard</h1><p>Monitor real-time attendance and workforce presence</p></div><div class="ctm-heading-actions"><button class="ctm-btn" t-on-click="showGateway"><i class="fa fa-exchange"/> Change Feature</button><button class="ctm-btn" t-on-click="exportCsv">⬇ Export Excel</button></div></div>
                <div class="ctm-kpis">
                    <article class="green"><i class="fa fa-user-plus"/><strong t-esc="state.counts.present || 0"/><span>Present Today</span></article>
                    <article class="red"><i class="fa fa-user-times"/><strong t-esc="state.counts.absent || 0"/><span>Absent Today</span></article>
                    <article class="amber"><i class="fa fa-exclamation-circle"/><strong t-esc="state.counts.late || 0"/><span>Late Arrivals</span></article>
                    <article class="blue"><i class="fa fa-line-chart"/><strong><t t-esc="state.attendanceRate"/>%</strong><span>Attendance Rate</span></article>
                </div>
                <section class="ctm-panel">
                    <div class="ctm-status-filter"><strong>Filter by Status:</strong><t t-foreach="['all','present','absent','late','on_leave']" t-as="status" t-key="status"><button t-att-class="state.status === status ? 'active' : ''" t-on-click="() => this.setStatus(status)" t-esc="status === 'all' ? 'All' : this.label(status)"/></t></div>
                    <t t-call="hr_time_management.AttendanceTable"/>
                </section>
            </t>
            <t t-elif="state.page === 'sheet'">
                <div class="ctm-heading"><div><h1>Attendance Sheets</h1><p>Review and correct recorded employee attendance</p></div></div>
                <section class="ctm-filters">
                    <label>Department<select t-model="state.departmentId"><option value="">All</option><t t-foreach="state.departments" t-as="dept" t-key="dept.id"><option t-att-value="dept.id" t-esc="dept.name"/></t></select></label>
                    <label>From<input type="date" t-model="state.dateFrom"/></label><label>To<input type="date" t-model="state.dateTo"/></label>
                    <label class="grow">Search Employee<input placeholder="Search by name or ID..." t-model="state.search" t-on-keydown="ev => ev.key === 'Enter' &amp;&amp; this.applyFilters()"/></label>
                    <button class="ctm-btn pink" t-on-click="applyFilters">Apply</button><button class="ctm-btn pink" t-on-click="exportCsv">⬇ Export CSV</button>
                </section>
                <section class="ctm-panel"><t t-call="hr_time_management.AttendanceTable"/></section>
            </t>
            <t t-else="">
                <div class="ctm-heading"><div><h1>Time Management Policy</h1><p>Configure company-wide attendance, grace period, clocking, and overtime defaults</p></div></div>
                <section class="ctm-policy">
                    <label>Work Week<select t-model="state.policy.work_week"><option value="five">5-day week</option><option value="six">6-day week</option><option value="custom">Custom</option></select></label>
                    <label>Standard Hours Per Day<input type="number" min="0" step="0.5" t-model="state.policy.standard_hours"/></label>
                    <label>Default Break (minutes)<input type="number" min="0" t-model="state.policy.default_break_minutes"/></label>
                    <label>Late Grace Period (minutes)<input type="number" min="0" t-model="state.policy.default_grace_minutes"/></label>
                    <label>Clock-in Method<select t-model="state.policy.clock_method"><option value="manual">Manual</option><option value="biometric">Biometric</option><option value="gps">GPS-based</option><option value="ip">IP-based</option><option value="mixed">Multiple Methods</option></select></label>
                    <label>Daily Overtime Threshold<input type="number" min="0" step="0.5" t-model="state.policy.daily_overtime_threshold"/></label>
                    <label class="check"><input type="checkbox" t-model="state.policy.weekend_overtime"/> Enable weekend overtime</label>
                    <label class="check"><input type="checkbox" t-model="state.policy.holiday_overtime"/> Enable holiday overtime</label>
                    <div class="ctm-policy-actions"><button class="ctm-btn pink" t-on-click="savePolicy">Save Policy</button></div>
                </section>
            </t>
        </main>
        </t>
        <t t-else="">
            <aside t-att-class="'ctm-sidebar employee ' + (state.isPortal ? 'portal-sidebar' : '')">
                <div class="ctm-employee-brand"><i class="fa fa-user-circle"/><strong t-esc="state.isPortal ? 'EMPLOYEE PORTAL' : 'EMPLOYEE VIEW'"/><small t-esc="state.employeeData?.employee || 'Employee'"/></div>
                <t t-if="state.isPortal">
                    <button t-att-class="'ctm-nav ' + (state.employeePage === 'dashboard' ? 'active' : '')" t-on-click="() => this.setEmployeePage('dashboard')"><i class="fa fa-home"/>Dashboard</button>
                    <button class="ctm-nav"><i class="fa fa-tasks"/>My Tasks</button>
                    <button class="ctm-nav ctm-section-toggle" t-on-click="() => this.togglePortalSection('profile')"><i class="fa fa-user-o"/><strong>My Profile</strong><i t-att-class="'fa ctm-chevron ' + (state.profileOpen ? 'fa-chevron-up' : 'fa-chevron-down')"/></button>
                    <div t-if="state.profileOpen" class="ctm-nav-children"><button class="ctm-nav"><i class="fa fa-id-card-o"/>Personal Information</button><button class="ctm-nav"><i class="fa fa-briefcase"/>Work History</button></div>
                    <button class="ctm-nav ctm-section-toggle" t-on-click="() => this.togglePortalSection('leave')"><i class="fa fa-calendar-o"/><strong>Leave Management</strong><i t-att-class="'fa ctm-chevron ' + (state.leaveOpen ? 'fa-chevron-up' : 'fa-chevron-down')"/></button>
                    <div t-if="state.leaveOpen" class="ctm-nav-children"><button t-att-class="'ctm-nav ' + (state.employeePage === 'leave' ? 'active' : '')" t-on-click="() => this.showPortalLeave('leave')"><i class="fa fa-calendar-plus-o"/>Apply for Leave</button><button t-att-class="'ctm-nav ' + (state.employeePage === 'leaveRequests' ? 'active' : '')" t-on-click="() => this.showPortalLeave('leaveRequests')"><i class="fa fa-file-text-o"/>My Leave Requests</button><button t-att-class="'ctm-nav ' + (state.employeePage === 'leave' ? 'active' : '')" t-on-click="() => this.showPortalLeave('leave')"><i class="fa fa-pie-chart"/>Leave Balance</button><button t-att-class="'ctm-nav ' + (state.employeePage === 'leaveCalendar' ? 'active' : '')" t-on-click="() => this.showPortalLeave('leaveCalendar')"><i class="fa fa-calendar"/>Leave Calendar</button></div>
                </t>
                <button t-if="state.isPortal" class="ctm-nav ctm-section-toggle" t-on-click="() => this.togglePortalSection('time')"><i class="fa fa-clock-o"/><strong>Time &amp; Attendance</strong><i t-att-class="'fa ctm-chevron ' + (state.timeOpen ? 'fa-chevron-up' : 'fa-chevron-down')"/></button>
                <p t-else="" class="ctm-nav-label">TIME &amp; ATTENDANCE</p>
                <div t-if="!state.isPortal or state.timeOpen" t-att-class="state.isPortal ? 'ctm-nav-children' : ''"><button t-att-class="'ctm-nav ' + (state.employeePage === 'clock' ? 'active' : '')" t-on-click="() => this.setEmployeePage('clock')"><i class="fa fa-clock-o"/>Clock In/Out</button><button t-att-class="'ctm-nav ' + (state.employeePage === 'history' ? 'active' : '')" t-on-click="() => this.setEmployeePage('history')"><i class="fa fa-calendar-check-o"/>My Attendance</button><button t-att-class="'ctm-nav ' + (state.employeePage === 'overtime' ? 'active' : '')" t-on-click="() => this.setEmployeePage('overtime')"><i class="fa fa-hourglass-half"/>Overtime Requests</button></div>
                <t t-if="state.isPortal">
                    <p class="ctm-nav-label">SELF SERVICE</p>
                    <button class="ctm-nav"><i class="fa fa-money"/>Payroll</button>
                    <button class="ctm-nav"><i class="fa fa-cube"/>My Assets</button>
                    <button class="ctm-nav"><i class="fa fa-heart-o"/>HMO &amp; Benefits</button>
                    <button class="ctm-nav"><i class="fa fa-folder-o"/>Documents</button>
                    <button class="ctm-nav"><i class="fa fa-users"/>Staff Directory</button>
                </t>
            </aside>
            <main class="ctm-main employee-main">
                <header t-if="!['leave','leaveRequests'].includes(state.employeePage)" class="ctm-employee-header"><div><h1 t-esc="state.employeePage === 'dashboard' ? 'Employee Portal' : 'Time &amp; Attendance'"/><p t-esc="state.employeePage === 'dashboard' ? 'Your personal HR workspace' : 'Track your attendance and working hours'"/></div><div class="ctm-view-switch" t-if="state.isManager and !state.isPortal"><button t-on-click="() => this.setMode('admin')"><i class="fa fa-shield"/> Admin View</button><button class="active"><i class="fa fa-user-o"/> Employee View</button></div></header>
                <t t-if="state.employeeData">
                    <t t-if="state.employeePage === 'leave'"><EmployeeLeaveDashboard embedded="true"/></t>
                    <t t-elif="state.employeePage === 'leaveRequests'"><MyLeaveRequestsPage embedded="true"/></t>
                    <t t-elif="state.employeePage === 'leaveCalendar'"><LeaveCalendarPage embedded="true" forceEmployee="true"/></t>
                    <t t-elif="state.employeePage === 'dashboard'">
                        <section class="ctm-portal-welcome"><div><h2>Welcome back, <t t-esc="state.employeeData.employee"/>!</h2><p>Access your attendance, leave and employee self-service tools.</p></div><button t-on-click="() => this.setEmployeePage('clock')"><i class="fa fa-clock-o"/> Clock In / Out</button></section>
                        <div class="ctm-portal-cards">
                            <article class="blue"><i class="fa fa-calendar-check-o"/><span>Days Present</span><strong t-esc="state.employeeData.summary.days_present"/><small>This month</small></article>
                            <article class="green"><i class="fa fa-clock-o"/><span>Today's Status</span><strong t-esc="state.employeeData.attendance_state === 'checked_in' ? 'Clocked In' : 'Clocked Out'"/><button t-on-click="toggleAttendance" t-esc="state.employeeData.attendance_state === 'checked_in' ? 'Clock Out' : 'Clock In'"/></article>
                            <article class="purple"><i class="fa fa-calendar"/><span>My Shift</span><strong t-esc="state.employeeData.shift.name"/><small><t t-esc="state.employeeData.shift.break_minutes"/> minute break</small></article>
                            <article class="pink"><i class="fa fa-hourglass-half"/><span>Late Arrivals</span><strong t-esc="state.employeeData.summary.late_arrivals"/><small>This month</small></article>
                        </div>
                        <section class="ctm-portal-actions"><h2>Employee Self Service</h2><div><button t-on-click="() => this.showPortalLeave('leave')"><i class="fa fa-plane"/> Manage My Leave</button><button t-on-click="() => this.setEmployeePage('history')"><i class="fa fa-calendar-check-o"/> My Attendance</button><button t-on-click="() => this.setEmployeePage('overtime')"><i class="fa fa-hourglass-half"/> Overtime Requests</button></div></section>
                    </t>
                    <t t-elif="state.employeePage === 'clock'">
                        <section class="ctm-clock-card"><i class="fa fa-clock-o"/><h2>CLOCK IN/OUT</h2><p>Status</p><strong t-esc="state.employeeData.attendance_state === 'checked_in' ? 'Clocked In' : 'Clocked Out'"/><small t-if="state.employeeData.today"><t t-esc="state.employeeData.today.check_in"/> <t t-if="state.employeeData.today.check_out">— <t t-esc="state.employeeData.today.check_out"/></t></small><button t-att-class="state.employeeData.attendance_state === 'checked_in' ? 'clock-out' : 'clock-in'" t-on-click="toggleAttendance" t-att-disabled="state.busy"><t t-esc="state.employeeData.attendance_state === 'checked_in' ? 'CLOCK OUT' : 'CLOCK IN'"/></button></section>
                        <div class="ctm-employee-widgets"><article><span>DAYS PRESENT</span><strong t-esc="state.employeeData.summary.days_present"/><small>This month</small></article><article><span>TOTAL HOURS</span><strong t-esc="state.employeeData.summary.total_hours"/><small>This month</small></article><article><span>LATE ARRIVALS</span><strong t-esc="state.employeeData.summary.late_arrivals"/><small>This month</small></article><article><span>MY SHIFT</span><strong t-esc="state.employeeData.shift.name"/><small><t t-esc="state.employeeData.shift.break_minutes"/> minute break</small></article></div>
                    </t>
                    <t t-elif="state.employeePage === 'history'">
                        <div class="ctm-heading"><div><h1>My Attendance History</h1><p>View your complete attendance records</p></div></div>
                        <section class="ctm-panel"><div class="ctm-table-wrap"><table><thead><tr><th>DATE</th><th>CLOCK IN</th><th>CLOCK OUT</th><th>HOURS</th><th>STATUS</th><th>LATE BY</th></tr></thead><tbody><tr t-foreach="state.employeeData.rows" t-as="row" t-key="row.id"><td t-esc="row.date"/><td t-esc="row.check_in"/><td t-esc="row.check_out || '—'"/><td><t t-esc="row.hours"/> hrs</td><td><span t-att-class="'status '+row.status" t-esc="label(row.status)"/></td><td><t t-if="row.late_by"><t t-esc="row.late_by"/> min</t><t t-else="">—</t></td></tr></tbody></table></div></section>
                    </t>
                    <t t-else=""><div class="ctm-heading"><div><h1>Overtime Requests</h1><p>Request and track your overtime hours</p></div></div><section class="ctm-empty-state"><i class="fa fa-hourglass-half"/><h2>Overtime workflow coming next</h2><p>The policy foundation is ready; request fields and approval rules will follow the detailed screen specification.</p></section></t>
                </t>
            </main>
        </t>
        <t t-if="state.gateway"><div class="ctm-overlay"><section class="ctm-gateway"><button class="ctm-close" t-on-click="() => this.selectFeature(state.feature)" aria-label="Close">×</button><h2><i class="fa fa-clock-o"/> Time Management</h2><p>Select a module to manage your workforce time and attendance</p><p class="ctm-gateway-message" t-if="state.gatewayMessage" t-esc="state.gatewayMessage"/><div class="ctm-module-grid"><button t-if="state.featureAccess.attendance" t-on-click="() => this.selectFeature('attendance')"><i class="fa fa-calendar pink"/><span><strong>Attendance Management</strong><small>Track and manage employee attendance, clock-ins, and absences</small></span></button><button t-if="state.featureAccess.shift" t-on-click="() => this.selectFeature('shift')"><i class="fa fa-clock-o blue"/><span><strong>Shift Management</strong><small>Schedule and assign shifts across your organization</small></span></button><button t-if="state.featureAccess.tracking" t-on-click="() => this.selectFeature('tracking')"><i class="fa fa-list-alt green"/><span><strong>Time Tracking</strong><small>Track task hours and manage timesheets</small></span></button><button t-if="state.featureAccess.overtime" t-on-click="() => this.selectFeature('overtime')"><i class="fa fa-hourglass-half orange"/><span><strong>Overtime Management</strong><small>Monitor and approve overtime requests and costs</small></span></button></div><footer>Need help choosing? <b>View the guide</b> · Press <kbd>Alt</kbd> + <kbd>T</kbd> to return here</footer></section></div></t>
        <t t-if="state.detail"><div class="ctm-overlay"><section class="ctm-modal detail"><button class="ctm-close" t-on-click="closeDetail">×</button><h2>Employee Attendance Details</h2><div class="ctm-person"><div class="avatar" t-esc="state.detail.employee[0]"/><div><strong t-esc="state.detail.employee"/><small><t t-esc="state.detail.employee_code"/> • <t t-esc="state.detail.department"/></small></div></div><div class="ctm-detail-grid"><div><span>Clock In</span><strong t-esc="state.detail.check_in || 'Missing'"/></div><div><span>Clock Out</span><strong t-esc="state.detail.check_out || 'Missing'"/></div><div><span>Shift</span><strong t-esc="state.detail.shift"/></div><div><span>Status</span><b t-att-class="'status '+state.detail.status" t-esc="label(state.detail.status)"/></div></div></section></div></t>
        <t t-if="state.edit"><div class="ctm-overlay"><section class="ctm-modal edit"><button class="ctm-close" t-on-click="closeEdit">×</button><h2>Edit Attendance Record</h2><div class="ctm-warning">⚠ <strong>You are about to modify an attendance record</strong><br/>Please provide a reason for this change. The update will be audited.</div><div class="ctm-person"><div><span>Employee Name</span><strong t-esc="state.edit.employee"/></div><div><span>Employee ID</span><strong t-esc="state.edit.employee_code"/></div><div><span>Date</span><strong t-esc="state.edit.date"/></div><div><span>Current Status</span><b t-att-class="'status '+state.edit.status" t-esc="label(state.edit.status)"/></div></div><label>Clock-in Time<input type="datetime-local" t-model="state.edit.check_in_input"/></label><label>Clock-out Time<input type="datetime-local" t-model="state.edit.check_out_input"/></label><label>Attendance Status *<select t-model="state.edit.status"><option value="present">Present</option><option value="late">Late</option><option value="absent">Absent</option><option value="on_leave">On Leave</option></select></label><label>Break Duration (minutes)<input type="number" min="0" t-model="state.edit.break_minutes"/></label><label>Reason for change *<textarea t-model="state.editReason"/></label><p class="ctm-error" t-if="state.error" t-esc="state.error"/><footer><button class="ctm-btn" t-on-click="closeEdit">Cancel</button><button class="ctm-btn pink" t-on-click="saveEdit">Save Changes</button></footer></section></div></t>
    </div>
</t>
<t t-name="hr_time_management.AttendanceTable">
    <div class="ctm-table-wrap"><table><thead><tr><th>EMPLOYEE</th><th>DEPARTMENT</th><th t-if="state.page === 'sheet'">DATE</th><th>CLOCK IN</th><th>CLOCK OUT</th><th>SHIFT</th><th t-if="state.page === 'sheet'">HOURS</th><th>STATUS</th><th t-if="state.page === 'dashboard'">SOURCE</th><th>LATE BY</th><th>ACTIONS</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="row" t-key="row.employee_id + '-' + row.id"><td><div class="ctm-employee"><span class="avatar" t-esc="row.employee[0]"/><div><strong t-esc="row.employee"/><small t-esc="row.employee_code"/></div></div></td><td t-esc="row.department"/><td t-if="state.page === 'sheet'" t-esc="row.date"/><td t-esc="row.check_in || '—'"/><td t-esc="row.check_out || 'Missing'"/><td t-esc="row.shift"/><td t-if="state.page === 'sheet'"><t t-esc="row.hours"/> hrs</td><td><span t-att-class="'status '+row.status" t-esc="label(row.status)"/></td><td t-if="state.page === 'dashboard'" t-esc="row.source"/><td><span t-if="row.late_by" class="late"><t t-esc="row.late_by"/> min late</span><span t-else="" class="ontime">On time</span></td><td><button class="link" t-on-click="() => this.openDetail(row)">View</button><button t-if="state.page === 'sheet' and row.id" class="icon-btn" title="Edit" t-on-click="() => this.beginEdit(row)">✎</button></td></tr><tr t-if="!filteredRows.length"><td colspan="11" class="empty">No attendance records match these filters.</td></tr></tbody></table></div>
</t>
</templates>
