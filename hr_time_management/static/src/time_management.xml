<templates xml:space="preserve">
<t t-name="hr_time_management.App">
    <div class="ctm-app">
        <aside class="ctm-sidebar">
            <button class="ctm-module-title" t-on-click="showGateway"><strong>Attendance</strong><span>⌄</span><small>Module Management</small></button>
            <p class="ctm-nav-label">MAIN</p>
            <button t-att-class="'ctm-nav ' + (state.page === 'dashboard' ? 'active' : '')" t-on-click="() => this.setPage('dashboard')"><i class="fa fa-th-large"/>Dashboard</button>
            <button class="ctm-nav"><i class="fa fa-rocket"/>Get Started</button>
            <p class="ctm-nav-label">MANAGEMENT</p>
            <button t-att-class="'ctm-nav ' + (state.page === 'sheet' ? 'active' : '')" t-on-click="() => this.setPage('sheet')"><i class="fa fa-clipboard"/>Attendance Sheets</button>
            <button class="ctm-nav"><i class="fa fa-file-text-o"/>Regularization Requests <span class="ctm-count">0</span></button>
            <p class="ctm-nav-label">SYSTEM</p>
            <button class="ctm-nav"><i class="fa fa-bar-chart"/>Reports</button>
            <button class="ctm-nav"><i class="fa fa-cog"/>Settings</button>
            <button class="ctm-nav"><i class="fa fa-shield"/>Audit Trail</button>
        </aside>
        <main class="ctm-main">
            <t t-if="state.page === 'dashboard'">
                <div class="ctm-heading"><div><span>Time Management &gt; Attendance Management</span><h1><i class="fa fa-clock-o"/> Attendance Dashboard</h1><p>Monitor real-time attendance and workforce presence</p></div><div><button class="ctm-btn" t-on-click="exportCsv">⬇ Export Excel</button></div></div>
                <div class="ctm-kpis">
                    <article class="green"><i class="fa fa-user-plus"/><strong t-esc="state.counts.present || 0"/><span>Present Today</span></article>
                    <article class="red"><i class="fa fa-user-times"/><strong t-esc="state.counts.absent || 0"/><span>Absent Today</span></article>
                    <article class="amber"><i class="fa fa-exclamation-circle"/><strong t-esc="state.counts.late || 0"/><span>Late Arrivals</span></article>
                    <article class="blue"><i class="fa fa-line-chart"/><strong><t t-esc="state.attendanceRate"/>%</strong><span>Attendance Rate</span></article>
                </div>
                <section class="ctm-panel">
                    <div class="ctm-status-filter"><strong>Filter by Status:</strong><t t-foreach="['all','present','absent','late','on_leave']" t-as="status" t-key="status"><button t-att-class="state.status === status ? 'active' : ''" t-on-click="() => this.setStatus(status)" t-esc="status === 'all' ? 'All' : this.label(status)"/></t></div>
                    <t t-call="hr_time_management.AttendanceTable"/>
                </section>
            </t>
            <t t-else="">
                <div class="ctm-heading"><div><h1>Attendance Sheets</h1><p>Review and correct recorded employee attendance</p></div></div>
                <section class="ctm-filters">
                    <label>Department<select t-model="state.departmentId"><option value="">All</option><t t-foreach="state.departments" t-as="dept" t-key="dept.id"><option t-att-value="dept.id" t-esc="dept.name"/></t></select></label>
                    <label>From<input type="date" t-model="state.dateFrom"/></label><label>To<input type="date" t-model="state.dateTo"/></label>
                    <label class="grow">Search Employee<input placeholder="Search by name or ID..." t-model="state.search" t-on-keydown="ev => ev.key === 'Enter' &amp;&amp; this.applyFilters()"/></label>
                    <button class="ctm-btn pink" t-on-click="applyFilters">Apply</button><button class="ctm-btn pink" t-on-click="exportCsv">⬇ Export CSV</button>
                </section>
                <section class="ctm-panel"><t t-call="hr_time_management.AttendanceTable"/></section>
            </t>
        </main>
        <t t-if="state.gateway"><div class="ctm-overlay"><section class="ctm-gateway"><button class="ctm-close" t-on-click="selectAttendance">×</button><h2>Time Management</h2><p>Select a module to manage your workforce time and attendance</p><div class="ctm-module-grid"><button t-on-click="selectAttendance"><i class="fa fa-clock-o blue"/><span><strong>Attendance Management</strong><small>Track and manage employee attendance, clock-ins, and absences</small></span></button><button t-on-click="() => this.selectPending('Shift Management')"><i class="fa fa-calendar purple"/><span><strong>Shift Management</strong><small>Schedule and assign shifts across your organization</small></span></button><button t-on-click="() => this.selectPending('Overtime Management')"><i class="fa fa-money green"/><span><strong>Overtime Management</strong><small>Monitor and approve overtime requests and costs</small></span></button><button t-on-click="() => this.selectPending('Time Tracking')"><i class="fa fa-clock-o orange"/><span><strong>Time Tracking</strong><small>Track task hours and manage timesheets</small></span></button></div><p class="ctm-gateway-message" t-if="state.gatewayMessage" t-esc="state.gatewayMessage"/><footer>Need help choosing? <b>View the guide</b></footer></section></div></t>
        <t t-if="state.detail"><div class="ctm-overlay"><section class="ctm-modal detail"><button class="ctm-close" t-on-click="closeDetail">×</button><h2>Employee Attendance Details</h2><div class="ctm-person"><div class="avatar" t-esc="state.detail.employee[0]"/><div><strong t-esc="state.detail.employee"/><small><t t-esc="state.detail.employee_code"/> • <t t-esc="state.detail.department"/></small></div></div><div class="ctm-detail-grid"><div><span>Clock In</span><strong t-esc="state.detail.check_in || 'Missing'"/></div><div><span>Clock Out</span><strong t-esc="state.detail.check_out || 'Missing'"/></div><div><span>Shift</span><strong t-esc="state.detail.shift"/></div><div><span>Status</span><b t-att-class="'status '+state.detail.status" t-esc="label(state.detail.status)"/></div></div></section></div></t>
        <t t-if="state.edit"><div class="ctm-overlay"><section class="ctm-modal edit"><button class="ctm-close" t-on-click="closeEdit">×</button><h2>Edit Attendance Record</h2><div class="ctm-warning">⚠ <strong>You are about to modify an attendance record</strong><br/>Please provide a reason for this change. The update will be audited.</div><div class="ctm-person"><div><span>Employee Name</span><strong t-esc="state.edit.employee"/></div><div><span>Employee ID</span><strong t-esc="state.edit.employee_code"/></div><div><span>Date</span><strong t-esc="state.edit.date"/></div><div><span>Current Status</span><b t-att-class="'status '+state.edit.status" t-esc="label(state.edit.status)"/></div></div><label>Clock-in Time<input type="datetime-local" t-model="state.edit.check_in_input"/></label><label>Clock-out Time<input type="datetime-local" t-model="state.edit.check_out_input"/></label><label>Attendance Status *<select t-model="state.edit.status"><option value="present">Present</option><option value="late">Late</option><option value="absent">Absent</option><option value="on_leave">On Leave</option></select></label><label>Break Duration (minutes)<input type="number" min="0" t-model="state.edit.break_minutes"/></label><label>Reason for change *<textarea t-model="state.editReason"/></label><p class="ctm-error" t-if="state.error" t-esc="state.error"/><footer><button class="ctm-btn" t-on-click="closeEdit">Cancel</button><button class="ctm-btn pink" t-on-click="saveEdit">Save Changes</button></footer></section></div></t>
    </div>
</t>
<t t-name="hr_time_management.AttendanceTable">
    <div class="ctm-table-wrap"><table><thead><tr><th>EMPLOYEE</th><th>DEPARTMENT</th><th t-if="state.page === 'sheet'">DATE</th><th>CLOCK IN</th><th>CLOCK OUT</th><th>SHIFT</th><th t-if="state.page === 'sheet'">HOURS</th><th>STATUS</th><th t-if="state.page === 'dashboard'">SOURCE</th><th>LATE BY</th><th>ACTIONS</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="row" t-key="row.employee_id + '-' + row.id"><td><div class="ctm-employee"><span class="avatar" t-esc="row.employee[0]"/><div><strong t-esc="row.employee"/><small t-esc="row.employee_code"/></div></div></td><td t-esc="row.department"/><td t-if="state.page === 'sheet'" t-esc="row.date"/><td t-esc="row.check_in || '—'"/><td t-esc="row.check_out || 'Missing'"/><td t-esc="row.shift"/><td t-if="state.page === 'sheet'"><t t-esc="row.hours"/> hrs</td><td><span t-att-class="'status '+row.status" t-esc="label(row.status)"/></td><td t-if="state.page === 'dashboard'" t-esc="row.source"/><td><span t-if="row.late_by" class="late"><t t-esc="row.late_by"/> min late</span><span t-else="" class="ontime">On time</span></td><td><button class="link" t-on-click="() => this.openDetail(row)">View</button><button t-if="state.page === 'sheet' and row.id" class="icon-btn" title="Edit" t-on-click="() => this.beginEdit(row)">✎</button></td></tr><tr t-if="!filteredRows.length"><td colspan="11" class="empty">No attendance records match these filters.</td></tr></tbody></table></div>
</t>
</templates>
