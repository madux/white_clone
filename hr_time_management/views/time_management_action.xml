<odoo>
    <record id="action_time_management" model="ir.actions.client">
        <field name="name">Time Management</field>
        <field name="tag">hr_time_management.App</field>
    </record>

    <record id="action_employee_time_management" model="ir.actions.client">
        <field name="name">Time Management</field>
        <field name="tag">hr_time_management.App</field>
        <field name="params">{'force_employee_mode': True, 'employee_page': 'attendance_dashboard'}</field>
    </record>

    <!-- Kept as a compatibility alias for databases upgraded from the old
         employee-portal-in-time-management implementation. -->
    <record id="action_employee_portal" model="ir.actions.client">
        <field name="name">Time Management</field>
        <field name="tag">hr_time_management.App</field>
        <field name="params">{'force_employee_mode': True, 'employee_page': 'attendance_dashboard'}</field>
    </record>

</odoo>
