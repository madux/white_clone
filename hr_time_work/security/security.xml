<odoo>
    <record id="hr_time_management.group_time_management_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_timesheet.group_hr_timesheet_user'))]"/>
    </record>
    <record id="rule_time_sheet_company_global" model="ir.rule">
        <field name="name">Timesheet Global Company Rule</field>
        <field name="model_id" ref="model_cleon_time_sheet" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_time_sheet_line_company_global" model="ir.rule">
        <field name="name">Timesheet Line Global Company Rule</field>
        <field name="model_id" ref="model_cleon_time_sheet_line" />
        <field name="domain_force">[('sheet_id.company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_time_sheet_employee_own" model="ir.rule">
        <field name="name">Employees manage their own weekly timesheets</field>
        <field name="model_id" ref="model_cleon_time_sheet" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_user')), (4, ref('base.group_user'))]" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_time_sheet_line_manager_team" model="ir.rule">
        <field name="name">Line Managers manage team weekly timesheets</field>
        <field name="model_id" ref="model_cleon_time_sheet" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_line_manager'))]" />
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_time_sheet_hr_manager_company" model="ir.rule">
        <field name="name">HR Managers manage company weekly timesheets</field>
        <field name="model_id" ref="model_cleon_time_sheet" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_hr_manager')), (4, ref('base.group_system'))]" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_time_sheet_line_employee_own" model="ir.rule">
        <field name="name">Employees manage entries on their own timesheets</field>
        <field name="model_id" ref="model_cleon_time_sheet_line" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_user')), (4, ref('base.group_user'))]" />
        <field name="domain_force">[('sheet_id.employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_time_sheet_line_line_manager_team" model="ir.rule">
        <field name="name">Line Managers manage team timesheet entries</field>
        <field name="model_id" ref="model_cleon_time_sheet_line" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_line_manager'))]" />
        <field name="domain_force">['|', ('sheet_id.employee_id.user_id', '=', user.id), ('sheet_id.employee_id.parent_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_time_sheet_line_hr_manager_company" model="ir.rule">
        <field name="name">HR Managers manage company timesheet entries</field>
        <field name="model_id" ref="model_cleon_time_sheet_line" />
        <field name="groups" eval="[(4, ref('hr_time_management.group_time_management_hr_manager')), (4, ref('base.group_system'))]" />
        <field name="domain_force">[('sheet_id.company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>
